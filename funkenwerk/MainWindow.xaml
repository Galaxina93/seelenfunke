                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="MODUS:" Foreground="#9CA3AF" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ComboBox x:Name="CamRecordModeCombo" Width="178" SelectionChanged="CamRecordModeCombo_SelectionChanged" SelectedIndex="0" Padding="10,6" FontSize="12">
                                        <ComboBoxItem Content="🎬 Standard (Video+Ton)" Tag="standard"/>
                                        <ComboBoxItem Content="🎮 Gaming (High-Bitrate)" Tag="gaming"/>
                                        <ComboBoxItem Content="🔇 Nur Video (Stumm)" Tag="silent"/>
                                        <ComboBoxItem Content="⏱ 3s Selbstauslöser" Tag="countdown3"/>
                                        <ComboBoxItem Content="⚡ 15s Short-Clip" Tag="clip15"/>
