                                            <MediaElement x:Name="SmartClipMediaElement" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform" MediaOpened="SmartClipMedia_MediaOpened" MediaEnded="SmartClipMedia_MediaEnded" MouseLeftButtonUp="SmartClipPlayPause_Click" Cursor="Hand"/>
