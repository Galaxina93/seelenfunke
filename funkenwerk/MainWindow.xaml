                <Border Grid.Column="0" Background="#161922" Padding="14,18">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Top">
                            <Border Background="#1E222D" BorderBrush="#2A2F3D" BorderThickness="1" CornerRadius="10" Padding="10,7" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
