            <Grid x:Name="CameraStudioViewGrid" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="310" MinWidth="240" MaxWidth="460"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*" MinWidth="460"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="355" MinWidth="290" MaxWidth="500"/>
