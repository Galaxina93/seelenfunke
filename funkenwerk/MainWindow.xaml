                                    <TextBlock x:Name="MusicNowTitleTxt" Text="Kein Song ausgewählt" Foreground="#F9FAFB" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" MaxHeight="52" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="MusicNowArtistTxt" Text="Wähle links einen Titel aus" Foreground="#C5A059" FontSize="13.5" FontWeight="SemiBold" Margin="0,4,0,18" TextTrimming="CharacterEllipsis"/>
