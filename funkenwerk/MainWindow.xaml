                                        </StackPanel>
                                        <Button Grid.Column="1" Click="SettingsRefreshCameraAudioDevices_Click" Background="#1F2430" Foreground="#C5A059" BorderThickness="0" Padding="10,4" Cursor="Hand" FontSize="11" FontWeight="Bold" Content="↻ Geräte suchen">
