                                        <TextBlock x:Name="MusicCountAll" Grid.Column="2" Text="" Foreground="#C5A059" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <Border x:Name="MusicSmartFavBorder" Tag="favorites" MouseLeftButtonUp="MusicSmartView_Click" CornerRadius="10" Padding="12,9" Margin="0,1" Background="Transparent" Cursor="Hand">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="★" Foreground="#F59E0B" FontSize="15" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="Favoriten" Foreground="#E5E7EB" FontSize="13.5" FontWeight="Medium" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="MusicCountFav" Grid.Column="2" Text="" Foreground="#F59E0B" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <Border Height="1" Background="#232734" Margin="4,6,4,10"/>
                            <TextBlock Text="PLAYLISTS" Foreground="#6B7280" FontSize="10.5" FontWeight="Bold" Margin="6,0,0,6"/>
                        </StackPanel>

                        <!-- Bottom New Playlist Input -->
                        <Border DockPanel.Dock="Bottom" BorderBrush="#232734" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#181B24" BorderBrush="#262A36" BorderThickness="1" CornerRadius="9" Padding="9,6" Margin="0,0,6,0">
                                    <Grid>
                                        <TextBox x:Name="NewMusicPlaylistBox" Background="Transparent" BorderThickness="0" Foreground="#F3F4F6" CaretBrush="#C5A059" FontSize="12" KeyDown="NewMusicPlaylistBox_KeyDown" TextChanged="NewMusicPlaylistBox_TextChanged"/>
                                        <TextBlock x:Name="NewMusicPlaylistPlaceholder" Text="Neue Playlist..." Foreground="#6B7280" FontSize="11.5" VerticalAlignment="Center" IsHitTestVisible="False"/>
