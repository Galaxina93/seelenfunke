                                        <Button x:Name="SmartGridBtn1" Click="SmartGridLayout_Click" Tag="1" Background="#C5A059" Foreground="#111827" BorderThickness="0" Padding="11,6" Margin="0,0,3,0" Cursor="Hand" ToolTip="Einzelkachel Groß (Vollfokus mit PTZ-Steuerung)">
