                                            <Border Background="#0F1117" BorderBrush="#232734" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,6">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Swatch + Label -->
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
