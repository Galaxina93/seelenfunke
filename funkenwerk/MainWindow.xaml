                                                </StackPanel>
                                                <CheckBox x:Name="ShowCompletedDefaultCheck" Grid.Column="1" VerticalAlignment="Center" IsChecked="True" Cursor="Hand"/>
                                            </Grid>
                                        </StackPanel>
