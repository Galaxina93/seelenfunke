                                            <!-- 1. BACKGROUND FARBE                                     -->
                                            <!-- ======================================================= -->
                                            <Border Background="#0F1117" BorderBrush="#232734" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,10">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Swatch + Label -->
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border x:Name="DesignSpaceBgPreviewSwatch" Width="28" Height="28" CornerRadius="7" Background="#000000" BorderBrush="#C5A059" BorderThickness="1.5" Margin="0,0,10,0"/>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="Background Farbe:" Foreground="#F9FAFB" FontSize="12.5" FontWeight="Bold"/>
                                                                <TextBlock Text="Farbcode manuell, Farbpipette oder Farbpalette" Foreground="#9CA3AF" FontSize="10.5"/>
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <!-- Manual Hex Input + Eyedropper Pipette + Spectrum Picker -->
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Background="#000000" BorderBrush="#382D18" BorderThickness="1" CornerRadius="7" Padding="8,4" Margin="0,0,6,0">
                                                                <TextBox x:Name="DesignSpaceBgHexBox" Text="#000000" Width="74" Background="Transparent" Foreground="#F9FAFB" CaretBrush="#C5A059" BorderThickness="0" FontSize="12" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" TextChanged="DesignSpaceBgHexBox_TextChanged" LostFocus="DesignSpaceBgHexBox_LostFocus" KeyDown="DesignSpaceHexBox_KeyDown"/>
