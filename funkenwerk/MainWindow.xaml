                                        <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="☀" Foreground="#C5A059" FontSize="15" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="Mein Tag" Foreground="#E5E7EB" FontSize="13.5" FontWeight="Medium" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="CountMyDay" Grid.Column="2" Text="" Foreground="#C5A059" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <Border x:Name="SmartImportantBorder" Tag="important" MouseLeftButtonUp="SmartList_Click" CornerRadius="10" Padding="12,9" Margin="0,1" Background="Transparent" Cursor="Hand">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="★" Foreground="#C5A059" FontSize="15" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="Wichtig" Foreground="#E5E7EB" FontSize="13.5" FontWeight="Medium" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="CountImportant" Grid.Column="2" Text="" Foreground="#C5A059" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <Border x:Name="SmartPlannedBorder" Tag="planned" MouseLeftButtonUp="SmartList_Click" CornerRadius="10" Padding="12,9" Margin="0,1" Background="Transparent" Cursor="Hand">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="📅" Foreground="#34D399" FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="Geplant" Foreground="#E5E7EB" FontSize="13.5" FontWeight="Medium" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="CountPlanned" Grid.Column="2" Text="" Foreground="#34D399" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <Border x:Name="SmartAllBorder" Tag="all" MouseLeftButtonUp="SmartList_Click" CornerRadius="10" Padding="12,9" Margin="0,1" Background="Transparent" Cursor="Hand">
