                                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style></Button.Resources>
                                                            </Button>
                                                            <Button Click="DesignSpaceOpenBgSpectrumPopup_Click" Background="#1F2430" Foreground="#F9FAFB" BorderBrush="#382D18" BorderThickness="1" Padding="9,5" Cursor="Hand" FontSize="11.5" FontWeight="SemiBold" ToolTip="Farbspektrum-Regler öffnen" Content="🎨 Regler">
                                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style></Button.Resources>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- Vorauswahl Farbpalette (Background) -->
                                                    <TextBlock Text="VORAUSWAHL FARBPALETTE (BACKGROUND)" Foreground="#9CA3AF" FontSize="9.5" FontWeight="Bold" Margin="0,0,0,5"/>
                                                    <WrapPanel x:Name="DesignSpaceBgPalettePanel" Orientation="Horizontal"/>
                                                </StackPanel>
                                            </Border>

