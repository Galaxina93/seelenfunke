                                        </Button>
                                    </Grid>
                                    <ComboBox x:Name="SettingsMicrophoneCombo" SelectionChanged="SettingsMicrophoneCombo_SelectionChanged" Padding="10,7" FontSize="13"/>
                                </StackPanel>
                            </Border>

                            <!-- STANDARD HARDWARE-KAMERA AUSWAHL -->
                            <Border Background="#13161F" BorderBrush="#232734" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="🎥 STANDARD HARDWARE-KAMERA (HAUPTQUELLE)" Foreground="#9CA3AF" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="SettingsPrimaryCameraCombo" SelectionChanged="SettingsPrimaryCameraCombo_SelectionChanged" Padding="10,7" FontSize="13"/>
                                </StackPanel>
                            </Border>

                            <!-- 5. MEDIEN-SPEICHERPFAD KONFIGURIERBAR -->
                            <Border Background="#13161F" BorderBrush="#232734" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="📁 SPEICHERPFAD FÜR KAMERA-MEDIEN (SCREENSHOTS &amp; VIDEOS)" Foreground="#9CA3AF" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBlock Text="Standardmäßig werden alle Fotos (.png) und Videos (.mp4) logisch im Projektverzeichnis unter 'KameraMedien' gespeichert." Foreground="#6B7280" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                    <Border Background="#0F1117" BorderBrush="#2A2F3D" BorderThickness="1" CornerRadius="10" Padding="10,7" Margin="0,0,0,8">
                                        <TextBox x:Name="SettingsCameraMediaPathBox" Background="Transparent" BorderThickness="0" Foreground="#F9FAFB" CaretBrush="#C5A059" FontSize="12.5"/>
                                    </Border>

                                    <StackPanel Orientation="Horizontal">
                                        <Button Click="SettingsBrowseCameraMediaPath_Click" Background="#1F2430" Foreground="#C5A059" BorderThickness="0" Padding="12,6" Margin="0,0,8,0" Cursor="Hand" FontSize="11.5" FontWeight="Bold" Content="📂 Ordner auswählen...">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                        </Button>
                                        <Button Click="SettingsResetCameraMediaPath_Click" Background="#1F2430" Foreground="#D1D5DB" BorderThickness="0" Padding="12,6" Margin="0,0,8,0" Cursor="Hand" FontSize="11.5" Content="↺ Projektverzeichnis (Standard)">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                        </Button>
                                        <Button Click="CamOpenMediaFolder_Click" Background="#1F2430" Foreground="#D1D5DB" BorderThickness="0" Padding="12,6" Cursor="Hand" FontSize="11.5" Content="↗ Im Explorer öffnen">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- VIRTUELLE WINDOWS KAMERA TREIBER STATUS -->
                            <Border Background="#13161F" BorderBrush="#232734" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="📡 Virtuelle System-Kamera: 'Funkenwerk Kamera'" Foreground="#F9FAFB" FontSize="12.5" FontWeight="Bold"/>
                                        <TextBlock x:Name="SettingsVirtualCamDriverStatusTxt" Text="DirectShow 64-Bit &amp; 32-Bit Treiber in Windows registriert" Foreground="#34D399" FontSize="11" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Click="SettingsRegisterVirtualCam_Click" Background="#1F2430" Foreground="#C5A059" BorderThickness="0" Padding="12,6" VerticalAlignment="Center" Cursor="Hand" FontSize="11.5" FontWeight="Bold" Content="✓ Treiber prüfen">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Footer Buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                            <Button Click="CloseSettings_Click" Background="#232734" Foreground="#D1D5DB" BorderThickness="0" Padding="16,9" Margin="0,0,8,0" Cursor="Hand" Content="Schließen">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="9"/></Style></Button.Resources>
                            </Button>
                            <Button Click="SaveSettings_Click" Background="#C5A059" Foreground="#111827" FontWeight="Bold" BorderThickness="0" Padding="18,9" Cursor="Hand" Content="✓ Einstellungen speichern">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="9"/></Style></Button.Resources>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===================================================================== -->
            <!-- MODAL OVERLAY 3: SMART HOME DEVICE / CAMERA / PLUG CONFIGURATION      -->
            <!-- ===================================================================== -->
            <Grid x:Name="SmartDeviceModalOverlay" Background="#B3000000" Visibility="Collapsed">
                <Border Width="580" Background="#161922" BorderBrush="#262A36" BorderThickness="1" CornerRadius="18" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="SmartModalTitleTxt" Text="Smart Home Gerät konfigurieren" Foreground="#F9FAFB" FontSize="17.5" FontWeight="Bold" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Click="CloseSmartModal_Click" Style="{StaticResource ModalCloseButtonStyle}" Content="✕"/>
                        </Grid>

                        <!-- Camera Form -->
                        <StackPanel x:Name="SmartCameraFormPanel">
                            <TextBlock Text="KAMERA-NAME (Z. B. TERASSE, EINFAHRT, GARAGE, FITNESSSTUDIO)" Foreground="#9CA3AF" FontSize="10.5" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBox x:Name="SmartCamNameInput" Background="#0F1117" Foreground="#F9FAFB" BorderBrush="#262A36" CaretBrush="#C5A059" Padding="10,8" FontSize="13.5" Margin="0,0,0,10"/>

                            <TextBlock Text="LIVE RTSP STREAM-URL" Foreground="#9CA3AF" FontSize="10.5" FontWeight="Bold" Margin="0,0,0,4"/>
                            <Border Background="#0F1117" BorderBrush="#262A36" BorderThickness="1" CornerRadius="8" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SmartCamUrlInput" Background="Transparent" Foreground="#F9FAFB" BorderThickness="0" CaretBrush="#C5A059" Padding="10,8" FontSize="13" VerticalContentAlignment="Center"/>
                                    <TextBlock x:Name="SmartCamUrlMaskedTxt" Background="Transparent" Foreground="#F9FAFB" Padding="10,8" FontSize="13" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    <Button x:Name="SmartCamUrlEyeBtn" Grid.Column="1" Click="ToggleSmartCamUrlPassword_Click" Background="Transparent" Foreground="#9CA3AF" BorderThickness="0" Padding="10,4" Cursor="Hand" ToolTip="Passwort in RTSP-URL anzeigen / verbergen">
                                        <TextBlock x:Name="SmartCamUrlEyeTxt" Text="👁" FontSize="13" Foreground="#C5A059"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <TextBlock Text="ONVIF SERVICE-URL (PTZ &amp; GERÄTESTEUERUNG)" Foreground="#9CA3AF" FontSize="10.5" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBox x:Name="SmartCamServiceUrlInput" Background="#0F1117" Foreground="#F9FAFB" BorderBrush="#262A36" CaretBrush="#C5A059" Padding="10,8" FontSize="13" Margin="0,0,0,10"/>

                            <TextBlock Text="STANDORT / BESCHREIBUNG" Foreground="#9CA3AF" FontSize="10.5" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBox x:Name="SmartCamDescInput" Background="#0F1117" Foreground="#F9FAFB" BorderBrush="#262A36" CaretBrush="#C5A059" Padding="10,8" FontSize="13" Margin="0,0,0,12"/>

                            <Border Background="#13161F" BorderBrush="#232734" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,12">
                                <StackPanel>
                                    <CheckBox x:Name="SmartCamMotionCheck" Content="Automatische Videoaufnahme bei Bewegung aktivieren (15s MP4-Clip)" Foreground="#F3F4F6" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,8" Cursor="Hand"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="45"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Empfindlichkeit:" Foreground="#9CA3AF" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <Slider x:Name="SmartCamSensSlider" Grid.Column="1" Minimum="10" Maximum="100" Value="65" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding ElementName=SmartCamSensSlider, Path=Value, StringFormat={}{0:0}%}" Foreground="#C5A059" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Plug / Tapo Local Auth Form -->
                        <StackPanel x:Name="SmartPlugFormPanel" Visibility="Collapsed">
                            <TextBlock Text="STECKDOSE BEZEICHNUNG" Foreground="#9CA3AF" FontSize="10.5" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBox x:Name="SmartPlugNameInput" Background="#0F1117" Foreground="#F9FAFB" BorderBrush="#262A36" CaretBrush="#C5A059" Padding="10,8" FontSize="13.5" Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="LOKALE IP-ADRESSE" Foreground="#9CA3AF" FontSize="10.5" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBox x:Name="SmartPlugIpInput" Background="#0F1117" Foreground="#F9FAFB" BorderBrush="#262A36" CaretBrush="#C5A059" Padding="10,8" FontSize="13"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="MODELL / MAC" Foreground="#9CA3AF" FontSize="10.5" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBox x:Name="SmartPlugModelInput" Background="#0F1117" Foreground="#F9FAFB" BorderBrush="#262A36" CaretBrush="#C5A059" Padding="10,8" FontSize="13"/>
                                </StackPanel>
                            </Grid>

                            <Border Background="#13161F" BorderBrush="#C5A059" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,4,0,10">
                                <StackPanel>
                                    <TextBlock Text="🔑 Lokaler In-House KLAP-Schlüssel (TP-Link / Tapo Konto)" Foreground="#C5A059" FontSize="12" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBlock Text="Tapo-Steckdosen (P100/P110) verschlüsseln lokale Befehle im WLAN per SHA-256 Hash deiner Tapo-Zugangsdaten (KLAP v2). Die Daten bleiben zu 100% lokal auf deinem PC." Foreground="#9CA3AF" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                    <TextBlock Text="TAPO E-MAIL-ADRESSE" Foreground="#9CA3AF" FontSize="10" FontWeight="Bold" Margin="0,0,0,3"/>
                                    <TextBox x:Name="SmartTapoEmailInput" Background="#0F1117" Foreground="#F9FAFB" BorderBrush="#262A36" CaretBrush="#C5A059" Padding="8,6" FontSize="12.5" Margin="0,0,0,8"/>

                                    <TextBlock Text="TAPO PASSWORT" Foreground="#9CA3AF" FontSize="10" FontWeight="Bold" Margin="0,0,0,3"/>
                                    <Border Background="#0F1117" BorderBrush="#262A36" BorderThickness="1" CornerRadius="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <PasswordBox x:Name="SmartTapoPassInput" Background="Transparent" Foreground="#F9FAFB" BorderThickness="0" CaretBrush="#C5A059" Padding="8,6" FontSize="12.5" VerticalContentAlignment="Center" PasswordChanged="SmartTapoPassInput_PasswordChanged"/>
                                            <TextBox x:Name="SmartTapoPassVisibleInput" Background="Transparent" Foreground="#F9FAFB" BorderThickness="0" CaretBrush="#C5A059" Padding="8,6" FontSize="12.5" VerticalContentAlignment="Center" Visibility="Collapsed" TextChanged="SmartTapoPassVisibleInput_TextChanged"/>
                                            <Button x:Name="SmartTapoPassEyeBtn" Grid.Column="1" Click="ToggleSmartTapoPassVisibility_Click" Background="Transparent" Foreground="#C5A059" BorderThickness="0" Padding="10,4" Cursor="Hand" ToolTip="Passwort anzeigen / verbergen">
                                                <TextBlock x:Name="SmartTapoPassEyeTxt" Text="👁" FontSize="13.5" Foreground="#C5A059" VerticalAlignment="Center"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button x:Name="SmartModalDeleteBtn" Click="DeleteSmartModalDevice_Click" Background="#2D161B" Foreground="#F87171" BorderThickness="0" Padding="14,8" Margin="0,0,8,0" Cursor="Hand" Content="🗑 Entfernen" Visibility="Collapsed">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                            </Button>
                            <Button Click="CloseSmartModal_Click" Background="#232734" Foreground="#D1D5DB" BorderThickness="0" Padding="14,8" Margin="0,0,8,0" Cursor="Hand" Content="Abbrechen">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                            </Button>
                            <Button Click="SaveSmartModalDevice_Click" Background="#C5A059" Foreground="#111827" FontWeight="Bold" BorderThickness="0" Padding="16,8" Cursor="Hand" Content="✓ Speichern">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>

        <!-- ========================================================================= -->
        <!-- FULL-WINDOW AUTHENTICATION / LOGIN OVERLAY (Luxury Atelier Video + Magic) -->
        <!-- ========================================================================= -->
        <Grid x:Name="AuthLoginOverlayGrid" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Panel.ZIndex="999" Background="#0B0D12" Visibility="Collapsed" ClipToBounds="True">
            <!-- Layer 0: High-Res Poster Backdrop (Zero-latency initial frame) -->
            <Image x:Name="AuthLoginBgPosterImg" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>

            <!-- Layer 1: Epic Slow-Motion Luxury Atelier Video (Slate, Metal, Smoked Glass, Candles & Golden Diamond Crystal "Mein Seelenfunke") -->
            <MediaElement x:Name="AuthLoginBgVideo" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" IsMuted="True" MediaEnded="AuthLoginBgVideo_MediaEnded"/>

            <!-- Layer 2: Ultra-Subtle Ambient Veil so the Atelier Video shines through crystal clear -->
            <Border IsHitTestVisible="False">
                <Border.Background>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.75" RadiusY="0.75">
                        <GradientStop Color="#22000000" Offset="0.0"/>
                        <GradientStop Color="#12000000" Offset="0.65"/>
                        <GradientStop Color="#33000000" Offset="1.0"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>

            <!-- Layer 3: Centered Ultra-Noble Transparent Crystal Login Modal (Main Card #28000000, Smoked Opaque Inputs & Buttons for Crisp Readability) -->
            <Border x:Name="AuthLoginCardBorder" Width="430" Background="#28000000" BorderBrush="#77C5A059" BorderThickness="1" CornerRadius="20" Padding="32,26" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0">
                <StackPanel>
                    <!-- Subtle Translucent Atelier Emblem Line -->
                    <TextBlock x:Name="AuthHeaderSubtitleTxt" Text="✦   M E I N   S E E L E N F U N K E   ✦" Foreground="#F2FCE7B2" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,16"/>

                    <!-- Environment Selector Pills (Lokal / Stage / Live) - Smoked Dark Glass for Crisp Readability -->
                    <UniformGrid Columns="3" Margin="0,0,0,16">
                        <Border x:Name="AuthEnvLocalPill" Background="#A6000000" BorderBrush="#66C5A059" BorderThickness="1" CornerRadius="9" Padding="8,6" Margin="0,0,4,0" Cursor="Hand" MouseLeftButtonUp="AuthEnvPill_Click" Tag="local" ToolTip="http://127.0.0.1/api">
                            <TextBlock x:Name="AuthEnvLocalTxt" Text="Lokal" Foreground="#E6FFFFFF" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        </Border>
                        <Border x:Name="AuthEnvStagePill" Background="#D91F1708" BorderBrush="#F2C5A059" BorderThickness="1.2" CornerRadius="9" Padding="8,6" Margin="2,0,2,0" Cursor="Hand" MouseLeftButtonUp="AuthEnvPill_Click" Tag="stage" ToolTip="https://stage.mein-seelenfunke.de/api">
                            <TextBlock x:Name="AuthEnvStageTxt" Text="Stage" Foreground="#FFFCE7B2" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </Border>
                        <Border x:Name="AuthEnvLivePill" Background="#A6000000" BorderBrush="#66C5A059" BorderThickness="1" CornerRadius="9" Padding="8,6" Margin="4,0,0,0" Cursor="Hand" MouseLeftButtonUp="AuthEnvPill_Click" Tag="live" ToolTip="https://mein-seelenfunke.de/api">
                            <TextBlock x:Name="AuthEnvLiveTxt" Text="Live" Foreground="#E6FFFFFF" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        </Border>
                    </UniformGrid>

                    <!-- E-Mail Field (Smoked Obsidian Glass Input) -->
                    <TextBlock x:Name="AuthEmailLabelTxt" Text="E-MAIL" Foreground="#F2FCE7B2" FontSize="10" FontWeight="Bold" Margin="2,0,0,5"/>
                    <Border x:Name="AuthEmailInputBorder" Background="#BF000000" BorderBrush="#A6C5A059" BorderThickness="1" CornerRadius="11" Margin="0,0,0,12">
                        <TextBox x:Name="AuthLoginEmailBox" Background="Transparent" Foreground="#FFFFFFFF" BorderThickness="0" CaretBrush="#C5A059" Padding="13,9" FontSize="13.5" VerticalContentAlignment="Center" KeyDown="AuthLoginInput_KeyDown"/>
                    </Border>

                    <!-- Password Field (Smoked Obsidian Glass Input + Crisp White Vector Eye Icon) -->
                    <TextBlock x:Name="AuthPasswordLabelTxt" Text="PASSWORT" Foreground="#F2FCE7B2" FontSize="10" FontWeight="Bold" Margin="2,0,0,5"/>
                    <Border x:Name="AuthPasswordInputBorder" Background="#BF000000" BorderBrush="#A6C5A059" BorderThickness="1" CornerRadius="11" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="AuthLoginPasswordBox" Grid.Column="0" Background="Transparent" Foreground="#FFFFFFFF" BorderThickness="0" CaretBrush="#C5A059" Padding="13,9" FontSize="13.5" VerticalContentAlignment="Center" PasswordChanged="AuthLoginPasswordBox_PasswordChanged" KeyDown="AuthLoginInput_KeyDown"/>
                            <TextBox x:Name="AuthLoginPasswordVisibleBox" Grid.Column="0" Background="Transparent" Foreground="#FFFFFFFF" BorderThickness="0" CaretBrush="#C5A059" Padding="13,9" FontSize="13.5" VerticalContentAlignment="Center" Visibility="Collapsed" TextChanged="AuthLoginPasswordVisibleBox_TextChanged" KeyDown="AuthLoginInput_KeyDown"/>
                            <Button x:Name="AuthLoginPasswordEyeBtn" Grid.Column="1" Click="ToggleAuthLoginPasswordVisibility_Click" Background="Transparent" BorderThickness="0" Padding="11,4" Cursor="Hand" ToolTip="Passwort anzeigen / verbergen">
                                <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path x:Name="AuthLoginPasswordEyePath" Fill="Transparent" Stroke="#F2FFFFFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Data="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z M12 9a3 3 0 100 6 3 3 0 000-6z"/>
                                        <Path x:Name="AuthLoginPasswordEyeSlashPath" Fill="Transparent" Stroke="#FFFCE7B2" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"
                                              Data="M3 3l18 18"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Remember Password & Auto-Login Checkbox -->
                    <CheckBox x:Name="AuthLoginRememberCheck" Content="Passwort merken &amp; automatisch einloggen" Foreground="#F2FFFFFF" FontSize="12" FontWeight="SemiBold" IsChecked="True" Margin="2,0,0,14" Cursor="Hand"/>

                    <!-- Error Feedback Box -->
                    <Border x:Name="AuthLoginErrorBorder" Background="#CC1A0808" BorderBrush="#CCEF4444" BorderThickness="1" CornerRadius="9" Padding="10,7" Margin="0,0,0,12" Visibility="Collapsed">
                        <TextBlock x:Name="AuthLoginErrorTxt" Text="" Foreground="#FCA5A5" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </Border>

                    <!-- Primary Login Button (Smoked Obsidian-Gold Glass + Noble Gold Text) -->
                    <Button x:Name="AuthLoginSubmitBtn" Click="AuthLoginSubmitBtn_Click" Background="#D91F1708" BorderBrush="#F2C5A059" BorderThickness="1.2" Foreground="#FFFCE7B2" FontWeight="Bold" FontSize="13.5" Padding="0,11" Cursor="Hand" Content="✦   ANMELDEN   ✦">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BtnBorder" Property="Background" Value="#EB2B200B"/>
                                        <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#FFC5A059"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="BtnBorder" Property="Background" Value="#F536280E"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Layer 4: Full-Window "Magie aktivieren" Portal Transition Overlay -->
            <Grid x:Name="AuthMagicActivationOverlay" Background="#E6070A14" Visibility="Collapsed" IsHitTestVisible="True">
                <!-- Warm Golden Radial Glow -->
                <Ellipse Width="680" Height="680" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#44C5A059" Offset="0.0"/>
                            <GradientStop Color="#18C5A059" Offset="0.45"/>
                            <GradientStop Color="#00C5A059" Offset="1.0"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- 60 FPS Golden Sparks Vortex & Supernova Canvas -->
                <Canvas x:Name="AuthMagicSparksCanvas" IsHitTestVisible="False"/>

                <!-- Centered Celestial Emblem & Typography ("Die Magie erwacht") -->
                <StackPanel x:Name="AuthMagicCenterPanel" VerticalAlignment="Center" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                    <StackPanel.RenderTransform>
                        <ScaleTransform x:Name="AuthMagicCenterScale" ScaleX="1" ScaleY="1"/>
                    </StackPanel.RenderTransform>

                    <Grid Width="170" Height="170" HorizontalAlignment="Center" Margin="0,0,0,18">
                        <!-- Expanding Supernova Shockwave Ring -->
                        <Ellipse x:Name="AuthMagicShockwaveRing" Width="110" Height="110" Stroke="#C5A059" StrokeThickness="2" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="AuthMagicShockwaveScale" ScaleX="0.8" ScaleY="0.8"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>

                        <!-- Rotating Celestial Orbit Rings -->
                        <Viewbox Width="166" Height="166" RenderTransformOrigin="0.5,0.5">
                            <Viewbox.RenderTransform>
                                <RotateTransform x:Name="AuthMagicOrbitRotate" Angle="0"/>
                            </Viewbox.RenderTransform>
                            <Canvas Width="200" Height="200">
                                <Ellipse Canvas.Left="8" Canvas.Top="8" Width="184" Height="184" Stroke="#66C5A059" StrokeThickness="1.2" StrokeDashArray="4 8"/>
                                <Ellipse Canvas.Left="18" Canvas.Top="18" Width="164" Height="164" Stroke="#99C5A059" StrokeThickness="1.6" StrokeDashArray="16 8 3 8"/>
                            </Canvas>
                        </Viewbox>

                        <!-- Golden Core Medallion with 4-Pointed Seelenfunke Star -->
                        <Border Width="88" Height="88" CornerRadius="44" BorderBrush="#CCFFFFFF" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FDE68A" Offset="0.0"/>
                                    <GradientStop Color="#C5A059" Offset="0.55"/>
                                    <GradientStop Color="#9A7229" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="AuthMagicCoreScale" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <Viewbox Width="44" Height="44" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <Viewbox.RenderTransform>
                                    <RotateTransform x:Name="AuthMagicStarRotate" Angle="0"/>
                                </Viewbox.RenderTransform>
                                <Canvas Width="24" Height="24">
                                    <Path Fill="#111827" Data="M12 2L14.6 9.4L22 12L14.6 14.6L12 22L9.4 14.6L2 12L9.4 9.4L12 2Z"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                    </Grid>

                    <!-- Status Pill -->
                    <Border Background="#26C5A059" BorderBrush="#66C5A059" BorderThickness="1" CornerRadius="14" Padding="14,5" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="#FBBF24" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="AuthMagicPhasePillTxt" Text="SEELENFUNKEN SAMMELN SICH..." Foreground="#FDE68A" FontSize="11" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <!-- Headline -->
                    <TextBlock HorizontalAlignment="Center" FontSize="34" FontWeight="Bold" Foreground="#F9FAFB">
                        <Run Text="Die Magie "/>
                        <Run Text="erwacht" Foreground="#C5A059"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ========================================================================= -->
        <!-- FULL-WINDOW MUSIC FOCUS MODE: RED & BLACK VENOM WALLPAPER ANIMATION       -->
        <!-- ========================================================================= -->
        <Grid x:Name="MusicVenomFocusOverlay" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="2"
              Panel.ZIndex="9950" Visibility="Collapsed" Background="#000000" ClipToBounds="True"
              MouseEnter="MusicVenomFocusOverlay_MouseEnter"
              MouseMove="MusicVenomFocusOverlay_MouseMove"
              MouseLeave="MusicVenomFocusOverlay_MouseLeave"
              MouseLeftButtonDown="MusicVenomFocusOverlay_MouseLeftButtonDown">
            <Canvas x:Name="VenomFocusCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsHitTestVisible="False"/>

            <!-- Bottom-Right "Fokus beenden" Button (Only visible when mouse is inside the window) -->
            <Button x:Name="VenomExitFocusBtn" Click="ExitMusicVenomFocusMode_Click"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,26,22"
                    Background="#4D0A0204" Foreground="#CCF9FAFB" BorderBrush="#55EF4444" BorderThickness="1"
                    Padding="16,9" Cursor="Hand" FontSize="12.5" FontWeight="SemiBold" Opacity="0.62"
                    Visibility="Collapsed">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                <TextBlock Text="Fokus beenden"/>
            </Button>
        </Grid>
    </Grid>
</Window>
