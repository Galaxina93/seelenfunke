                                                        <TextBlock x:Name="DesignSpaceSatValTxt" Grid.Column="2" Text="0 %" Foreground="#C5A059" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    </Grid>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="75"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
