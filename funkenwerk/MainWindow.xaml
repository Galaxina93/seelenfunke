                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="⬇" Foreground="#C5A059" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBox x:Name="MusicImportUrlBox" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                             Foreground="#F3F4F6" CaretBrush="#C5A059" FontSize="12.5" VerticalContentAlignment="Center" KeyDown="MusicImportUrlBox_KeyDown"/>
                                    <TextBlock x:Name="MusicImportPlaceholder" Grid.Column="1" Text="YouTube- oder Spotify-Song/Playlist-URL einfügen zum Direkt-Import..."
