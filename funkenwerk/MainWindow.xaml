                            </Grid>

                            <!-- Progress Scrubber -->
                            <Slider x:Name="MusicSeekSlider" Minimum="0" Maximum="100" Value="0" Cursor="Hand"
                                    IsMoveToPointEnabled="True"
                                    PreviewMouseLeftButtonDown="MusicSeekSlider_MouseDown"
                                    PreviewMouseMove="MusicSeekSlider_MouseMove"
                                    PreviewMouseLeftButtonUp="MusicSeekSlider_MouseUp"/>
                            <Grid Margin="0,4,0,18">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="MusicCurrentTimeTxt" Text="0:00" Foreground="#9CA3AF" FontSize="11.5"/>
                                <TextBlock x:Name="MusicTotalTimeTxt" Grid.Column="1" Text="0:00" Foreground="#9CA3AF" FontSize="11.5"/>
                            </Grid>

                            <!-- Playback Controls -->
                            <Grid HorizontalAlignment="Center" Margin="0,0,0,22">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button x:Name="MusicShuffleBtn" Grid.Column="0" Click="MusicToggleShuffle_Click" ToolTip="Zufällige Wiedergabe"
