                                    </Button>
                                </Grid>

                                <UniformGrid Columns="2" Rows="2" Margin="0,0,0,5">
                                    <Button x:Name="CamSplitSingleBtn" Click="CamSplitMode_Click" Tag="single" Background="#C5A059" Foreground="#111827" FontWeight="Bold" BorderThickness="0" Padding="8,7" Margin="0,0,3,5" Cursor="Hand" FontSize="11.5" Content="▣ 1x Einfach">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                    </Button>
                                    <Button x:Name="CamSplitPipBtn" Click="CamSplitMode_Click" Tag="pip" Background="#13161F" Foreground="#D1D5DB" FontWeight="SemiBold" BorderThickness="0" Padding="8,7" Margin="3,0,0,5" Cursor="Hand" FontSize="11.5" Content="⧉ 2-Fach (PiP)">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                    </Button>
                                    <Button x:Name="CamSplitSideBySideBtn" Click="CamSplitMode_Click" Tag="sidebyside" Background="#13161F" Foreground="#D1D5DB" FontWeight="SemiBold" BorderThickness="0" Padding="8,7" Margin="0,0,3,0" Cursor="Hand" FontSize="11.5" Content="◫ Links / Rechts">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                    </Button>
                                    <Button x:Name="CamSplitTopBottomBtn" Click="CamSplitMode_Click" Tag="topbottom" Background="#13161F" Foreground="#D1D5DB" FontWeight="SemiBold" BorderThickness="0" Padding="8,7" Margin="3,0,0,0" Cursor="Hand" FontSize="11.5" Content="⬒ 2-Fach Oben/Unten">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                    </Button>
                                </UniformGrid>

                                <UniformGrid Columns="2" Rows="1" Margin="0,5,0,8">
                                    <Button x:Name="CamSplitScreenOnlyBtn" Click="CamSplitMode_Click" Tag="screenshare_only" Background="#13161F" Foreground="#D1D5DB" FontWeight="SemiBold" BorderThickness="0" Padding="8,7" Margin="0,0,3,0" Cursor="Hand" FontSize="11.5" ToolTip="Nur das geteilte Bild / Fenster / Maus-Follow einzeln im Vollbild anzeigen (ohne Zweitfenster)" Content="🖥 Nur Teilen (Pur)">
