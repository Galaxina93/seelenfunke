                                </Grid>
                            </Border>

                            <!-- Offline Pre-Cache All Button -->
                            <Button x:Name="MusicCacheAllBtn" Click="MusicCacheAllOffline_Click" Background="#1E222D" Foreground="#C5A059" BorderThickness="0" Padding="12,10" Margin="0,0,0,10" Cursor="Hand" FontSize="12" FontWeight="Bold" Content="⚡ Alle Playlist-Songs lokal auf PC cachen (Offline)">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                            </Button>

                            <!-- Venom Audio-Reactive Focus Mode Wallpaper Button -->
                            <Button x:Name="MusicEnterFocusModeBtn" Click="EnterMusicVenomFocusMode_Click" Background="#1F090D" Foreground="#EF4444" BorderBrush="#7F1D1D" BorderThickness="1" Padding="12,11" Cursor="Hand" FontSize="12.5" FontWeight="Bold" ToolTip="Ganzes Fenster in audio-reaktive Rot-Schwarz Venom Animation verwandeln">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Fill="#EF4444" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Fokus Modus" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ===================================================================== -->
            <!-- MODULE 6: SMART HOME, IP-KAMERAS (RTSP/ONVIF) & SMARTE STECKDOSEN     -->
            <!-- ===================================================================== -->
            <Grid x:Name="SmartHomeViewGrid" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SmartHomeColSidebar" Width="320" MinWidth="260" MaxWidth="520"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*" MinWidth="480"/>
                </Grid.ColumnDefinitions>

                <!-- Left Sidebar: Cameras, Smart Plugs & Recordings -->
                <Border x:Name="SmartHomeSidebarBorder" Grid.Column="0" Background="#11131A" BorderBrush="#1E222D" BorderThickness="0,0,1,0" Padding="16,18">
                    <DockPanel>
                        <!-- Header -->
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="SMART HOME" Foreground="#F9FAFB" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="Lokale IP-Kameras &amp; Steckdosen (In-House)" Foreground="#9CA3AF" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Click="SmartAddCamera_Click" Background="#C5A059" Foreground="#111827" BorderThickness="0" Padding="9,5" Margin="0,0,5,0" Cursor="Hand" ToolTip="Neue RTSP/ONVIF Kamera hinzufügen">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                    <TextBlock Text="+ Kamera" Foreground="#111827" FontSize="11" FontWeight="Bold"/>
