                                                    <WrapPanel x:Name="DesignSpaceFgPalettePanel" Orientation="Horizontal"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Inline HSV Color Spectrum Sliders (Toggled by "🎨 Regler") -->
                                            <Border x:Name="DesignSpaceSpectrumPanel" Background="#0F1117" BorderBrush="#C5A059" BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,4,0,0" Visibility="Collapsed">
