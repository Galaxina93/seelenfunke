                                        <ComboBoxItem Content="24 FPS" Tag="24"/>
                                        <ComboBoxItem Content="30 FPS" Tag="30"/>
                                        <ComboBoxItem Content="60 FPS" Tag="60"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Resolution Selector -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="FORMAT:" Foreground="#9CA3AF" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ComboBox x:Name="CamResolutionCombo" Width="132" SelectionChanged="CamResolutionCombo_SelectionChanged" SelectedIndex="0" Padding="10,6" FontSize="12">
                                        <ComboBoxItem Content="1280x720 HD" Tag="1280x720"/>
                                        <ComboBoxItem Content="1920x1080 FHD" Tag="1920x1080"/>
                                        <ComboBoxItem Content="960x540 qHD" Tag="960x540"/>
