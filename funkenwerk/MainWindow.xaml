                <Border Grid.Column="2" Background="#0F1117" Padding="18,14">
                    <DockPanel>
                        <!-- TOP BAR: Camera Select, FPS, Resolution, Recording Mode, VirtualCam Status -->
                        <Border x:Name="CamTopModeBarBorder" DockPanel.Dock="Top" Background="#141720" BorderBrush="#2B2D31" BorderThickness="1" CornerRadius="14" Padding="14,10" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Primary Camera Selector -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="🎥 KAMERA:" Foreground="#9CA3AF" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ComboBox x:Name="CamPrimaryDeviceCombo" Width="185" SelectionChanged="CamPrimaryDeviceCombo_SelectionChanged" Padding="10,6" FontSize="12"/>
