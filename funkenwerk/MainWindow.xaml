                                        <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="🏠" Foreground="#60A5FA" FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="Alle Aufgaben" Foreground="#E5E7EB" FontSize="13.5" FontWeight="Medium" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="CountAll" Grid.Column="2" Text="" Foreground="#60A5FA" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <Border Height="1" Background="#232734" Margin="4,6,4,10"/>
                        </StackPanel>

                        <Border DockPanel.Dock="Bottom" BorderBrush="#232734" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Background="#1E222D" CornerRadius="10" Padding="10,7">
                                    <TextBox x:Name="NewTodoListBox" Background="Transparent" BorderThickness="0" Foreground="#F3F4F6" CaretBrush="#C5A059" FontSize="13" KeyDown="NewTodoListBox_KeyDown"/>
                                </Border>
                                <Button Grid.Column="1" Click="CreateTodoList_Click" Background="#C5A059" Foreground="#111827" FontWeight="Bold" FontSize="12" BorderThickness="0" Padding="12,7" Margin="6,0,0,0" Cursor="Hand" Content="+ Liste">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                                </Button>
                            </Grid>
                        </Border>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="CustomTodoListsPanel" Margin="0,0,4,0"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Resizable Splitter -->
                <GridSplitter Grid.Column="1" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" DragCompleted="Splitter_DragCompleted"/>

                <!-- Center Todo List -->
                <Border Grid.Column="2" Background="#0F1117" Padding="28,22">
                    <DockPanel LastChildFill="True">
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="TodoHeaderTitle" Text="Mein Tag" Foreground="#F9FAFB" FontSize="26" FontWeight="Bold"/>
                                <TextBlock x:Name="TodoHeaderSubtitle" Text="Mittwoch, 4. November" Foreground="#9CA3AF" FontSize="13" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#181B24" BorderBrush="#262A36" BorderThickness="1" CornerRadius="10" Padding="12,6" VerticalAlignment="Center">
                                <TextBlock x:Name="TodoStatusCounter" Text="0 offen · 0 erledigt" Foreground="#D1D5DB" FontSize="12" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>

                        <Border x:Name="TodoBottomInputBorder" DockPanel.Dock="Bottom" Background="#181B24" BorderBrush="#2A2F3D" BorderThickness="1" CornerRadius="14" Padding="14,10" Margin="0,14,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="+" Foreground="#C5A059" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBox x:Name="NewTaskBox" Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="#F9FAFB" CaretBrush="#C5A059" FontSize="14" VerticalContentAlignment="Center" KeyDown="NewTaskBox_KeyDown"/>
                                <Button x:Name="NewTaskImportantBtn" Grid.Column="2" Click="ToggleNewTaskImportant_Click" Background="Transparent" BorderThickness="0" FontSize="18" Foreground="#6B7280" Margin="8,0" Cursor="Hand" Content="☆"/>
                                <Button Grid.Column="3" Click="AddTask_Click" Background="#C5A059" Foreground="#111827" FontWeight="Bold" FontSize="12.5" BorderThickness="0" Padding="14,7" Cursor="Hand" Content="Hinzufügen">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                                </Button>
                            </Grid>
                        </Border>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,6,0">
                                <StackPanel x:Name="OpenTasksPanel"/>
                                <StackPanel x:Name="CompletedSectionWrapper" Margin="0,14,0,0" Visibility="Collapsed">
                                    <Button Click="ToggleCompletedSection_Click" HorizontalAlignment="Left" Background="#1E222D" Foreground="#C5A059" BorderThickness="0" Padding="12,6" Cursor="Hand">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="CompletedChevron" Text="▼" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock x:Name="CompletedHeaderLabel" Text="Erledigt (0)" FontSize="12.5" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Button>
                                    <StackPanel x:Name="CompletedTasksPanel" Margin="0,8,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Resizable Splitter before Todo Detail -->
                <GridSplitter x:Name="TodoDetailSplitter" Grid.Column="3" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Visibility="Collapsed" DragCompleted="Splitter_DragCompleted"/>

                <!-- Right Todo Detail Inspector -->
                <Border x:Name="TodoDetailBorder" Grid.Column="4" Background="#161922" Padding="18,20" Visibility="Collapsed">
                    <DockPanel LastChildFill="True">
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="AUFGABENDETAILS" Foreground="#9CA3AF" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Click="CloseTodoDetail_Click" Background="Transparent" BorderThickness="0" Foreground="#9CA3AF" FontSize="15" Cursor="Hand" Content="✕"/>
                        </Grid>

                        <Border DockPanel.Dock="Bottom" BorderBrush="#232734" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="DetailCreatedText" Text="Erstellt" Foreground="#6B7280" FontSize="11.5" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Click="DeleteSelectedTask_Click" Background="#2D161B" Foreground="#F87171" BorderThickness="0" Padding="10,6" Cursor="Hand" FontSize="12" FontWeight="SemiBold" Content="🗑 Löschen">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                </Button>
                            </Grid>
                        </Border>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,4,0">
                                <Border Background="#1E222D" CornerRadius="12" Padding="14" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBox x:Name="DetailTitleBox" Background="Transparent" BorderThickness="0" Foreground="#F9FAFB" CaretBrush="#C5A059" FontSize="15" FontWeight="Bold" TextWrapping="Wrap" LostFocus="DetailTitleBox_LostFocus"/>
                                        <Border Height="1" Background="#2A2F3D" Margin="0,10"/>
                                        <StackPanel x:Name="SubtasksPanel"/>
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="+" Foreground="#C5A059" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <TextBox x:Name="NewSubtaskBox" Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="#F3F4F6" CaretBrush="#C5A059" FontSize="13" KeyDown="NewSubtaskBox_KeyDown" Tag="Schritt hinzufügen (Enter)..."/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Button x:Name="DetailMyDayBtn" Click="ToggleSelectedMyDay_Click" Background="#1E222D" Foreground="#E5E7EB" BorderThickness="0" Padding="14,11" Margin="0,0,0,10" Cursor="Hand" HorizontalContentAlignment="Left">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="12"/></Style></Button.Resources>
                                    <TextBlock x:Name="DetailMyDayText" Text="☀  Zu 'Mein Tag' hinzufügen" FontSize="13" FontWeight="SemiBold"/>
                                </Button>

                                <Border Background="#1E222D" CornerRadius="12" Padding="14" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="FÄLLIGKEITSDATUM" Foreground="#9CA3AF" FontSize="10.5" FontWeight="Bold" Margin="0,0,0,6"/>
                                        <DatePicker x:Name="DetailDatePicker" SelectedDateChanged="DetailDatePicker_SelectedDateChanged" Background="#14171F" Foreground="#111827" BorderThickness="0"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#1E222D" CornerRadius="12" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="NOTIZ" Foreground="#9CA3AF" FontSize="10.5" FontWeight="Bold" Margin="0,0,0,6"/>
                                        <TextBox x:Name="DetailNoteBox" Background="#14171F" BorderThickness="0" Foreground="#E5E7EB" CaretBrush="#C5A059" FontSize="13" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" Padding="10" LostFocus="DetailNoteBox_LostFocus"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

