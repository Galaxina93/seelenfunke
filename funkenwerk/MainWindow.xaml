                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                                    <Viewbox Width="16" Height="16">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M16,3 L21,3 L21,8 M4,20 L21,3 M21,16 L21,21 L16,21 M15,15 L21,21 M4,4 L9,9"
                                                  Stroke="#C5A059" StrokeThickness="2.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                        </Canvas>
                                    </Viewbox>
                                </Button>

                                <Button Grid.Column="1" Click="MusicPrev_Click" ToolTip="Vorheriger Titel"
                                        Background="#1E222D" Foreground="#F3F4F6" BorderThickness="0" Width="40" Height="40" Margin="0,0,10,0" Cursor="Hand" FontSize="15" Content="⏮">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="20"/></Style></Button.Resources>
                                </Button>

                                <Button x:Name="MusicPlayPauseBtn" Grid.Column="2" Click="MusicPlayPause_Click" ToolTip="Wiedergabe / Pause"
                                        Background="#C5A059" Foreground="#111827" BorderThickness="0" Width="54" Height="54" Margin="0,0,10,0" Cursor="Hand" FontSize="20" FontWeight="Bold" Content="▶">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="27"/></Style></Button.Resources>
                                </Button>

                                <Button Grid.Column="3" Click="MusicNext_Click" ToolTip="Nächster Titel"
                                        Background="#1E222D" Foreground="#F3F4F6" BorderThickness="0" Width="40" Height="40" Margin="0,0,8,0" Cursor="Hand" FontSize="15" Content="⏭">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="20"/></Style></Button.Resources>
                                </Button>

                                <Button x:Name="MusicRepeatBtn" Grid.Column="4" Click="MusicToggleRepeat_Click" ToolTip="Dauerschleife"
                                        Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Width="38" Height="38" Cursor="Hand" Opacity="0.65">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                                    <Viewbox Width="16" Height="16">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M17,2 L21,6 L17,10 M3,11 L3,9 A3,3 0 0 1 6,6 L21,6 M7,22 L3,18 L7,14 M21,13 L21,15 A3,3 0 0 1 18,18 L3,18"
                                                  Stroke="#C5A059" StrokeThickness="2.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                            </Grid>

                            <!-- Volume Bar -->
                            <Border Background="#181B24" BorderBrush="#242936" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="42"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🔊" Foreground="#C5A059" FontSize="13" VerticalAlignment="Center"/>
