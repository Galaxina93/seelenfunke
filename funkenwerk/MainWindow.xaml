                                <TextBox x:Name="EventDescInput" Background="#13161F" Foreground="#F9FAFB" BorderBrush="#262A36" Padding="14,10" FontSize="13.5" Height="100" AcceptsReturn="True" TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Footer Buttons -->
                            <Border BorderBrush="#1E222D" BorderThickness="0,1,0,0" Padding="0,18,0,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Click="CloseCalendarEditor_Click" Background="#181B24" Foreground="#D1D5DB" BorderBrush="#262A36" BorderThickness="1" Padding="20,11" Margin="0,0,12,0" Cursor="Hand" FontWeight="SemiBold" Content="Abbrechen">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="12"/></Style></Button.Resources>
                                    </Button>
                                    <Button Click="SaveCalendarEvent_Click" Background="#C5A059" Foreground="#111827" BorderThickness="0" Padding="28,11" Cursor="Hand" FontWeight="Bold" Content="✓ Termin speichern">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="12"/></Style></Button.Resources>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ===================================================================== -->
            <!-- MODULE 4: TO DO (Microsoft To Do / Seelenfunke Tasks)                 -->
