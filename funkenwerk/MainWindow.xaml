                            <Border Background="#181B24" BorderBrush="#262A36" BorderThickness="1" CornerRadius="10" Padding="10,7" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="🔍" Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBox x:Name="MusicSearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                             Foreground="#F3F4F6" CaretBrush="#C5A059" FontSize="12.5" TextChanged="MusicSearchBox_TextChanged"/>
                                    <TextBlock x:Name="MusicSearchPlaceholder" Grid.Column="1" Text="Songs oder Künstler suchen..."
