                                                        <Slider x:Name="DesignSpaceValSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="0" ValueChanged="DesignSpaceHsvSlider_ValueChanged" Cursor="Hand"/>
                                                        <TextBlock x:Name="DesignSpaceValValTxt" Grid.Column="2" Text="0 %" Foreground="#C5A059" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#13161F" BorderBrush="#232734" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="START-ANSICHT BEIM PROGRAMMSTART" Foreground="#9CA3AF" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                                            <ComboBox x:Name="StartupModuleCombo" Padding="10,7" FontSize="13" SelectedIndex="0">
                                                <ComboBoxItem Content="Immer mit Kachel-Deck starten" Tag="launcher"/>
                                                <ComboBoxItem Content="Zuletzt geöffnetes Modul wiederherstellen" Tag="remember"/>
                                                <ComboBoxItem Content="Immer mit E-Mail starten" Tag="mail"/>
                                                <ComboBoxItem Content="Immer mit To Do (Aufgaben) starten" Tag="todo"/>
                                                <ComboBoxItem Content="Immer mit Kalender starten" Tag="calendar"/>
                                                <ComboBoxItem Content="Immer mit Adressbuch starten" Tag="contacts"/>
                                                <ComboBoxItem Content="Immer mit Bestellungen &amp; Labeldrucker starten" Tag="orders"/>
                                                <ComboBoxItem Content="Immer mit Dateiverwaltung starten" Tag="files"/>
                                                <ComboBoxItem Content="Immer mit Funkira KI-Agent starten" Tag="agent"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#13161F" BorderBrush="#232734" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,12">
                                        <StackPanel>
                                            <Grid Margin="0,2,0,10">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,14,0">
                                                    <TextBlock Text="Kompakte Listenansicht (E-Mail &amp; To Do)" Foreground="#F9FAFB" FontSize="13" FontWeight="SemiBold"/>
                                                    <TextBlock Text="Reduziert Innenabstände der Karten für mehr Einträge auf einen Blick" Foreground="#9CA3AF" FontSize="11" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <CheckBox x:Name="CompactModeCheck" Grid.Column="1" VerticalAlignment="Center" Cursor="Hand"/>
                                            </Grid>
                                            <Border Height="1" Background="#1E222D" Margin="0,0,0,10"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,14,0">
