                                        </StackPanel>
                                        <TextBlock x:Name="ApiPresetLiveSub" Text="mein-seelenfunke.de" Foreground="#9CA3AF" FontSize="10.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <TextBlock Text="SEELENFUNKE PORTAL API-URL" Foreground="#9CA3AF" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                            <Border Background="#0F1117" BorderBrush="#2A2F3D" BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="0,0,0,12">
                                <TextBox x:Name="ApiUrlBox" Background="Transparent" BorderThickness="0" Foreground="#F9FAFB" CaretBrush="#C5A059" FontSize="13" TextChanged="ApiUrlBox_TextChanged"/>
                            </Border>

                            <TextBlock Text="SANCTUM API BEARER TOKEN (AES-256-GCM + DPAPI VERSCHLÜSSELT)" Foreground="#9CA3AF" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                            <Border Background="#0F1117" BorderBrush="#2A2F3D" BorderThickness="1" CornerRadius="10" Padding="10,6" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ApiTokenBox" Background="Transparent" BorderThickness="0" Foreground="#F9FAFB" CaretBrush="#C5A059" FontSize="13" Visibility="Collapsed"/>
                                    <TextBlock x:Name="ApiTokenMaskedTxt" Background="Transparent" Foreground="#F9FAFB" Padding="2,3" FontSize="13" VerticalAlignment="Center"/>
                                    <Button x:Name="ApiTokenEyeBtn" Grid.Column="1" Click="ToggleApiTokenVisibility_Click" Background="Transparent" Foreground="#C5A059" BorderThickness="0" Padding="8,2" Cursor="Hand" ToolTip="Bearer-Token anzeigen / verbergen">
                                        <TextBlock x:Name="ApiTokenEyeTxt" Text="👁" FontSize="13.5" Foreground="#C5A059" VerticalAlignment="Center"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <Border Background="#13161F" BorderBrush="#232734" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="ApiTestStatusText" Text="Bereit zum Verbindungstest." Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    <Button Grid.Column="1" Click="TestApiConnection_Click" Background="#1F2430" Foreground="#C5A059" BorderThickness="0" Padding="12,6" Cursor="Hand" FontSize="12" FontWeight="Bold" Content="⚡ Verbindung prüfen">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Footer Buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                            <Button Click="CloseSettings_Click" Background="#232734" Foreground="#D1D5DB" BorderThickness="0" Padding="16,9" Margin="0,0,8,0" Cursor="Hand" Content="Schließen">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="9"/></Style></Button.Resources>
                            </Button>
                            <Button Click="SaveSettings_Click" Background="#C5A059" Foreground="#111827" FontWeight="Bold" BorderThickness="0" Padding="18,9" Cursor="Hand" Content="✓ Einstellungen speichern">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="9"/></Style></Button.Resources>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>

        <!-- ========================================================================= -->
        <!-- FULL-WINDOW AUTHENTICATION / LOGIN OVERLAY (Luxury Atelier Video + Magic) -->
        <!-- ========================================================================= -->
        <Grid x:Name="AuthLoginOverlayGrid" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Panel.ZIndex="999" Background="#0B0D12" Visibility="Collapsed" ClipToBounds="True">
            <!-- Layer 0: High-Res Poster Backdrop (Zero-latency initial frame matching exact Frame 0) -->
            <Image x:Name="AuthLoginBgPosterImg" Panel.ZIndex="0" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>

            <!-- Layer 1A & 1B: Dual-Buffered A/B Seamless Loop Video Players (Zero black frame / decoder flush on loop!) -->
            <MediaElement x:Name="AuthLoginBgVideo" Panel.ZIndex="2" LoadedBehavior="Manual" UnloadedBehavior="Manual" ScrubbingEnabled="True" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" IsMuted="True" MediaEnded="AuthLoginBgVideo_MediaEnded"/>
            <MediaElement x:Name="AuthLoginBgVideoB" Panel.ZIndex="1" Opacity="0" LoadedBehavior="Manual" UnloadedBehavior="Manual" ScrubbingEnabled="True" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" IsMuted="True" MediaEnded="AuthLoginBgVideoB_MediaEnded"/>

            <!-- Layer 2: Ultra-Subtle Ambient Veil so the Atelier Video shines through crystal clear -->
            <Border Panel.ZIndex="3" IsHitTestVisible="False">
                <Border.Background>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.75" RadiusY="0.75">
                        <GradientStop Color="#22000000" Offset="0.0"/>
                        <GradientStop Color="#12000000" Offset="0.65"/>
                        <GradientStop Color="#33000000" Offset="1.0"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>

            <!-- Layer 3: Centered Ultra-Noble Transparent Crystal Login Modal (Main Card #28000000, Smoked Opaque Inputs & Buttons for Crisp Readability) -->
            <Border x:Name="AuthLoginCardBorder" Panel.ZIndex="4" Width="430" Background="#28000000" BorderBrush="#77C5A059" BorderThickness="1" CornerRadius="20" Padding="32,26" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0">
                <Grid>
                    <!-- Top-Right Minimize Login Card Button -->
                    <Button x:Name="AuthLoginMinimizeCardBtn" Click="MinimizeAuthLoginCard_Click"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-8,-10,0"
                            Width="28" Height="28" Background="#80000000" BorderBrush="#66C5A059" BorderThickness="1"
                            Foreground="#F2FCE7B2" FontSize="12" FontWeight="Bold" Cursor="Hand"
                            ToolTip="Login-Fenster minimieren (Unten rechts als Login-Icon ablegen)" Content="—">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="14"/></Style></Button.Resources>
                    </Button>

                    <StackPanel>
                        <!-- Subtle Translucent Atelier Emblem Line -->
                        <TextBlock x:Name="AuthHeaderSubtitleTxt" Text="✦   M E I N   S E E L E N F U N K E   ✦" Foreground="#F2FCE7B2" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,16"/>

                        <!-- Environment Selector Pills (Lokal / Stage / Live) - Smoked Dark Glass for Crisp Readability -->
                        <UniformGrid Columns="3" Margin="0,0,0,16">
                            <Border x:Name="AuthEnvLocalPill" Background="#A6000000" BorderBrush="#66C5A059" BorderThickness="1" CornerRadius="9" Padding="8,6" Margin="0,0,4,0" Cursor="Hand" MouseLeftButtonUp="AuthEnvPill_Click" Tag="local" ToolTip="http://127.0.0.1/api">
                                <TextBlock x:Name="AuthEnvLocalTxt" Text="Lokal" Foreground="#E6FFFFFF" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </Border>
                            <Border x:Name="AuthEnvStagePill" Background="#D91F1708" BorderBrush="#F2C5A059" BorderThickness="1.2" CornerRadius="9" Padding="8,6" Margin="2,0,2,0" Cursor="Hand" MouseLeftButtonUp="AuthEnvPill_Click" Tag="stage" ToolTip="https://stage.mein-seelenfunke.de/api">
                                <TextBlock x:Name="AuthEnvStageTxt" Text="Stage" Foreground="#FFFCE7B2" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </Border>
                            <Border x:Name="AuthEnvLivePill" Background="#A6000000" BorderBrush="#66C5A059" BorderThickness="1" CornerRadius="9" Padding="8,6" Margin="4,0,0,0" Cursor="Hand" MouseLeftButtonUp="AuthEnvPill_Click" Tag="live" ToolTip="https://mein-seelenfunke.de/api">
                                <TextBlock x:Name="AuthEnvLiveTxt" Text="Live" Foreground="#E6FFFFFF" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </Border>
                        </UniformGrid>

                        <!-- E-Mail Field (Smoked Obsidian Glass Input + Sound Effect on Click) -->
                        <TextBlock x:Name="AuthEmailLabelTxt" Text="E-MAIL" Foreground="#F2FCE7B2" FontSize="10" FontWeight="Bold" Margin="2,0,0,5"/>
                        <Border x:Name="AuthEmailInputBorder" Background="#BF000000" BorderBrush="#A6C5A059" BorderThickness="1" CornerRadius="11" Margin="0,0,0,12" PreviewMouseLeftButtonDown="AuthLoginInput_PreviewMouseLeftButtonDown">
                            <TextBox x:Name="AuthLoginEmailBox" Background="Transparent" Foreground="#FFFFFFFF" BorderThickness="0" CaretBrush="#C5A059" Padding="13,9" FontSize="13.5" VerticalContentAlignment="Center" KeyDown="AuthLoginInput_KeyDown" PreviewMouseLeftButtonDown="AuthLoginInput_PreviewMouseLeftButtonDown"/>
                        </Border>

                        <!-- Password Field (Smoked Obsidian Glass Input + Crisp White Vector Eye Icon + Sound Effect on Click) -->
                        <TextBlock x:Name="AuthPasswordLabelTxt" Text="PASSWORT" Foreground="#F2FCE7B2" FontSize="10" FontWeight="Bold" Margin="2,0,0,5"/>
                        <Border x:Name="AuthPasswordInputBorder" Background="#BF000000" BorderBrush="#A6C5A059" BorderThickness="1" CornerRadius="11" Margin="0,0,0,12" PreviewMouseLeftButtonDown="AuthLoginInput_PreviewMouseLeftButtonDown">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <PasswordBox x:Name="AuthLoginPasswordBox" Grid.Column="0" Background="Transparent" Foreground="#FFFFFFFF" BorderThickness="0" CaretBrush="#C5A059" Padding="13,9" FontSize="13.5" VerticalContentAlignment="Center" PasswordChanged="AuthLoginPasswordBox_PasswordChanged" KeyDown="AuthLoginInput_KeyDown" PreviewMouseLeftButtonDown="AuthLoginInput_PreviewMouseLeftButtonDown"/>
                                <TextBox x:Name="AuthLoginPasswordVisibleBox" Grid.Column="0" Background="Transparent" Foreground="#FFFFFFFF" BorderThickness="0" CaretBrush="#C5A059" Padding="13,9" FontSize="13.5" VerticalContentAlignment="Center" Visibility="Collapsed" TextChanged="AuthLoginPasswordVisibleBox_TextChanged" KeyDown="AuthLoginInput_KeyDown" PreviewMouseLeftButtonDown="AuthLoginInput_PreviewMouseLeftButtonDown"/>
                                <TextBlock x:Name="AuthLoginConnectedHintTxt" Grid.Column="0" Text="✓ Angemeldet" Foreground="#34D399" FontWeight="Bold" FontSize="13.5" VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False" Visibility="Collapsed"/>
                                <Button x:Name="AuthLoginPasswordEyeBtn" Grid.Column="1" Click="ToggleAuthLoginPasswordVisibility_Click" Background="Transparent" BorderThickness="0" Padding="11,4" Cursor="Hand" ToolTip="Passwort anzeigen / verbergen">
                                    <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path x:Name="AuthLoginPasswordEyePath" Fill="Transparent" Stroke="#F2FFFFFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Data="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z M12 9a3 3 0 100 6 3 3 0 000-6z"/>
                                            <Path x:Name="AuthLoginPasswordEyeSlashPath" Fill="Transparent" Stroke="#FFFCE7B2" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"
                                                  Data="M3 3l18 18"/>
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Optional 2FA Verification Step (TOTP / Recovery Code) -->
                        <StackPanel x:Name="AuthTwoFactorPanel" Visibility="Collapsed" Margin="0,0,0,12">
                            <TextBlock Text="2FA-CODE" Foreground="#F2FCE7B2" FontSize="10" FontWeight="Bold" Margin="2,0,0,5"/>
                            <Border Background="#BF000000" BorderBrush="#F2C5A059" BorderThickness="1.2" CornerRadius="11">
                                <TextBox x:Name="AuthLoginTwoFactorBox" Background="Transparent" Foreground="#FFFFFFFF" BorderThickness="0" CaretBrush="#C5A059" Padding="13,9" FontSize="15" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" KeyDown="AuthLoginInput_KeyDown"/>
                            </Border>
                        </StackPanel>

                        <!-- Remember Password & Auto-Login Checkbox -->
                        <CheckBox x:Name="AuthLoginRememberCheck" Content="Passwort merken &amp; automatisch einloggen" Foreground="#F2FFFFFF" FontSize="12" FontWeight="SemiBold" IsChecked="True" Margin="2,0,0,14" Cursor="Hand"/>

                        <!-- Error Feedback Box -->
                        <Border x:Name="AuthLoginErrorBorder" Background="#CC1A0808" BorderBrush="#CCEF4444" BorderThickness="1" CornerRadius="9" Padding="10,7" Margin="0,0,0,12" Visibility="Collapsed">
                            <TextBlock x:Name="AuthLoginErrorTxt" Text="" Foreground="#FCA5A5" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </Border>

                        <!-- Primary Login Button (Smoked Obsidian-Gold Glass + Noble Gold Text) -->
                        <Button x:Name="AuthLoginSubmitBtn" Click="AuthLoginSubmitBtn_Click" Background="#D91F1708" BorderBrush="#F2C5A059" BorderThickness="1.2" Foreground="#FFFCE7B2" FontWeight="Bold" FontSize="13.5" Padding="0,11" Cursor="Hand" Content="✦   ANMELDEN   ✦">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="BtnBorder" Property="Background" Value="#EB2B200B"/>
                                            <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#FFC5A059"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="BtnBorder" Property="Background" Value="#F536280E"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Layer 3B: Minimized Login Icon Button at Bottom-Right (Only visible when Login Card is minimized) -->
            <Button x:Name="AuthLoginMinimizedRestoreBtn" Panel.ZIndex="4" Click="RestoreAuthLoginCard_Click"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,26,22"
                    Width="48" Height="48" Background="#D9141008" BorderBrush="#F2C5A059" BorderThickness="1.5"
                    Cursor="Hand" Visibility="Collapsed" ToolTip="Login-Fenster wieder einblenden">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="MinIconBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="24">
                            <Viewbox Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="Transparent" Stroke="#FFFCE7B2" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Data="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4 M10 17l5-5-5-5 M15 12H3"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MinIconBorder" Property="Background" Value="#F2261D0C"/>
                                <Setter TargetName="MinIconBorder" Property="BorderBrush" Value="#FFFDE68A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Layer 4: Full-Window "Magie aktivieren" Portal Transition Overlay -->
            <Grid x:Name="AuthMagicActivationOverlay" Panel.ZIndex="5" Background="#E6070A14" Visibility="Collapsed" IsHitTestVisible="True">
                <!-- Warm Golden Radial Glow -->
                <Ellipse Width="680" Height="680" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#44C5A059" Offset="0.0"/>
                            <GradientStop Color="#18C5A059" Offset="0.45"/>
                            <GradientStop Color="#00C5A059" Offset="1.0"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- 60 FPS Golden Sparks Vortex & Supernova Canvas -->
                <Canvas x:Name="AuthMagicSparksCanvas" IsHitTestVisible="False"/>

                <!-- Centered Celestial Emblem & Typography ("Die Magie erwacht") -->
                <StackPanel x:Name="AuthMagicCenterPanel" VerticalAlignment="Center" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                    <StackPanel.RenderTransform>
                        <ScaleTransform x:Name="AuthMagicCenterScale" ScaleX="1" ScaleY="1"/>
                    </StackPanel.RenderTransform>

                    <Grid Width="170" Height="170" HorizontalAlignment="Center" Margin="0,0,0,18">
                        <!-- Expanding Supernova Shockwave Ring -->
                        <Ellipse x:Name="AuthMagicShockwaveRing" Width="110" Height="110" Stroke="#C5A059" StrokeThickness="2" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="AuthMagicShockwaveScale" ScaleX="0.8" ScaleY="0.8"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>

                        <!-- Rotating Celestial Orbit Rings -->
                        <Viewbox Width="166" Height="166" RenderTransformOrigin="0.5,0.5">
                            <Viewbox.RenderTransform>
                                <RotateTransform x:Name="AuthMagicOrbitRotate" Angle="0"/>
                            </Viewbox.RenderTransform>
                            <Canvas Width="200" Height="200">
                                <Ellipse Canvas.Left="8" Canvas.Top="8" Width="184" Height="184" Stroke="#66C5A059" StrokeThickness="1.2" StrokeDashArray="4 8"/>
                                <Ellipse Canvas.Left="18" Canvas.Top="18" Width="164" Height="164" Stroke="#99C5A059" StrokeThickness="1.6" StrokeDashArray="16 8 3 8"/>
                            </Canvas>
                        </Viewbox>

                        <!-- Golden Core Medallion with 4-Pointed Seelenfunke Star -->
                        <Border Width="88" Height="88" CornerRadius="44" BorderBrush="#CCFFFFFF" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FDE68A" Offset="0.0"/>
                                    <GradientStop Color="#C5A059" Offset="0.55"/>
                                    <GradientStop Color="#9A7229" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="AuthMagicCoreScale" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <Viewbox Width="44" Height="44" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <Viewbox.RenderTransform>
                                    <RotateTransform x:Name="AuthMagicStarRotate" Angle="0"/>
                                </Viewbox.RenderTransform>
                                <Canvas Width="24" Height="24">
                                    <Path Fill="#111827" Data="M12 2L14.6 9.4L22 12L14.6 14.6L12 22L9.4 14.6L2 12L9.4 9.4L12 2Z"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                    </Grid>

                    <!-- Status Pill -->
                    <Border Background="#26C5A059" BorderBrush="#66C5A059" BorderThickness="1" CornerRadius="14" Padding="14,5" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="#FBBF24" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="AuthMagicPhasePillTxt" Text="SEELENFUNKEN SAMMELN SICH..." Foreground="#FDE68A" FontSize="11" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <!-- Headline -->
                    <TextBlock HorizontalAlignment="Center" FontSize="34" FontWeight="Bold" Foreground="#F9FAFB">
                        <Run Text="Die Magie "/>
                        <Run Text="erwacht" Foreground="#C5A059"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
