<Window x:Class="Funkenwerk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Funkenwerk"
        Icon="pack://application:,,,/funkenwerk.ico"
        Height="860" Width="1440" MinHeight="620" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="#000000"
        Foreground="#FFFFFF"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        Closing="Window_Closing">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Global Modern Button Style (Eliminates ugly default Windows light-blue hover box) -->
        <Style TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnRootBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnRootBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnRootBorder" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnRootBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Modal Close ('X') Button Style -->
        <Style x:Key="ModalCloseButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseBd" Background="Transparent" CornerRadius="8">
                            <TextBlock x:Name="CloseTxt" Text="✕" Foreground="#9CA3AF" FontSize="14" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseBd" Property="Background" Value="#EF4444"/>
                                <Setter TargetName="CloseTxt" Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Caption Control Button Style -->
        <Style x:Key="WinCaptionBtnStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CapBd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CapBd" Property="Background" Value="#22888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WinCloseBtnStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CapCloseBd" Background="Transparent">
                            <TextBlock x:Name="CapCloseTxt" Text="✕" Foreground="#9CA3AF" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CapCloseBd" Property="Background" Value="#E11D48"/>
                                <Setter TargetName="CapCloseTxt" Property="Foreground" Value="#FEFEFE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dynamic Theme-Aware Brushes for Inputs, Dropdowns, Popups & ContextMenus -->
        <SolidColorBrush x:Key="ThemeInputBgBrush" Color="#000000"/>
        <SolidColorBrush x:Key="ThemeInputFgBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ThemeInputBorderBrush" Color="#382D18"/>
        <SolidColorBrush x:Key="ThemeDropdownPopupBgBrush" Color="#000000"/>
        <SolidColorBrush x:Key="ThemeDropdownChevronBgBrush" Color="#000000"/>
        <SolidColorBrush x:Key="ThemeDropdownChevronStrokeBrush" Color="#C5A059"/>
        <SolidColorBrush x:Key="ThemeDropdownItemFgBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ThemeDropdownItemHoverBgBrush" Color="#0D0A06"/>
        <SolidColorBrush x:Key="ThemeDropdownItemHoverFgBrush" Color="#C5A059"/>
        <SolidColorBrush x:Key="ThemeDropdownItemSelectedBgBrush" Color="#141008"/>
        <SolidColorBrush x:Key="ThemeDropdownItemSelectedFgBrush" Color="#C5A059"/>

        <!-- Global Modern TextBox Style (Pure Deep-Black & Gold/White in Darkmode, Bright in Lightmode) -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ThemeInputBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeInputFgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="#C5A059"/>
            <Setter Property="SelectionBrush" Value="#C5A059"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="TxtBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="9"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TxtBorder" Property="BorderBrush" Value="#C5A059"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TxtBorder" Property="BorderBrush" Value="#C5A059"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Global Discord-Inspired ComboBoxItem Style (Rounded Hover Pill + Radio Indicator) -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="3,1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeDropdownItemFgBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}"
                                Margin="{TemplateBinding Margin}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <Border x:Name="RadioOuter" Grid.Column="1" Width="15" Height="15" CornerRadius="8"
                                        BorderBrush="#6B7280" BorderThickness="1.5" Background="Transparent"
                                        Margin="10,0,0,0" VerticalAlignment="Center">
                                    <Ellipse x:Name="RadioInner" Width="7" Height="7" Fill="Transparent"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBd" Property="Background" Value="{DynamicResource ThemeDropdownItemHoverBgBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeDropdownItemHoverFgBrush}"/>
                                <Setter TargetName="RadioOuter" Property="BorderBrush" Value="#C5A059"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBd" Property="Background" Value="{DynamicResource ThemeDropdownItemSelectedBgBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeDropdownItemSelectedFgBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="RadioOuter" Property="BorderBrush" Value="#C5A059"/>
                                <Setter TargetName="RadioOuter" Property="Background" Value="#C5A059"/>
                                <Setter TargetName="RadioInner" Property="Fill" Value="#000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Global Discord-Inspired Modern ComboBox Style (Eliminates Windows 2000 Grey Bevel Chrome) -->
        <Style TargetType="ComboBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="Background" Value="{DynamicResource ThemeInputBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeInputFgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="MainGrid" SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition MinWidth="28" Width="0"/>
                            </Grid.ColumnDefinitions>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Grid.ColumnSpan="2"
                                   IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   Margin="1"
                                   Placement="Bottom"
                                   PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder"
                                        MinWidth="{Binding ActualWidth, ElementName=MainGrid}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{DynamicResource ThemeDropdownPopupBgBrush}"
                                        BorderBrush="{DynamicResource ThemeInputBorderBrush}"
                                        BorderThickness="1.5"
                                        CornerRadius="10"
                                        Padding="4"
                                        Margin="0,4,0,8">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.45"/>
                                    </Border.Effect>
                                    <ScrollViewer x:Name="DropDownScrollViewer">
                                        <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                            <ToggleButton x:Name="ToggleButton"
                                          Grid.ColumnSpan="2"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ComboRootBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="9">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="1" Width="22" Height="22" CornerRadius="6"
                                                        Background="{DynamicResource ThemeDropdownChevronBgBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,4,0">
                                                    <Path x:Name="Arrow"
                                                          Data="M 0,0 L 4.5,4.5 L 9,0"
                                                          Stroke="{DynamicResource ThemeDropdownChevronStrokeBrush}"
                                                          StrokeThickness="1.8"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ComboRootBorder" Property="BorderBrush" Value="#C5A059"/>
                                                <Setter TargetName="Arrow" Property="Stroke" Value="#C5A059"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ComboRootBorder" Property="BorderBrush" Value="#C5A059"/>
                                                <Setter TargetName="Arrow" Property="Stroke" Value="#C5A059"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              IsHitTestVisible="False"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Global Clean GridSplitter Style -->
        <Style TargetType="GridSplitter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border x:Name="SplitBd" Background="Transparent">
                            <Border x:Name="SplitLine" Width="1" HorizontalAlignment="Center" Background="#22888888"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SplitLine" Property="Width" Value="2"/>
                                <Setter TargetName="SplitLine" Property="Background" Value="#C5A059"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Global Slider Style: Jump directly to mouse click position -->
        <Style TargetType="Slider">
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootWindowGrid">
        <Grid.RowDefinitions>
            <!-- Unified Custom Window Titlebar -->
            <RowDefinition Height="42"/>
            <!-- Main Workspace -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <!-- Left Vertical Spaces Toolbar (Thunderbird-inspired) -->
            <ColumnDefinition Width="56"/>
            <!-- Active Module Content -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ========================================================================= -->
        <!-- ROW 0: UNIFIED CUSTOM TITLEBAR (Single Larger Logo + "Funkenwerk")        -->
        <!-- ========================================================================= -->
        <Border x:Name="CustomTitleBar" Grid.Row="0" Grid.ColumnSpan="2" Background="#0A0C10" BorderBrush="#1E222D" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Single Larger Funkenwerk Icon (Top-Left, Centered over Spaces Bar) -->
                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" Cursor="Hand" MouseLeftButtonUp="BrandLogo_Click" ToolTip="Funkenwerk">
                    <Image Source="pack://application:,,,/funkenwerk.png" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <!-- Clean Window Title "Funkenwerk" + Live API Connection Dot + Lock/Logout Button -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                    <TextBlock x:Name="WindowTitleTxt" Text="Funkenwerk" Foreground="#F9FAFB" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Border x:Name="ApiConnectionDotBorder" Background="Transparent" Padding="6,6,8,6" Margin="2,-3,0,0" VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Cursor="Hand"
                            MouseLeftButtonUp="ApiConnectionDot_Click"
                            ToolTipService.InitialShowDelay="80" ToolTipService.ShowDuration="30000"
                            ToolTip="Verbindung wird geprüft...">
                        <Grid Width="10" Height="10" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Ellipse x:Name="ApiConnectionPulseRing" Width="10" Height="10" Fill="#2610B981" Visibility="Visible"/>
                            <Ellipse x:Name="ApiConnectionDotEllipse" Width="7.5" Height="7.5" Fill="#10B981" Stroke="#111827" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Button x:Name="HeaderLogoutLockBtn" Click="HeaderLogoutLockBtn_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Background="#161922" BorderBrush="#262A36" BorderThickness="1"
                            Padding="8,3" Margin="4,0,0,0" VerticalAlignment="Center" Cursor="Hand"
                            ToolTip="Funkenwerk sperren / Abmelden">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="11" Height="11" Margin="0,0,5,0" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path x:Name="HeaderLogoutLockIconPath" Fill="Transparent" Stroke="#FFFFFF" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Data="M19 11H5a2 2 0 00-2 2v7a2 2 0 002 2h14a2 2 0 002-2v-7a2 2 0 00-2-2zM7 11V7a5 5 0 0110 0v4"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock x:Name="HeaderLogoutLockTxt" Text="Abmelden" Foreground="#FFFFFF" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Right Window Controls: Minimize, Maximize/Restore, Close -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch">
                    <Button Style="{StaticResource WinCaptionBtnStyle}" Click="MinimizeWindow_Click" ToolTip="Minimieren">
                        <TextBlock Text="─" Foreground="#9CA3AF" FontSize="12"/>
                    </Button>
                    <Button Style="{StaticResource WinCaptionBtnStyle}" Click="MaximizeRestoreWindow_Click" ToolTip="Maximieren / Wiederherstellen">
                        <TextBlock x:Name="MaximizeRestoreTxt" Text="□" Foreground="#9CA3AF" FontSize="13"/>
                    </Button>
                    <Button Style="{StaticResource WinCloseBtnStyle}" Click="CloseWindow_Click" ToolTip="Schließen"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- ROW 1, COLUMN 0: VERTICAL SPACES TOOLBAR (E-Mail, Adressbuch, Kalender...) -->
        <!-- ========================================================================= -->
        <Border x:Name="LeftSpacesBarBorder" Grid.Row="1" Grid.Column="0" Background="#0A0C10" BorderBrush="#1E222D" BorderThickness="0,0,1,0" Padding="6,10,6,12">
            <DockPanel LastChildFill="False">

                <!-- Top Navigation Icons (No duplicate logo here!) -->
                <StackPanel DockPanel.Dock="Top" VerticalAlignment="Top">

                    <!-- 1. E-Mail -->
                    <Button x:Name="SpaceMailBtn" Click="SwitchSpace_Click" Tag="mail" ToolTip="E-Mail (Postfächer &amp; Nachrichten)"
                            Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,8" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid Width="42" Height="42">
                                    <Border x:Name="SpaceMailBg" Background="#C5A059" CornerRadius="11"/>
                                    <Viewbox Width="20" Height="20">
                                        <Canvas Width="24" Height="24">
                                            <Path x:Name="SpaceMailPath" Fill="Transparent" Stroke="#111827" StrokeThickness="2"
                                                  Data="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                                        </Canvas>
                                    </Viewbox>
                                    <Border x:Name="SpaceMailBadge" Background="#EF4444" CornerRadius="8" Padding="4,1"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0" Visibility="Collapsed">
                                        <TextBlock x:Name="SpaceMailBadgeTxt" Text="0" Foreground="#FEFEFE" FontSize="9" FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- 2. Adressbuch -->
                    <Button x:Name="SpaceContactsBtn" Click="SwitchSpace_Click" Tag="contacts" ToolTip="Adressbuch &amp; Kontakte"
                            Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,8" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid Width="42" Height="42">
                                    <Border x:Name="SpaceContactsBg" Background="Transparent" CornerRadius="11"/>
                                    <Viewbox Width="20" Height="20">
                                        <Canvas Width="24" Height="24">
                                            <Path x:Name="SpaceContactsPath" Fill="Transparent" Stroke="#9CA3AF" StrokeThickness="2"
                                                  Data="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                                        </Canvas>
                                    </Viewbox>
                                </Grid>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- 3. Kalender -->
                    <Button x:Name="SpaceCalendarBtn" Click="SwitchSpace_Click" Tag="calendar" ToolTip="Kalender &amp; Termine"
                            Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,8" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid Width="42" Height="42">
                                    <Border x:Name="SpaceCalendarBg" Background="Transparent" CornerRadius="11"/>
                                    <Viewbox Width="20" Height="20">
                                        <Canvas Width="24" Height="24">
                                            <Path x:Name="SpaceCalendarPath" Fill="Transparent" Stroke="#9CA3AF" StrokeThickness="2"
                                                  Data="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                        </Canvas>
                                    </Viewbox>
                                </Grid>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- 4. To Do / Aufgaben -->
                    <Button x:Name="SpaceTodoBtn" Click="SwitchSpace_Click" Tag="todo" ToolTip="To Do &amp; Aufgaben"
                            Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,8" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid Width="42" Height="42">
                                    <Border x:Name="SpaceTodoBg" Background="Transparent" CornerRadius="11"/>
                                    <Viewbox Width="20" Height="20">
                                        <Canvas Width="24" Height="24">
                                            <Path x:Name="SpaceTodoPath" Fill="Transparent" Stroke="#9CA3AF" StrokeThickness="2"
                                                  Data="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/>
                                        </Canvas>
                                    </Viewbox>
                                    <Border x:Name="SpaceTodoBadge" Background="#C5A059" CornerRadius="8" Padding="4,1"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0" Visibility="Collapsed">
                                        <TextBlock x:Name="SpaceTodoBadgeTxt" Text="0" Foreground="#111827" FontSize="9" FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- 5. Musik / Soundplayer -->
                    <Button x:Name="SpaceMusicBtn" Click="SwitchSpace_Click" Tag="music" ToolTip="Musik &amp; Soundplayer"
                            Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,8" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid Width="42" Height="42">
                                    <Border x:Name="SpaceMusicBg" Background="Transparent" CornerRadius="11"/>
                                    <Viewbox Width="20" Height="20">
                                        <Canvas Width="24" Height="24">
                                            <Path x:Name="SpaceMusicPath" Fill="Transparent" Stroke="#9CA3AF" StrokeThickness="2"
                                                  Data="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"/>
                                        </Canvas>
                                    </Viewbox>
                                    <Border x:Name="SpaceMusicPlayingDot" Width="9" Height="9" Background="#34D399" CornerRadius="5"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0" Visibility="Collapsed"/>
                                </Grid>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- 6. Smart Home & IP-Kameras -->
                    <Button x:Name="SpaceSmartHomeBtn" Click="SwitchSpace_Click" Tag="smarthome" ToolTip="Smart Home, IP-Kameras &amp; Steckdosen"
                            Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,8" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid Width="42" Height="42">
                                    <Border x:Name="SpaceSmartHomeBg" Background="Transparent" CornerRadius="11"/>
                                    <Viewbox Width="20" Height="20">
                                        <Canvas Width="24" Height="24">
                                            <Path x:Name="SpaceSmartHomePath" Fill="Transparent" Stroke="#9CA3AF" StrokeThickness="2"
                                                  Data="M3 10.5L12 3l9 7.5M5 9v10a1 1 0 001 1h12a1 1 0 001-1V9M9 20v-6a1 1 0 011-1h4a1 1 0 011 1v6"/>
                                        </Canvas>
                                    </Viewbox>
                                </Grid>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- 7. Kamera & Streaming Studio (Funkenwerk Kamera) -->
                    <Button x:Name="SpaceCameraBtn" Click="SwitchSpace_Click" Tag="camera" ToolTip="Kamera &amp; Streaming Studio (Virtuelle Funkenwerk Kamera)"
                            Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,8" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid Width="42" Height="42">
                                    <Border x:Name="SpaceCameraBg" Background="Transparent" CornerRadius="11"/>
                                    <Viewbox Width="20" Height="20">
                                        <Canvas Width="24" Height="24">
                                            <Path x:Name="SpaceCameraPath" Fill="Transparent" Stroke="#9CA3AF" StrokeThickness="2"
                                                  Data="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z M9 12a2 2 0 11-4 0 2 2 0 014 0z"/>
                                        </Canvas>
                                    </Viewbox>
                                    <Border x:Name="SpaceCameraLiveDot" Width="9" Height="9" Background="#EF4444" CornerRadius="5"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0" Visibility="Collapsed"/>
                                </Grid>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- 8. Marketing & Content-Planer -->
                    <Button x:Name="SpaceMarketingBtn" Click="SwitchSpace_Click" Tag="marketing" ToolTip="Marketing &amp; Content-Planer"
                            Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,8" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid Width="42" Height="42">
                                    <Border x:Name="SpaceMarketingBg" Background="Transparent" CornerRadius="11"/>
                                    <Viewbox Width="20" Height="20">
                                        <Canvas Width="24" Height="24">
                                            <Path x:Name="SpaceMarketingPath" Fill="Transparent" Stroke="#9CA3AF" StrokeThickness="2"
                                                  Data="M13 10V3L4 14h7v7l9-11h-7z"/>
                                        </Canvas>
                                    </Viewbox>
                                </Grid>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- 9. Bestellungen & Labeldruck-Warteschlange (MUNBYN ITPP941AP) -->
                    <Button x:Name="SpaceOrdersBtn" Click="SwitchSpace_Click" Tag="orders" ToolTip="Bestellungen, Labeldruck-Warteschlange &amp; Diagnose-Logs (MUNBYN ITPP941AP)"
                            Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,8" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid Width="42" Height="42">
                                    <Border x:Name="SpaceOrdersBg" Background="Transparent" CornerRadius="11"/>
                                    <Viewbox Width="20" Height="20">
                                        <Canvas Width="24" Height="24">
                                            <Path x:Name="SpaceOrdersPath" Fill="Transparent" Stroke="#9CA3AF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Data="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/>
                                        </Canvas>
                                    </Viewbox>
                                    <Border x:Name="SpaceOrdersBadge" Background="#C5A059" CornerRadius="8" Padding="4,1"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0" Visibility="Collapsed">
                                        <TextBlock x:Name="SpaceOrdersBadgeTxt" Text="0" Foreground="#111827" FontSize="9" FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <!-- Bottom Icon: Settings -->
                <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">

                    <!-- Settings Gear -->
                    <Button x:Name="SpaceSettingsBtn" Click="OpenSettings_Click" ToolTip="Funkenwerk API &amp; Einstellungen"
                            Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="SetBorder" Width="42" Height="42" Background="Transparent" CornerRadius="11">
                                    <Viewbox Width="20" Height="20">
                                        <Canvas Width="24" Height="24">
                                            <Path x:Name="SpaceSettingsPath" Fill="Transparent" Stroke="#9CA3AF" StrokeThickness="2"
                                                  Data="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="SetBorder" Property="Background" Value="#22888888"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- ========================================================================= -->
        <!-- COLUMN 1: MODULE VIEWS                                                    -->
        <!-- ========================================================================= -->
        <Grid Grid.Row="1" Grid.Column="1">

            <!-- ===================================================================== -->
            <!-- MODULE 1: E-MAIL CLIENT (Thunderbird Replacement)                     -->
            <!-- ===================================================================== -->
            <Grid x:Name="MailViewGrid" Visibility="Visible">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="MailColSidebar" Width="275" MinWidth="190" MaxWidth="520"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition x:Name="MailColList" Width="360" MinWidth="240" MaxWidth="680"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*" MinWidth="320"/>
                </Grid.ColumnDefinitions>

                <!-- 1A: Accounts & Folders Sidebar -->
                <Border Grid.Column="0" Background="#13161F" Padding="14,16">
                    <DockPanel LastChildFill="True">
                        <!-- Top Header + KI-Sortierung + Sync + New Mail -->
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Mail" Foreground="#F9FAFB" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button x:Name="MailAiSortBtn" Grid.Column="1" Click="AiSortMails_Click"
                                    ToolTip="✨ KI-Trichter: Wichtige Aufgaben in 'Verarbeitet' bündeln, Routine- &amp; unwichtige Mails kategorisiert ins 'Archiv' verschieben &amp; Spam leeren"
                                    Background="#1A1710" Foreground="#C5A059" BorderBrush="#4D3D1E" BorderThickness="1" Padding="8,5" Margin="0,0,5,0" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                <TextBlock Text="✨ KI" FontSize="11" FontWeight="Bold"/>
                            </Button>
                            <Button Grid.Column="2" Click="SyncMails_Click" ToolTip="Postfächer synchronisieren (IMAP)"
                                    Background="#1F2430" Foreground="#D1D5DB" BorderThickness="0" Padding="8,5" Margin="0,0,5,0" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                <TextBlock Text="↻ Sync" FontSize="11" FontWeight="SemiBold"/>
                            </Button>
                            <Button Grid.Column="3" Click="OpenCompose_Click" ToolTip="Neue E-Mail verfassen"
                                    Background="#C5A059" Foreground="#111827" BorderThickness="0" Padding="9,5" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                <TextBlock Text="✎ Neu" FontSize="11" FontWeight="Bold"/>
                            </Button>
                        </Grid>

                        <!-- Bottom Add Custom Folder Bar -->
                        <Border DockPanel.Dock="Bottom" BorderBrush="#1E222D" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#181B24" BorderBrush="#262A36" BorderThickness="1" CornerRadius="8" Padding="8,5">
                                    <TextBox x:Name="NewMailFolderInput" Background="Transparent" BorderThickness="0" Foreground="#F3F4F6"
                                             CaretBrush="#C5A059" FontSize="12" KeyDown="NewMailFolderInput_KeyDown"
                                             Tag="Neuer Ordner..."/>
                                </Border>
                                <Button Grid.Column="1" Click="CreateMailFolder_Click" Background="#1F2430" Foreground="#C5A059"
                                        BorderThickness="0" Padding="10,5" Margin="6,0,0,0" Cursor="Hand" FontWeight="Bold" Content="+">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Accounts & Folders Tree (Supports Drag & Drop of Accounts, Folders, and Mails!) -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <StackPanel x:Name="MailAccountsPanel" Margin="0,2,4,2"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Resizable Splitter 1 -->
                <GridSplitter Grid.Column="1" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" DragCompleted="Splitter_DragCompleted"/>

                <!-- 1B: Message List Column -->
                <Border Grid.Column="2" Background="#0F1117" Padding="14,16">
                    <DockPanel LastChildFill="True">
                        <!-- Folder Title & Filter -->
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="ActiveFolderTitle" Text="Posteingang" Foreground="#F9FAFB" FontSize="17" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="ActiveAccountSubtitle" Text="kontakt@mein-seelenfunke.de" Foreground="#9CA3AF" FontSize="11"/>
                                </StackPanel>
                                <Button x:Name="UnreadFilterBtn" Grid.Column="1" Click="ToggleUnreadFilter_Click"
                                        Background="#181B24" Foreground="#9CA3AF" BorderThickness="0" Padding="9,5" VerticalAlignment="Center" Cursor="Hand">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                    <TextBlock x:Name="UnreadFilterTxt" Text="Alle Mails" FontSize="11" FontWeight="SemiBold"/>
                                </Button>
                            </Grid>

                            <!-- Search Mail Input -->
                            <Border Background="#181B24" BorderBrush="#262A36" BorderThickness="1" CornerRadius="10" Padding="10,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🔍" Foreground="#6B7280" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBox x:Name="MailSearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                             Foreground="#F3F4F6" CaretBrush="#C5A059" FontSize="12.5" VerticalContentAlignment="Center"
                                             KeyDown="MailSearchBox_KeyDown"/>
                                    <TextBlock x:Name="MailSearchPlaceholder" Grid.Column="1" Text="E-Mails &amp; Papierkorb durchsuchen (Enter)..."
                                               Foreground="#6B7280" FontSize="12.5" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                </Grid>
                            </Border>

                            <!-- Funnel Category & Importance Filter Pills (Visible in "Verarbeitet") -->
                            <WrapPanel x:Name="MailFunnelFilterPanel" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed"/>
                        </StackPanel>

                        <!-- Messages List (Supports Right-Click ContextMenu & Drag-and-Drop!) -->
                        <ScrollViewer x:Name="MailMessagesScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <StackPanel x:Name="MailMessagesPanel" Margin="0,0,4,0" Focusable="True" FocusVisualStyle="{x:Null}"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Resizable Splitter 2 -->
                <GridSplitter Grid.Column="3" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" DragCompleted="Splitter_DragCompleted"/>

                <!-- 1C: Message Reading Pane -->
                <Border Grid.Column="4" Background="#0B0D12" Padding="24,20">
                    <Grid>
                        <!-- Empty State when no message selected -->
                        <StackPanel x:Name="MailEmptyReader" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border Width="68" Height="68" CornerRadius="18" Background="#161922" BorderBrush="#262A36" BorderThickness="1" Margin="0,0,0,12">
                                <Image Source="pack://application:,,,/funkenwerk.png" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Keine E-Mail ausgewählt" Foreground="#E5E7EB" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Wähle links eine Nachricht aus oder nutze den Ordner '✨ Verarbeitet' für den Gesamtüberblick." Foreground="#6B7280" FontSize="12.5" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Active Message Reader -->
                        <DockPanel x:Name="MailActiveReader" Visibility="Collapsed" LastChildFill="True">
                            <!-- Action Toolbar -->
                            <Border DockPanel.Dock="Top" Background="#13161F" BorderBrush="#1E222D" BorderThickness="1" CornerRadius="12" Padding="12,8" Margin="0,0,0,16">
                                <WrapPanel Orientation="Horizontal">
                                    <Button x:Name="EditDraftActionBtn" Click="EditDraft_Click" Visibility="Collapsed" Background="#C5A059" Foreground="#111827" BorderThickness="0" Padding="11,6" Margin="0,0,6,0" Cursor="Hand">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                        <TextBlock Text="✎ Entwurf weiterbearbeiten" FontSize="12" FontWeight="Bold"/>
                                    </Button>
                                    <Button x:Name="ReplyMailActionBtn" Click="ReplyMail_Click" Background="#1F2430" Foreground="#F3F4F6" BorderThickness="0" Padding="10,6" Margin="0,0,6,0" Cursor="Hand">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                        <TextBlock Text="↩ Antworten" FontSize="12" FontWeight="SemiBold"/>
                                    </Button>
                                    <Button Click="ForwardMail_Click" Background="#1F2430" Foreground="#F3F4F6" BorderThickness="0" Padding="10,6" Margin="0,0,6,0" Cursor="Hand">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                        <TextBlock Text="↪ Weiterleiten" FontSize="12" FontWeight="SemiBold"/>
                                    </Button>
                                    <Button Click="ArchiveMail_Click" Background="#1F2430" Foreground="#C5A059" BorderThickness="0" Padding="10,6" Margin="0,0,6,0" Cursor="Hand" ToolTip="E-Mail kategorisiert ins Archiv legen">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                        <TextBlock Text="📦 Ins Archiv" FontSize="12" FontWeight="SemiBold"/>
                                    </Button>
                                    <Button x:Name="ToggleImportantActionBtn" Click="ToggleMailImportant_Click" Background="#3A181E" Foreground="#F87171" BorderThickness="0" Padding="10,6" Margin="0,0,6,0" Cursor="Hand">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                        <TextBlock x:Name="ToggleImportantActionBtnTxt" Text="🔴 Als Wichtig markieren" FontSize="12" FontWeight="Bold"/>
                                    </Button>
                                    <Button Click="CreateContactFromMail_Click" Background="#182232" Foreground="#60A5FA" BorderThickness="0" Padding="10,6" Margin="0,0,6,0" Cursor="Hand">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                        <TextBlock Text="👤 Kontakt speichern" FontSize="12" FontWeight="SemiBold"/>
                                    </Button>
                                    <Button x:Name="SpamActionBtn" Click="SpamMail_Click" Background="#2A1E17" Foreground="#F59E0B" BorderThickness="0" Padding="10,6" Margin="0,0,6,0" Cursor="Hand" ToolTip="Absender auf Spam-Regel setzen &amp; in Spam verschieben (keine Löschung)">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                        <TextBlock x:Name="SpamActionBtnTxt" Text="🛡 Spam" FontSize="12" FontWeight="SemiBold"/>
                                    </Button>
                                    <Button Click="DeleteMail_Click" Visibility="Collapsed" Background="#2D161B" Foreground="#F87171" BorderThickness="0" Padding="10,6" Cursor="Hand">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                        <TextBlock Text="📦 Archivieren" FontSize="12" FontWeight="SemiBold"/>
                                    </Button>
                                </WrapPanel>
                            </Border>

                            <!-- Wichtig Action Hint Callout Banner (Visible when viewing a Wichtig mail) -->
                            <Border x:Name="ReaderActionHintBorder" DockPanel.Dock="Top" Visibility="Collapsed"
                                    Background="#2A1216" BorderBrush="#EF4444" BorderThickness="1.5" CornerRadius="12" Padding="14,11" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="🔴 WICHTIG — HANDLUNGSBEDARF" Foreground="#FCA5A5" FontSize="10.5" FontWeight="Bold" Margin="0,0,0,3"/>
                                        <TextBlock x:Name="ReaderActionHintTxt" Text="Was ist zu tun?" Foreground="#F9FAFB" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Click="ResolveImportantMail_Click" Background="#10B981" Foreground="#06281E"
                                            BorderThickness="0" Padding="12,7" Margin="12,0,0,0" VerticalAlignment="Center" Cursor="Hand"
                                            ToolTip="Markiert diese Aufgabe als erledigt und verschiebt die E-Mail automatisch ins Archiv">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                        <TextBlock Text="✓ Erledigt (→ Archiv)" FontSize="12" FontWeight="Bold"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Subject & Sender Header -->
                            <Border DockPanel.Dock="Top" BorderBrush="#1E222D" BorderThickness="0,0,0,1" Padding="0,0,0,14" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock x:Name="ReaderSubjectTxt" Text="Betreff" Foreground="#F9FAFB" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="38" Height="38" CornerRadius="19" Background="#26231F" BorderBrush="#C5A059" BorderThickness="1" HorizontalAlignment="Left">
                                            <TextBlock x:Name="ReaderAvatarTxt" Text="A" Foreground="#C5A059" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                                            <TextBlock x:Name="ReaderFromNameTxt" Text="Absender" Foreground="#F3F4F6" FontSize="13.5" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="ReaderFromEmailTxt" Text="from@example.com" Foreground="#9CA3AF" FontSize="11.5"/>
                                            <TextBlock x:Name="ReaderCcBccTxt" Text="" Foreground="#C5A059" FontSize="11" Margin="0,2,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <TextBlock x:Name="ReaderDateTxt" Grid.Column="2" Text="04.11.2026 14:30" Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Top"/>
                                    </Grid>

                                    <!-- Attachments Chip Row -->
                                    <WrapPanel x:Name="ReaderAttachmentsPanel" Orientation="Horizontal" Margin="0,10,0,0" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>

                            <!-- Message Body -->
                            <Border Background="#13161F" BorderBrush="#1E222D" BorderThickness="1" CornerRadius="14" Padding="20,18">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                    <TextBox x:Name="ReaderBodyTxt" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                             Foreground="#F3F4F6" FontSize="14" TextWrapping="Wrap" AcceptsReturn="True" Padding="2"/>
                                </ScrollViewer>
                            </Border>
                        </DockPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===================================================================== -->
            <!-- MODULE 2: ADRESSBUCH (Contacts)                                       -->
            <!-- ===================================================================== -->
            <Grid x:Name="ContactsViewGrid" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ContactsColSidebar" Width="350" MinWidth="220" MaxWidth="620"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*" MinWidth="320"/>
                </Grid.ColumnDefinitions>

                <!-- Left List -->
                <Border Grid.Column="0" Background="#13161F" Padding="16,18">
                    <DockPanel LastChildFill="True">
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Adressbuch" Foreground="#F9FAFB" FontSize="20" FontWeight="Bold"/>
                            <Button Grid.Column="1" Click="NewContact_Click" Background="#C5A059" Foreground="#111827" BorderThickness="0" Padding="12,6" Cursor="Hand" FontWeight="Bold" Content="+ Kontakt">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                            </Button>
                        </Grid>

                        <Border DockPanel.Dock="Top" Background="#181B24" BorderBrush="#262A36" BorderThickness="1" CornerRadius="10" Padding="10,7" Margin="0,0,0,12">
                            <TextBox x:Name="ContactSearchBox" Background="Transparent" BorderThickness="0" Foreground="#F3F4F6" CaretBrush="#C5A059" FontSize="12.5" TextChanged="ContactSearchBox_TextChanged"/>
                        </Border>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ContactsListPanel" Margin="0,0,4,0"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Resizable Splitter -->
                <GridSplitter Grid.Column="1" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" DragCompleted="Splitter_DragCompleted"/>

                <!-- Right Contact Detail / Editor -->
                <Border Grid.Column="2" Background="#0F1117" Padding="32,24">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ContactDetailPanel" MaxWidth="620" HorizontalAlignment="Left">
                            <TextBlock x:Name="ContactFormHeader" Text="Kontakt bearbeiten" Foreground="#F9FAFB" FontSize="22" FontWeight="Bold" Margin="0,0,0,18"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,0,12">
                                    <TextBlock Text="VORNAME *" Foreground="#9CA3AF" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBox x:Name="ContactFirstNameInput" Background="#181B24" Foreground="#F9FAFB" BorderBrush="#262A36" Padding="10,8" FontSize="13.5"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,0,12">
                                    <TextBlock Text="NACHNAME" Foreground="#9CA3AF" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBox x:Name="ContactLastNameInput" Background="#181B24" Foreground="#F9FAFB" BorderBrush="#262A36" Padding="10,8" FontSize="13.5"/>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,0,12">
                                    <TextBlock Text="FIRMA / ORGANISATION" Foreground="#9CA3AF" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBox x:Name="ContactCompanyInput" Background="#181B24" Foreground="#F9FAFB" BorderBrush="#262A36" Padding="10,8" FontSize="13.5"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,0,12">
                                    <TextBlock Text="KATEGORIE / ROLLE" Foreground="#9CA3AF" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBox x:Name="ContactRoleInput" Background="#181B24" Foreground="#F9FAFB" BorderBrush="#262A36" Padding="10,8" FontSize="13.5"/>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,0,12">
                                    <TextBlock Text="E-MAIL ADRESSE" Foreground="#9CA3AF" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBox x:Name="ContactEmailInput" Background="#181B24" Foreground="#F9FAFB" BorderBrush="#262A36" Padding="10,8" FontSize="13.5"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,0,12">
                                    <TextBlock Text="TELEFON / MOBIL" Foreground="#9CA3AF" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBox x:Name="ContactPhoneInput" Background="#181B24" Foreground="#F9FAFB" BorderBrush="#262A36" Padding="10,8" FontSize="13.5"/>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="2*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,0,12">
                                    <TextBlock Text="STRASSE &amp; HAUSNR." Foreground="#9CA3AF" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBox x:Name="ContactStreetInput" Background="#181B24" Foreground="#F9FAFB" BorderBrush="#262A36" Padding="10,8" FontSize="13.5"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,0,12">
                                    <TextBlock Text="PLZ" Foreground="#9CA3AF" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBox x:Name="ContactPostalInput" Background="#181B24" Foreground="#F9FAFB" BorderBrush="#262A36" Padding="10,8" FontSize="13.5"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4" Margin="0,0,0,12">
                                    <TextBlock Text="ORT" Foreground="#9CA3AF" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBox x:Name="ContactCityInput" Background="#181B24" Foreground="#F9FAFB" BorderBrush="#262A36" Padding="10,8" FontSize="13.5"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="NOTIZEN / KI-KONTEXT" Foreground="#9CA3AF" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                                <TextBox x:Name="ContactNotesInput" Background="#181B24" Foreground="#F9FAFB" BorderBrush="#262A36" Padding="10,8" FontSize="13" Height="100" AcceptsReturn="True" TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <Button Click="SaveContact_Click" Background="#C5A059" Foreground="#111827" BorderThickness="0" Padding="18,10" Margin="0,0,10,0" Cursor="Hand" FontWeight="Bold" Content="Kontakt speichern">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                                </Button>
                                <Button Click="WriteMailToContact_Click" Background="#1F2430" Foreground="#F3F4F6" BorderThickness="0" Padding="16,10" Margin="0,0,10,0" Cursor="Hand" FontWeight="SemiBold" Content="✉ E-Mail schreiben">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                                </Button>
                                <Button Click="DeleteContact_Click" Background="#2D161B" Foreground="#F87171" BorderThickness="0" Padding="16,10" Cursor="Hand" FontWeight="SemiBold" Content="🗑 Löschen">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ===================================================================== -->
            <!-- MODULE 3: KALENDER (Full Suite matching /admin/calender)              -->
            <!-- ===================================================================== -->
            <Grid x:Name="CalendarViewGrid" Visibility="Collapsed" Background="#0F1117">
                <!-- MAIN CALENDAR VIEW -->
                <DockPanel x:Name="CalendarMainPanel" LastChildFill="True">
                    <!-- 1. TOP HEADER BAR -->
                    <Border DockPanel.Dock="Top" Background="#13161F" BorderBrush="#1E222D" BorderThickness="0,0,0,1" Padding="26,18">
                        <StackPanel>
                            <!-- Row 1: Title, KW Badge & Primary Actions -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="CalendarHeaderTitleTxt" Text="November 2026" Foreground="#F9FAFB" FontSize="28" FontWeight="Bold"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                                        <Border Background="#26231F" BorderBrush="#4D3D1E" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="0,0,10,0">
                                            <TextBlock x:Name="CalendarKwBadgeTxt" Text="KW 45" Foreground="#C5A059" FontSize="10.5" FontWeight="Bold"/>
                                        </Border>
                                        <TextBlock x:Name="CalendarSubtitleTxt" Text="ZENTRALE ZEITVERWALTUNG · DOPPELKLICK ZUM ANLEGEN · DRAG &amp; DROP ZUM VERSCHIEBEN"
                                                   Foreground="#9CA3AF" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Click="ImportCalendarIcs_Click" Background="#181B24" Foreground="#D1D5DB" BorderBrush="#262A36" BorderThickness="1"
                                            Padding="14,9" Margin="0,0,10,0" Cursor="Hand" ToolTip="ICS Kalenderdatei (.ics) importieren">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="12"/></Style></Button.Resources>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⬆" Foreground="#C5A059" FontSize="12" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="IMPORT (.ICS)" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Click="NewCalendarEvent_Click" Background="#C5A059" Foreground="#111827" BorderThickness="0"
                                            Padding="18,9" Cursor="Hand" ToolTip="Neuen Termin anlegen (oder Doppelklick direkt im Kalender)">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="12"/></Style></Button.Resources>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="＋" Foreground="#111827" FontSize="13" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="NEUER EINTRAG" Foreground="#111827" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Row 2: Prev/Today/Next Navigation + 6-Mode View Switcher -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Date Stepper Pill -->
                                <Border Grid.Column="0" Background="#181B24" BorderBrush="#242936" BorderThickness="1" CornerRadius="12" Padding="4">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Click="CalendarPrev_Click" Background="Transparent" Foreground="#9CA3AF" BorderThickness="0" Padding="11,6" Cursor="Hand" ToolTip="Zurück">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                            <TextBlock Text="◀" FontSize="11" FontWeight="Bold"/>
                                        </Button>
                                        <Button Click="CalendarToday_Click" Background="#13161F" Foreground="#F9FAFB" BorderBrush="#262A36" BorderThickness="1" Padding="16,6" Margin="4,0" Cursor="Hand" ToolTip="Zu Heute springen">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                            <TextBlock Text="HEUTE" FontSize="10.5" FontWeight="Bold"/>
                                        </Button>
                                        <Button Click="CalendarNext_Click" Background="Transparent" Foreground="#9CA3AF" BorderThickness="0" Padding="11,6" Cursor="Hand" ToolTip="Weiter">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                            <TextBlock Text="▶" FontSize="11" FontWeight="Bold"/>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- 6 View Modes Segmented Control (Jahr, Monat, 4-W, Woche, Tag, Liste) -->
                                <Border Grid.Column="2" Background="#181B24" BorderBrush="#242936" BorderThickness="1" CornerRadius="12" Padding="4">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="CalViewBtnYear" Tag="year" Click="CalendarSwitchView_Click" Background="Transparent" Foreground="#9CA3AF" BorderThickness="0" Padding="14,6" Margin="0,0,2,0" Cursor="Hand">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                            <TextBlock x:Name="CalViewTxtYear" Text="JAHR" FontSize="10.5" FontWeight="Bold"/>
                                        </Button>
                                        <Button x:Name="CalViewBtnMonth" Tag="month" Click="CalendarSwitchView_Click" Background="#C5A059" Foreground="#111827" BorderThickness="0" Padding="14,6" Margin="0,0,2,0" Cursor="Hand">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                            <TextBlock x:Name="CalViewTxtMonth" Text="MONAT" Foreground="#111827" FontSize="10.5" FontWeight="Bold"/>
                                        </Button>
                                        <Button x:Name="CalViewBtnMultiWeek" Tag="multi-week" Click="CalendarSwitchView_Click" Background="Transparent" Foreground="#9CA3AF" BorderThickness="0" Padding="14,6" Margin="0,0,2,0" Cursor="Hand">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                            <TextBlock x:Name="CalViewTxtMultiWeek" Text="4-W" FontSize="10.5" FontWeight="Bold"/>
                                        </Button>
                                        <Button x:Name="CalViewBtnWeek" Tag="week" Click="CalendarSwitchView_Click" Background="Transparent" Foreground="#9CA3AF" BorderThickness="0" Padding="14,6" Margin="0,0,2,0" Cursor="Hand">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                            <TextBlock x:Name="CalViewTxtWeek" Text="WOCHE" FontSize="10.5" FontWeight="Bold"/>
                                        </Button>
                                        <Button x:Name="CalViewBtnDay" Tag="day" Click="CalendarSwitchView_Click" Background="Transparent" Foreground="#9CA3AF" BorderThickness="0" Padding="14,6" Margin="0,0,2,0" Cursor="Hand">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                            <TextBlock x:Name="CalViewTxtDay" Text="TAG" FontSize="10.5" FontWeight="Bold"/>
                                        </Button>
                                        <Button x:Name="CalViewBtnList" Tag="list" Click="CalendarSwitchView_Click" Background="Transparent" Foreground="#9CA3AF" BorderThickness="0" Padding="14,6" Cursor="Hand">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                            <TextBlock x:Name="CalViewTxtList" Text="LISTE" FontSize="10.5" FontWeight="Bold"/>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Quick Search / Filter in Calendar -->
                                <Border Grid.Column="4" Width="230" Background="#181B24" BorderBrush="#242936" BorderThickness="1" CornerRadius="10" Padding="10,5" VerticalAlignment="Center">
                                    <Grid>
                                        <TextBlock x:Name="CalendarSearchPlaceholder" Text="🔍 Termine filtern..." Foreground="#6B7280" FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                        <TextBox x:Name="CalendarSearchBox" Background="Transparent" Foreground="#F3F4F6" BorderThickness="0" FontSize="12" VerticalAlignment="Center" TextChanged="CalendarSearchBox_TextChanged"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 2. FEEDBACK BANNER -->
                    <Border x:Name="CalendarFeedbackBanner" DockPanel.Dock="Top" Visibility="Collapsed" Background="#142921" BorderBrush="#047857" BorderThickness="0,0,0,1" Padding="16,8">
                        <TextBlock x:Name="CalendarFeedbackTxt" Text="✓ Termin gespeichert." Foreground="#34D399" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- 3. DYNAMIC CALENDAR VIEWPORT -->
                    <Grid x:Name="CalendarViewportHost" Background="#0F1117"/>
                </DockPanel>

                <!-- FULL-FEATURED EVENT EDITOR VIEW (Matching /admin/calender Editor) -->
                <Border x:Name="CalendarEditorOverlay" Visibility="Collapsed" Background="#0F1117" Padding="32,24">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel MaxWidth="780" HorizontalAlignment="Center" Width="740">
                            <!-- Editor Header -->
                            <Border BorderBrush="#1E222D" BorderThickness="0,0,0,1" Padding="0,0,0,18" Margin="0,0,0,22">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" Click="CloseCalendarEditor_Click" Background="#181B24" Foreground="#D1D5DB" BorderBrush="#262A36" BorderThickness="1" Padding="12,8" Margin="0,0,14,0" Cursor="Hand">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                                        <TextBlock Text="◀ Zurück" FontSize="12.5" FontWeight="Bold"/>
                                    </Button>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📅" Foreground="#C5A059" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock x:Name="EventFormHeader" Text="Neuer Termin" Foreground="#F9FAFB" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button x:Name="CalendarDeleteEventBtn" Click="DeleteCalendarEvent_Click" Background="#2D161B" Foreground="#F87171" BorderBrush="#7F1D1D" BorderThickness="1" Padding="14,8" Cursor="Hand" Visibility="Collapsed">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                                            <TextBlock Text="🗑 Löschen" FontSize="12.5" FontWeight="Bold"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Titel -->
                            <StackPanel Margin="0,0,0,18">
                                <TextBlock Text="WAS STEHT AN? *" Foreground="#9CA3AF" FontSize="10.5" FontWeight="Bold" Margin="2,0,0,6"/>
                                <TextBox x:Name="EventTitleInput" Background="#13161F" Foreground="#F9FAFB" BorderBrush="#262A36" Padding="14,12" FontSize="15" FontWeight="Bold"/>
                            </StackPanel>

                            <!-- Kategorie, Erinnerung & Priorität (3 Columns) -->
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="KATEGORIE" Foreground="#9CA3AF" FontSize="10.5" FontWeight="Bold" Margin="2,0,0,6"/>
                                    <ComboBox x:Name="EventCategoryCombo" SelectedValuePath="Tag" Padding="10,9" FontSize="13" FontWeight="SemiBold">
                                        <ComboBoxItem Tag="general" Content="📅 Termin (Allgemein)" IsSelected="True"/>
                                        <ComboBoxItem Tag="project" Content="💼 Projekte"/>
                                        <ComboBoxItem Tag="meeting" Content="👥 Besprechung"/>
                                        <ComboBoxItem Tag="call" Content="📞 Anrufe"/>
                                        <ComboBoxItem Tag="customer" Content="👤 Kunde"/>
                                        <ComboBoxItem Tag="travel" Content="🌍 Reise"/>
                                        <ComboBoxItem Tag="vacation" Content="☀ Feiertage / Urlaub"/>
                                        <ComboBoxItem Tag="birthday" Content="🎂 Geburtstag"/>
                                        <ComboBoxItem Tag="task" Content="📋 Aufgabe"/>
                                        <ComboBoxItem Tag="restmuell" Content="🗑 Restmüll"/>
                                        <ComboBoxItem Tag="altpapier" Content="📰 Papier"/>
                                        <ComboBoxItem Tag="biomuell" Content="🍂 Bio"/>
                                        <ComboBoxItem Tag="gelber_sack" Content="🛍 Gelber Sack"/>
                                        <ComboBoxItem Tag="schadstoffe" Content="⚠ Schadstoffe"/>
                                        <ComboBoxItem Tag="sperrmuell" Content="🚚 Sperrmüll"/>
                                        <ComboBoxItem Tag="gruen" Content="✂ Grünabfall"/>
                                        <ComboBoxItem Tag="baum" Content="🎄 Tannenbaum"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="ERINNERUNG" Foreground="#9CA3AF" FontSize="10.5" FontWeight="Bold" Margin="2,0,0,6"/>
                                    <ComboBox x:Name="EventReminderCombo" SelectedValuePath="Tag" Padding="10,9" FontSize="13" FontWeight="SemiBold">
                                        <ComboBoxItem Tag="" Content="🔕 Aus" IsSelected="True"/>
                                        <ComboBoxItem Tag="0" Content="🔔 Pünktlich"/>
                                        <ComboBoxItem Tag="15" Content="🔔 15 Min. vorher"/>
                                        <ComboBoxItem Tag="60" Content="🔔 1 Std. vorher"/>
                                        <ComboBoxItem Tag="1440" Content="🔔 1 Tag vorher"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="PRIORITÄT" Foreground="#9CA3AF" FontSize="10.5" FontWeight="Bold" Margin="2,0,0,6"/>
                                    <ComboBox x:Name="EventPriorityCombo" SelectedValuePath="Tag" Padding="10,9" FontSize="13" FontWeight="SemiBold">
                                        <ComboBoxItem Tag="low" Content="⚪ Niedrig (Standard)" IsSelected="True"/>
                                        <ComboBoxItem Tag="medium" Content="🟡 Mittel (Gelb)"/>
                                        <ComboBoxItem Tag="high" Content="🔴 Wichtig (Rot)"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <!-- Zeitraum Card -->
                            <Border Background="#13161F" BorderBrush="#232734" BorderThickness="1" CornerRadius="16" Padding="20,18" Margin="0,0,0,18">
                                <StackPanel>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="ZEITRAUM" Foreground="#9CA3AF" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <CheckBox x:Name="EventAllDayCheck" Grid.Column="1" Content="Ganztägig" Foreground="#E5E7EB" FontSize="12.5" FontWeight="Bold"
                                                  VerticalAlignment="Center" Cursor="Hand" Checked="EventAllDayCheck_Changed" Unchecked="EventAllDayCheck_Changed"/>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="BEGINN" Foreground="#C5A059" FontSize="10" FontWeight="Bold" Margin="2,0,0,6"/>
                                            <DatePicker x:Name="EventStartDatePicker" Background="#181B24" Foreground="#111827" Padding="6" Margin="0,0,0,8"/>
                                            <Grid x:Name="EventStartTimeRow">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Uhrzeit (HH:mm):" Foreground="#9CA3AF" FontSize="11.5" VerticalAlignment="Center" Margin="2,0,10,0"/>
                                                <TextBox x:Name="EventStartTimeInput" Grid.Column="1" Text="09:00" Background="#181B24" Foreground="#F9FAFB" BorderBrush="#262A36" Padding="10,7" FontSize="13" FontWeight="Bold"/>
                                            </Grid>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="ENDE" Foreground="#C5A059" FontSize="10" FontWeight="Bold" Margin="2,0,0,6"/>
                                            <DatePicker x:Name="EventEndDatePicker" Background="#181B24" Foreground="#111827" Padding="6" Margin="0,0,0,8"/>
                                            <Grid x:Name="EventEndTimeRow">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Uhrzeit (HH:mm):" Foreground="#9CA3AF" FontSize="11.5" VerticalAlignment="Center" Margin="2,0,10,0"/>
                                                <TextBox x:Name="EventEndTimeInput" Grid.Column="1" Text="10:00" Background="#181B24" Foreground="#F9FAFB" BorderBrush="#262A36" Padding="10,7" FontSize="13" FontWeight="Bold"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Wiederholung (Serie) -->
                            <Grid Margin="0,0,0,18">
