<Window x:Class="Funkenwerk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Funkenwerk"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Funkenwerk"
        Icon="pack://application:,,,/funkenwerk.ico"
        Height="860" Width="1440" MinHeight="620" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="#000000"
        Foreground="#FFFFFF"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        Closing="Window_Closing">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Global Modern Button Style (Eliminates ugly default Windows light-blue hover box) -->
        <Style TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnRootBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnRootBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnRootBorder" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnRootBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mouse-Selectable & Copyable Read-Only Headline Style -->
        <Style x:Key="SelectableHeaderTextBox" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="IsReadOnlyCaretVisible" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="SelectionBrush" Value="#66C5A059"/>
            <Setter Property="Cursor" Value="IBeam"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="0"
                                      Padding="0"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Modal Close ('X') Button Style -->
        <Style x:Key="ModalCloseButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseBd" Background="Transparent" CornerRadius="8">
                            <TextBlock x:Name="CloseTxt" Text="✕" Foreground="#9CA3AF" FontSize="14" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseBd" Property="Background" Value="#EF4444"/>
                                <Setter TargetName="CloseTxt" Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Caption Control Button Style -->
        <Style x:Key="WinCaptionBtnStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CapBd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CapBd" Property="Background" Value="#22888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WinCloseBtnStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CapCloseBd" Background="Transparent">
                            <TextBlock x:Name="CapCloseTxt" Text="✕" Foreground="#9CA3AF" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CapCloseBd" Property="Background" Value="#E11D48"/>
                                <Setter TargetName="CapCloseTxt" Property="Foreground" Value="#FEFEFE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dynamic Theme-Aware Brushes for Inputs, Dropdowns, Popups & ContextMenus -->
        <SolidColorBrush x:Key="ThemeInputBgBrush" Color="#000000"/>
        <SolidColorBrush x:Key="ThemeInputFgBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ThemeInputBorderBrush" Color="#382D18"/>
        <SolidColorBrush x:Key="ThemeDropdownPopupBgBrush" Color="#000000"/>
        <SolidColorBrush x:Key="ThemeDropdownChevronBgBrush" Color="#000000"/>
        <SolidColorBrush x:Key="ThemeDropdownChevronStrokeBrush" Color="#C5A059"/>
        <SolidColorBrush x:Key="ThemeDropdownItemFgBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ThemeDropdownItemHoverBgBrush" Color="#0D0A06"/>
        <SolidColorBrush x:Key="ThemeDropdownItemHoverFgBrush" Color="#C5A059"/>
        <SolidColorBrush x:Key="ThemeDropdownItemSelectedBgBrush" Color="#141008"/>
        <SolidColorBrush x:Key="ThemeDropdownItemSelectedFgBrush" Color="#C5A059"/>

        <!-- Global Modern TextBox Style (Pure Deep-Black & Gold/White in Darkmode, Bright in Lightmode) -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ThemeInputBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeInputFgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="#C5A059"/>
            <Setter Property="SelectionBrush" Value="#C5A059"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="TxtBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="9"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TxtBorder" Property="BorderBrush" Value="#C5A059"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TxtBorder" Property="BorderBrush" Value="#C5A059"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="AcceptsReturn" Value="True">
                    <Setter Property="VerticalContentAlignment" Value="Top"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Global Discord-Inspired ComboBoxItem Style (Rounded Hover Pill + Radio Indicator) -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="3,1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeDropdownItemFgBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}"
                                Margin="{TemplateBinding Margin}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <Border x:Name="RadioOuter" Grid.Column="1" Width="15" Height="15" CornerRadius="8"
                                        BorderBrush="#6B7280" BorderThickness="1.5" Background="Transparent"
                                        Margin="10,0,0,0" VerticalAlignment="Center">
                                    <Ellipse x:Name="RadioInner" Width="7" Height="7" Fill="Transparent"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBd" Property="Background" Value="{DynamicResource ThemeDropdownItemHoverBgBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeDropdownItemHoverFgBrush}"/>
                                <Setter TargetName="RadioOuter" Property="BorderBrush" Value="#C5A059"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBd" Property="Background" Value="{DynamicResource ThemeDropdownItemSelectedBgBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeDropdownItemSelectedFgBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="RadioOuter" Property="BorderBrush" Value="#C5A059"/>
                                <Setter TargetName="RadioOuter" Property="Background" Value="#C5A059"/>
                                <Setter TargetName="RadioInner" Property="Fill" Value="#000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Global Discord-Inspired Modern ComboBox Style (Eliminates Windows 2000 Grey Bevel Chrome) -->
        <Style TargetType="ComboBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="Background" Value="{DynamicResource ThemeInputBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeInputFgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="MainGrid" SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition MinWidth="28" Width="0"/>
                            </Grid.ColumnDefinitions>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Grid.ColumnSpan="2"
                                   IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   Margin="1"
                                   Placement="Bottom"
                                   PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder"
                                        MinWidth="{Binding ActualWidth, ElementName=MainGrid}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{DynamicResource ThemeDropdownPopupBgBrush}"
                                        BorderBrush="{DynamicResource ThemeInputBorderBrush}"
                                        BorderThickness="1.5"
                                        CornerRadius="10"
                                        Padding="4"
                                        Margin="0,4,0,8">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.45"/>
                                    </Border.Effect>
                                    <ScrollViewer x:Name="DropDownScrollViewer">
                                        <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                            <ToggleButton x:Name="ToggleButton"
                                          Grid.ColumnSpan="2"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ComboRootBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="9">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="1" Width="22" Height="22" CornerRadius="6"
                                                        Background="{DynamicResource ThemeDropdownChevronBgBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,4,0">
                                                    <Path x:Name="Arrow"
                                                          Data="M 0,0 L 4.5,4.5 L 9,0"
                                                          Stroke="{DynamicResource ThemeDropdownChevronStrokeBrush}"
                                                          StrokeThickness="1.8"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ComboRootBorder" Property="BorderBrush" Value="#C5A059"/>
                                                <Setter TargetName="Arrow" Property="Stroke" Value="#C5A059"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ComboRootBorder" Property="BorderBrush" Value="#C5A059"/>
                                                <Setter TargetName="Arrow" Property="Stroke" Value="#C5A059"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              IsHitTestVisible="False"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Global Clean GridSplitter Style -->
        <Style TargetType="GridSplitter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border x:Name="SplitBd" Background="Transparent">
                            <Border x:Name="SplitLine" Width="1" HorizontalAlignment="Center" Background="#22888888"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SplitLine" Property="Width" Value="2"/>
                                <Setter TargetName="SplitLine" Property="Background" Value="#C5A059"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Global Slider Style: Jump directly to mouse click position -->
        <Style TargetType="Slider">
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootWindowGrid">
        <Grid.RowDefinitions>
            <!-- Unified Custom Window Titlebar -->
            <RowDefinition Height="42"/>
            <!-- Main Workspace -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <!-- Left Vertical Spaces Toolbar (Thunderbird-inspired) -->
            <ColumnDefinition Width="56"/>
            <!-- Active Module Content -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ========================================================================= -->
        <!-- ROW 0: UNIFIED CUSTOM TITLEBAR (Single Larger Logo + "Funkenwerk")        -->
        <!-- ========================================================================= -->
        <Border x:Name="CustomTitleBar" Grid.Row="0" Grid.ColumnSpan="2" Background="#0A0C10" BorderBrush="#1E222D" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Single Larger Funkenwerk Icon (Top-Left, Centered over Spaces Bar) -->
                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" Cursor="Hand" MouseLeftButtonUp="BrandLogo_Click" ToolTip="Funkenwerk">
                    <Image Source="pack://application:,,,/funkenwerk.png" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <!-- Clean Window Title "Funkenwerk" + Live API Connection Dot + Lock/Logout Button -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                    <TextBlock x:Name="WindowTitleTxt" Text="Funkenwerk" Foreground="#F9FAFB" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Border x:Name="ApiConnectionDotBorder" Background="Transparent" Padding="6,6,8,6" Margin="2,-3,0,0" VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Cursor="Hand"
                            MouseLeftButtonUp="ApiConnectionDot_Click"
                            ToolTipService.InitialShowDelay="80" ToolTipService.ShowDuration="30000"
                            ToolTip="Verbindung wird geprüft...">
                        <Grid Width="10" Height="10" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Ellipse x:Name="ApiConnectionPulseRing" Width="10" Height="10" Fill="#2610B981" Visibility="Visible"/>
                            <Ellipse x:Name="ApiConnectionDotEllipse" Width="7.5" Height="7.5" Fill="#10B981" Stroke="#111827" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Button x:Name="HeaderLogoutLockBtn" Click="HeaderLogoutLockBtn_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Background="#161922" BorderBrush="#262A36" BorderThickness="1"
                            Padding="8,3" Margin="4,0,0,0" VerticalAlignment="Center" Cursor="Hand"
                            ToolTip="Funkenwerk sperren / Abmelden">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="11" Height="11" Margin="0,0,5,0" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path x:Name="HeaderLogoutLockIconPath" Fill="Transparent" Stroke="#FFFFFF" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Data="M19 11H5a2 2 0 00-2 2v7a2 2 0 002 2h14a2 2 0 002-2v-7a2 2 0 00-2-2zM7 11V7a5 5 0 0110 0v4"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock x:Name="HeaderLogoutLockTxt" Text="Abmelden" Foreground="#FFFFFF" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="HeaderOtaUpdateBtn" Click="HeaderOtaUpdateBtn_Click"
                            Visibility="Collapsed"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Background="#24C5A059" BorderBrush="#C5A059" BorderThickness="1"
                            Padding="9,3" Margin="8,0,0,0" VerticalAlignment="Center" Cursor="Hand"
                            ToolTip="Neues Funkenwerk-Update verfügbar">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        <TextBlock x:Name="HeaderOtaUpdateTxt" Text="Update verfügbar" Foreground="#C5A059" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>

                <!-- Right Window Controls: Minimize, Maximize/Restore, Close -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch">
                    <Button Style="{StaticResource WinCaptionBtnStyle}" Click="MinimizeWindow_Click" ToolTip="Minimieren">
                        <TextBlock Text="─" Foreground="#9CA3AF" FontSize="12"/>
                    </Button>
                    <Button Style="{StaticResource WinCaptionBtnStyle}" Click="MaximizeRestoreWindow_Click" ToolTip="Maximieren / Wiederherstellen">
                        <TextBlock x:Name="MaximizeRestoreTxt" Text="□" Foreground="#9CA3AF" FontSize="13"/>
                    </Button>
                    <Button Style="{StaticResource WinCloseBtnStyle}" Click="CloseWindow_Click" ToolTip="Schließen"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- ROW 1, COLUMN 0: VERTICAL SPACES TOOLBAR (E-Mail, Adressbuch, Kalender...) -->
        <!-- ========================================================================= -->
        <Border x:Name="LeftSpacesBarBorder" Grid.Row="1" Grid.Column="0" Background="#0A0C10" BorderBrush="#1E222D" BorderThickness="0,0,1,0" Padding="6,10,6,12">
            <DockPanel LastChildFill="False">

                <!-- Top Navigation Icons (No duplicate logo here!) -->
                <StackPanel DockPanel.Dock="Top" VerticalAlignment="Top">

                    <!-- 0. Apps / Kachel-Deck (Launcher) -->
                    <Button x:Name="SpaceLauncherBtn" Click="SwitchSpace_Click" Tag="launcher" ToolTip="Apps &amp; Module (Kachel-Deck)"
                            Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,8" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid Width="42" Height="42">
                                    <Border x:Name="SpaceLauncherBg" Background="#C5A059" CornerRadius="11"/>
                                    <Viewbox Width="20" Height="20">
                                        <Canvas Width="24" Height="24">
                                            <Path x:Name="SpaceLauncherPath" Fill="Transparent" Stroke="#111827" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Data="M4 4h6v6H4V4zm10 0h6v6h-6V4zM4 14h6v6H4v-6zm10 0h6v6h-6v-6z"/>
                                        </Canvas>
                                    </Viewbox>
                                </Grid>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- 1. E-Mail -->
                    <Button x:Name="SpaceMailBtn" Click="SwitchSpace_Click" Tag="mail" ToolTip="E-Mail (Postfächer &amp; Nachrichten)"
                            Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,8" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid Width="42" Height="42">
                                    <Border x:Name="SpaceMailBg" Background="Transparent" CornerRadius="11"/>
                                    <Viewbox Width="20" Height="20">
                                        <Canvas Width="24" Height="24">
                                            <Path x:Name="SpaceMailPath" Fill="Transparent" Stroke="#9CA3AF" StrokeThickness="2"
                                                  Data="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                                        </Canvas>
                                    </Viewbox>
                                    <Border x:Name="SpaceMailBadge" Background="#EF4444" CornerRadius="8" Padding="4,1"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0" Visibility="Collapsed">
                                        <TextBlock x:Name="SpaceMailBadgeTxt" Text="0" Foreground="#FEFEFE" FontSize="9" FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- 2. Adressbuch -->
                    <Button x:Name="SpaceContactsBtn" Click="SwitchSpace_Click" Tag="contacts" ToolTip="Adressbuch &amp; Kontakte"
                            Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,8" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid Width="42" Height="42">
                                    <Border x:Name="SpaceContactsBg" Background="Transparent" CornerRadius="11"/>
                                    <Viewbox Width="20" Height="20">
                                        <Canvas Width="24" Height="24">
                                            <Path x:Name="SpaceContactsPath" Fill="Transparent" Stroke="#9CA3AF" StrokeThickness="2"
                                                  Data="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                                        </Canvas>
                                    </Viewbox>
                                </Grid>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- 3. Kalender -->
                    <Button x:Name="SpaceCalendarBtn" Click="SwitchSpace_Click" Tag="calendar" ToolTip="Kalender &amp; Termine"
                            Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,8" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid Width="42" Height="42">
                                    <Border x:Name="SpaceCalendarBg" Background="Transparent" CornerRadius="11"/>
                                    <Viewbox Width="20" Height="20">
                                        <Canvas Width="24" Height="24">
                                            <Path x:Name="SpaceCalendarPath" Fill="Transparent" Stroke="#9CA3AF" StrokeThickness="2"
                                                  Data="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                        </Canvas>
                                    </Viewbox>
                                </Grid>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- 4. To Do / Aufgaben -->
                    <Button x:Name="SpaceTodoBtn" Click="SwitchSpace_Click" Tag="todo" ToolTip="To Do &amp; Aufgaben"
                            Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,8" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid Width="42" Height="42">
                                    <Border x:Name="SpaceTodoBg" Background="Transparent" CornerRadius="11"/>
                                    <Viewbox Width="20" Height="20">
                                        <Canvas Width="24" Height="24">
                                            <Path x:Name="SpaceTodoPath" Fill="Transparent" Stroke="#9CA3AF" StrokeThickness="2"
                                                  Data="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/>
                                        </Canvas>
                                    </Viewbox>
                                    <Border x:Name="SpaceTodoBadge" Background="#C5A059" CornerRadius="8" Padding="4,1"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0" Visibility="Collapsed">
                                        <TextBlock x:Name="SpaceTodoBadgeTxt" Text="0" Foreground="#111827" FontSize="9" FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- 9. Bestellungen & Labeldruck-Warteschlange (MUNBYN ITPP941AP) -->
                    <Button x:Name="SpaceOrdersBtn" Click="SwitchSpace_Click" Tag="orders" ToolTip="Bestellungen, Labeldruck-Warteschlange &amp; Diagnose-Logs (MUNBYN ITPP941AP)"
                            Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,8" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid Width="42" Height="42">
                                    <Border x:Name="SpaceOrdersBg" Background="Transparent" CornerRadius="11"/>
                                    <Viewbox Width="20" Height="20">
                                        <Canvas Width="24" Height="24">
                                            <Path x:Name="SpaceOrdersPath" Fill="Transparent" Stroke="#9CA3AF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Data="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/>
                                        </Canvas>
                                    </Viewbox>
                                    <Border x:Name="SpaceOrdersBadge" Background="#C5A059" CornerRadius="8" Padding="4,1"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0" Visibility="Collapsed">
                                        <TextBlock x:Name="SpaceOrdersBadgeTxt" Text="0" Foreground="#111827" FontSize="9" FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- 10. Dateiverwaltung (Workspace) -->
                    <Button x:Name="SpaceFilesBtn" Click="SwitchSpace_Click" Tag="files" ToolTip="Dateiverwaltung"
                            Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,8" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid Width="42" Height="42">
                                    <Border x:Name="SpaceFilesBg" Background="Transparent" CornerRadius="11"/>
                                    <Viewbox Width="20" Height="20">
                                        <Canvas Width="24" Height="24">
                                            <Path x:Name="SpaceFilesPath" Fill="Transparent" Stroke="#9CA3AF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Data="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/>
                                        </Canvas>
                                    </Viewbox>
                                </Grid>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- 11. Funkira KI-Agent (Integrierter PC-Agent) -->
                    <Button x:Name="SpaceAgentBtn" Click="SwitchSpace_Click" Tag="agent" ToolTip="Funkira KI-Agent (Strg+K)"
                            Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,8" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid Width="42" Height="42">
                                    <Border x:Name="SpaceAgentBg" Background="Transparent" CornerRadius="11"/>
                                    <Viewbox Width="20" Height="20">
                                        <Canvas Width="24" Height="24">
                                            <Path x:Name="SpaceAgentPath" Fill="Transparent" Stroke="#C5A059" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Data="M12 2L14.4 9.6L22 12L14.4 14.4L12 22L9.6 14.4L2 12L9.6 9.6L12 2Z M19 3v4 M17 5h4"/>
                                        </Canvas>
                                    </Viewbox>
                                </Grid>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <!-- Bottom Icon: Settings -->
                <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">

                    <!-- Settings Gear -->
                    <Button x:Name="SpaceSettingsBtn" Click="OpenSettings_Click" ToolTip="Funkenwerk API &amp; Einstellungen"
                            Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="SetBorder" Width="42" Height="42" Background="Transparent" CornerRadius="11">
                                    <Viewbox Width="20" Height="20">
                                        <Canvas Width="24" Height="24">
                                            <Path x:Name="SpaceSettingsPath" Fill="Transparent" Stroke="#9CA3AF" StrokeThickness="2"
                                                  Data="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="SetBorder" Property="Background" Value="#22888888"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- ========================================================================= -->
        <!-- COLUMN 1: MODULE VIEWS                                                    -->
        <!-- ========================================================================= -->
        <Grid Grid.Row="1" Grid.Column="1">

            <!-- ===================================================================== -->
            <!-- MODULE 0: CLEAN-DESIGN KACHEL-DECK (MODULAR LAUNCHER & FUZZY SEARCH)  -->
            <!-- ===================================================================== -->
            <Grid x:Name="LauncherViewGrid" Visibility="Visible" Background="#0F1117">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Centered Intelligent Search Bar (No subtexts, crisp Clean-Design) -->
                <Border x:Name="LauncherSearchBorder" Grid.Row="0" Width="540" HorizontalAlignment="Center" Margin="0,34,0,22"
                        Background="#141720" BorderBrush="#2E3346" BorderThickness="1.2" CornerRadius="14" Padding="16,11">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Viewbox Grid.Column="0" Width="17" Height="17" VerticalAlignment="Center" Margin="0,0,12,0">
                            <Canvas Width="24" Height="24">
                                <Path Stroke="#C5A059" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"
                                      Data="M21 21l-4.35-4.35M19 11a8 8 0 11-16 0 8 8 0 0116 0z"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock x:Name="LauncherSearchPlaceholderTxt" Grid.Column="1" Text="Modul suchen..." Foreground="#6B7280" FontSize="14" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <TextBox x:Name="LauncherSearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="#F9FAFB" CaretBrush="#C5A059" FontSize="14" VerticalContentAlignment="Center"
                                 TextChanged="LauncherSearchBox_TextChanged" PreviewKeyDown="LauncherSearchBox_PreviewKeyDown"/>
                        <Button x:Name="LauncherClearSearchBtn" Grid.Column="2" Click="LauncherClearSearch_Click" Visibility="Collapsed"
                                Background="Transparent" Foreground="#9CA3AF" BorderThickness="0" Padding="6,0" Cursor="Hand" FontSize="13" FontWeight="Bold" Content="✕"/>
                    </Grid>
                </Border>

                <!-- Modular Tile Matrix -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,4,32,32">
                    <Grid HorizontalAlignment="Center" MaxWidth="1160">
                        <WrapPanel x:Name="LauncherTilesWrapPanel" Orientation="Horizontal" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="LauncherEmptyHintTxt" Visibility="Collapsed" Text="Kein Treffer" FontSize="15" FontWeight="SemiBold" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,48,0,0"/>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- ===================================================================== -->
            <!-- MODULE 1: E-MAIL CLIENT (Thunderbird Replacement)                     -->
            <!-- ===================================================================== -->
            <Grid x:Name="MailViewGrid" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="MailColSidebar" Width="275" MinWidth="190" MaxWidth="520"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition x:Name="MailColList" Width="360" MinWidth="240" MaxWidth="680"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*" MinWidth="320"/>
                </Grid.ColumnDefinitions>

                <!-- 1A: Accounts & Folders Sidebar -->
                <Border Grid.Column="0" Background="#13161F" Padding="14,16">
                    <DockPanel LastChildFill="True">
                        <!-- Top Header + KI-Sortierung + Sync + New Mail -->
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Mail" Foreground="#F9FAFB" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button x:Name="MailAiSortBtn" Grid.Column="1" Click="AiSortMails_Click"
                                    ToolTip="✨ KI-Trichter: Alle E-Mails aus 'Alle Posteingänge' verarbeiten (Wichtiges in 'Verarbeitet', Routine ins 'Archiv', Spam aussortieren)"
                                    Background="#1A1710" Foreground="#C5A059" BorderBrush="#4D3D1E" BorderThickness="1" Padding="8,5" Margin="0,0,5,0" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                <TextBlock Text="✨ KI Trichter" FontSize="11" FontWeight="Bold"/>
                            </Button>
                            <Button x:Name="MailSyncBtn" Grid.Column="2" Click="SyncMails_Click" ToolTip="Postfächer synchronisieren (IMAP)"
                                    Background="#161922" Foreground="#E5E7EB" BorderBrush="#262A36" BorderThickness="1" Padding="8,5" Margin="0,0,5,0" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="MailSyncIconTxt" Text="↻" Foreground="#E5E7EB" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                        <TextBlock.RenderTransform>
                                            <RotateTransform x:Name="MailSyncIconRotate" Angle="0"/>
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                    <TextBlock x:Name="MailSyncLabelTxt" Text="Sync" Foreground="#E5E7EB" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="3" Click="OpenCompose_Click" ToolTip="Neue E-Mail verfassen"
                                    Background="#C5A059" Foreground="#111827" BorderThickness="0" Padding="9,5" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                <TextBlock Text="✎ Neu" FontSize="11" FontWeight="Bold"/>
                            </Button>
                        </Grid>

                        <!-- Live IMAP Sync Progress Strip -->
                        <Border x:Name="MailSyncStatusBar" DockPanel.Dock="Top" Visibility="Collapsed"
                                Background="#1A1710" BorderBrush="#4D3D1E" BorderThickness="1" CornerRadius="8" Padding="9,6" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse x:Name="MailSyncStatusDot" Grid.Column="0" Width="6" Height="6" Fill="#C5A059" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock x:Name="MailSyncStatusTxt" Grid.Column="1" Text="Synchronisiere Postfächer..." FontSize="11" FontWeight="SemiBold" Foreground="#C5A059" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="MailSyncTimerTxt" Grid.Column="2" Text="" FontSize="10.5" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </Grid>
                                <ProgressBar x:Name="MailSyncProgressBar" IsIndeterminate="True" Height="2.5" Background="#262A36" Foreground="#C5A059" BorderThickness="0" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Bottom Add Custom Folder Bar -->
                        <Border DockPanel.Dock="Bottom" BorderBrush="#1E222D" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#181B24" BorderBrush="#262A36" BorderThickness="1" CornerRadius="8" Padding="8,5">
                                    <TextBox x:Name="NewMailFolderInput" Background="Transparent" BorderThickness="0" Foreground="#F3F4F6"
                                             CaretBrush="#C5A059" FontSize="12" KeyDown="NewMailFolderInput_KeyDown"
                                             Tag="Neuer Ordner..."/>
                                </Border>
                                <Button Grid.Column="1" Click="CreateMailFolder_Click" Background="#1F2430" Foreground="#C5A059"
                                        BorderThickness="0" Padding="10,5" Margin="6,0,0,0" Cursor="Hand" FontWeight="Bold" Content="+">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Accounts & Folders Tree (Supports Drag & Drop of Accounts, Folders, and Mails!) -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <StackPanel x:Name="MailAccountsPanel" Margin="0,2,4,2"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Resizable Splitter 1 -->
                <GridSplitter Grid.Column="1" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" DragCompleted="Splitter_DragCompleted"/>

                <!-- 1B: Message List Column -->
                <Border Grid.Column="2" Background="#0F1117" Padding="14,16">
                    <DockPanel LastChildFill="True">
                        <!-- Folder Title & Filter -->
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBox x:Name="ActiveFolderTitle" Style="{StaticResource SelectableHeaderTextBox}" Text="Posteingang" Foreground="#F9FAFB" FontSize="17" FontWeight="Bold" TextWrapping="Wrap"/>
                                    <TextBox x:Name="ActiveAccountSubtitle" Style="{StaticResource SelectableHeaderTextBox}" Text="kontakt@mein-seelenfunke.de" Foreground="#9CA3AF" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button x:Name="UnreadFilterBtn" Grid.Column="1" Click="ToggleUnreadFilter_Click"
                                        Background="#181B24" Foreground="#9CA3AF" BorderThickness="0" Padding="9,5" VerticalAlignment="Center" Cursor="Hand">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                    <TextBlock x:Name="UnreadFilterTxt" Text="Alle Mails" FontSize="11" FontWeight="SemiBold"/>
                                </Button>
                            </Grid>

                            <!-- Search Mail Input -->
                            <Border Background="#181B24" BorderBrush="#262A36" BorderThickness="1" CornerRadius="10" Padding="10,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🔍" Foreground="#6B7280" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBox x:Name="MailSearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                             Foreground="#F3F4F6" CaretBrush="#C5A059" FontSize="12.5" VerticalContentAlignment="Center"
                                             KeyDown="MailSearchBox_KeyDown"/>
                                    <TextBlock x:Name="MailSearchPlaceholder" Grid.Column="1" Text="E-Mails &amp; Papierkorb durchsuchen (Enter)..."
                                               Foreground="#6B7280" FontSize="12.5" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                </Grid>
                            </Border>

                            <!-- Funnel Category & Importance Filter Pills (Visible in "Verarbeitet") -->
                            <WrapPanel x:Name="MailFunnelFilterPanel" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed"/>
                        </StackPanel>

                        <!-- Messages List (Supports Right-Click ContextMenu & Drag-and-Drop!) -->
                        <ScrollViewer x:Name="MailMessagesScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <StackPanel x:Name="MailMessagesPanel" Margin="0,0,4,0" Focusable="True" FocusVisualStyle="{x:Null}"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Resizable Splitter 2 -->
                <GridSplitter Grid.Column="3" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" DragCompleted="Splitter_DragCompleted"/>

                <!-- 1C: Message Reading Pane -->
                <Border Grid.Column="4" Background="#0B0D12" Padding="24,20">
                    <Grid>
                        <!-- Empty State when no message selected -->
                        <StackPanel x:Name="MailEmptyReader" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border Width="68" Height="68" CornerRadius="18" Background="#161922" BorderBrush="#262A36" BorderThickness="1" Margin="0,0,0,12">
                                <Image Source="pack://application:,,,/funkenwerk.png" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Keine E-Mail ausgewählt" Foreground="#E5E7EB" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Wähle links eine Nachricht aus oder nutze den Ordner '✨ Verarbeitet' für den Gesamtüberblick." Foreground="#6B7280" FontSize="12.5" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Active Message Reader -->
                        <DockPanel x:Name="MailActiveReader" Visibility="Collapsed" LastChildFill="True">
                            <!-- Action Toolbar -->
                            <Border DockPanel.Dock="Top" Background="#13161F" BorderBrush="#1E222D" BorderThickness="1" CornerRadius="12" Padding="12,8" Margin="0,0,0,16">
                                <WrapPanel Orientation="Horizontal">
                                    <Button x:Name="EditDraftActionBtn" Click="EditDraft_Click" Visibility="Collapsed" Background="#C5A059" Foreground="#111827" BorderThickness="0" Padding="11,6" Margin="0,0,6,0" Cursor="Hand">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                        <TextBlock Text="✎ Entwurf weiterbearbeiten" FontSize="12" FontWeight="Bold"/>
                                    </Button>
                                    <Button x:Name="ReplyMailActionBtn" Click="ReplyMail_Click" Background="#1F2430" Foreground="#F3F4F6" BorderThickness="0" Padding="10,6" Margin="0,0,6,0" Cursor="Hand">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                        <TextBlock Text="↩ Antworten" FontSize="12" FontWeight="SemiBold"/>
                                    </Button>
                                    <Button Click="ForwardMail_Click" Background="#1F2430" Foreground="#F3F4F6" BorderThickness="0" Padding="10,6" Margin="0,0,6,0" Cursor="Hand">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                        <TextBlock Text="↪ Weiterleiten" FontSize="12" FontWeight="SemiBold"/>
                                    </Button>
                                    <Button Click="ArchiveMail_Click" Background="#1F2430" Foreground="#C5A059" BorderThickness="0" Padding="10,6" Margin="0,0,6,0" Cursor="Hand" ToolTip="E-Mail kategorisiert ins Archiv legen">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                        <TextBlock Text="📦 Ins Archiv" FontSize="12" FontWeight="SemiBold"/>
                                    </Button>
                                    <Button x:Name="ToggleImportantActionBtn" Click="ToggleMailImportant_Click" Background="#3A181E" Foreground="#F87171" BorderThickness="0" Padding="10,6" Margin="0,0,6,0" Cursor="Hand">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                        <TextBlock x:Name="ToggleImportantActionBtnTxt" Text="🔴 Als Wichtig markieren" FontSize="12" FontWeight="Bold"/>
                                    </Button>
                                    <Button Click="CreateContactFromMail_Click" Background="#182232" Foreground="#60A5FA" BorderThickness="0" Padding="10,6" Margin="0,0,6,0" Cursor="Hand">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                        <TextBlock Text="👤 Kontakt speichern" FontSize="12" FontWeight="SemiBold"/>
                                    </Button>
                                    <Button x:Name="SpamActionBtn" Click="SpamMail_Click" Background="#2A1E17" Foreground="#F59E0B" BorderThickness="0" Padding="10,6" Margin="0,0,6,0" Cursor="Hand" ToolTip="Absender auf Spam-Regel setzen &amp; in Spam verschieben (keine Löschung)">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                        <TextBlock x:Name="SpamActionBtnTxt" Text="🛡 Spam" FontSize="12" FontWeight="SemiBold"/>
                                    </Button>
                                    <Button x:Name="ReaderViewModeToggleBtn" Click="ToggleMailReaderViewMode_Click" Background="#1F2430" Foreground="#D1D5DB" BorderThickness="0" Padding="10,6" Margin="0,0,6,0" Cursor="Hand" ToolTip="Zwischen schicker Original-Ansicht und reiner Text-Ansicht wechseln">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                        <TextBlock x:Name="ReaderViewModeToggleTxt" Text="📄 Nur Text" FontSize="12" FontWeight="SemiBold"/>
                                    </Button>
                                    <Button Click="DeleteMail_Click" Visibility="Collapsed" Background="#2D161B" Foreground="#F87171" BorderThickness="0" Padding="10,6" Cursor="Hand">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                        <TextBlock Text="📦 Archivieren" FontSize="12" FontWeight="SemiBold"/>
                                    </Button>
                                </WrapPanel>
                            </Border>

                            <!-- Wichtig Action Hint Callout Banner (Visible when viewing a Wichtig mail) -->
                            <Border x:Name="ReaderActionHintBorder" DockPanel.Dock="Top" Visibility="Collapsed"
                                    Background="#2A1216" BorderBrush="#EF4444" BorderThickness="1.5" CornerRadius="12" Padding="14,11" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="🔴 WICHTIG · HANDLUNGSBEDARF" Foreground="#FCA5A5" FontSize="10.5" FontWeight="Bold" Margin="0,0,0,3"/>
                                        <TextBox x:Name="ReaderActionHintTxt" Style="{StaticResource SelectableHeaderTextBox}" Text="Was ist zu tun?" Foreground="#F9FAFB" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Click="ResolveImportantMail_Click" Background="#10B981" Foreground="#06281E"
                                            BorderThickness="0" Padding="12,7" Margin="12,0,0,0" VerticalAlignment="Center" Cursor="Hand"
                                            ToolTip="Markiert diese Aufgabe als erledigt und verschiebt die E-Mail automatisch ins Archiv">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                        <TextBlock Text="✓ Erledigt (→ Archiv)" FontSize="12" FontWeight="Bold"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Subject & Sender Header -->
                            <Border DockPanel.Dock="Top" BorderBrush="#1E222D" BorderThickness="0,0,0,1" Padding="0,0,0,14" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBox x:Name="ReaderSubjectTxt" Style="{StaticResource SelectableHeaderTextBox}" Text="Betreff" Foreground="#F9FAFB" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="38" Height="38" CornerRadius="19" Background="#26231F" BorderBrush="#C5A059" BorderThickness="1" HorizontalAlignment="Left" ClipToBounds="True">
                                            <Grid>
                                                <TextBlock x:Name="ReaderAvatarTxt" Text="A" Foreground="#C5A059" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Ellipse x:Name="ReaderAvatarEllipse" Width="36" Height="36" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                                            <TextBox x:Name="ReaderFromNameTxt" Style="{StaticResource SelectableHeaderTextBox}" Text="Absender" Foreground="#F3F4F6" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBox x:Name="ReaderFromEmailTxt" Style="{StaticResource SelectableHeaderTextBox}" Text="from@example.com" Foreground="#9CA3AF" FontSize="11.5" TextWrapping="Wrap"/>
                                            <TextBox x:Name="ReaderCcBccTxt" Style="{StaticResource SelectableHeaderTextBox}" Text="" Foreground="#C5A059" FontSize="11" Margin="0,2,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <TextBox x:Name="ReaderDateTxt" Style="{StaticResource SelectableHeaderTextBox}" Grid.Column="2" Text="04.11.2026 14:30" Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Top"/>
                                    </Grid>

                                    <!-- Attachments Chip Row -->
                                    <WrapPanel x:Name="ReaderAttachmentsPanel" Orientation="Horizontal" Margin="0,10,0,0" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>

                            <!-- Message Body (Hardened Stylish HTML WebView2 + Safe RichTextBox Fallback) -->
                            <Border x:Name="ReaderBodyOuterBorder" Background="#13161F" BorderBrush="#1E222D" BorderThickness="1" CornerRadius="14" Padding="0" ClipToBounds="True">
                                <Grid>
                                    <RichTextBox x:Name="ReaderBodyRichBox" IsReadOnly="True" IsDocumentEnabled="True" IsReadOnlyCaretVisible="False"
                                                 Background="Transparent" BorderThickness="0" Foreground="#F3F4F6" FontSize="14" Padding="20,18"
                                                 SelectionBrush="#66C5A059" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
                                    <Border x:Name="ReaderBodyWebViewHost" Visibility="Collapsed" Background="Transparent" ClipToBounds="True"/>
                                    <TextBox x:Name="ReaderBodyTxt" Visibility="Collapsed" IsReadOnly="True" Background="Transparent" BorderThickness="0"/>
                                </Grid>
                            </Border>
                        </DockPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===================================================================== -->
            <!-- MODULE 2: ADRESSBUCH (Contacts)                                       -->
            <!-- ===================================================================== -->
            <Grid x:Name="ContactsViewGrid" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ContactsColSidebar" Width="350" MinWidth="220" MaxWidth="620"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*" MinWidth="320"/>
                </Grid.ColumnDefinitions>

                <!-- Left List -->
                <Border Grid.Column="0" Background="#13161F" Padding="16,18">
                    <DockPanel LastChildFill="True">
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource SelectableHeaderTextBox}" Text="Adressbuch" Foreground="#F9FAFB" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Click="NewContact_Click" Background="#C5A059" Foreground="#111827" BorderThickness="0" Padding="12,6" Cursor="Hand" FontWeight="Bold" Content="+ Kontakt">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                            </Button>
                        </Grid>

                        <Border DockPanel.Dock="Top" Background="#181B24" BorderBrush="#262A36" BorderThickness="1" CornerRadius="10" Padding="10,7" Margin="0,0,0,12">
                            <TextBox x:Name="ContactSearchBox" Background="Transparent" BorderThickness="0" Foreground="#F3F4F6" CaretBrush="#C5A059" FontSize="12.5" TextChanged="ContactSearchBox_TextChanged"/>
                        </Border>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ContactsListPanel" Margin="0,0,4,0"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Resizable Splitter -->
                <GridSplitter Grid.Column="1" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" DragCompleted="Splitter_DragCompleted"/>

                <!-- Right Contact Detail / Editor -->
                <Border Grid.Column="2" Background="#0F1117" Padding="32,24">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ContactDetailPanel" MaxWidth="620" HorizontalAlignment="Left">
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Circular Contact Profile Photo + Favorite Star Badge -->
                                <Grid Width="74" Height="74" Margin="0,0,18,0" VerticalAlignment="Center">
                                    <Border x:Name="ContactDetailAvatarHost" Width="70" Height="70" CornerRadius="35"
                                            Background="#232734" BorderBrush="#C5A059" BorderThickness="1.5"
                                            HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="Hand" AllowDrop="True"
                                            MouseLeftButtonUp="ContactDetailAvatar_Click" Drop="ContactDetailAvatar_Drop"
                                            ToolTip="Profilbild ändern (Klicken oder Bilddatei hineinziehen)">
                                        <Grid>
                                            <TextBlock x:Name="ContactDetailAvatarInitialsTxt" Text="+" Foreground="#C5A059" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Ellipse x:Name="ContactDetailAvatarEllipse" Width="67" Height="67" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Grid>
                                    </Border>
                                    <Button x:Name="ContactDetailFavBtn" Width="24" Height="24" Padding="0"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="Hand"
                                            Background="#181B24" BorderBrush="#2E3545" BorderThickness="1"
                                            Click="ContactDetailFavorite_Click" ToolTip="Favorit umschalten">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="12"/></Style></Button.Resources>
                                        <TextBlock x:Name="ContactDetailFavStarTxt" Text="★" FontSize="12.5" Foreground="#6B7280" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                </Grid>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBox x:Name="ContactFormHeader" Style="{StaticResource SelectableHeaderTextBox}" Text="Kontakt bearbeiten" Foreground="#F9FAFB" FontSize="23" FontWeight="Bold" TextWrapping="Wrap"/>
                                    <Border x:Name="ContactDetailRoleBadge" Visibility="Collapsed" Background="#181B24" BorderBrush="#262A36" BorderThickness="1" CornerRadius="10" Padding="10,3" Margin="0,6,0,0" HorizontalAlignment="Left">
                                        <TextBlock x:Name="ContactDetailRoleBadgeTxt" Text="" Foreground="#D1D5DB" FontSize="12" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,0,12">
                                    <TextBlock Text="VORNAME *" Foreground="#9CA3AF" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBox x:Name="ContactFirstNameInput" Background="#181B24" Foreground="#F9FAFB" BorderBrush="#262A36" Padding="10,8" FontSize="13.5"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,0,12">
                                    <TextBlock Text="NACHNAME" Foreground="#9CA3AF" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBox x:Name="ContactLastNameInput" Background="#181B24" Foreground="#F9FAFB" BorderBrush="#262A36" Padding="10,8" FontSize="13.5"/>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,0,12">
                                    <TextBlock Text="FIRMA / ORGANISATION" Foreground="#9CA3AF" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBox x:Name="ContactCompanyInput" Background="#181B24" Foreground="#F9FAFB" BorderBrush="#262A36" Padding="10,8" FontSize="13.5"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,0,12">
                                    <TextBlock Text="KATEGORIE / ROLLE" Foreground="#9CA3AF" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBox x:Name="ContactRoleInput" Background="#181B24" Foreground="#F9FAFB" BorderBrush="#262A36" Padding="10,8" FontSize="13.5"/>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,0,12">
                                    <TextBlock Text="E-MAIL ADRESSE" Foreground="#9CA3AF" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBox x:Name="ContactEmailInput" Background="#181B24" Foreground="#F9FAFB" BorderBrush="#262A36" Padding="10,8" FontSize="13.5"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,0,12">
                                    <TextBlock Text="TELEFON / MOBIL" Foreground="#9CA3AF" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBox x:Name="ContactPhoneInput" Background="#181B24" Foreground="#F9FAFB" BorderBrush="#262A36" Padding="10,8" FontSize="13.5"/>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="2*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,0,12">
                                    <TextBlock Text="STRASSE &amp; HAUSNR." Foreground="#9CA3AF" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBox x:Name="ContactStreetInput" Background="#181B24" Foreground="#F9FAFB" BorderBrush="#262A36" Padding="10,8" FontSize="13.5"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,0,12">
                                    <TextBlock Text="PLZ" Foreground="#9CA3AF" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBox x:Name="ContactPostalInput" Background="#181B24" Foreground="#F9FAFB" BorderBrush="#262A36" Padding="10,8" FontSize="13.5"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4" Margin="0,0,0,12">
                                    <TextBlock Text="ORT" Foreground="#9CA3AF" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBox x:Name="ContactCityInput" Background="#181B24" Foreground="#F9FAFB" BorderBrush="#262A36" Padding="10,8" FontSize="13.5"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="NOTIZEN / KI-KONTEXT" Foreground="#9CA3AF" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                                <TextBox x:Name="ContactNotesInput" Background="#181B24" Foreground="#F9FAFB" BorderBrush="#262A36" Padding="10,8" FontSize="13" Height="100" AcceptsReturn="True" TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <Button Click="SaveContact_Click" Background="#C5A059" Foreground="#111827" BorderThickness="0" Padding="18,10" Margin="0,0,10,0" Cursor="Hand" FontWeight="Bold" Content="Kontakt speichern">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                                </Button>
                                <Button Click="WriteMailToContact_Click" Background="#1F2430" Foreground="#F3F4F6" BorderThickness="0" Padding="16,10" Margin="0,0,10,0" Cursor="Hand" FontWeight="SemiBold" Content="✉ E-Mail schreiben">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                                </Button>
                                <Button Click="DeleteContact_Click" Background="#2D161B" Foreground="#F87171" BorderThickness="0" Padding="16,10" Cursor="Hand" FontWeight="SemiBold" Content="🗑 Löschen">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ===================================================================== -->
            <!-- MODULE 3: KALENDER (Full Suite matching /admin/calender)              -->
            <!-- ===================================================================== -->
            <Grid x:Name="CalendarViewGrid" Visibility="Collapsed" Background="#0F1117">
                <!-- MAIN CALENDAR VIEW -->
                <DockPanel x:Name="CalendarMainPanel" LastChildFill="True">
                    <!-- 1. TOP HEADER BAR -->
                    <Border DockPanel.Dock="Top" Background="#13161F" BorderBrush="#1E222D" BorderThickness="0,0,0,1" Padding="26,18">
                        <StackPanel>
                            <!-- Row 1: Title, KW Badge & Primary Actions -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBox x:Name="CalendarHeaderTitleTxt" Style="{StaticResource SelectableHeaderTextBox}" Text="November 2026" Foreground="#F9FAFB" FontSize="28" FontWeight="Bold"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                                        <Border Background="#26231F" BorderBrush="#4D3D1E" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="0,0,10,0">
                                            <TextBlock x:Name="CalendarKwBadgeTxt" Text="KW 45" Foreground="#C5A059" FontSize="10.5" FontWeight="Bold"/>
                                        </Border>
                                        <TextBox x:Name="CalendarSubtitleTxt" Style="{StaticResource SelectableHeaderTextBox}" Text="ZENTRALE ZEITVERWALTUNG · DOPPELKLICK ZUM ANLEGEN · DRAG &amp; DROP ZUM VERSCHIEBEN"
                                                 Foreground="#9CA3AF" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Click="ImportCalendarIcs_Click" Background="#181B24" Foreground="#D1D5DB" BorderBrush="#262A36" BorderThickness="1"
                                            Padding="14,9" Margin="0,0,10,0" Cursor="Hand" ToolTip="ICS Kalenderdatei (.ics) importieren">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="12"/></Style></Button.Resources>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⬆" Foreground="#C5A059" FontSize="12" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="IMPORT (.ICS)" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Click="NewCalendarEvent_Click" Background="#C5A059" Foreground="#111827" BorderThickness="0"
                                            Padding="18,9" Cursor="Hand" ToolTip="Neuen Termin anlegen (oder Doppelklick direkt im Kalender)">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="12"/></Style></Button.Resources>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="＋" Foreground="#111827" FontSize="13" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="NEUER EINTRAG" Foreground="#111827" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Row 2: Prev/Today/Next Navigation + 6-Mode View Switcher -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Date Stepper Pill -->
                                <Border Grid.Column="0" Background="#181B24" BorderBrush="#242936" BorderThickness="1" CornerRadius="12" Padding="4">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Click="CalendarPrev_Click" Background="Transparent" Foreground="#9CA3AF" BorderThickness="0" Padding="11,6" Cursor="Hand" ToolTip="Zurück">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                            <TextBlock Text="◀" FontSize="11" FontWeight="Bold"/>
                                        </Button>
                                        <Button Click="CalendarToday_Click" Background="#13161F" Foreground="#F9FAFB" BorderBrush="#262A36" BorderThickness="1" Padding="16,6" Margin="4,0" Cursor="Hand" ToolTip="Zu Heute springen">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                            <TextBlock Text="HEUTE" FontSize="10.5" FontWeight="Bold"/>
                                        </Button>
                                        <Button Click="CalendarNext_Click" Background="Transparent" Foreground="#9CA3AF" BorderThickness="0" Padding="11,6" Cursor="Hand" ToolTip="Weiter">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                            <TextBlock Text="▶" FontSize="11" FontWeight="Bold"/>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- 6 View Modes Segmented Control (Jahr, Monat, 4-W, Woche, Tag, Liste) -->
                                <Border Grid.Column="2" Background="#181B24" BorderBrush="#242936" BorderThickness="1" CornerRadius="12" Padding="4">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="CalViewBtnYear" Tag="year" Click="CalendarSwitchView_Click" Background="Transparent" Foreground="#9CA3AF" BorderThickness="0" Padding="14,6" Margin="0,0,2,0" Cursor="Hand">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                            <TextBlock x:Name="CalViewTxtYear" Text="JAHR" FontSize="10.5" FontWeight="Bold"/>
                                        </Button>
                                        <Button x:Name="CalViewBtnMonth" Tag="month" Click="CalendarSwitchView_Click" Background="#C5A059" Foreground="#111827" BorderThickness="0" Padding="14,6" Margin="0,0,2,0" Cursor="Hand">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                            <TextBlock x:Name="CalViewTxtMonth" Text="MONAT" Foreground="#111827" FontSize="10.5" FontWeight="Bold"/>
                                        </Button>
                                        <Button x:Name="CalViewBtnMultiWeek" Tag="multi-week" Click="CalendarSwitchView_Click" Background="Transparent" Foreground="#9CA3AF" BorderThickness="0" Padding="14,6" Margin="0,0,2,0" Cursor="Hand">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                            <TextBlock x:Name="CalViewTxtMultiWeek" Text="4-W" FontSize="10.5" FontWeight="Bold"/>
                                        </Button>
                                        <Button x:Name="CalViewBtnWeek" Tag="week" Click="CalendarSwitchView_Click" Background="Transparent" Foreground="#9CA3AF" BorderThickness="0" Padding="14,6" Margin="0,0,2,0" Cursor="Hand">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                            <TextBlock x:Name="CalViewTxtWeek" Text="WOCHE" FontSize="10.5" FontWeight="Bold"/>
                                        </Button>
                                        <Button x:Name="CalViewBtnDay" Tag="day" Click="CalendarSwitchView_Click" Background="Transparent" Foreground="#9CA3AF" BorderThickness="0" Padding="14,6" Margin="0,0,2,0" Cursor="Hand">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                            <TextBlock x:Name="CalViewTxtDay" Text="TAG" FontSize="10.5" FontWeight="Bold"/>
                                        </Button>
                                        <Button x:Name="CalViewBtnList" Tag="list" Click="CalendarSwitchView_Click" Background="Transparent" Foreground="#9CA3AF" BorderThickness="0" Padding="14,6" Cursor="Hand">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                            <TextBlock x:Name="CalViewTxtList" Text="LISTE" FontSize="10.5" FontWeight="Bold"/>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Quick Search / Filter in Calendar -->
                                <Border Grid.Column="4" Width="230" Background="#181B24" BorderBrush="#242936" BorderThickness="1" CornerRadius="10" Padding="10,5" VerticalAlignment="Center">
                                    <Grid>
                                        <TextBlock x:Name="CalendarSearchPlaceholder" Text="🔍 Termine filtern..." Foreground="#6B7280" FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                        <TextBox x:Name="CalendarSearchBox" Background="Transparent" Foreground="#F3F4F6" BorderThickness="0" FontSize="12" VerticalAlignment="Center" TextChanged="CalendarSearchBox_TextChanged"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 2. FEEDBACK BANNER -->
                    <Border x:Name="CalendarFeedbackBanner" DockPanel.Dock="Top" Visibility="Collapsed" Background="#142921" BorderBrush="#047857" BorderThickness="0,0,0,1" Padding="16,8">
                        <TextBlock x:Name="CalendarFeedbackTxt" Text="✓ Termin gespeichert." Foreground="#34D399" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- 3. DYNAMIC CALENDAR VIEWPORT -->
                    <Grid x:Name="CalendarViewportHost" Background="#0F1117"/>
                </DockPanel>

                <!-- FULL-FEATURED EVENT EDITOR VIEW (Matching /admin/calender Editor) -->
                <Border x:Name="CalendarEditorOverlay" Visibility="Collapsed" Background="#0F1117" Padding="32,24">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel MaxWidth="780" HorizontalAlignment="Center" Width="740">
                            <!-- Editor Header -->
                            <Border BorderBrush="#1E222D" BorderThickness="0,0,0,1" Padding="0,0,0,18" Margin="0,0,0,22">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" Click="CloseCalendarEditor_Click" Background="#181B24" Foreground="#D1D5DB" BorderBrush="#262A36" BorderThickness="1" Padding="12,8" Margin="0,0,14,0" Cursor="Hand">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                                        <TextBlock Text="◀ Zurück" FontSize="12.5" FontWeight="Bold"/>
                                    </Button>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📅" Foreground="#C5A059" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock x:Name="EventFormHeader" Text="Neuer Termin" Foreground="#F9FAFB" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button x:Name="CalendarDeleteEventBtn" Click="DeleteCalendarEvent_Click" Background="#2D161B" Foreground="#F87171" BorderBrush="#7F1D1D" BorderThickness="1" Padding="14,8" Cursor="Hand" Visibility="Collapsed">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                                            <TextBlock Text="🗑 Löschen" FontSize="12.5" FontWeight="Bold"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Titel -->
                            <StackPanel Margin="0,0,0,18">
                                <TextBlock Text="WAS STEHT AN? *" Foreground="#9CA3AF" FontSize="10.5" FontWeight="Bold" Margin="2,0,0,6"/>
                                <TextBox x:Name="EventTitleInput" Background="#13161F" Foreground="#F9FAFB" BorderBrush="#262A36" Padding="14,12" FontSize="15" FontWeight="Bold"/>
                            </StackPanel>

                            <!-- Kategorie, Erinnerung & Priorität (3 Columns) -->
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="KATEGORIE" Foreground="#9CA3AF" FontSize="10.5" FontWeight="Bold" Margin="2,0,0,6"/>
                                    <ComboBox x:Name="EventCategoryCombo" SelectedValuePath="Tag" Padding="10,9" FontSize="13" FontWeight="SemiBold">
                                        <ComboBoxItem Tag="general" Content="📅 Termin (Allgemein)" IsSelected="True"/>
                                        <ComboBoxItem Tag="project" Content="💼 Projekte"/>
                                        <ComboBoxItem Tag="meeting" Content="👥 Besprechung"/>
                                        <ComboBoxItem Tag="call" Content="📞 Anrufe"/>
                                        <ComboBoxItem Tag="customer" Content="👤 Kunde"/>
                                        <ComboBoxItem Tag="travel" Content="🌍 Reise"/>
                                        <ComboBoxItem Tag="vacation" Content="☀ Feiertage / Urlaub"/>
                                        <ComboBoxItem Tag="birthday" Content="🎂 Geburtstag"/>
                                        <ComboBoxItem Tag="task" Content="📋 Aufgabe"/>
                                        <ComboBoxItem Tag="restmuell" Content="🗑 Restmüll"/>
                                        <ComboBoxItem Tag="altpapier" Content="📰 Papier"/>
                                        <ComboBoxItem Tag="biomuell" Content="🍂 Bio"/>
                                        <ComboBoxItem Tag="gelber_sack" Content="🛍 Gelber Sack"/>
                                        <ComboBoxItem Tag="schadstoffe" Content="⚠ Schadstoffe"/>
                                        <ComboBoxItem Tag="sperrmuell" Content="🚚 Sperrmüll"/>
                                        <ComboBoxItem Tag="gruen" Content="✂ Grünabfall"/>
                                        <ComboBoxItem Tag="baum" Content="🎄 Tannenbaum"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="ERINNERUNG" Foreground="#9CA3AF" FontSize="10.5" FontWeight="Bold" Margin="2,0,0,6"/>
                                    <ComboBox x:Name="EventReminderCombo" SelectedValuePath="Tag" Padding="10,9" FontSize="13" FontWeight="SemiBold">
                                        <ComboBoxItem Tag="" Content="🔕 Aus" IsSelected="True"/>
                                        <ComboBoxItem Tag="0" Content="🔔 Pünktlich"/>
                                        <ComboBoxItem Tag="15" Content="🔔 15 Min. vorher"/>
                                        <ComboBoxItem Tag="60" Content="🔔 1 Std. vorher"/>
                                        <ComboBoxItem Tag="1440" Content="🔔 1 Tag vorher"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="PRIORITÄT" Foreground="#9CA3AF" FontSize="10.5" FontWeight="Bold" Margin="2,0,0,6"/>
                                    <ComboBox x:Name="EventPriorityCombo" SelectedValuePath="Tag" Padding="10,9" FontSize="13" FontWeight="SemiBold">
                                        <ComboBoxItem Tag="low" Content="⚪ Niedrig (Standard)" IsSelected="True"/>
                                        <ComboBoxItem Tag="medium" Content="🟡 Mittel (Gelb)"/>
                                        <ComboBoxItem Tag="high" Content="🔴 Wichtig (Rot)"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <!-- Zeitraum Card -->
                            <Border Background="#13161F" BorderBrush="#232734" BorderThickness="1" CornerRadius="16" Padding="20,18" Margin="0,0,0,18">
                                <StackPanel>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="ZEITRAUM" Foreground="#9CA3AF" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <CheckBox x:Name="EventAllDayCheck" Grid.Column="1" Content="Ganztägig" Foreground="#E5E7EB" FontSize="12.5" FontWeight="Bold"
                                                  VerticalAlignment="Center" Cursor="Hand" Checked="EventAllDayCheck_Changed" Unchecked="EventAllDayCheck_Changed"/>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="BEGINN" Foreground="#C5A059" FontSize="10" FontWeight="Bold" Margin="2,0,0,6"/>
                                            <DatePicker x:Name="EventStartDatePicker" Background="#181B24" Foreground="#111827" Padding="6" Margin="0,0,0,8"/>
                                            <Grid x:Name="EventStartTimeRow">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Uhrzeit (HH:mm):" Foreground="#9CA3AF" FontSize="11.5" VerticalAlignment="Center" Margin="2,0,10,0"/>
                                                <TextBox x:Name="EventStartTimeInput" Grid.Column="1" Text="09:00" Background="#181B24" Foreground="#F9FAFB" BorderBrush="#262A36" Padding="10,7" FontSize="13" FontWeight="Bold"/>
                                            </Grid>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="ENDE" Foreground="#C5A059" FontSize="10" FontWeight="Bold" Margin="2,0,0,6"/>
                                            <DatePicker x:Name="EventEndDatePicker" Background="#181B24" Foreground="#111827" Padding="6" Margin="0,0,0,8"/>
                                            <Grid x:Name="EventEndTimeRow">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Uhrzeit (HH:mm):" Foreground="#9CA3AF" FontSize="11.5" VerticalAlignment="Center" Margin="2,0,10,0"/>
                                                <TextBox x:Name="EventEndTimeInput" Grid.Column="1" Text="10:00" Background="#181B24" Foreground="#F9FAFB" BorderBrush="#262A36" Padding="10,7" FontSize="13" FontWeight="Bold"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Wiederholung (Serie) -->
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="WIEDERHOLUNG (SERIE)" Foreground="#9CA3AF" FontSize="10.5" FontWeight="Bold" Margin="2,0,0,6"/>
                                    <ComboBox x:Name="EventRecurrenceCombo" SelectedValuePath="Tag" Padding="10,9" FontSize="13" FontWeight="SemiBold" SelectionChanged="EventRecurrenceCombo_SelectionChanged">
                                        <ComboBoxItem Tag="none" Content="Einmaliger Termin" IsSelected="True"/>
                                        <ComboBoxItem Tag="daily" Content="🔁 Täglich"/>
                                        <ComboBoxItem Tag="weekly" Content="🔁 Wöchentlich"/>
                                        <ComboBoxItem Tag="monthly" Content="🔁 Monatlich"/>
                                        <ComboBoxItem Tag="yearly" Content="🔁 Jährlich"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel x:Name="EventRecurrenceEndPanel" Grid.Column="2" Width="220" Visibility="Collapsed">
                                    <TextBlock Text="SERIE ENDET AM (OPTIONAL)" Foreground="#9CA3AF" FontSize="10.5" FontWeight="Bold" Margin="2,0,0,6"/>
                                    <DatePicker x:Name="EventRecurrenceEndPicker" Background="#181B24" Foreground="#111827" Padding="6"/>
                                </StackPanel>
                            </Grid>

                            <!-- Notizen & Details -->
                            <StackPanel Margin="0,0,0,22">
                                <TextBlock Text="NOTIZEN &amp; DETAILS" Foreground="#9CA3AF" FontSize="10.5" FontWeight="Bold" Margin="2,0,0,6"/>
                                <TextBox x:Name="EventDescInput" Background="#13161F" Foreground="#F9FAFB" BorderBrush="#262A36" Padding="14,10" FontSize="13.5" Height="100" AcceptsReturn="True" TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Footer Buttons -->
                            <Border BorderBrush="#1E222D" BorderThickness="0,1,0,0" Padding="0,18,0,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Click="CloseCalendarEditor_Click" Background="#181B24" Foreground="#D1D5DB" BorderBrush="#262A36" BorderThickness="1" Padding="20,11" Margin="0,0,12,0" Cursor="Hand" FontWeight="SemiBold" Content="Abbrechen">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="12"/></Style></Button.Resources>
                                    </Button>
                                    <Button Click="SaveCalendarEvent_Click" Background="#C5A059" Foreground="#111827" BorderThickness="0" Padding="28,11" Cursor="Hand" FontWeight="Bold" Content="✓ Termin speichern">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="12"/></Style></Button.Resources>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ===================================================================== -->
            <!-- MODULE 4: PERSOENLICHES TICKET-, CHAT-, ESKALATIONS- & ZEIT-SYSTEM     -->
            <!-- ===================================================================== -->
            <Grid x:Name="TodoViewGrid" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="TodoColSidebar" Width="320" MinWidth="230" MaxWidth="560"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*" MinWidth="480"/>
                    <ColumnDefinition x:Name="TodoColSplitterDetail" Width="0"/>
                    <ColumnDefinition x:Name="TodoColDetail" Width="0"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Top = Meine Tickets | Draggable Horizontal Splitter | Bottom = Listen + Neue Liste -->
                <Border Grid.Column="0" Background="#13161F" Padding="12,14">
                    <Grid x:Name="TodoLeftSplitGrid">
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="TodoRowMyTickets" Height="1.15*" MinHeight="145"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition x:Name="TodoRowLists" Height="*" MinHeight="145"/>
                        </Grid.RowDefinitions>

                        <!-- TOP LEFT TILE: MEINE TICKETS (Drag & Drop Ziel, Status bleibt gleich!) -->
                        <Border x:Name="MyTicketsTileBorder" Grid.Row="0" Background="#161922" BorderBrush="#242936" BorderThickness="1" CornerRadius="14" Padding="12,12"
                                AllowDrop="True" DragOver="MyTicketsTile_DragOver" Drop="MyTicketsTile_Drop">
                            <DockPanel LastChildFill="True">
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="8" Height="8" CornerRadius="4" Background="#C5A059" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Meine Tickets" Foreground="#F9FAFB" FontSize="14.5" FontWeight="Bold" VerticalAlignment="Center"
                                                   ToolTip="Ziehe Tickets aus Offene Tickets hierher. Der Status bleibt dabei unveraendert."/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#26231F" BorderBrush="#382D18" BorderThickness="1" CornerRadius="8" Padding="8,2">
                                        <TextBlock x:Name="CountMyTicketsPill" Text="0" Foreground="#C5A059" FontSize="11.5" FontWeight="Bold"/>
                                    </Border>
                                </Grid>

                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="0,0,3,0">
                                        <StackPanel x:Name="MyTicketsPanel"/>
                                        <TextBlock x:Name="MyTicketsEmptyText" Text="Ticket per Drag &amp; Drop hierher ziehen" Foreground="#6B7280" FontSize="12" HorizontalAlignment="Center" Margin="0,24,0,0" Visibility="Collapsed"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <!-- Draggable Horizontal Transition Line (Meine Tickets <-> Listen) -->
                        <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                      Background="#232734" Cursor="SizeNS"
                                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                                      DragCompleted="TodoHorizontalSplitter_DragCompleted"/>

                        <!-- BOTTOM LEFT TILE: LISTEN + NEUE LISTE... -->
                        <Border Grid.Row="2" Background="#161922" BorderBrush="#242936" BorderThickness="1" CornerRadius="14" Padding="12,12">
                            <DockPanel LastChildFill="True">
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Listen" Foreground="#F9FAFB" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="CountAll" Grid.Column="1" Text="" Foreground="#9CA3AF" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Grid>

                                <Border DockPanel.Dock="Bottom" BorderBrush="#232734" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,8,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Background="#1E222D" BorderBrush="#2A2F3D" BorderThickness="1" CornerRadius="9" Padding="9,6">
                                            <Grid>
                                                <TextBox x:Name="NewTodoListBox" Background="Transparent" BorderThickness="0" Foreground="#F3F4F6" CaretBrush="#C5A059" FontSize="12.5" KeyDown="NewTodoListBox_KeyDown" TextChanged="NewTodoListBox_TextChanged"/>
                                                <TextBlock x:Name="NewTodoListPlaceholder" Text="Neue Liste..." Foreground="#6B7280" FontSize="12.5" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                            </Grid>
                                        </Border>
                                        <Border Grid.Column="1" Background="#26231F" BorderBrush="#C5A059" BorderThickness="1" CornerRadius="9" Margin="6,0,0,0">
                                            <Button Click="CreateTodoList_Click" Background="Transparent" Foreground="#C5A059" FontWeight="Bold" FontSize="12" BorderThickness="0" Padding="11,6" Cursor="Hand" Content="Anlegen"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="0,0,3,0">
                                        <Border x:Name="SmartAllBorder" Tag="all" MouseLeftButtonUp="SmartList_Click" CornerRadius="9" Padding="10,7" Margin="0,0,0,2" Background="Transparent" Cursor="Hand">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="☰" Foreground="#C5A059" FontSize="12.5" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="Alle Listen" Foreground="#E5E7EB" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="CountAllRowBadge" Grid.Column="2" Text="" Foreground="#C5A059" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <StackPanel x:Name="CustomTodoListsPanel"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Draggable Vertical Transition Line (Left Column <-> Right Column) -->
                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                              Background="#232734" Cursor="SizeWE"
                              ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                              DragCompleted="TodoVerticalSplitter_DragCompleted"/>

                <!-- Right Main Column: Offene Tickets Inline-Table <-> Ticket-Detail & Chat -->
                <Border x:Name="RightTicketTileBorder" Grid.Column="2" Background="#0F1117" Padding="20,16"
                        AllowDrop="True" DragOver="TicketDetail_DragOver" Drop="TicketDetail_Drop">
                    <Grid>
                        <!-- SUBVIEW A: OFFENE TICKETS INLINE-TABELLE -->
                        <DockPanel x:Name="OpenTicketsSubView" LastChildFill="True"
                                   AllowDrop="True" DragOver="OpenTicketsTile_DragOver" Drop="OpenTicketsTile_Drop">
                            <!-- Top Header + Search + Sound Toggle -->
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="230"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox x:Name="TodoHeaderTitle" Style="{StaticResource SelectableHeaderTextBox}" Text="Offene Tickets" Foreground="#F9FAFB" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TodoHeaderSubtitle" Style="{StaticResource SelectableHeaderTextBox}" Text="" Foreground="#9CA3AF" FontSize="12" Margin="10,4,0,0" Visibility="Collapsed"/>
                                </StackPanel>

                                <Border Grid.Column="1" Background="#161922" BorderBrush="#262A36" BorderThickness="1" CornerRadius="9" Padding="9,5" Margin="10,0,8,0" VerticalAlignment="Center">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="🔍" Foreground="#9CA3AF" FontSize="11.5" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TodoSearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="#F3F4F6" CaretBrush="#C5A059" FontSize="12.5" TextChanged="TodoSearchBox_TextChanged"/>
                                        <TextBlock x:Name="TodoSearchPlaceholder" Grid.Column="1" Text="Tickets suchen..." Foreground="#6B7280" FontSize="12.5" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="2" Background="#161922" BorderBrush="#262A36" BorderThickness="1" CornerRadius="9" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Button x:Name="TodoSoundToggleBtn" Click="ToggleTodoSound_Click" Background="Transparent" Foreground="#C5A059" BorderThickness="0" Padding="9,5" Cursor="Hand" FontSize="13" Content="🔊" ToolTip="Interaktive Klick-Sounds an/aus"/>
                                </Border>

                                <Border Grid.Column="3" Background="#161922" BorderBrush="#262A36" BorderThickness="1" CornerRadius="9" Padding="11,5" VerticalAlignment="Center">
                                    <TextBox x:Name="TodoStatusCounter" Style="{StaticResource SelectableHeaderTextBox}" Text="0 Meine · 0 Offen" Foreground="#D1D5DB" FontSize="12" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>

                            <!-- Quick-Create Bar -->
                            <Border x:Name="TodoBottomInputBorder" DockPanel.Dock="Top" Background="#161922" BorderBrush="#262A36" BorderThickness="1" CornerRadius="12" Padding="12,7" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="+" Foreground="#C5A059" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Grid Grid.Column="1">
                                        <TextBox x:Name="NewTaskBox" Background="Transparent" BorderThickness="0" Foreground="#F9FAFB" CaretBrush="#C5A059" FontSize="13" VerticalContentAlignment="Center" KeyDown="NewTaskBox_KeyDown" TextChanged="NewTaskBox_TextChanged"/>
                                        <TextBlock x:Name="NewTaskPlaceholder" Text="Neues Ticket erfassen..." Foreground="#6B7280" FontSize="13" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                    </Grid>
                                    <Border x:Name="NewTaskAssigneeBorder" Grid.Column="2" Background="#14171F" BorderBrush="#2A2F3D" BorderThickness="1" CornerRadius="8" Margin="8,0,4,0" VerticalAlignment="Center" ToolTip="Bearbeiter auswaehlen (mit Live-Suche)">
                                        <Button x:Name="NewTaskAssigneeBtn" Click="NewTaskAssigneeBtn_Click" Background="Transparent" Foreground="#D1D5DB" BorderThickness="0" Padding="10,5" Cursor="Hand" FontSize="12" FontWeight="SemiBold" Content="👤 Bearbeiter ▾"/>
                                    </Border>
                                    <DatePicker x:Name="NewTaskDatePicker" Grid.Column="3" Width="128" Margin="4,0,4,0" VerticalAlignment="Center" Background="#14171F" Foreground="#111827" BorderThickness="0" ToolTip="Faelligkeitsdatum"/>
                                    <Border Grid.Column="4" Background="#14171F" BorderBrush="#2A2F3D" BorderThickness="1" CornerRadius="8" Padding="6,3" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="Uhrzeit HH:MM (fuer Kalender)">
                                        <TextBox x:Name="NewTaskTimeBox" Width="44" MaxLength="5" Background="Transparent" BorderThickness="0" Foreground="#E5E7EB" CaretBrush="#C5A059" FontSize="12" HorizontalContentAlignment="Center" Text=""/>
                                    </Border>
                                    <Button x:Name="NewTaskImportantBtn" Grid.Column="5" Click="ToggleNewTaskImportant_Click" Background="Transparent" BorderThickness="0" FontSize="17" Foreground="#6B7280" Margin="2,0,8,0" Cursor="Hand" Content="☆" ToolTip="Hohe Prioritaet"/>
                                    <Border Grid.Column="6" Background="#26231F" BorderBrush="#C5A059" BorderThickness="1" CornerRadius="9">
                                        <Button Click="AddTask_Click" Background="Transparent" Foreground="#C5A059" FontWeight="Bold" FontSize="12" BorderThickness="0" Padding="13,5" Cursor="Hand" Content="Anlegen"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Inline-Editable Offene Tickets Table -->
                            <Border Background="#141720" BorderBrush="#242936" BorderThickness="1" CornerRadius="14">
                                <DockPanel LastChildFill="True">
                                    <!-- Table Column Header -->
                                    <Border DockPanel.Dock="Top" Background="#181C27" BorderBrush="#242936" BorderThickness="0,0,0,1" CornerRadius="14,14,0,0" Padding="14,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="154"/>
                                                <ColumnDefinition Width="116"/>
                                                <ColumnDefinition Width="148"/>
                                                <ColumnDefinition Width="68"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="1" Text="TITEL" Foreground="#9CA3AF" FontSize="10.5" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="2" Text="BEARBEITER" Foreground="#9CA3AF" FontSize="10.5" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="3" Text="ERSTELLT AM" Foreground="#9CA3AF" FontSize="10.5" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="4" Text="STATUS" Foreground="#9CA3AF" FontSize="10.5" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="5" Text="CHAT" Foreground="#9CA3AF" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Border>

                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="0,0,0,8">
                                            <StackPanel x:Name="OpenTasksPanel"/>
                                            <TextBlock x:Name="OpenTicketsEmptyText" Text="Keine offenen Tickets in dieser Ansicht" Foreground="#6B7280" FontSize="12.5" HorizontalAlignment="Center" Margin="0,32,0,24" Visibility="Collapsed"/>

                                            <StackPanel x:Name="CompletedSectionWrapper" Margin="14,12,14,4" Visibility="Collapsed">
                                                <Button Click="ToggleCompletedSection_Click" HorizontalAlignment="Left" Background="#1A1E29" Foreground="#34D399" BorderThickness="0" Padding="11,5" Cursor="Hand">
                                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock x:Name="CompletedChevron" Text="▼" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBlock x:Name="CompletedHeaderLabel" Text="Erledigt (0)" FontSize="12" FontWeight="Bold"/>
                                                    </StackPanel>
                                                </Button>
                                                <StackPanel x:Name="CompletedTasksPanel" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </DockPanel>

                        <!-- SUBVIEW B: INLINE TICKET-DETAIL & CHAT (Zurueck oben links, Bearbeiter + Status oben rechts) -->
                        <DockPanel x:Name="TicketDetailSubView" LastChildFill="True" Visibility="Collapsed">
                            <!-- Top Bar: Left = Zurueck | Right = Bearbeiter + Meine Tickets Toggle + Single Status Dropdown + Delete -->
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#181C27" BorderBrush="#2E3446" BorderThickness="1" CornerRadius="9">
                                    <Button Click="CloseTodoDetail_Click" Background="Transparent" Foreground="#F3F4F6" BorderThickness="0" Padding="12,6" Cursor="Hand" FontWeight="Bold" FontSize="12.5" Content="← Zurück"/>
                                </Border>

                                <Border x:Name="DetailAssigneeBorder" Grid.Column="2" Background="#181C27" BorderBrush="#2E3446" BorderThickness="1" CornerRadius="9" Margin="6,0,0,0">
                                    <Button x:Name="DetailAssigneeBtn" Click="DetailAssigneeBtn_Click" Background="Transparent" Foreground="#E5E7EB" BorderThickness="0" Padding="11,6" Cursor="Hand" FontSize="12" FontWeight="SemiBold" Content="👤 Frei ▾" ToolTip="Bearbeiter auswaehlen (mit Live-Suche)"/>
                                </Border>

                                <Border Grid.Column="3" Background="#181C27" BorderBrush="#2E3446" BorderThickness="1" CornerRadius="9" Margin="6,0,0,0">
                                    <Button x:Name="DetailClaimOrReleaseBtn" Click="DetailClaimOrRelease_Click" Background="Transparent" Foreground="#C5A059" BorderThickness="0" Padding="11,6" Cursor="Hand" FontSize="12" FontWeight="SemiBold" Content="In Meine Tickets"/>
                                </Border>

                                <!-- Single Status Dropdown Top-Right (Only status word colored!) -->
                                <Border Grid.Column="4" Background="#181C27" BorderBrush="#2E3446" BorderThickness="1" CornerRadius="9" Padding="4,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <ComboBox x:Name="DetailStatusCombo" Width="152" Background="Transparent" BorderThickness="0" FontSize="12.5" FontWeight="Bold"
                                              SelectionChanged="DetailStatusCombo_SelectionChanged" Cursor="Hand" ToolTip="Ticket-Status aendern">
                                        <ComboBoxItem Tag="open" Content="Offen" Foreground="#F87171" FontWeight="Bold"/>
                                        <ComboBoxItem Tag="waiting" Content="Warten" Foreground="#FACC15" FontWeight="Bold"/>
                                        <ComboBoxItem Tag="in_progress" Content="In Bearbeitung" Foreground="#FB923C" FontWeight="Bold"/>
                                        <ComboBoxItem Tag="completed" Content="Erledigt" Foreground="#34D399" FontWeight="Bold"/>
                                    </ComboBox>
                                </Border>

                                <Border Grid.Column="5" Background="#2D161B" BorderBrush="#7F1D1D" BorderThickness="1" CornerRadius="9" Margin="8,0,0,0">
                                    <Button Click="DeleteSelectedTask_Click" Background="Transparent" Foreground="#F87171" BorderThickness="0" Padding="10,6" Cursor="Hand" FontSize="12" FontWeight="SemiBold" Content="🗑" ToolTip="Ticket loeschen"/>
                                </Border>
                            </Grid>

                            <!-- Compact Ticket Meta Card -->
                            <Border DockPanel.Dock="Top" Background="#161922" BorderBrush="#262B3A" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBox x:Name="DetailTitleBox" Background="Transparent" BorderThickness="0" Foreground="#F9FAFB" CaretBrush="#C5A059" FontSize="15.5" FontWeight="Bold" TextWrapping="Wrap" LostFocus="DetailTitleBox_LostFocus" KeyDown="DetailTitleBox_KeyDown"/>
                                    <WrapPanel Margin="0,8,0,0" VerticalAlignment="Center">
                                        <DatePicker x:Name="DetailDatePicker" SelectedDateChanged="DetailDatePicker_SelectedDateChanged" Width="118" Background="#14171F" Foreground="#111827" BorderThickness="0" Margin="0,0,6,4" ToolTip="Faelligkeitsdatum"/>
                                        <Border Background="#14171F" BorderBrush="#2A2F3D" BorderThickness="1" CornerRadius="7" Padding="6,3" Margin="0,0,6,4" VerticalAlignment="Center" ToolTip="Uhrzeit HH:MM">
                                            <TextBox x:Name="DetailTimeBox" Width="46" MaxLength="5" Background="Transparent" BorderThickness="0" Foreground="#E5E7EB" CaretBrush="#C5A059" FontSize="12" HorizontalContentAlignment="Center" LostFocus="DetailTimeBox_LostFocus" KeyDown="DetailTimeBox_KeyDown"/>
                                        </Border>
                                        <ComboBox x:Name="DetailDurationCombo" Width="78" Margin="0,0,8,4" SelectionChanged="DetailDurationCombo_SelectionChanged" FontSize="11.5" ToolTip="Kalender-Dauer">
                                            <ComboBoxItem Tag="30" Content="30 Min"/>
                                            <ComboBoxItem Tag="45" Content="45 Min"/>
                                            <ComboBoxItem Tag="60" Content="60 Min" IsSelected="True"/>
                                            <ComboBoxItem Tag="90" Content="90 Min"/>
                                            <ComboBoxItem Tag="120" Content="120 Min"/>
                                        </ComboBox>
                                        <ComboBox x:Name="DetailListCombo" Width="165" Margin="0,0,8,4" SelectionChanged="DetailListCombo_SelectionChanged" FontSize="11.5" ToolTip="Liste wechseln"/>
                                        <Button x:Name="ToggleTicketMetaExtrasBtn" Click="ToggleTicketMetaExtras_Click" Background="#14171F" Foreground="#9CA3AF" BorderThickness="0" Padding="10,4" Margin="0,0,0,4" Cursor="Hand">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style></Button.Resources>
                                            <TextBlock x:Name="ToggleTicketMetaExtrasText" Text="▸ Schritte &amp; Beschreibung" FontSize="11.5" FontWeight="SemiBold"/>
                                        </Button>
                                    </WrapPanel>

                                    <StackPanel x:Name="TicketMetaExtrasPanel" Visibility="Collapsed" Margin="0,8,0,0">
                                        <Border Height="1" Background="#262B3A" Margin="0,0,0,8"/>
                                        <StackPanel x:Name="SubtasksPanel"/>
                                        <Grid Margin="0,4,0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="+" Foreground="#C5A059" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <TextBox x:Name="NewSubtaskBox" Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="#F3F4F6" CaretBrush="#C5A059" FontSize="12.5" KeyDown="NewSubtaskBox_KeyDown"/>
                                        </Grid>
                                        <TextBox x:Name="DetailNoteBox" Background="#14171F" BorderBrush="#262B3A" BorderThickness="1" Foreground="#E5E7EB" CaretBrush="#C5A059" FontSize="12.5" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" Padding="8" LostFocus="DetailNoteBox_LostFocus"/>
                                        <TextBlock x:Name="DetailCreatedText" Text="" Foreground="#6B7280" FontSize="10.5" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- MANDATORY ESCALATION RESOLUTION BOX -->
                            <Border x:Name="EscalationGateBorder" DockPanel.Dock="Top" Background="#241317" BorderBrush="#991B1B" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,0,0,8" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock x:Name="EscalationReasonText" Text="⚠ Ticket eskaliert" Foreground="#FCA5A5" FontSize="12.5" FontWeight="Bold" TextWrapping="Wrap"/>
                                    <WrapPanel Margin="0,8,0,6" VerticalAlignment="Center">
                                        <DatePicker x:Name="EscalationDatePicker" Width="122" Background="#14171F" Foreground="#111827" BorderThickness="0" Margin="0,0,6,0"/>
                                        <Border Background="#14171F" BorderBrush="#7F1D1D" BorderThickness="1" CornerRadius="7" Padding="6,3" Margin="0,0,8,0">
                                            <TextBox x:Name="EscalationTimeBox" Width="46" MaxLength="5" Background="Transparent" BorderThickness="0" Foreground="#F3F4F6" CaretBrush="#C5A059" FontSize="12" HorizontalContentAlignment="Center"/>
                                        </Border>
                                        <Border Background="#26231F" BorderBrush="#C5A059" BorderThickness="1" CornerRadius="8">
                                            <Button Click="ResolveEscalation_Click" Background="Transparent" Foreground="#C5A059" BorderThickness="0" Padding="12,5" Cursor="Hand" FontSize="12" FontWeight="Bold" Content="Eskalation auflösen"/>
                                        </Border>
                                    </WrapPanel>
                                    <Border Background="#14171F" BorderBrush="#7F1D1D" BorderThickness="1" CornerRadius="8" Padding="8,6">
                                        <TextBox x:Name="EscalationNoteBox" Background="Transparent" BorderThickness="0" Foreground="#F9FAFB" CaretBrush="#C5A059" FontSize="12.5" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="36"/>
                                    </Border>
                                    <TextBlock x:Name="EscalationErrorText" Text="" Foreground="#FCA5A5" FontSize="11.5" Margin="0,4,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Bottom Chat Composer (Multi-Upload + Drag & Drop) -->
                            <Border DockPanel.Dock="Bottom" Background="#161922" BorderBrush="#2A2F3D" BorderThickness="1" CornerRadius="12" Padding="10,8" Margin="0,8,0,0">
                                <StackPanel>
                                    <WrapPanel x:Name="PendingChatFilesWrapPanel" Margin="0,0,0,6" Visibility="Collapsed"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="#14171F" BorderBrush="#2A2F3D" BorderThickness="1" CornerRadius="8" Margin="0,0,8,0" VerticalAlignment="Bottom">
                                            <Button Click="AttachChatFiles_Click" Background="Transparent" Foreground="#C5A059" BorderThickness="0" Padding="9,6" Cursor="Hand" FontSize="14" Content="📎" ToolTip="Dateien anhaengen (oder per Drag &amp; Drop hineinziehen)"/>
                                        </Border>
                                        <Border Grid.Column="1" Background="#14171F" BorderBrush="#262B3A" BorderThickness="1" CornerRadius="9" Padding="9,6">
                                            <TextBox x:Name="TicketChatInputBox" Background="Transparent" BorderThickness="0" Foreground="#F9FAFB" CaretBrush="#C5A059" FontSize="13" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="90" KeyDown="TicketChatInputBox_KeyDown"/>
                                        </Border>
                                        <Border Grid.Column="2" Background="#26231F" BorderBrush="#C5A059" BorderThickness="1" CornerRadius="9" Margin="8,0,0,0" VerticalAlignment="Bottom">
                                            <Button Click="SendTicketChat_Click" Background="Transparent" Foreground="#C5A059" BorderThickness="0" Padding="14,7" Cursor="Hand" FontSize="12.5" FontWeight="Bold" Content="Senden"/>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Chronological Ticket-Chat Stream (with 5-min inline edit) -->
                            <Border Background="#10131B" BorderBrush="#202533" BorderThickness="1" CornerRadius="12" Padding="12,10">
                                <ScrollViewer x:Name="TicketChatScrollViewer" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="TicketChatMessagesPanel"/>
                                </ScrollViewer>
                            </Border>
                        </DockPanel>
                    </Grid>
                </Border>

                <!-- Legacy Splitter/Detail placeholders kept collapsed -->
                <GridSplitter x:Name="TodoDetailSplitter" Grid.Column="3" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Visibility="Collapsed" DragCompleted="Splitter_DragCompleted"/>
                <Border x:Name="TodoDetailBorder" Grid.Column="4" Background="#161922" Visibility="Collapsed"/>
            </Grid>

            <!-- ===================================================================== -->
            <!-- MODULE 9: BESTELLUNGEN, LABELDRUCK-WARTESCHLANGE & DIAGNOSE-LOGS      -->
            <!-- ===================================================================== -->
            <Grid x:Name="OrdersViewGrid" Visibility="Collapsed" Background="#0F1117">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top Header Bar -->
                <Border Grid.Row="0" Background="#13161F" BorderBrush="#222634" BorderThickness="0,0,0,1" Padding="22,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox Style="{StaticResource SelectableHeaderTextBox}" Text="🖨️ Bestellungen &amp; Labeldruck-Warteschlange" Foreground="#F9FAFB" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Border x:Name="OrdersPrinterStatusBadgeBorder" Background="#181C26" BorderBrush="#C5A059" BorderThickness="1" CornerRadius="8" Padding="9,3" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse x:Name="OrdersPrinterStatusDot" Width="8" Height="8" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBox x:Name="OrdersPrinterStatusTxt" Style="{StaticResource SelectableHeaderTextBox}" Text="MUNBYN ITPP941AP (192.168.188.149) · Bereit" Foreground="#F9FAFB" FontSize="11" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <TextBox x:Name="OrdersApiSyncTxt" Style="{StaticResource SelectableHeaderTextBox}" Text="Shop-Bridge aktiv · Prüfe Warteschlange alle 3 Sekunden..." Foreground="#9CA3AF" FontSize="11.5" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="OrdersAutoPrintToggleBtn" Click="OrdersAutoPrintToggle_Click" Background="#C5A059" Foreground="#111827" BorderBrush="#C5A059" BorderThickness="1" Padding="12,7" Margin="0,0,8,0" Cursor="Hand" FontSize="11.5" FontWeight="Bold" Content="⚡ Auto-Print: EIN" ToolTip="Wenn aktiv, werden neue Druckaufträge aus dem Shop automatisch auf dem MUNBYN ausgedruckt">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                            </Button>
                            <Button Click="OrdersRefreshQueue_Click" Background="#1E222D" Foreground="#F9FAFB" BorderBrush="#2D3346" BorderThickness="1" Padding="12,7" Margin="0,0,8,0" Cursor="Hand" FontSize="11.5" FontWeight="Bold" Content="🔄 Jetzt synchronisieren" ToolTip="Warteschlange und Drucker-Status sofort abfragen">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                            </Button>
                            <Button x:Name="OrdersPrintAllPendingBtn" Click="OrdersPrintAllPending_Click" Background="#132226" Foreground="#34D399" BorderBrush="#104E3B" BorderThickness="1" Padding="12,7" Margin="0,0,8,0" Cursor="Hand" FontSize="11.5" FontWeight="Bold" Content="🖨 Alle offenen drucken" ToolTip="Alle wartenden Aufträge jetzt nacheinander drucken">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                            </Button>
                            <Button Click="SmartTestPrintLabel_Click" Background="#1E222D" Foreground="#D4AF37" BorderBrush="#C5A059" BorderThickness="1" Padding="12,7" Margin="0,0,8,0" Cursor="Hand" FontSize="11.5" FontWeight="Bold" Content="🧪 Test-Label" ToolTip="Druckt ein 4×6 Zoll Kalibrierungs-Label und protokolliert jeden Schritt im Diagnose-Log">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                            </Button>
                            <Button Click="OrdersIdentifyBeep_Click" Background="#1E222D" Foreground="#E5E7EB" BorderBrush="#2D3346" BorderThickness="1" Padding="10,7" Margin="0,0,8,0" Cursor="Hand" FontSize="11.5" FontWeight="Bold" Content="🔔 Ping" ToolTip="Lässt den MUNBYN im WLAN piepen (Verbindungstest ohne Papier)">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                            </Button>
                            <Button Click="OrdersClearHistory_Click" Background="#2D161B" Foreground="#F87171" BorderBrush="#7F1D1D" BorderThickness="1" Padding="10,7" Cursor="Hand" FontSize="11.5" FontWeight="Bold" Content="🗑 Verlauf leeren" ToolTip="Erledigte und fehlgeschlagene Aufträge aus der Liste entfernen">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Main Body: Left = Pending Queue + History | Right = Label Preview + Live Diagnostic Log -->
                <Grid Grid.Row="1" Margin="20,16,20,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="460"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT COLUMN: Warteschlange & Verlauf -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,16,0">
                        <StackPanel>
                            <!-- 1. Offene Druck-Warteschlange -->
                            <Border Background="#151822" BorderBrush="#232734" BorderThickness="1" CornerRadius="14" Padding="18,16" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="⏳ AKTIVE DRUCK-WARTESCHLANGE (OFFEN)" Foreground="#D4AF37" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <Border Background="#2A1E17" BorderBrush="#C5A059" BorderThickness="1" CornerRadius="7" Padding="8,2" Margin="10,0,0,0">
                                                <TextBlock x:Name="OrdersPendingCountBadgeTxt" Text="0 offen" Foreground="#FEF3C7" FontSize="10.5" FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="Wird bei aktivem Auto-Print sofort abgearbeitet" Foreground="#6B7280" FontSize="11" VerticalAlignment="Center"/>
                                    </Grid>

                                    <StackPanel x:Name="OrdersPendingListPanel"/>
                                </StackPanel>
                            </Border>

                            <!-- 2. Abgeschlossene & Fehlgeschlagene Druckaufträge (mit "Erneut drucken" & "Vorschau") -->
                            <Border Background="#151822" BorderBrush="#232734" BorderThickness="1" CornerRadius="14" Padding="18,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="📋 LETZTE DRUCKAUFTRÄGE &amp; VERLAUF" Foreground="#F9FAFB" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <Border Background="#1E222D" BorderBrush="#2D3346" BorderThickness="1" CornerRadius="7" Padding="8,2" Margin="10,0,0,0">
                                                <TextBlock x:Name="OrdersHistoryCountBadgeTxt" Text="0 Einträge" Foreground="#E5E7EB" FontSize="10.5" FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="Jedes DHL-Label kann hier jederzeit erneut gedruckt werden" Foreground="#6B7280" FontSize="11" VerticalAlignment="Center"/>
                                    </Grid>

                                    <StackPanel x:Name="OrdersHistoryListPanel"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- RIGHT COLUMN: 4x6" Label-Vorschau + Echtzeit-Diagnose-Log -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="320"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Top: Live 4x6" Label Preview -->
                        <Border Grid.Row="0" Background="#151822" BorderBrush="#232734" BorderThickness="1" CornerRadius="14" Padding="14,12" Margin="0,0,0,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="OrdersPreviewTitleTxt" Text="👁 4×6&quot; LABEL-VORSCHAU (203 DPI)" Foreground="#D4AF37" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Button x:Name="OrdersPrintPreviewedJobBtn" Click="OrdersPrintPreviewedJob_Click" Background="#C5A059" Foreground="#111827" BorderBrush="#C5A059" BorderThickness="1" Padding="10,4" Cursor="Hand" FontSize="10.5" FontWeight="Bold" Content="🖨 Dieses Label drucken" Visibility="Collapsed">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                    </Button>
                                </Grid>
                                <Border Grid.Row="1" Background="#0B0D12" BorderBrush="#232836" BorderThickness="1" CornerRadius="10" Padding="8">
                                    <Grid>
                                        <TextBlock x:Name="OrdersPreviewPlaceholderTxt" Text="Klicke bei einem Auftrag auf „👁 Vorschau“ oder starte einen Druck, um das gerenderte 100×150 mm Etikett hier zu prüfen." Foreground="#6B7280" FontSize="11.5" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Width="280"/>
                                        <Image x:Name="OrdersLabelPreviewImg" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Bottom: Live Diagnostic & Printer Log -->
                        <Border Grid.Row="1" Background="#151822" BorderBrush="#232734" BorderThickness="1" CornerRadius="14" Padding="14,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🔍 ECHTZEIT-DIAGNOSE &amp; DRUCK-LOG" Foreground="#F9FAFB" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Click="OrdersCopyLog_Click" Background="#1E222D" Foreground="#E5E7EB" BorderBrush="#2D3346" BorderThickness="1" Padding="8,3" Margin="0,0,6,0" Cursor="Hand" FontSize="10" FontWeight="Bold" Content="📋 Kopieren">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                        </Button>
                                        <Button Click="OrdersClearLog_Click" Background="#1E222D" Foreground="#9CA3AF" BorderBrush="#2D3346" BorderThickness="1" Padding="8,3" Cursor="Hand" FontSize="10" FontWeight="Bold" Content="🧹 Leeren">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <Border Grid.Row="1" Background="#0B0D12" BorderBrush="#232836" BorderThickness="1" CornerRadius="10" Padding="8">
                                    <TextBox x:Name="OrdersDiagnosticLogBox"
                                             IsReadOnly="True"
                                             Background="Transparent"
                                             Foreground="#E5E7EB"
                                             BorderThickness="0"
                                             FontFamily="Consolas"
                                             FontSize="11"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Disabled"
                                             VerticalContentAlignment="Top"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ===================================================================== -->
            <!-- MODULE 10: DATEIVERWALTUNG (CLEAN FUNKENWERK WORKSPACE - ROOT: files) -->
            <!-- ===================================================================== -->
            <Grid x:Name="FilesViewGrid" Visibility="Collapsed" Background="#0F1117"
                  AllowDrop="True" DragOver="FilesView_DragOver" Drop="FilesView_Drop">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ROW 0: DYNAMIC ARCHIVE SOURCE PATH BAR (Default: C:\Users\konta\kDrive\Meine Daten) -->
                <Border Grid.Row="0" Margin="22,18,22,10" Background="#11131A" BorderBrush="#C5A059" BorderThickness="1" CornerRadius="12" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="☁" FontSize="16" Foreground="#C5A059" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="QUELLPFAD" Foreground="#9CA3AF" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Border Grid.Column="1" Background="#181B24" BorderBrush="#262A36" BorderThickness="1" CornerRadius="8" Padding="10,5" Margin="0,0,8,0">
                            <TextBox x:Name="FilesRootPathBox"
                                     Background="Transparent" Foreground="#F9FAFB" CaretBrush="#C5A059"
                                     BorderThickness="0" FontFamily="Consolas" FontSize="12.5" FontWeight="SemiBold"
                                     VerticalContentAlignment="Center"
                                     ToolTip="Zielordner der Dateiverwaltung (Enter zum Uebernehmen)"
                                     KeyDown="FilesRootPathBox_KeyDown"/>
                        </Border>

                        <Button Grid.Column="2" Click="FilesApplyRootPath_Click"
                                Background="#26231F" Foreground="#C5A059" BorderBrush="#C5A059" BorderThickness="1"
                                Height="32" Padding="11,0" Margin="0,0,6,0" Cursor="Hand" FontSize="11.5" FontWeight="Bold"
                                ToolTip="Eingegebenen Pfad laden" Content="✓ Laden">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>

                        <Button Grid.Column="3" Click="FilesBrowseRootFolder_Click"
                                Background="#181B24" Foreground="#F9FAFB" BorderBrush="#262A36" BorderThickness="1"
                                Height="32" Padding="12,0" Margin="0,0,6,0" Cursor="Hand" FontSize="11.5" FontWeight="SemiBold"
                                ToolTip="Beliebigen Ordner auswaehlen (z. B. kDrive, NAS, Mini-PC)" Content="Ordner waehlen...">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>

                        <Button Grid.Column="4" Click="FilesResetDefaultKDrive_Click"
                                Background="#181B24" Foreground="#D1D5DB" BorderBrush="#262A36" BorderThickness="1"
                                Height="32" Padding="10,0" Margin="0,0,8,0" Cursor="Hand" FontSize="11.5" FontWeight="SemiBold"
                                ToolTip="Zurück auf Standard C:\Users\konta\kDrive\Meine Daten" Content="↺ kDrive">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>

                        <Border Grid.Column="5" Background="#26231F" BorderBrush="#242936" BorderThickness="1" CornerRadius="8" Padding="11,5" VerticalAlignment="Center"
                                Cursor="Hand" MouseLeftButtonUp="FilesOpenInExplorer_Click" ToolTip="Aktuellen Ordner im Windows Explorer oeffnen">
                            <TextBlock x:Name="FilesInfoTotalCountTxt" Text="0 Dokumente" Foreground="#C5A059" FontSize="12" FontWeight="Bold"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- ROW 1: FULL-WIDTH DYNAMIC & FUZZY SEARCH BAR (DARKMODE INPUT FIELD) -->
                <Border x:Name="FilesSearchFieldBorder" Grid.Row="1" Margin="22,0,22,10" Background="#11131A" BorderBrush="#232734" BorderThickness="1" CornerRadius="12" Padding="14,9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" Foreground="#C5A059" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="FilesSearchBox" Grid.Column="1"
                                 Background="Transparent" Foreground="#F9FAFB" CaretBrush="#C5A059"
                                 BorderThickness="0" Padding="2,3" FontSize="13.5" VerticalContentAlignment="Center"
                                 TextChanged="FilesSearchBox_TextChanged" KeyDown="FilesSearchBox_KeyDown"/>
                        <TextBlock x:Name="FilesSearchPlaceholder" Grid.Column="1"
                                   Text="Dynamische Suche nach Dateinamen, Kategorien, Tags, Inhalt oder Synonymen (z.B. Arbeitsamt, BKK, AU, Steuer, Kamera)..."
                                   Foreground="#9CA3AF" FontSize="13" VerticalAlignment="Center" Margin="4,0,0,0" IsHitTestVisible="False"/>
                        <Border x:Name="FilesSearchResultCountBadge" Grid.Column="2" Visibility="Collapsed"
                                Background="#26231F" BorderBrush="#C5A059" BorderThickness="1" CornerRadius="7" Padding="8,3" Margin="8,0,6,0" VerticalAlignment="Center">
                            <TextBlock x:Name="FilesSearchResultCountTxt" Text="0 Treffer" Foreground="#C5A059" FontSize="11" FontWeight="Bold"/>
                        </Border>
                        <Button x:Name="FilesClearSearchBtn" Grid.Column="3" Click="FilesClearSearch_Click"
                                Visibility="Collapsed" Background="#26231F" Foreground="#C5A059" BorderBrush="#242936" BorderThickness="1"
                                Padding="8,2" Cursor="Hand" FontSize="11.5" FontWeight="Bold" Content="✕">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        </Button>
                    </Grid>
                </Border>

                <!-- ROW 2: NAVIGATION & ACTION TOOLBAR (Clean Design, 100% Darkmode) -->
                <Border Grid.Row="2" Margin="22,0,22,12" Background="#11131A" BorderBrush="#232734" BorderThickness="1" CornerRadius="12" Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Up Button + Root Button + Dynamic Subfolder Pills + Current Path Badge -->
                        <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="FilesGoUpBtn" Click="FilesGoUp_Click"
                                    Background="#181B24" Foreground="#F9FAFB" BorderBrush="#262A36" BorderThickness="1"
                                    Width="34" Height="34" Margin="0,0,8,0" Cursor="Hand" ToolTip="Ebene hoeher"
                                    FontSize="14" FontWeight="Bold" Content="↑">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="9"/></Style></Button.Resources>
                            </Button>

                            <Button x:Name="FilesNavRootBtn" Click="FilesQuickFolder_Click" Tag="files"
                                    Background="#26231F" Foreground="#C5A059" BorderBrush="#C5A059" BorderThickness="1"
                                    Padding="12,6" Margin="0,0,6,0" Cursor="Hand" FontSize="12" FontWeight="Bold" Content="Alle">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="9"/></Style></Button.Resources>
                            </Button>

                            <WrapPanel x:Name="FilesDynamicFoldersPanel" Orientation="Horizontal" VerticalAlignment="Center"/>

                            <Border x:Name="FilesCurrentPathBadge" Background="#181B24" BorderBrush="#232734" BorderThickness="1"
                                    CornerRadius="8" Padding="10,5" Margin="2,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="FilesCurrentPathTxt" Text="Meine Daten" Foreground="#C5A059"
                                           FontFamily="Consolas" FontSize="11.5" FontWeight="Bold"/>
                            </Border>
                        </WrapPanel>

                        <!-- Right: New Folder + Upload + Dateitrichter + Refresh + View Mode Toggle -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- New Folder Input + Button -->
                            <Border Background="#181B24" BorderBrush="#262A36" BorderThickness="1" CornerRadius="9" Padding="8,0" Height="34" Margin="0,0,6,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="125"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="FilesNewFolderBox" Grid.Column="0"
                                             Background="Transparent" Foreground="#F9FAFB" CaretBrush="#C5A059"
                                             BorderThickness="0" FontSize="12" VerticalContentAlignment="Center"
                                             TextChanged="FilesNewFolderBox_TextChanged" KeyDown="FilesNewFolderBox_KeyDown"/>
                                    <TextBlock x:Name="FilesNewFolderPlaceholder" Grid.Column="0"
                                               Text="Neuer Ordner..." Foreground="#9CA3AF" FontSize="11.5"
                                               VerticalAlignment="Center" Margin="2,0,0,0" IsHitTestVisible="False"/>
                                    <Button Grid.Column="1" Click="FilesCreateFolder_Click"
                                            Background="Transparent" Foreground="#C5A059" BorderThickness="0"
                                            Padding="6,0" Cursor="Hand" ToolTip="Ordner erstellen" FontSize="14" FontWeight="Bold" Content="＋"/>
                                </Grid>
                            </Border>

                            <!-- Upload Button -->
                            <Button x:Name="FilesUploadBtn" Click="FilesUpload_Click"
                                    Background="#181B24" Foreground="#F9FAFB" BorderBrush="#262A36" BorderThickness="1"
                                    Height="34" Padding="13,0" Margin="0,0,6,0" Cursor="Hand" FontSize="12" FontWeight="Bold" Content="⬆ Hochladen">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="9"/></Style></Button.Resources>
                            </Button>

                            <!-- Dateitrichter Button (Darkmode Matte Black & Gold Border) -->
                            <Button x:Name="FilesDateitrichterBtn" Click="FilesRunDateitrichter_Click"
                                    Background="#26231F" Foreground="#C5A059" BorderBrush="#C5A059" BorderThickness="1"
                                    Height="34" Padding="14,0" Margin="0,0,6,0" Cursor="Hand" FontSize="12" FontWeight="Bold" Content="⚡ Dateitrichter">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="9"/></Style></Button.Resources>
                            </Button>

                            <!-- Refresh Button -->
                            <Button Click="FilesRefresh_Click"
                                    Background="#181B24" Foreground="#D1D5DB" BorderBrush="#262A36" BorderThickness="1"
                                    Width="34" Height="34" Margin="0,0,8,0" Cursor="Hand" ToolTip="Aktualisieren" FontSize="13" FontWeight="Bold" Content="↻">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="9"/></Style></Button.Resources>
                            </Button>

                            <!-- View Mode Switcher (Grid vs Table) -->
                            <Border Background="#181B24" BorderBrush="#262A36" BorderThickness="1" CornerRadius="9" Padding="3" Height="34">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="FilesViewGridBtn" Click="FilesSetGridView_Click"
                                            Background="#26231F" Foreground="#C5A059" BorderBrush="#C5A059" BorderThickness="1"
                                            Width="28" Height="26" Cursor="Hand" ToolTip="Kachelansicht" FontSize="13" FontWeight="Bold" Content="⊞">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                    </Button>
                                    <Button x:Name="FilesViewTableBtn" Click="FilesSetTableView_Click"
                                            Background="Transparent" Foreground="#9CA3AF" BorderBrush="Transparent" BorderThickness="1"
                                            Width="28" Height="26" Margin="2,0,0,0" Cursor="Hand" ToolTip="Listenansicht" FontSize="13" FontWeight="Bold" Content="☰">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ROW 3: MAIN CONTENT AREA (GRID VIEW / TABLE VIEW / EMPTY STATE) -->
                <Grid Grid.Row="3" Margin="22,0,22,18">
                    <!-- 1. Grid View (Kacheln) -->
                    <ScrollViewer x:Name="FilesGridScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <WrapPanel x:Name="FilesGridWrapPanel" Orientation="Horizontal"/>
                    </ScrollViewer>

                    <!-- 2. Table View (Schlanke Liste ohne Text-Overload) -->
                    <Border x:Name="FilesTableContainerBorder" Visibility="Collapsed" Background="#11131A" BorderBrush="#232734" BorderThickness="1" CornerRadius="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#181B24" BorderBrush="#232734" BorderThickness="0,0,0,1" CornerRadius="14,14,0,0" Padding="18,11">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="1.4*"/>
                                        <ColumnDefinition Width="0.8*"/>
                                        <ColumnDefinition Width="0.7*"/>
                                        <ColumnDefinition Width="1.0*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="DOKUMENT / ORDNER" Foreground="#9CA3AF" FontSize="10.5" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="1" Text="KATEGORIE" Foreground="#9CA3AF" FontSize="10.5" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="2" Text="GRÖSSE" Foreground="#9CA3AF" FontSize="10.5" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="3" Text="TYP" Foreground="#9CA3AF" FontSize="10.5" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="4" Text="DATUM" Foreground="#9CA3AF" FontSize="10.5" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="5" Text="AKTION" Foreground="#9CA3AF" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="FilesTableRowsPanel"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- 3. Empty State -->
                    <Border x:Name="FilesEmptyStateBorder" Visibility="Collapsed" Background="#11131A" BorderBrush="#232734" BorderThickness="1" CornerRadius="14">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="📁" FontSize="42" Foreground="#C5A059" HorizontalAlignment="Center" Margin="0,0,0,8" Opacity="0.8"/>
                            <TextBlock x:Name="FilesEmptyStateTxt" Text="Keine passenden Dokumente gefunden" Foreground="#9CA3AF" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- 4. Status Pill (Bottom Left, transient feedback) -->
                    <Border x:Name="FilesStatusToastBorder" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                            Margin="14,0,0,14" Background="#181B24" BorderBrush="#C5A059" BorderThickness="1" CornerRadius="10" Padding="14,8" Panel.ZIndex="45">
                        <TextBlock x:Name="FilesStatusToastTxt" Text="" Foreground="#F9FAFB" FontSize="12" FontWeight="Bold"/>
                    </Border>
                </Grid>

                <!-- ================================================================= -->
                <!-- IN-WINDOW LIGHTBOX / PREVIEW MODAL (Baustein 1: Lightbox im Fenster) -->
                <!-- ================================================================= -->
                <Grid x:Name="FilesPreviewModalOverlay" Grid.RowSpan="4" Background="#D9000000" Visibility="Collapsed" Panel.ZIndex="120"
                      MouseLeftButtonDown="FilesPreviewBackdrop_MouseLeftButtonDown">
                    <Border Width="960" Height="700" Background="#11131A" BorderBrush="#C5A059" BorderThickness="1.5" CornerRadius="18"
                            HorizontalAlignment="Center" VerticalAlignment="Center" MouseLeftButtonDown="FilesPreviewCard_BlockClick">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Lightbox Header -->
                            <Border Grid.Row="0" Background="#181B24" BorderBrush="#232734" BorderThickness="0,0,0,1" CornerRadius="18,18,0,0" Padding="20,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBox x:Name="FilesPreviewModalTitleTxt" Style="{StaticResource SelectableHeaderTextBox}" Text="Dateiname" Foreground="#F9FAFB" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" MaxWidth="460"/>
                                        <Border Background="#26231F" BorderBrush="#C5A059" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="FilesPreviewModalMetaTxt" Text="PDF · 120 KB" Foreground="#C5A059" FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Click="FilesPreviewOpenNative_Click" Background="#181B24" Foreground="#F9FAFB" BorderBrush="#262A36" BorderThickness="1" Padding="12,7" Margin="0,0,8,0" Cursor="Hand" FontSize="12" FontWeight="Bold" Content="📂 Lokal öffnen">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                        </Button>
                                        <Button Click="FilesPreviewDownload_Click" Background="#26231F" Foreground="#C5A059" BorderBrush="#C5A059" BorderThickness="1" Padding="14,7" Margin="0,0,10,0" Cursor="Hand" FontSize="12" FontWeight="Bold" Content="⬇ Speichern unter">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                        </Button>
                                        <Button Click="FilesClosePreviewModal_Click" Style="{StaticResource ModalCloseButtonStyle}" Content="✕"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Lightbox Content -->
                            <Grid Grid.Row="1" Margin="18">
                                <!-- Image Lightbox -->
                                <Image x:Name="FilesPreviewModalImage" Visibility="Collapsed" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>

                                <!-- Text / Code / Extracted PDF Full-Text Viewer -->
                                <Border x:Name="FilesPreviewTextContainer" Visibility="Collapsed" Background="#181B24" BorderBrush="#232734" BorderThickness="1" CornerRadius="12" Padding="14">
                                    <TextBox x:Name="FilesPreviewModalTextBox" IsReadOnly="True" Background="Transparent" Foreground="#F9FAFB" BorderThickness="0"
                                             FontFamily="Consolas" FontSize="12.5" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                                </Border>

                                <!-- Binary / Video Fallback Card -->
                                <StackPanel x:Name="FilesPreviewBinaryPanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock x:Name="FilesPreviewBinaryIconTxt" Text="📄" FontSize="54" Foreground="#C5A059" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                    <TextBlock x:Name="FilesPreviewBinaryNameTxt" Text="Datei" Foreground="#F9FAFB" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Click="FilesPreviewOpenNative_Click" Background="#26231F" Foreground="#C5A059" BorderBrush="#C5A059" BorderThickness="1" Padding="18,10" Margin="0,0,10,0" Cursor="Hand" FontSize="13" FontWeight="Bold" Content="📂 Direkt öffnen">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                                        </Button>
                                        <Button Click="FilesPreviewDownload_Click" Background="#181B24" Foreground="#F9FAFB" BorderBrush="#262A36" BorderThickness="1" Padding="18,10" Cursor="Hand" FontSize="13" FontWeight="Bold" Content="⬇ Speichern unter">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ================================================================= -->
                <!-- RENAME MODAL (100% DARKMODE)                                      -->
                <!-- ================================================================= -->
                <Grid x:Name="FilesRenameModalOverlay" Grid.RowSpan="4" Background="#B3000000" Visibility="Collapsed" Panel.ZIndex="125">
                    <Border Width="420" Background="#11131A" BorderBrush="#C5A059" BorderThickness="1.5" CornerRadius="16" Padding="22,18" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Umbenennen" Foreground="#F9FAFB" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Click="FilesCloseRenameModal_Click" Style="{StaticResource ModalCloseButtonStyle}" Content="✕"/>
                            </Grid>
                            <TextBox x:Name="FilesRenameInputBox" Background="#181B24" Foreground="#F9FAFB" CaretBrush="#C5A059" BorderBrush="#262A36" BorderThickness="1" Padding="12,9" FontSize="13.5" Margin="0,0,0,16" KeyDown="FilesRenameInputBox_KeyDown"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Click="FilesCloseRenameModal_Click" Background="#181B24" Foreground="#D1D5DB" BorderBrush="#262A36" BorderThickness="1" Padding="14,8" Margin="0,0,8,0" Cursor="Hand" FontSize="12" FontWeight="SemiBold" Content="Abbrechen">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                </Button>
                                <Button Click="FilesConfirmRename_Click" Background="#26231F" Foreground="#C5A059" BorderBrush="#C5A059" BorderThickness="1" Padding="16,8" Cursor="Hand" FontSize="12" FontWeight="Bold" Content="Speichern">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ================================================================= -->
                <!-- MOVE MODAL (100% DARKMODE - NO WHITE SYSTEM COMBOBOX POPUP)        -->
                <!-- ================================================================= -->
                <Grid x:Name="FilesMoveModalOverlay" Grid.RowSpan="4" Background="#B3000000" Visibility="Collapsed" Panel.ZIndex="125">
                    <Border Width="480" Background="#11131A" BorderBrush="#C5A059" BorderThickness="1.5" CornerRadius="16" Padding="22,18" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Verschieben in..." Foreground="#F9FAFB" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Click="FilesCloseMoveModal_Click" Style="{StaticResource ModalCloseButtonStyle}" Content="✕"/>
                            </Grid>
                            <Border Background="#181B24" BorderBrush="#232734" BorderThickness="1" CornerRadius="10" Height="220" Padding="6" Margin="0,0,0,16">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="FilesMoveTargetListPanel"/>
                                </ScrollViewer>
                            </Border>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Click="FilesCloseMoveModal_Click" Background="#181B24" Foreground="#D1D5DB" BorderBrush="#262A36" BorderThickness="1" Padding="14,8" Margin="0,0,8,0" Cursor="Hand" FontSize="12" FontWeight="SemiBold" Content="Abbrechen">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                </Button>
                                <Button Click="FilesConfirmMove_Click" Background="#26231F" Foreground="#C5A059" BorderBrush="#C5A059" BorderThickness="1" Padding="16,8" Cursor="Hand" FontSize="12" FontWeight="Bold" Content="Verschieben">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- ===================================================================== -->
            <!-- MODULE 11: FUNKIRA KI-AGENT (INTEGRIERTER PC- & SEELENFUNKE-AGENT)    -->
            <!-- ===================================================================== -->
            <Grid x:Name="AgentViewGrid" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="270" MinWidth="210" MaxWidth="420"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 11A: Sessions & Schnellbefehle Sidebar -->
                <Border Grid.Column="0" Background="#13161F" Padding="14,16">
                    <DockPanel LastChildFill="True">
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="✦ " Foreground="#C5A059" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock Text="Funkira" Foreground="#F9FAFB" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Grid.Column="1" Click="AgentNewChat_Click" ToolTip="Neuen Chat starten"
                                    Background="#C5A059" Foreground="#111827" BorderThickness="0" Padding="10,5" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                <TextBlock Text="+ Neu" FontSize="11" FontWeight="Bold"/>
                            </Button>
                        </Grid>

                        <!-- Schnellbefehle (Clean Minimalist Pills without subtexts) -->
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                            <Border Height="1" Background="#1E222D" Margin="0,0,0,10"/>
                            <TextBlock Text="SCHNELLSTEUERUNG" Foreground="#9CA3AF" FontSize="10" FontWeight="Bold" Margin="2,0,0,7"/>
                            <WrapPanel Orientation="Horizontal">
                                <Button Click="AgentQuickAction_Click" Tag="Spiel Musik ab" ToolTip="Musikwiedergabe starten"
                                        Background="#181B24" Foreground="#F9FAFB" BorderBrush="#262A36" BorderThickness="1" Padding="9,5" Margin="0,0,5,5" Cursor="Hand" FontSize="11" FontWeight="SemiBold" Content="🎵 Play">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style></Button.Resources>
                                </Button>
                                <Button Click="AgentQuickAction_Click" Tag="Starte den Fokus-Modus" ToolTip="Seelenfunke Musik Fokus-Modus öffnen"
                                        Background="#181B24" Foreground="#C5A059" BorderBrush="#382D18" BorderThickness="1" Padding="9,5" Margin="0,0,5,5" Cursor="Hand" FontSize="11" FontWeight="Bold" Content="✦ Fokus">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style></Button.Resources>
                                </Button>
                                <Button Click="AgentQuickAction_Click" Tag="Packtisch Warm Licht einschalten" ToolTip="Steckdose Packtisch Warm Licht einschalten"
                                        Background="#181B24" Foreground="#F9FAFB" BorderBrush="#262A36" BorderThickness="1" Padding="9,5" Margin="0,0,5,5" Cursor="Hand" FontSize="11" FontWeight="SemiBold" Content="💡 Packtisch AN">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style></Button.Resources>
                                </Button>
                                <Button Click="AgentQuickAction_Click" Tag="Alle Lichter ausschalten" ToolTip="Alle Smart-Home-Steckdosen ausschalten"
                                        Background="#181B24" Foreground="#F9FAFB" BorderBrush="#262A36" BorderThickness="1" Padding="9,5" Margin="0,0,5,5" Cursor="Hand" FontSize="11" FontWeight="SemiBold" Content="○ Lichter AUS">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style></Button.Resources>
                                </Button>
                                <Button Click="AgentQuickAction_Click" Tag="Öffne Funkenwerk PDF" ToolTip="Funkenwerk PDF Editor starten"
                                        Background="#181B24" Foreground="#F9FAFB" BorderBrush="#262A36" BorderThickness="1" Padding="9,5" Margin="0,0,5,5" Cursor="Hand" FontSize="11" FontWeight="SemiBold" Content="📄 PDF">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style></Button.Resources>
                                </Button>
                                <Button Click="AgentQuickAction_Click" Tag="Was steht heute auf meiner To-Do Liste und im Kalender?" ToolTip="Tagesbriefing abrufen"
                                        Background="#181B24" Foreground="#F9FAFB" BorderBrush="#262A36" BorderThickness="1" Padding="9,5" Margin="0,0,5,5" Cursor="Hand" FontSize="11" FontWeight="SemiBold" Content="📋 Briefing">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style></Button.Resources>
                                </Button>
                            </WrapPanel>
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="AgentSessionsListPanel" Margin="0,2,2,2"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Column="1" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>

                <!-- 11B: Main Chat Stream & Input Bar -->
                <Border Grid.Column="2" Background="#0F1117" Padding="22,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Top Header -->
                        <Border Grid.Row="0" BorderBrush="#1E222D" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="32" Height="32" CornerRadius="16" Background="#26231F" BorderBrush="#C5A059" BorderThickness="1" Margin="0,0,10,0">
                                        <TextBlock Text="✦" Foreground="#C5A059" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBox x:Name="AgentActiveSessionTitleTxt" Style="{StaticResource SelectableHeaderTextBox}" Text="Funkira" Foreground="#F9FAFB" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="AgentTtsToggleBtn" Click="AgentToggleTts_Click"
                                            ToolTip="Sprachausgabe (Opt-In) ein-/ausschalten"
                                            Background="#181B24" Foreground="#9CA3AF" BorderBrush="#262A36" BorderThickness="1"
                                            Padding="10,5" Cursor="Hand" FontSize="11.5" FontWeight="SemiBold" Content="🔇 Stimme AUS">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Messages Scroll -->
                        <ScrollViewer x:Name="AgentChatScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                            <StackPanel x:Name="AgentMessagesPanel" Margin="0,4,0,10"/>
                        </ScrollViewer>

                        <!-- Bottom Composer -->
                        <Border Grid.Row="2" Background="#161922" BorderBrush="#2A2F3D" BorderThickness="1" CornerRadius="14" Padding="12,9" Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock x:Name="AgentPromptPlaceholderTxt" Text="Nachricht oder PC-Befehl an Funkira... (Enter zum Senden)"
                                               Foreground="#6B7280" FontSize="13.5" Margin="4,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                    <TextBox x:Name="AgentPromptInputBox" Background="Transparent" Foreground="#F9FAFB" CaretBrush="#C5A059"
                                             BorderThickness="0" FontSize="13.5" Padding="2,4" MaxHeight="110" TextWrapping="Wrap" AcceptsReturn="False"
                                             TextChanged="AgentPromptInputBox_TextChanged" PreviewKeyDown="AgentPromptInputBox_PreviewKeyDown"/>
                                </Grid>
                                <Button x:Name="AgentSendPromptBtn" Grid.Column="1" Click="AgentSendPrompt_Click"
                                        ToolTip="Senden (Enter)"
                                        Background="#C5A059" Foreground="#111827" BorderThickness="0" Padding="16,8" Margin="10,0,0,0"
                                        Cursor="Hand" FontSize="12.5" FontWeight="Bold" Content="Senden ✦">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===================================================================== -->
            <!-- MODAL OVERLAY 1: COMPOSE / REPLY E-MAIL (Mein Seelenfunke Parity)     -->
            <!-- ===================================================================== -->
            <Grid x:Name="ComposeModalOverlay" Background="#B3000000" Visibility="Collapsed">
                <Border x:Name="ComposeModalCard" Width="760" MaxHeight="810" Background="#161922" BorderBrush="#262A36" BorderThickness="1" CornerRadius="18" Padding="24,20" VerticalAlignment="Center" HorizontalAlignment="Center"
                        AllowDrop="True"
                        PreviewDragEnter="ComposeModalCard_PreviewDragEnter"
                        PreviewDragOver="ComposeModalCard_PreviewDragOver"
                        PreviewDragLeave="ComposeModalCard_PreviewDragLeave"
                        PreviewDrop="ComposeModalCard_PreviewDrop">
                    <Grid>
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="ComposeModalTitle" Text="Neue E-Mail schreiben" Foreground="#F9FAFB" FontSize="19" FontWeight="Bold"/>
                            <Button Grid.Column="1" Click="CloseCompose_Click" Style="{StaticResource ModalCloseButtonStyle}" Content="✕"/>
                        </Grid>

                        <!-- INTELLIGENTER ASSISTENTEN-HINWEIS (STATT FEHLER-POPUP) -->
                        <Border x:Name="ComposeSmartGuidanceBanner" Visibility="Collapsed" Background="#17140D" BorderBrush="#C5A059" BorderThickness="1.2" CornerRadius="11" Padding="14,11" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="ComposeGuidanceTitleTxt" Text="Hinweis zum Versand" Foreground="#C5A059" FontSize="13" FontWeight="Bold" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="ComposeGuidanceStepsTxt" Text="" Foreground="#E5E7EB" FontSize="12" Margin="0,5,0,6" LineHeight="18" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="ComposeGuidanceSavedBadgeTxt" Text="✓ Dein Entwurf &amp; deine Eingaben sind vollständig gesichert." Foreground="#10B981" FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <Button x:Name="ComposeGuidanceActionBtn" Click="ComposeGuidanceAction_Click" Visibility="Collapsed"
                                            Background="#C5A059" Foreground="#111827" BorderThickness="0" Padding="12,7" Cursor="Hand" FontSize="11.5" FontWeight="Bold" Content="Jetzt lösen">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- VON POSTFACH -->
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="VON POSTFACH" Foreground="#9CA3AF" FontSize="10.5" FontWeight="Bold" Margin="0,0,0,4"/>
                            <ComboBox x:Name="ComposeAccountCombo" DisplayMemberPath="DisplayLabel" SelectedValuePath="Id" SelectionChanged="ComposeAccountCombo_SelectionChanged" Padding="8,6" FontSize="13"/>
                        </StackPanel>

                        <!-- EMPFÄNGER (AN) + CC/BCC TOGGLE + KACHELN -->
                        <StackPanel Margin="0,0,0,10" Panel.ZIndex="80">
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="EMPFÄNGER (AN)" Foreground="#9CA3AF" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock Text="  ·  Enter = als Kachel hinzufügen" Foreground="#6B7280" FontSize="10.5" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="ComposeToggleCcBtn" Click="ToggleComposeCc_Click" Background="#1F2430" Foreground="#D1D5DB" BorderBrush="#2E3446" BorderThickness="1" Padding="9,3" Margin="0,0,6,0" Cursor="Hand" ToolTip="CC (Kopie) ein-/ausblenden">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                        <TextBlock x:Name="ComposeToggleCcTxt" Text="+ CC" FontSize="11" FontWeight="Bold"/>
                                    </Button>
                                    <Button x:Name="ComposeToggleBccBtn" Click="ToggleComposeBcc_Click" Background="#1F2430" Foreground="#D1D5DB" BorderBrush="#2E3446" BorderThickness="1" Padding="9,3" Cursor="Hand" ToolTip="BCC (Blindkopie) ein-/ausblenden">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                        <TextBlock x:Name="ComposeToggleBccTxt" Text="+ BCC" FontSize="11" FontWeight="Bold"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <Grid>
                                <Border x:Name="ComposeToFieldBorder" Background="#0F1117" BorderBrush="#262A36" BorderThickness="1" CornerRadius="10" Padding="6,5" MinHeight="38" Cursor="IBeam" MouseLeftButtonDown="ComposeToFieldBorder_MouseLeftButtonDown">
                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <WrapPanel x:Name="ComposeToChipsPanel" Orientation="Horizontal" VerticalAlignment="Center"/>
                                        <TextBox x:Name="ComposeToInput" Background="Transparent" Foreground="#F9FAFB" BorderThickness="0" Padding="4,3" FontSize="13.5" MinWidth="200" VerticalAlignment="Center"
                                                 TextChanged="ComposeToInput_TextChanged"
                                                 PreviewKeyDown="ComposeToInput_PreviewKeyDown"
                                                 LostFocus="ComposeToInput_LostFocus"/>
                                    </WrapPanel>
                                </Border>
                                <Canvas HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="0" Panel.ZIndex="140">
                                    <Border x:Name="ComposeToAutocompleteBorder"
                                            Canvas.Top="3"
                                            Canvas.Left="0"
                                            Width="{Binding ActualWidth, ElementName=ComposeToFieldBorder}"
                                            MaxHeight="240"
                                            Visibility="Collapsed"
                                            Background="#13161F"
                                            BorderBrush="#C5A059"
                                            BorderThickness="1.5"
                                            CornerRadius="10"
                                            Padding="5">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="18" ShadowDepth="6" Opacity="0.55" Color="#000000"/>
                                        </Border.Effect>
                                        <ScrollViewer x:Name="ComposeToAutocompleteScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                            <StackPanel x:Name="ComposeToAutocompletePanel"/>
                                        </ScrollViewer>
                                    </Border>
                                </Canvas>
                            </Grid>
                        </StackPanel>

                        <!-- KOPIE (CC) + KACHELN -->
                        <StackPanel x:Name="ComposeCcSection" Margin="0,0,0,10" Visibility="Collapsed" Panel.ZIndex="70">
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="KOPIE (CC)" Foreground="#C5A059" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock Text="  ·  Enter = als Kachel hinzufügen" Foreground="#6B7280" FontSize="10.5" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Grid.Column="1" Click="CloseComposeCc_Click" Background="Transparent" Foreground="#9CA3AF" BorderThickness="0" Padding="5,1" Cursor="Hand" ToolTip="CC-Feld schließen &amp; leeren" Content="✕"/>
                            </Grid>
                            <Grid>
                                <Border x:Name="ComposeCcFieldBorder" Background="#0F1117" BorderBrush="#262A36" BorderThickness="1" CornerRadius="10" Padding="6,5" MinHeight="36" Cursor="IBeam" MouseLeftButtonDown="ComposeCcFieldBorder_MouseLeftButtonDown">
                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <WrapPanel x:Name="ComposeCcChipsPanel" Orientation="Horizontal" VerticalAlignment="Center"/>
                                        <TextBox x:Name="ComposeCcInput" Background="Transparent" Foreground="#F9FAFB" BorderThickness="0" Padding="4,3" FontSize="13" MinWidth="200" VerticalAlignment="Center"
                                                 TextChanged="ComposeCcInput_TextChanged"
                                                 PreviewKeyDown="ComposeCcInput_PreviewKeyDown"
                                                 LostFocus="ComposeCcInput_LostFocus"/>
                                    </WrapPanel>
                                </Border>
                                <Canvas HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="0" Panel.ZIndex="140">
                                    <Border x:Name="ComposeCcAutocompleteBorder"
                                            Canvas.Top="3"
                                            Canvas.Left="0"
                                            Width="{Binding ActualWidth, ElementName=ComposeCcFieldBorder}"
                                            MaxHeight="220"
                                            Visibility="Collapsed"
                                            Background="#13161F"
                                            BorderBrush="#C5A059"
                                            BorderThickness="1.5"
                                            CornerRadius="10"
                                            Padding="5">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="18" ShadowDepth="6" Opacity="0.55" Color="#000000"/>
                                        </Border.Effect>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                            <StackPanel x:Name="ComposeCcAutocompletePanel"/>
                                        </ScrollViewer>
                                    </Border>
                                </Canvas>
                            </Grid>
                        </StackPanel>

                        <!-- BLINDKOPIE (BCC) + KACHELN -->
                        <StackPanel x:Name="ComposeBccSection" Margin="0,0,0,10" Visibility="Collapsed" Panel.ZIndex="65">
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="BLINDKOPIE (BCC)" Foreground="#C5A059" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock Text="  ·  Enter = als Kachel hinzufügen" Foreground="#6B7280" FontSize="10.5" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Grid.Column="1" Click="CloseComposeBcc_Click" Background="Transparent" Foreground="#9CA3AF" BorderThickness="0" Padding="5,1" Cursor="Hand" ToolTip="BCC-Feld schließen &amp; leeren" Content="✕"/>
                            </Grid>
                            <Grid>
                                <Border x:Name="ComposeBccFieldBorder" Background="#0F1117" BorderBrush="#262A36" BorderThickness="1" CornerRadius="10" Padding="6,5" MinHeight="36" Cursor="IBeam" MouseLeftButtonDown="ComposeBccFieldBorder_MouseLeftButtonDown">
                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <WrapPanel x:Name="ComposeBccChipsPanel" Orientation="Horizontal" VerticalAlignment="Center"/>
                                        <TextBox x:Name="ComposeBccInput" Background="Transparent" Foreground="#F9FAFB" BorderThickness="0" Padding="4,3" FontSize="13" MinWidth="200" VerticalAlignment="Center"
                                                 TextChanged="ComposeBccInput_TextChanged"
                                                 PreviewKeyDown="ComposeBccInput_PreviewKeyDown"
                                                 LostFocus="ComposeBccInput_LostFocus"/>
                                    </WrapPanel>
                                </Border>
                                <Canvas HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="0" Panel.ZIndex="140">
                                    <Border x:Name="ComposeBccAutocompleteBorder"
                                            Canvas.Top="3"
                                            Canvas.Left="0"
                                            Width="{Binding ActualWidth, ElementName=ComposeBccFieldBorder}"
                                            MaxHeight="220"
                                            Visibility="Collapsed"
                                            Background="#13161F"
                                            BorderBrush="#C5A059"
                                            BorderThickness="1.5"
                                            CornerRadius="10"
                                            Padding="5">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="18" ShadowDepth="6" Opacity="0.55" Color="#000000"/>
                                        </Border.Effect>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                            <StackPanel x:Name="ComposeBccAutocompletePanel"/>
                                        </ScrollViewer>
                                    </Border>
                                </Canvas>
                            </Grid>
                        </StackPanel>

                        <!-- BETREFF -->
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="BETREFF" Foreground="#9CA3AF" FontSize="10.5" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBox x:Name="ComposeSubjectInput" Background="#0F1117" Foreground="#F9FAFB" BorderBrush="#262A36" Padding="10,8" FontSize="13.5"/>
                        </StackPanel>

                        <!-- NACHRICHT + FORMATIERUNGS-TOOLBAR -->
                        <StackPanel Margin="0,0,0,12">
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="NACHRICHT" Foreground="#9CA3AF" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Click="ComposeFormat_Click" Tag="bold" Background="#1F2430" Foreground="#D1D5DB" BorderThickness="0" Padding="7,2" Margin="0,0,4,0" Cursor="Hand" ToolTip="Fett markieren" FontWeight="Bold" FontSize="11" Content="B">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                                    </Button>
                                    <Button Click="ComposeFormat_Click" Tag="italic" Background="#1F2430" Foreground="#D1D5DB" BorderThickness="0" Padding="8,2" Margin="0,0,4,0" Cursor="Hand" ToolTip="Kursiv markieren" FontStyle="Italic" FontWeight="SemiBold" FontSize="11" Content="I">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                                    </Button>
                                    <Button Click="ComposeFormat_Click" Tag="bullet" Background="#1F2430" Foreground="#D1D5DB" BorderThickness="0" Padding="7,2" Margin="0,0,4,0" Cursor="Hand" ToolTip="Aufzählung einfügen" FontSize="11" Content="• Liste">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                                    </Button>
                                    <Button Click="ComposeFormat_Click" Tag="quote" Background="#1F2430" Foreground="#D1D5DB" BorderThickness="0" Padding="7,2" Margin="0,0,4,0" Cursor="Hand" ToolTip="Zitat einfügen" FontSize="11" Content="❝ Zitat">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                                    </Button>
                                    <Button Click="ComposeFormat_Click" Tag="signature" Background="#1F2430" Foreground="#C5A059" BorderThickness="0" Padding="8,2" Cursor="Hand" ToolTip="Kontosignatur am Ende einfügen" FontSize="11" FontWeight="SemiBold" Content="✍ Signatur">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <TextBox x:Name="ComposeBodyInput" Background="#0F1117" Foreground="#F9FAFB" BorderBrush="#262A36" Padding="12,10" FontSize="13.5" Height="210" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" HorizontalContentAlignment="Left" TextAlignment="Left" VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>

                        <!-- ANHÄNGE BEREICH (wie in Mein Seelenfunke) -->
                        <Border x:Name="ComposeAttachmentsSection" Visibility="Collapsed" Background="#11141C" BorderBrush="#242936" BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="ComposeAttachmentsCountTxt" Text="ANHÄNGE (0):" Foreground="#9CA3AF" FontSize="10.5" FontWeight="Bold"/>
                                    <TextBlock x:Name="ComposeAttachmentsSizeTxt" Grid.Column="1" Text="Gesamtgröße: 0 KB / 20.00 MB" Foreground="#C5A059" FontSize="10.5" FontWeight="Bold"/>
                                </Grid>
                                <ScrollViewer MaxHeight="82" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <WrapPanel x:Name="ComposeAttachmentsPanel" Orientation="Horizontal"/>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <!-- FOOTER ACTION BAR -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
