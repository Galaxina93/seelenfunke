                                    <Button x:Name="CamHardwareStartStopBtn" Click="CamHardwareStartStop_Click" Background="#26231F" Foreground="#C5A059" BorderBrush="#C5A059" BorderThickness="1" Padding="12,6" Margin="0,0,8,0" Cursor="Hand" FontSize="11.5" FontWeight="Bold" ToolTip="PC-Hardware-Kamera (Webcam) erst bei Bedarf starten oder wieder ausschalten" Content="▶ Kamera starten">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                                    </Button>
                                    <Button x:Name="CamVirtualCamToggleBtn" Click="CamVirtualCamToggle_Click" Background="#163026" Foreground="#34D399" BorderBrush="#10B981" BorderThickness="1" Padding="12,6" Margin="0,0,8,0" Cursor="Hand" FontSize="11.5" FontWeight="Bold" ToolTip="Virtuelle Windows-Kamera 'Funkenwerk Kamera' für Discord, Teams, Zoom, OBS &amp; Browser aktivieren/synchronisieren" Content="🎥 Funkenwerk Kamera">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                                    </Button>
                                    <Button Click="CamOpenCameraSettings_Click" Background="#1E1F22" Foreground="#D1D5DB" BorderBrush="#2B2D31" BorderThickness="1" Padding="10,6" Cursor="Hand" FontSize="12" ToolTip="Kamera-, Mikrofon- &amp; Speicherpfad-Einstellungen öffnen" Content="⚙">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
