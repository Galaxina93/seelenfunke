                                    <Button Grid.Column="1" Click="TestApiConnection_Click" Background="#1F2430" Foreground="#C5A059" BorderThickness="0" Padding="12,6" Cursor="Hand" FontSize="12" FontWeight="Bold" Content="⚡ Verbindung prüfen">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- =============================================================== -->
                        <!-- TAB 4: KAMERA, MIKROFON & MEDIEN-SPEICHERPFAD                   -->
                        <!-- (Requirements 5, 8 & Virtual Camera OS Registration)            -->
                        <!-- =============================================================== -->
                        <StackPanel x:Name="SettingsPaneCamera" Visibility="Collapsed">
