                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="🎙 MIKROFON-AUSWAHL (AUDIO-EINGANG)" Foreground="#F9FAFB" FontSize="12.5" FontWeight="Bold"/>
