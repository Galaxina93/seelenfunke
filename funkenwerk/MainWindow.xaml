                            <Border Background="#0F1117" BorderBrush="#2A2F3D" BorderThickness="1" CornerRadius="10" Padding="10,6" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ApiTokenBox" Background="Transparent" BorderThickness="0" Foreground="#F9FAFB" CaretBrush="#C5A059" FontSize="13" Visibility="Collapsed"/>
                                    <TextBlock x:Name="ApiTokenMaskedTxt" Background="Transparent" Foreground="#F9FAFB" Padding="2,3" FontSize="13" VerticalAlignment="Center"/>
                                    <Button x:Name="ApiTokenEyeBtn" Grid.Column="1" Click="ToggleApiTokenVisibility_Click" Background="Transparent" Foreground="#C5A059" BorderThickness="0" Padding="8,2" Cursor="Hand" ToolTip="Bearer-Token anzeigen / verbergen">
                                        <TextBlock x:Name="ApiTokenEyeTxt" Text="👁" FontSize="13.5" Foreground="#C5A059" VerticalAlignment="Center"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <Border Background="#13161F" BorderBrush="#232734" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
