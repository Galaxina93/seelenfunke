                                            <ComboBox x:Name="CamBottomMicCombo" Grid.Column="0" SelectionChanged="CamBottomMicCombo_SelectionChanged" Padding="7,3" FontSize="10.5" Margin="0,0,8,0" ToolTip="Mikrofon direkt hier auswählen"/>
                                            <TextBlock x:Name="CamActiveMicLabel" Text="Standard-Mikrofon" Visibility="Collapsed"/>
                                            <ProgressBar x:Name="CamMicVuBar" Grid.Column="1" Minimum="0" Maximum="100" Value="12" Height="6" Background="#111214" Foreground="#23A55A" BorderThickness="0" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- CENTER: DISCORD VOICE/VIDEO CONTROL PILL CLUSTER (Matches User Screenshot 1 & 2) -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <!-- Discord Pill Group 1: Mic + Chevron & Cam + Chevron -->
                                    <Border Background="#1E1F22" BorderBrush="#2B2D31" BorderThickness="1" CornerRadius="12" Padding="4" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <!-- Quick Camera / VirtualCam Popup Selector Button (Like Discord Camera Button + ^) -->
                                            <Button Click="CamOpenDiscordDevicePopup_Click" Background="#2B2D31" Foreground="#F2F3F5" BorderThickness="0" Padding="11,8" Margin="0,0,2,0" Cursor="Hand" FontSize="12" FontWeight="SemiBold" ToolTip="Kamera-Auswahl &amp; Discord Virtuelle Kamera Menü öffnen">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="9"/></Style></Button.Resources>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🎥 Kamera" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="▴" Foreground="#949BA4" FontSize="10" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- Screen Share Quick Toggle + Source Menu (Fensterauswahl, Ganzer Monitor, Benutzerdefinierte Fläche, Spiegeln) -->
                                            <Button x:Name="CamDiscordScreenShareBtn" Click="CamQuickScreenShare_Click" Background="#2B2D31" Foreground="#F2F3F5" BorderThickness="0" Padding="11,8" Cursor="Hand" FontSize="12" FontWeight="SemiBold" ToolTip="Auswahl öffnen: Fenster teilen, Ganzen Monitor teilen, Benutzerdefinierte Fläche definieren &amp; Geteilten Bereich spiegeln" Content="🖥 Teilen ▴">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="9"/></Style></Button.Resources>
                                            </Button>
                                        </StackPanel>
                                    </Border>

                                    <!-- Discord Pill Group 2: Snapshot, 3s Timer, Spin, Confetti, DeepFake -->
                                    <Border Background="#1E1F22" BorderBrush="#2B2D31" BorderThickness="1" CornerRadius="12" Padding="4" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <!-- Foto machen -->
                                            <Button x:Name="CamTakePhotoBtn" Click="CamTakePhoto_Click" Background="#2B2D31" Foreground="#F2F3F5" FontWeight="Bold" BorderThickness="0" Padding="12,8" Margin="0,0,3,0" Cursor="Hand" FontSize="12" ToolTip="Sofort-Foto (Full-HD PNG) mit allen aktiven Effekten aufnehmen" Content="📸 Foto">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="9"/></Style></Button.Resources>
                                            </Button>

                                            <!-- 3s Timer Foto -->
                                            <Button x:Name="CamTakePhotoTimerBtn" Click="CamTakePhotoTimer_Click" Background="Transparent" Foreground="#B5BAC1" FontWeight="SemiBold" BorderThickness="0" Padding="9,8" Margin="0,0,3,0" Cursor="Hand" FontSize="11.5" ToolTip="Foto mit 3-Sekunden-Countdown aufnehmen" Content="⏱ 3s">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="9"/></Style></Button.Resources>
                                            </Button>

                                            <!-- Quick Action: 360° Spin -->
                                            <Button Click="CamTriggerSpin_Click" Background="Transparent" Foreground="#C5A059" BorderThickness="0" Padding="9,8" Margin="0,0,3,0" Cursor="Hand" FontSize="12" FontWeight="Bold" ToolTip="Spezialeffekt: Bild dreht sich um 360° (Barrel Roll)!" Content="🔄 Spin">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="9"/></Style></Button.Resources>
                                            </Button>

                                            <!-- Quick Action: Confetti -->
                                            <Button Click="CamTriggerConfetti_Click" Background="Transparent" Foreground="#F2F3F5" BorderThickness="0" Padding="9,8" Cursor="Hand" FontSize="12" ToolTip="Spezialeffekt: Konfetti-Kanone abfeuern!" Content="🎉">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="9"/></Style></Button.Resources>
                                            </Button>
                                        </StackPanel>
                                    </Border>

                                    <!-- Discord Red Action Pill: Video Aufnahme Start / Stop (#DA373C) -->
                                    <Button x:Name="CamRecordVideoBtn" Click="CamRecordVideo_Click" Background="#DA373C" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Padding="15,10" Margin="0,0,5,0" Cursor="Hand" FontSize="12.5" ToolTip="MP4 Videoaufnahme starten oder beenden (Standard-Tempo: 1x Echtzeit)" Content="⏺ Aufnahme">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="12"/></Style></Button.Resources>
                                    </Button>

                                    <!-- Pause Recording -->
                                    <Button x:Name="CamPauseRecordBtn" Click="CamPauseRecord_Click" Background="#2B2D31" Foreground="#FBBF24" FontWeight="Bold" BorderThickness="0" Padding="11,10" Margin="0,0,5,0" Cursor="Hand" FontSize="12.5" Visibility="Collapsed" ToolTip="Laufende Videoaufnahme pausieren / fortsetzen" Content="⏸">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="12"/></Style></Button.Resources>
                                    </Button>

                                    <!-- Recording Speed / Tempo Selector Pill (1x Standard | 2x | 3x | Individuell) -->
                                    <Border x:Name="CamRecordSpeedPillBorder" Background="#1E1F22" BorderBrush="#2B2D31" BorderThickness="1" CornerRadius="12" Padding="4" ToolTip="Aufnahme- &amp; Abspiel-Tempo wählen (Standard: 1x Echtzeit)">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="CamRecSpeed1xBtn" Click="CamRecordSpeedPreset_Click" Tag="1x" Background="#C5A059" Foreground="#111827" FontWeight="Bold" BorderThickness="0" Padding="8,7" Margin="0,0,2,0" Cursor="Hand" FontSize="11.5" ToolTip="Tempo 1x (Standard Echtzeit-Aufnahme)" Content="1x">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                            </Button>
                                            <Button x:Name="CamRecSpeed2xBtn" Click="CamRecordSpeedPreset_Click" Tag="2x" Background="Transparent" Foreground="#B5BAC1" FontWeight="SemiBold" BorderThickness="0" Padding="8,7" Margin="0,0,2,0" Cursor="Hand" FontSize="11.5" ToolTip="Tempo 2x (Doppelte Geschwindigkeit / Zeitraffer)" Content="2x">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                            </Button>
                                            <Button x:Name="CamRecSpeed3xBtn" Click="CamRecordSpeedPreset_Click" Tag="3x" Background="Transparent" Foreground="#B5BAC1" FontWeight="SemiBold" BorderThickness="0" Padding="8,7" Margin="0,0,2,0" Cursor="Hand" FontSize="11.5" ToolTip="Tempo 3x (Dreifache Geschwindigkeit / Zeitraffer)" Content="3x">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                            </Button>
                                            <Button x:Name="CamRecSpeedCustomBtn" Click="CamRecordSpeedPreset_Click" Tag="custom" Background="Transparent" Foreground="#B5BAC1" FontWeight="SemiBold" BorderThickness="0" Padding="8,7" Cursor="Hand" FontSize="11" ToolTip="Individuelles Tempo eingeben (z.B. 0.5x bis 10x)" Content="Indiv.">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                            </Button>
                                            <StackPanel x:Name="CamRecSpeedCustomWrap" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,3,0" Visibility="Collapsed">
                                                <TextBox x:Name="CamRecSpeedCustomBox" Text="1.5" Width="38" Background="#111214" Foreground="#F2F3F5" BorderBrush="#C5A059" BorderThickness="1" Padding="3,3" FontSize="11" FontWeight="Bold" HorizontalContentAlignment="Center" LostFocus="CamRecSpeedCustomBox_LostFocus" KeyDown="CamRecSpeedCustomBox_KeyDown" ToolTip="Eigenen Tempo-Faktor eingeben (0.25 bis 10.0) und Enter drücken"/>
                                                <TextBlock Text="x" Foreground="#C5A059" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- RIGHT: SYSTEM SOUND VOLUME & MUTE + LIVE VU METER (Requirement 7) -->
                                <Border Grid.Column="2" Background="#1E1F22" BorderBrush="#2B2D31" BorderThickness="1" CornerRadius="12" Padding="12,7" Margin="10,0,0,0">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="42"/>
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="CamSoundMuteBtn" Grid.Column="0" Click="CamSoundMute_Click" Background="#2B2D31" Foreground="#5865F2" BorderThickness="0" Padding="9,4" Margin="0,0,8,0" Cursor="Hand" FontSize="11.5" FontWeight="Bold" ToolTip="System-Sound / Lautsprecher stummschalten oder aktivieren" Content="🎧 Sound">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                            </Button>
                                            <Slider x:Name="CamSoundVolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="80" VerticalAlignment="Center" ValueChanged="CamSoundVolumeSlider_ValueChanged" Cursor="Hand" ToolTip="System-Lautstärke regeln"/>
                                            <TextBlock x:Name="CamSoundVolumeTxt" Grid.Column="2" Text="80 %" Foreground="#F2F3F5" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="System-Audio Pegel" Foreground="#949BA4" FontSize="10" Width="115" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <ProgressBar x:Name="CamSoundVuBar" Grid.Column="1" Minimum="0" Maximum="100" Value="5" Height="6" Background="#111214" Foreground="#5865F2" BorderThickness="0"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- CENTER VIEWPORT: 16:9 LIVE COMPOSITOR CANVAS + INTERACTIVE PIP GIZMO + OVERLAYS -->
                        <Border x:Name="CamViewportContainerBorder" Background="#07090D" BorderBrush="#222634" BorderThickness="1.5" CornerRadius="16" ClipToBounds="True" SizeChanged="CamViewport_SizeChanged">
                            <Grid x:Name="CamViewportRootGrid">
                                <!-- Live Composited Camera Image (Supports Eyedropper Pipette Click) -->
                                <Image x:Name="CamLivePreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                       MouseLeftButtonDown="CamLivePreviewImage_MouseLeftButtonDown" Cursor="Arrow" SizeChanged="CamViewport_SizeChanged"/>

                                <!-- INTERACTIVE MOUSE-DRAGGABLE, RESIZABLE & RIGHT-CLICKABLE PIP OVERLAY GIZMO -->
                                <Canvas x:Name="CamPipInteractiveCanvas" Visibility="Collapsed"
                                        Width="{Binding ActualWidth, ElementName=CamLivePreviewImage}"
                                        Height="{Binding ActualHeight, ElementName=CamLivePreviewImage}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border x:Name="CamPipInteractiveBox"
                                            Width="240" Height="135" Canvas.Left="420" Canvas.Top="240"
                                            Background="#02FFFFFF" BorderBrush="Transparent" BorderThickness="2" CornerRadius="12"
                                            Cursor="SizeAll"
                                            MouseEnter="CamPipBox_MouseEnter"
                                            MouseLeave="CamPipBox_MouseLeave"
                                            MouseLeftButtonDown="CamPipBox_MouseLeftButtonDown"
                                            MouseMove="CamPipBox_MouseMove"
                                            MouseLeftButtonUp="CamPipBox_MouseLeftButtonUp"
                                            MouseWheel="CamPipBox_MouseWheel"
                                            ToolTip="Zweitfenster: Ziehen zum Verschieben • Mausrad/Ecke zum Skalieren • Rechtsklick für Chroma Key, Runde Form &amp; Scheren-Zuschnitt">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="🚫 Zweitfenster ausblenden (Nur geteiltes Bild einzeln zeigen)" Click="CamPipHideFromHover_Click"/>
                                                <Separator/>
                                                <MenuItem x:Name="CamPipContextChromaItem" Header="🟩 Greenscreen / Chroma Key auf Zweitfenster" Click="CamPipToggleChroma_Click"/>
                                                <MenuItem Header="✂ Scheren-Werkzeug: Zweitfenster zuschneiden" Click="CamPipToggleScissors_Click"/>
                                                <Separator/>
                                                <MenuItem Header="📐 Form: Abgerundet (Standard)" Tag="rounded" Click="CamPipSetShapeMenu_Click"/>
                                                <MenuItem Header="⭕ Form: Rund / Kreis" Tag="circle" Click="CamPipSetShapeMenu_Click"/>
                                                <MenuItem Header="⬢ Form: 6-Eck / Hexagon" Tag="hexagon" Click="CamPipSetShapeMenu_Click"/>
                                                <MenuItem Header="▭ Form: Klassisches Rechteck" Tag="rect" Click="CamPipSetShapeMenu_Click"/>
                                                <Separator/>
                                                <MenuItem Header="⇄ Haupt- und Zweitquelle tauschen" Click="CamSwapSources_Click"/>
                                                <MenuItem Header="↺ Größe, Position &amp; Zuschnitt zurücksetzen" Click="CamPipResetLayout_Click"/>
                                            </ContextMenu>
                                        </Border.ContextMenu>

                                        <Grid>
                                            <!-- Exact Shape Hover Outline (Matches Rounded, Circle/Ellipse, 6-Eck Hexagon, and Rectangle 1:1!) -->
                                            <Path x:Name="CamPipShapeHoverOutline" IsHitTestVisible="False" Visibility="Collapsed"
                                                  Stroke="#C5A059" StrokeThickness="2.2" Fill="#18C5A059" Stretch="None"/>

                                            <!-- Hover Floating Action Bar inside PiP Window -->
                                            <Border x:Name="CamPipHoverToolbar" Visibility="Collapsed"
                                                    Background="#E6111214" BorderBrush="#C5A059" BorderThickness="1" CornerRadius="8" Padding="4,3"
                                                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Click="CamPipCycleShape_Click" Background="#2B2D31" Foreground="#F2F3F5" BorderThickness="0" Padding="6,2" Margin="0,0,3,0" Cursor="Hand" FontSize="10.5" ToolTip="Form ändern (Rund / Abgerundet / 6-Eck / Rechteck)" Content="⭕ Form">
                                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                                                    </Button>
                                                    <Button x:Name="CamPipChromaBtn" Click="CamPipToggleChroma_Click" Background="#2B2D31" Foreground="#34D399" BorderThickness="0" Padding="6,2" Margin="0,0,3,0" Cursor="Hand" FontSize="10.5" ToolTip="Greenscreen auf Zweitfenster anwenden" Content="🟩 Chroma">
                                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                                                    </Button>
                                                    <Button Click="CamPipToggleScissors_Click" Background="#2B2D31" Foreground="#FBBF24" BorderThickness="0" Padding="6,2" Margin="0,0,3,0" Cursor="Hand" FontSize="10.5" ToolTip="Scheren-Werkzeug zum Zuschneiden aktivieren" Content="✂ Schere">
                                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                                                    </Button>
                                                    <Button Click="CamSwapSources_Click" Background="#2B2D31" Foreground="#C5A059" BorderThickness="0" Padding="6,2" Margin="0,0,3,0" Cursor="Hand" FontSize="10.5" ToolTip="Quellen tauschen" Content="⇄">
                                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                                                    </Button>
                                                    <Button Click="CamPipHideFromHover_Click" Background="#2B2D31" Foreground="#F87171" BorderThickness="0" Padding="6,2" Cursor="Hand" FontSize="10.5" FontWeight="Bold" ToolTip="Zweitfenster ausblenden (Nur geteiltes Bild einzeln anzeigen)" Content="✕">
                                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                                                    </Button>
                                                </StackPanel>
                                            </Border>

                                            <!-- Scissors Crop Mode Guides (Visible when Scissors Crop tool is active) -->
                                            <Border x:Name="CamPipScissorsBanner" Visibility="Collapsed"
                                                    Background="#D97C2D12" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="6" Padding="7,2"
                                                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="✂ Kanten ziehen zum Zuschneiden" Foreground="#FEF3C7" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <Button Click="CamPipCropSideStep_Click" Tag="left" Background="#1E1F22" Foreground="#FBBF24" BorderThickness="0" Padding="4,1" Margin="0,0,2,0" Cursor="Hand" FontSize="9" Content="◀L"/>
                                                    <Button Click="CamPipCropSideStep_Click" Tag="right" Background="#1E1F22" Foreground="#FBBF24" BorderThickness="0" Padding="4,1" Margin="0,0,2,0" Cursor="Hand" FontSize="9" Content="R▶"/>
                                                    <Button Click="CamPipCropSideStep_Click" Tag="top" Background="#1E1F22" Foreground="#FBBF24" BorderThickness="0" Padding="4,1" Margin="0,0,2,0" Cursor="Hand" FontSize="9" Content="▲O"/>
                                                    <Button Click="CamPipCropSideStep_Click" Tag="bottom" Background="#1E1F22" Foreground="#FBBF24" BorderThickness="0" Padding="4,1" Cursor="Hand" FontSize="9" Content="U▼"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Bottom-Right Resize Grip Handle -->
                                            <Border x:Name="CamPipResizeGrip" Visibility="Collapsed"
                                                    Width="20" Height="20" CornerRadius="5" Background="#C5A059"
                                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2"
                                                    Cursor="SizeNWSE"
                                                    MouseLeftButtonDown="CamPipResizeGrip_MouseLeftButtonDown"
                                                    MouseMove="CamPipResizeGrip_MouseMove"
                                                    MouseLeftButtonUp="CamPipResizeGrip_MouseLeftButtonUp"
                                                    ToolTip="Ziehen zum Vergrößern / Verkleinern">
                                                <TextBlock Text="⤡" Foreground="#111827" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Canvas>

                                <!-- Eyedropper Active Banner Overlay -->
                                <Border x:Name="CamEyedropperBanner" Background="#D90F172A" BorderBrush="#34D399" BorderThickness="1.5" CornerRadius="10" Padding="16,8"
                                        HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="💧 Pipette aktiv: Klicke jetzt direkt im Live-Kamerabild auf deinen Hintergrund (z.B. Grün/Blau/Wand)!" Foreground="#34D399" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <Button Click="CamCancelEyedropper_Click" Background="#1E293B" Foreground="#F9FAFB" BorderThickness="0" Padding="8,3" Margin="12,0,0,0" Cursor="Hand" FontSize="11" Content="Abbrechen">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Top-Left Live Status Badges -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,14,0,0" IsHitTestVisible="False">
                                    <Border x:Name="CamLiveStatsBadgeBorder" Background="#CC111827" BorderBrush="#374151" BorderThickness="1" CornerRadius="8" Padding="10,4" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="CamLiveDotIndicator" Width="8" Height="8" Fill="#34D399" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock x:Name="CamLiveStatsBadgeTxt" Text="LIVE • 1280x720 • 30 FPS" Foreground="#F9FAFB" FontSize="11" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>

                                    <Border x:Name="CamRecordingBadge" Background="#E6DC2626" CornerRadius="8" Padding="10,4" Margin="0,0,8,0" Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Fill="#FFFFFF" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock x:Name="CamRecordingTimerTxt" Text="REC 00:00" Foreground="#FFFFFF" FontSize="11.5" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>

                                    <Border x:Name="CamActiveEffectsBadge" Background="#CC26231F" BorderBrush="#C5A059" BorderThickness="1" CornerRadius="8" Padding="10,4" Visibility="Collapsed">
                                        <TextBlock x:Name="CamActiveEffectsBadgeTxt" Text="✨ Filter aktiv" Foreground="#C5A059" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>

                                <!-- Center Countdown Overlay (3.. 2.. 1..) -->
                                <Border x:Name="CamCountdownOverlay" Background="#88000000" Visibility="Collapsed" IsHitTestVisible="False">
                                    <TextBlock x:Name="CamCountdownNumberTxt" Text="3" Foreground="#C5A059" FontSize="110" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- White Photo Shutter Flash Overlay -->
                                <Border x:Name="CamShutterFlashBorder" Background="#FFFFFF" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False"/>

                                <!-- Toast Notification inside Viewport -->
                                <Border x:Name="CamToastBanner" Background="#E6161922" BorderBrush="#C5A059" BorderThickness="1" CornerRadius="10" Padding="16,8"
                                        HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18" Visibility="Collapsed" IsHitTestVisible="False">
                                    <TextBlock x:Name="CamToastBannerTxt" Text="📸 Foto gespeichert!" Foreground="#F9FAFB" FontSize="12.5" FontWeight="SemiBold"/>
                                </Border>

                                <!-- BUILT-IN MEDIA PREVIEW OVERLAY (For viewing recorded videos / photos) -->
                                <Border x:Name="CamMediaPreviewOverlay" Background="#F20B0D13" Visibility="Collapsed" Padding="18">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Top" Background="#161922" BorderBrush="#262A36" BorderThickness="1" CornerRadius="11" Padding="14,9" Margin="0,0,0,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock x:Name="CamPreviewTitleTxt" Text="Medien-Vorschau" Foreground="#F9FAFB" FontSize="14" FontWeight="Bold"/>
                                                    <TextBlock x:Name="CamPreviewSubTxt" Text="" Foreground="#9CA3AF" FontSize="11"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <!-- Playback Speed Controls inside Video Preview -->
                                                    <Border x:Name="CamPreviewSpeedBarBorder" Background="#1F2430" BorderBrush="#2B2D31" BorderThickness="1" CornerRadius="8" Padding="4,2" Margin="0,0,8,0">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="Tempo:" Foreground="#9CA3AF" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,6,0"/>
                                                            <Button x:Name="CamPrevSpeed1xBtn" Click="CamPreviewSpeedPreset_Click" Tag="1x" Background="#C5A059" Foreground="#111827" FontWeight="Bold" BorderThickness="0" Padding="7,4" Margin="0,0,2,0" Cursor="Hand" FontSize="11" Content="1x">
                                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                                            </Button>
                                                            <Button x:Name="CamPrevSpeed2xBtn" Click="CamPreviewSpeedPreset_Click" Tag="2x" Background="Transparent" Foreground="#D1D5DB" FontWeight="SemiBold" BorderThickness="0" Padding="7,4" Margin="0,0,2,0" Cursor="Hand" FontSize="11" Content="2x">
                                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                                            </Button>
                                                            <Button x:Name="CamPrevSpeed3xBtn" Click="CamPreviewSpeedPreset_Click" Tag="3x" Background="Transparent" Foreground="#D1D5DB" FontWeight="SemiBold" BorderThickness="0" Padding="7,4" Margin="0,0,2,0" Cursor="Hand" FontSize="11" Content="3x">
                                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                                            </Button>
                                                            <Button x:Name="CamPrevSpeedCustomBtn" Click="CamPreviewSpeedPreset_Click" Tag="custom" Background="Transparent" Foreground="#D1D5DB" FontWeight="SemiBold" BorderThickness="0" Padding="7,4" Cursor="Hand" FontSize="11" Content="Indiv.">
                                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                                            </Button>
                                                            <StackPanel x:Name="CamPrevSpeedCustomWrap" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,2,0" Visibility="Collapsed">
                                                                <TextBox x:Name="CamPrevSpeedCustomBox" Text="1.5" Width="36" Background="#111214" Foreground="#F9FAFB" BorderBrush="#C5A059" BorderThickness="1" Padding="2,2" FontSize="11" FontWeight="Bold" HorizontalContentAlignment="Center" LostFocus="CamPrevSpeedCustomBox_LostFocus" KeyDown="CamPrevSpeedCustomBox_KeyDown"/>
                                                                <TextBlock Text="x" Foreground="#C5A059" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="2,0,2,0"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>

                                                    <Button x:Name="CamPreviewPlayPauseBtn" Click="CamPreviewPlayPause_Click" Background="#C5A059" Foreground="#111827" FontWeight="Bold" BorderThickness="0" Padding="12,6" Margin="0,0,8,0" Cursor="Hand" FontSize="12" Content="⏯ Start/Pause">
                                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                                    </Button>
                                                    <Button Click="CamPreviewOpenExplorer_Click" Background="#1F2430" Foreground="#D1D5DB" BorderThickness="0" Padding="12,6" Margin="0,0,8,0" Cursor="Hand" FontSize="12" Content="📂 Im Explorer zeigen">
                                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                                    </Button>
                                                    <Button Click="CamCloseMediaPreview_Click" Background="#2D161B" Foreground="#F87171" FontWeight="Bold" BorderThickness="0" Padding="12,6" Cursor="Hand" FontSize="12" Content="✕ Zurück zum Live-Studio">
                                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Grid>
                                            <MediaElement x:Name="CamPreviewMediaElement" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform" MediaEnded="CamPreviewMedia_MediaEnded"/>
                                            <Image x:Name="CamPreviewSnapshotImage" Stretch="Uniform" Visibility="Collapsed"/>
                                        </Grid>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>

                <!-- COLUMN 4: RIGHT STUDIO INSPECTOR (BILD & ZOOM | EFFEKTE | DEEP FAKE | GREENSCREEN) -->
                <Border Grid.Column="4" Background="#141720" BorderBrush="#1F222D" BorderThickness="1,0,0,0" Padding="14,16">
                    <DockPanel>
                        <!-- Inspector Sub-Tab Bar (5 Tabs: Bild & Zoom | Stimme | Effekte | Deep Fake | Chroma) -->
                        <Border DockPanel.Dock="Top" Background="#0D0F14" BorderBrush="#1F222D" BorderThickness="1" CornerRadius="11" Padding="3" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.15*"/>
                                    <ColumnDefinition Width="0.90*"/>
                                    <ColumnDefinition Width="0.90*"/>
                                    <ColumnDefinition Width="1.05*"/>
                                    <ColumnDefinition Width="0.88*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="CamTabImageBtn" Grid.Column="0" Background="#2E291F" BorderBrush="#C5A059" BorderThickness="1" CornerRadius="8" Padding="3,7" Cursor="Hand" MouseLeftButtonUp="CamInspectorTab_Click" Tag="image">
                                    <TextBlock x:Name="CamTabImageTxt" Text="🎛 Bild &amp; Zoom" Foreground="#F9FAFB" FontSize="10.2" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </Border>
                                <Border x:Name="CamTabVoiceBtn" Grid.Column="1" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="3,7" Cursor="Hand" MouseLeftButtonUp="CamInspectorTab_Click" Tag="voice">
                                    <TextBlock x:Name="CamTabVoiceTxt" Text="🎙 Stimme" Foreground="#E5E7EB" FontSize="10.2" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                </Border>
                                <Border x:Name="CamTabEffectsBtn" Grid.Column="2" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="3,7" Cursor="Hand" MouseLeftButtonUp="CamInspectorTab_Click" Tag="effects">
                                    <TextBlock x:Name="CamTabEffectsTxt" Text="✨ Effekte" Foreground="#E5E7EB" FontSize="10.2" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                </Border>
                                <Border x:Name="CamTabDeepFakeBtn" Grid.Column="3" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="3,7" Cursor="Hand" MouseLeftButtonUp="CamInspectorTab_Click" Tag="deepfake">
                                    <TextBlock x:Name="CamTabDeepFakeTxt" Text="🎭 Deep Fake" Foreground="#E5E7EB" FontSize="10.2" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                </Border>
                                <Border x:Name="CamTabChromaBtn" Grid.Column="4" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="3,7" Cursor="Hand" MouseLeftButtonUp="CamInspectorTab_Click" Tag="chroma">
                                    <TextBlock x:Name="CamTabChromaTxt" Text="🟩 Chroma" Foreground="#E5E7EB" FontSize="10.2" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- ======================================================= -->
                                <!-- INSPECTOR PANE 1: BILD, ZOOM, FOKUS, AWB & VIDEO-SIGNAL -->
                                <!-- (Requirements 10, 11, 12, 13 + Dynamic Video Signal)    -->
                                <!-- ======================================================= -->
                                <StackPanel x:Name="CamInspectorImagePane" Visibility="Visible">
                                    <!-- 10. ZOOM & PAN / TILT -->
                                    <Border Background="#181B24" BorderBrush="#262A36" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,0,0,10">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="🔍 ZOOM &amp; SCHWENKEN / NEIGEN" Foreground="#9CA3AF" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="CamZoomValueTxt" Grid.Column="1" Text="1.0x" Foreground="#C5A059" FontSize="12" FontWeight="Bold"/>
                                            </Grid>

                                            <Slider x:Name="CamZoomSlider" Minimum="1.0" Maximum="4.0" Value="1.0" SmallChange="0.1" LargeChange="0.5" ValueChanged="CamZoomSlider_ValueChanged" Cursor="Hand" Margin="0,0,0,8"/>

                                            <!-- Quick Zoom Presets -->
                                            <UniformGrid Columns="4" Rows="1" Margin="0,0,0,8">
                                                <Button Click="CamZoomPreset_Click" Tag="1.0" Background="#13161F" Foreground="#D1D5DB" BorderThickness="0" Padding="4,5" Margin="0,0,3,0" Cursor="Hand" FontSize="11" FontWeight="Bold" Content="1.0x">
                                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                                </Button>
                                                <Button Click="CamZoomPreset_Click" Tag="1.5" Background="#13161F" Foreground="#D1D5DB" BorderThickness="0" Padding="4,5" Margin="2,0,2,0" Cursor="Hand" FontSize="11" FontWeight="Bold" Content="1.5x">
                                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                                </Button>
                                                <Button Click="CamZoomPreset_Click" Tag="2.0" Background="#13161F" Foreground="#D1D5DB" BorderThickness="0" Padding="4,5" Margin="2,0,2,0" Cursor="Hand" FontSize="11" FontWeight="Bold" Content="2.0x">
                                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                                </Button>
                                                <Button Click="CamZoomPreset_Click" Tag="3.0" Background="#13161F" Foreground="#D1D5DB" BorderThickness="0" Padding="4,5" Margin="3,0,0,0" Cursor="Hand" FontSize="11" FontWeight="Bold" Content="3.0x">
                                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                                </Button>
                                            </UniformGrid>

                                            <!-- Pan X / Tilt Y (Now works immediately even at 1.0x via Overscan + Hardware PTZ!) -->
                                            <Grid Margin="0,0,0,5">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Schwenken (X):" Foreground="#9CA3AF" FontSize="11" VerticalAlignment="Center"/>
                                                <Slider x:Name="CamPanXSlider" Grid.Column="1" Minimum="-100" Maximum="100" Value="0" ValueChanged="CamPanTilt_ValueChanged" Cursor="Hand"/>
                                                <TextBlock x:Name="CamPanXTxt" Grid.Column="2" Text="0" Foreground="#C5A059" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Neigen (Y):" Foreground="#9CA3AF" FontSize="11" VerticalAlignment="Center"/>
                                                <Slider x:Name="CamPanYSlider" Grid.Column="1" Minimum="-100" Maximum="100" Value="0" ValueChanged="CamPanTilt_ValueChanged" Cursor="Hand"/>
                                                <TextBlock x:Name="CamPanYTxt" Grid.Column="2" Text="0" Foreground="#C5A059" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- Mirror H / Flip V -->
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <CheckBox x:Name="CamMirrorHCheck" Grid.Column="0" Content="↔ Spiegeln (H)" Foreground="#D1D5DB" FontSize="11.5" Checked="CamTransformCheck_Changed" Unchecked="CamTransformCheck_Changed" Cursor="Hand"/>
                                                <CheckBox x:Name="CamFlipVCheck" Grid.Column="2" Content="↕ Kopfüber (V)" Foreground="#D1D5DB" FontSize="11.5" Checked="CamTransformCheck_Changed" Unchecked="CamTransformCheck_Changed" Cursor="Hand"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- 11 & 12. AUTOFOCUS & AUTOMATISCHER WEISSABGLEICH -->
                                    <Border Background="#181B24" BorderBrush="#262A36" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="🎯 AUTOFOKUS &amp; WEISSABGLEICH" Foreground="#9CA3AF" FontSize="10.5" FontWeight="Bold" Margin="0,0,0,8"/>

                                            <!-- Autofocus (Requirement 11) -->
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Autofokus (Kamera-Hardware)" Foreground="#F9FAFB" FontSize="12.5" FontWeight="SemiBold"/>
                                                    <TextBlock Text="Automatische Scharfstellung des Sensors" Foreground="#6B7280" FontSize="10.5"/>
                                                </StackPanel>
                                                <CheckBox x:Name="CamAutofocusCheck" Grid.Column="1" IsChecked="True" VerticalAlignment="Center" Checked="CamAutofocusCheck_Changed" Unchecked="CamAutofocusCheck_Changed" Cursor="Hand">
                                                    <CheckBox.LayoutTransform><ScaleTransform ScaleX="1.15" ScaleY="1.15"/></CheckBox.LayoutTransform>
                                                </CheckBox>
                                            </Grid>

                                            <Grid x:Name="CamManualFocusRow" Margin="0,0,0,10" Opacity="0.45" IsEnabled="False">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="95"/><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Manueller Fokus:" Foreground="#9CA3AF" FontSize="11" VerticalAlignment="Center"/>
                                                <Slider x:Name="CamManualFocusSlider" Grid.Column="1" Minimum="0" Maximum="250" Value="60" ValueChanged="CamManualFocusSlider_ValueChanged" Cursor="Hand"/>
                                                <TextBlock x:Name="CamManualFocusTxt" Grid.Column="2" Text="60" Foreground="#C5A059" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>

                                            <Border Height="1" Background="#232734" Margin="0,0,0,8"/>

                                            <!-- Auto White Balance (Requirement 12) -->
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Automatischer Weißabgleich (AWB)" Foreground="#F9FAFB" FontSize="12.5" FontWeight="SemiBold"/>
                                                    <TextBlock Text="Hardware-AWB + intelligente Farbtemperatur-Korrektur" Foreground="#6B7280" FontSize="10.5" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <CheckBox x:Name="CamAutoWbCheck" Grid.Column="1" IsChecked="True" VerticalAlignment="Center" Checked="CamAutoWbCheck_Changed" Unchecked="CamAutoWbCheck_Changed" Cursor="Hand">
                                                    <CheckBox.LayoutTransform><ScaleTransform ScaleX="1.15" ScaleY="1.15"/></CheckBox.LayoutTransform>
                                                </CheckBox>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- 13. BILDEINSTELLUNGEN (Helligkeit, Kontrast, Wärme, Schärfe) -->
                                    <Border Background="#181B24" BorderBrush="#262A36" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,0,0,10">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="☀ BILDEINSTELLUNGEN" Foreground="#9CA3AF" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                                <Button Click="CamResetImageAdjustments_Click" Background="#1F2430" Foreground="#C5A059" BorderThickness="0" Padding="8,3" Cursor="Hand" FontSize="10.5" FontWeight="Bold" Content="↺ Standard">
                                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                                </Button>
                                            </Grid>

                                            <!-- Helligkeit -->
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Helligkeit:" Foreground="#D1D5DB" FontSize="11.5" VerticalAlignment="Center"/>
                                                <Slider x:Name="CamBrightnessSlider" Grid.Column="1" Minimum="-100" Maximum="100" Value="0" ValueChanged="CamImageSetting_ValueChanged" Cursor="Hand"/>
                                                <TextBlock x:Name="CamBrightnessTxt" Grid.Column="2" Text="0" Foreground="#C5A059" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- Kontrast -->
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Kontrast:" Foreground="#D1D5DB" FontSize="11.5" VerticalAlignment="Center"/>
                                                <Slider x:Name="CamContrastSlider" Grid.Column="1" Minimum="-100" Maximum="100" Value="0" ValueChanged="CamImageSetting_ValueChanged" Cursor="Hand"/>
                                                <TextBlock x:Name="CamContrastTxt" Grid.Column="2" Text="0" Foreground="#C5A059" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- Wärme -->
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Wärme:" Foreground="#D1D5DB" FontSize="11.5" VerticalAlignment="Center"/>
                                                <Slider x:Name="CamWarmthSlider" Grid.Column="1" Minimum="-100" Maximum="100" Value="0" ValueChanged="CamImageSetting_ValueChanged" Cursor="Hand"/>
                                                <TextBlock x:Name="CamWarmthTxt" Grid.Column="2" Text="0" Foreground="#C5A059" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- Schärfe -->
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Schärfe:" Foreground="#D1D5DB" FontSize="11.5" VerticalAlignment="Center"/>
                                                <Slider x:Name="CamSharpnessSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="0" ValueChanged="CamImageSetting_ValueChanged" Cursor="Hand"/>
                                                <TextBlock x:Name="CamSharpnessTxt" Grid.Column="2" Text="0" Foreground="#C5A059" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- ======================================================= -->
                                    <!-- NEW: DYNAMIC VIDEO SIGNAL INJECTOR & LOOP DECK          -->
                                    <!-- (Bottom of "Bild & Zoom" as requested)                  -->
                                    <!-- ======================================================= -->
                                    <Border Background="#181B24" BorderBrush="#C5A059" BorderThickness="1" CornerRadius="12" Padding="12,11" Margin="0,0,0,10">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="🎬 VIDEO-EINSPIELER, TARN-CLIP &amp; BOOMERANG" Foreground="#C5A059" FontSize="10.5" FontWeight="Bold"/>
                                                    <TextBlock Text="Spiele per Knopfdruck Videos &amp; Tarn-Clips als Live-Kamerasignal ein" Foreground="#9CA3AF" FontSize="10"/>
                                                </StackPanel>
                                                <CheckBox x:Name="CamVideoLoopCheck" Grid.Column="1" Content="🔁 Dauerschleife" IsChecked="True" Foreground="#34D399" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Checked="CamVideoLoopCheck_Changed" Unchecked="CamVideoLoopCheck_Changed" Cursor="Hand"/>
                                            </Grid>

                                            <!-- Playback Behavior Checkboxes: Return to Original Live Recording + Instagram Boomerang -->
                                            <StackPanel Margin="0,0,0,8">
                                                <CheckBox x:Name="CamVideoSignalReturnLiveCheck" Content="↩ Auf Original-Aufnahme springen nach Ablauf" IsChecked="False" Foreground="#F2F3F5" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5" Checked="CamVideoSignalReturnLiveCheck_Changed" Unchecked="CamVideoSignalReturnLiveCheck_Changed" Cursor="Hand" ToolTip="Springt automatisch zurück auf das Live-Kamerabild, sobald der Tarn-Clip oder das Video einmal abgelaufen ist"/>
                                                <CheckBox x:Name="CamVideoSignalBoomerangCheck" Content="🪃 Boomerang-Modus (Vorwärts ⇄ Rückwärts wie Instagram)" IsChecked="False" Foreground="#F472B6" FontSize="11" FontWeight="SemiBold" Checked="CamVideoSignalBoomerangCheck_Changed" Unchecked="CamVideoSignalBoomerangCheck_Changed" Cursor="Hand" ToolTip="Spielt den Clip wie bei Instagram Boomerang nahtlos vorwärts und rückwärts ab"/>
                                            </StackPanel>

                                            <!-- Tarn-Clip Duration Selector (Default 10s: 5s | 10s | 15s | Manuell) -->
                                            <Border Background="#111214" BorderBrush="#2B2D31" BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,5">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="⏱ TARN-CLIP LÄNGE (STANDARD: 10 SEK.)" Foreground="#9CA3AF" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="Manuell:" Foreground="#9CA3AF" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                            <TextBox x:Name="CamTarnCustomSecBox" Text="10" Width="40" Background="#1E1F22" Foreground="#F2F3F5" BorderBrush="#2B2D31" BorderThickness="1" Padding="4,2" FontSize="11" FontWeight="Bold" HorizontalContentAlignment="Center" TextChanged="CamTarnCustomSecBox_TextChanged" ToolTip="Eigene Tarn-Clip Dauer in Sekunden (1 - 120s)"/>
                                                            <TextBlock Text="s" Foreground="#9CA3AF" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <UniformGrid Columns="4" Rows="1">
                                                        <Button x:Name="CamTarnLen5Btn" Click="CamTarnDurationPreset_Click" Tag="5" Background="#1E1F22" Foreground="#D1D5DB" BorderBrush="#2B2D31" BorderThickness="1" Padding="4,4" Margin="0,0,2,0" Cursor="Hand" FontSize="10.5" FontWeight="Bold" Content="5 Sek."/>
                                                        <Button x:Name="CamTarnLen10Btn" Click="CamTarnDurationPreset_Click" Tag="10" Background="#C5A059" Foreground="#111827" BorderBrush="#C5A059" BorderThickness="1" Padding="4,4" Margin="2,0,2,0" Cursor="Hand" FontSize="10.5" FontWeight="Bold" Content="10 Sek. (Std)"/>
                                                        <Button x:Name="CamTarnLen15Btn" Click="CamTarnDurationPreset_Click" Tag="15" Background="#1E1F22" Foreground="#D1D5DB" BorderBrush="#2B2D31" BorderThickness="1" Padding="4,4" Margin="2,0,2,0" Cursor="Hand" FontSize="10.5" FontWeight="Bold" Content="15 Sek."/>
                                                        <Button x:Name="CamTarnLenCustomBtn" Click="CamTarnDurationPreset_Click" Tag="custom" Background="#1E1F22" Foreground="#D1D5DB" BorderBrush="#2B2D31" BorderThickness="1" Padding="4,4" Margin="2,0,0,0" Cursor="Hand" FontSize="10.5" FontWeight="Bold" Content="Manuell"/>
                                                    </UniformGrid>
                                                </StackPanel>
                                            </Border>

                                            <!-- Quick Actions: Add Video File + Record Tarn-Clip (10s default) + Record Instagram Boomerang Clip -->
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="5"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="5"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Click="CamAddVideoSignal_Click" Grid.Column="0" Background="#2B2D31" Foreground="#F2F3F5" BorderBrush="#3F4147" BorderThickness="1" Padding="7,6" Cursor="Hand" FontSize="10.5" FontWeight="Bold" Content="➕ Video...">
                                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style></Button.Resources>
                                                </Button>
                                                <Button x:Name="CamRecordQuickLoopBtn" Click="CamRecordQuickLoop_Click" Grid.Column="2" Background="#26231F" Foreground="#C5A059" BorderBrush="#C5A059" BorderThickness="1" Padding="8,6" Cursor="Hand" FontSize="10.5" FontWeight="Bold" ToolTip="Nimmt deine aktuelle Kamera für die gewählte Dauer (Standard: 10s) auf und legt es als abspielbares Tarn-Video an!" Content="⏺ 10s Tarn-Clip">
                                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style></Button.Resources>
                                                </Button>
                                                <Button x:Name="CamRecordBoomerangBtn" Click="CamRecordBoomerangClip_Click" Grid.Column="4" Background="#2D1B2E" Foreground="#F472B6" BorderBrush="#EC4899" BorderThickness="1" Padding="8,6" Cursor="Hand" FontSize="10.5" FontWeight="Bold" ToolTip="Instagram Boomerang: Erstellt einen Kurz-Clip, der immer wieder vorwärts und rückwärts läuft!" Content="🪃 Boomerang">
                                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style></Button.Resources>
                                                </Button>
                                            </Grid>

                                            <!-- Active Signal Status Banner -->
                                            <Border x:Name="CamVideoSignalActiveBar" Background="#064E3B" BorderBrush="#10B981" BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="0,0,0,8" Visibility="Collapsed">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="CamVideoSignalStatusTxt" Text="▶ Sendet: Video.mp4 (Dauerschleife)" Foreground="#ECFDF5" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <Button x:Name="CamStopVideoSignalBtn" Grid.Column="1" Click="CamStopVideoSignal_Click" Background="#DC2626" Foreground="#FFFFFF" BorderThickness="0" Padding="8,3" Cursor="Hand" FontSize="10.5" FontWeight="Bold" Content="⏹ Live-Kamera">
                                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                                                    </Button>
                                                </Grid>
                                            </Border>

                                            <!-- Dynamic Clip List Container -->
                                            <StackPanel x:Name="CamVideoSignalListPanel"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- ======================================================= -->
                                    <!-- MUSIK-EINSPIELER & STUDIO-SOUND (Under Video-Einspieler)-->
                                    <!-- ======================================================= -->
                                    <Border Background="#181B24" BorderBrush="#C5A059" BorderThickness="1" CornerRadius="12" Padding="12,11" Margin="0,0,0,10">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="🎵 MUSIK-EINSPIELER" Foreground="#C5A059" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                                <CheckBox x:Name="CamMusicLoopCheck" Grid.Column="1" Content="🔁 Dauerschleife" IsChecked="True" Foreground="#34D399" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Checked="CamMusicLoopCheck_Changed" Unchecked="CamMusicLoopCheck_Changed" Cursor="Hand"/>
