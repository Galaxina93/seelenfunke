                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                </Button>
                            </Grid>
                        </Border>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="MusicPlaylistsPanel" Margin="0,0,4,0"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Resizable Splitter 1 -->
                <GridSplitter Grid.Column="1" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" DragCompleted="Splitter_DragCompleted"/>

                <!-- 5B: Center Tracklist & URL Importer -->
                <Border Grid.Column="2" Background="#0F1117" Padding="24,20">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="MusicHeaderTitle" Text="Lieblingssongs" Foreground="#F9FAFB" FontSize="24" FontWeight="Bold"/>
                                    <TextBlock x:Name="MusicHeaderSubtitle" Text="148 Titel · Unterbrechungsfreies Funkenwerk-Streaming &amp; Lokaler Smart-Cache" Foreground="#9CA3AF" FontSize="12.5" Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Click="MusicPlayAll_Click" Background="#C5A059" Foreground="#111827" BorderThickness="0" Padding="14,8" Margin="0,0,8,0" Cursor="Hand" FontWeight="Bold" FontSize="12.5" Content="▶ Alle abspielen">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                                    </Button>
                                    <Button Click="MusicShuffleAll_Click" Background="#1F2430" Foreground="#F3F4F6" BorderBrush="#4D3D1E" BorderThickness="1" Padding="13,8" Cursor="Hand" FontWeight="SemiBold" FontSize="12.5">
