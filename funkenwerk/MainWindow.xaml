                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="OrdersAutoPrintToggleBtn" Click="OrdersAutoPrintToggle_Click" Background="#C5A059" Foreground="#111827" BorderBrush="#C5A059" BorderThickness="1" Padding="12,7" Margin="0,0,8,0" Cursor="Hand" FontSize="11.5" FontWeight="Bold" Content="⚡ Auto-Print: EIN" ToolTip="Wenn aktiv, werden neue Druckaufträge aus dem Shop automatisch auf dem MUNBYN ausgedruckt">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                            </Button>
                            <Button Click="OrdersRefreshQueue_Click" Background="#1E222D" Foreground="#F9FAFB" BorderBrush="#2D3346" BorderThickness="1" Padding="12,7" Margin="0,0,8,0" Cursor="Hand" FontSize="11.5" FontWeight="Bold" Content="🔄 Jetzt synchronisieren" ToolTip="Warteschlange und Drucker-Status sofort abfragen">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                            </Button>
                            <Button x:Name="OrdersPrintAllPendingBtn" Click="OrdersPrintAllPending_Click" Background="#132226" Foreground="#34D399" BorderBrush="#104E3B" BorderThickness="1" Padding="12,7" Margin="0,0,8,0" Cursor="Hand" FontSize="11.5" FontWeight="Bold" Content="🖨 Alle offenen drucken" ToolTip="Alle wartenden Aufträge jetzt nacheinander drucken">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                            </Button>
                            <Button Click="SmartTestPrintLabel_Click" Background="#1E222D" Foreground="#D4AF37" BorderBrush="#C5A059" BorderThickness="1" Padding="12,7" Margin="0,0,8,0" Cursor="Hand" FontSize="11.5" FontWeight="Bold" Content="🧪 Test-Label" ToolTip="Druckt ein 4×6 Zoll Kalibrierungs-Label und protokolliert jeden Schritt im Diagnose-Log">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                            </Button>
                            <Button Click="OrdersIdentifyBeep_Click" Background="#1E222D" Foreground="#E5E7EB" BorderBrush="#2D3346" BorderThickness="1" Padding="10,7" Margin="0,0,8,0" Cursor="Hand" FontSize="11.5" FontWeight="Bold" Content="🔔 Ping" ToolTip="Lässt den MUNBYN im WLAN piepen (Verbindungstest ohne Papier)">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                            </Button>
                            <Button Click="OrdersClearHistory_Click" Background="#2D161B" Foreground="#F87171" BorderBrush="#7F1D1D" BorderThickness="1" Padding="10,7" Cursor="Hand" FontSize="11.5" FontWeight="Bold" Content="🗑 Verlauf leeren" ToolTip="Erledigte und fehlgeschlagene Aufträge aus der Liste entfernen">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Main Body: Left = Pending Queue + History | Right = Label Preview + Live Diagnostic Log -->
                <Grid Grid.Row="1" Margin="20,16,20,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="460"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT COLUMN: Warteschlange & Verlauf -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,16,0">
                        <StackPanel>
                            <!-- 1. Offene Druck-Warteschlange -->
                            <Border Background="#151822" BorderBrush="#232734" BorderThickness="1" CornerRadius="14" Padding="18,16" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="⏳ AKTIVE DRUCK-WARTESCHLANGE (OFFEN)" Foreground="#D4AF37" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <Border Background="#2A1E17" BorderBrush="#C5A059" BorderThickness="1" CornerRadius="7" Padding="8,2" Margin="10,0,0,0">
                                                <TextBlock x:Name="OrdersPendingCountBadgeTxt" Text="0 offen" Foreground="#FEF3C7" FontSize="10.5" FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="Wird bei aktivem Auto-Print sofort abgearbeitet" Foreground="#6B7280" FontSize="11" VerticalAlignment="Center"/>
                                    </Grid>

                                    <StackPanel x:Name="OrdersPendingListPanel"/>
                                </StackPanel>
                            </Border>

                            <!-- 2. Abgeschlossene & Fehlgeschlagene Druckaufträge (mit "Erneut drucken" & "Vorschau") -->
                            <Border Background="#151822" BorderBrush="#232734" BorderThickness="1" CornerRadius="14" Padding="18,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="📋 LETZTE DRUCKAUFTRÄGE &amp; VERLAUF" Foreground="#F9FAFB" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <Border Background="#1E222D" BorderBrush="#2D3346" BorderThickness="1" CornerRadius="7" Padding="8,2" Margin="10,0,0,0">
                                                <TextBlock x:Name="OrdersHistoryCountBadgeTxt" Text="0 Einträge" Foreground="#E5E7EB" FontSize="10.5" FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="Jedes DHL-Label kann hier jederzeit erneut gedruckt werden" Foreground="#6B7280" FontSize="11" VerticalAlignment="Center"/>
                                    </Grid>

                                    <StackPanel x:Name="OrdersHistoryListPanel"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- RIGHT COLUMN: 4x6" Label-Vorschau + Echtzeit-Diagnose-Log -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="320"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Top: Live 4x6" Label Preview -->
                        <Border Grid.Row="0" Background="#151822" BorderBrush="#232734" BorderThickness="1" CornerRadius="14" Padding="14,12" Margin="0,0,0,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="OrdersPreviewTitleTxt" Text="👁 4×6&quot; LABEL-VORSCHAU (203 DPI)" Foreground="#D4AF37" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Button x:Name="OrdersPrintPreviewedJobBtn" Click="OrdersPrintPreviewedJob_Click" Background="#C5A059" Foreground="#111827" BorderBrush="#C5A059" BorderThickness="1" Padding="10,4" Cursor="Hand" FontSize="10.5" FontWeight="Bold" Content="🖨 Dieses Label drucken" Visibility="Collapsed">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                    </Button>
                                </Grid>
                                <Border Grid.Row="1" Background="#0B0D12" BorderBrush="#232836" BorderThickness="1" CornerRadius="10" Padding="8">
                                    <Grid>
                                        <TextBlock x:Name="OrdersPreviewPlaceholderTxt" Text="Klicke bei einem Auftrag auf „👁 Vorschau“ oder starte einen Druck, um das gerenderte 100×150 mm Etikett hier zu prüfen." Foreground="#6B7280" FontSize="11.5" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Width="280"/>
                                        <Image x:Name="OrdersLabelPreviewImg" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Bottom: Live Diagnostic & Printer Log -->
                        <Border Grid.Row="1" Background="#151822" BorderBrush="#232734" BorderThickness="1" CornerRadius="14" Padding="14,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🔍 ECHTZEIT-DIAGNOSE &amp; DRUCK-LOG" Foreground="#F9FAFB" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Click="OrdersCopyLog_Click" Background="#1E222D" Foreground="#E5E7EB" BorderBrush="#2D3346" BorderThickness="1" Padding="8,3" Margin="0,0,6,0" Cursor="Hand" FontSize="10" FontWeight="Bold" Content="📋 Kopieren">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                        </Button>
                                        <Button Click="OrdersClearLog_Click" Background="#1E222D" Foreground="#9CA3AF" BorderBrush="#2D3346" BorderThickness="1" Padding="8,3" Cursor="Hand" FontSize="10" FontWeight="Bold" Content="🧹 Leeren">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <Border Grid.Row="1" Background="#0B0D12" BorderBrush="#232836" BorderThickness="1" CornerRadius="10" Padding="8">
                                    <TextBox x:Name="OrdersDiagnosticLogBox"
                                             IsReadOnly="True"
                                             Background="Transparent"
                                             Foreground="#E5E7EB"
                                             BorderThickness="0"
                                             FontFamily="Consolas"
                                             FontSize="11"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Disabled"
                                             VerticalContentAlignment="Top"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ===================================================================== -->
            <!-- GLOBAL FLOATING MINI-PLAYER BAR (Visible in Mail/Todo while playing)  -->
            <!-- ===================================================================== -->
            <Border x:Name="GlobalMiniPlayerBar" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,22,18"
                    Background="#181B24" BorderBrush="#C5A059" BorderThickness="1" CornerRadius="16" Padding="14,10"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="9" Background="#26231F" Margin="0,0,10,0" Cursor="Hand" MouseLeftButtonUp="MiniPlayerOpenMusic_Click">
                        <TextBlock Text="🎵" Foreground="#C5A059" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Width="175" Margin="0,0,8,0" Cursor="Hand" MouseLeftButtonUp="MiniPlayerOpenMusic_Click">
                        <TextBlock x:Name="MiniPlayerTitleTxt" Text="Songtitel" Foreground="#F9FAFB" FontSize="12.5" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="MiniPlayerArtistTxt" Text="Künstler" Foreground="#C5A059" FontSize="11" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button x:Name="MiniPlayerFavBtn" Click="MusicNowPlayingFav_Click" ToolTip="Als Lieblingssong markieren" Background="Transparent" Foreground="#6B7280" BorderThickness="0" Padding="5,4" Cursor="Hand" FontSize="15" Content="♡"/>
                    <Button Click="MusicPrev_Click" Background="Transparent" Foreground="#D1D5DB" BorderThickness="0" Padding="6,4" Cursor="Hand" FontSize="13" Content="⏮"/>
                    <Button x:Name="MiniPlayerPlayBtn" Click="MusicPlayPause_Click" Background="#C5A059" Foreground="#111827" BorderThickness="0" Width="32" Height="32" Margin="4,0" Cursor="Hand" FontSize="13" FontWeight="Bold" Content="▶">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="16"/></Style></Button.Resources>
                    </Button>
                    <Button Click="MusicNext_Click" Background="Transparent" Foreground="#D1D5DB" BorderThickness="0" Padding="6,4" Cursor="Hand" FontSize="13" Content="⏭"/>
                    <Button Click="EnterMusicVenomFocusMode_Click" ToolTip="Fokus Modus (Venom Animation)" Background="#1F090D" Foreground="#EF4444" BorderBrush="#7F1D1D" BorderThickness="1" Padding="7,4" Margin="4,0,0,0" Cursor="Hand" FontSize="10.5" FontWeight="Bold" Content="Fokus">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ===================================================================== -->
            <!-- MODAL OVERLAY 1: COMPOSE / REPLY E-MAIL (Mein Seelenfunke Parity)     -->
            <!-- ===================================================================== -->
            <Grid x:Name="ComposeModalOverlay" Background="#B3000000" Visibility="Collapsed">
                <Border Width="760" MaxHeight="810" Background="#161922" BorderBrush="#262A36" BorderThickness="1" CornerRadius="18" Padding="24,20" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="ComposeModalTitle" Text="Neue E-Mail schreiben" Foreground="#F9FAFB" FontSize="19" FontWeight="Bold"/>
                            <Button Grid.Column="1" Click="CloseCompose_Click" Style="{StaticResource ModalCloseButtonStyle}" Content="✕"/>
                        </Grid>

                        <!-- VON POSTFACH -->
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="VON POSTFACH" Foreground="#9CA3AF" FontSize="10.5" FontWeight="Bold" Margin="0,0,0,4"/>
                            <ComboBox x:Name="ComposeAccountCombo" DisplayMemberPath="DisplayLabel" SelectedValuePath="Id" Padding="8,6" FontSize="13"/>
                        </StackPanel>

                        <!-- EMPFÄNGER (AN) + CC/BCC TOGGLE + KACHELN -->
                        <StackPanel Margin="0,0,0,10" Panel.ZIndex="80">
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="EMPFÄNGER (AN)" Foreground="#9CA3AF" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock Text="  ·  Enter = als Kachel hinzufügen" Foreground="#6B7280" FontSize="10.5" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="ComposeToggleCcBtn" Click="ToggleComposeCc_Click" Background="#1F2430" Foreground="#D1D5DB" BorderBrush="#2E3446" BorderThickness="1" Padding="9,3" Margin="0,0,6,0" Cursor="Hand" ToolTip="CC (Kopie) ein-/ausblenden">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                        <TextBlock x:Name="ComposeToggleCcTxt" Text="+ CC" FontSize="11" FontWeight="Bold"/>
                                    </Button>
                                    <Button x:Name="ComposeToggleBccBtn" Click="ToggleComposeBcc_Click" Background="#1F2430" Foreground="#D1D5DB" BorderBrush="#2E3446" BorderThickness="1" Padding="9,3" Cursor="Hand" ToolTip="BCC (Blindkopie) ein-/ausblenden">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                        <TextBlock x:Name="ComposeToggleBccTxt" Text="+ BCC" FontSize="11" FontWeight="Bold"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <Grid>
                                <Border x:Name="ComposeToFieldBorder" Background="#0F1117" BorderBrush="#262A36" BorderThickness="1" CornerRadius="10" Padding="6,5" MinHeight="38" Cursor="IBeam" MouseLeftButtonDown="ComposeToFieldBorder_MouseLeftButtonDown">
                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <WrapPanel x:Name="ComposeToChipsPanel" Orientation="Horizontal" VerticalAlignment="Center"/>
                                        <TextBox x:Name="ComposeToInput" Background="Transparent" Foreground="#F9FAFB" BorderThickness="0" Padding="4,3" FontSize="13.5" MinWidth="200" VerticalAlignment="Center"
                                                 TextChanged="ComposeToInput_TextChanged"
                                                 PreviewKeyDown="ComposeToInput_PreviewKeyDown"
                                                 LostFocus="ComposeToInput_LostFocus"/>
                                    </WrapPanel>
                                </Border>
                                <Canvas HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="0" Panel.ZIndex="140">
                                    <Border x:Name="ComposeToAutocompleteBorder"
                                            Canvas.Top="3"
                                            Canvas.Left="0"
                                            Width="{Binding ActualWidth, ElementName=ComposeToFieldBorder}"
                                            MaxHeight="240"
                                            Visibility="Collapsed"
                                            Background="#13161F"
                                            BorderBrush="#C5A059"
                                            BorderThickness="1.5"
                                            CornerRadius="10"
                                            Padding="5">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="18" ShadowDepth="6" Opacity="0.55" Color="#000000"/>
                                        </Border.Effect>
                                        <ScrollViewer x:Name="ComposeToAutocompleteScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                            <StackPanel x:Name="ComposeToAutocompletePanel"/>
                                        </ScrollViewer>
                                    </Border>
                                </Canvas>
                            </Grid>
                        </StackPanel>

                        <!-- KOPIE (CC) + KACHELN -->
                        <StackPanel x:Name="ComposeCcSection" Margin="0,0,0,10" Visibility="Collapsed" Panel.ZIndex="70">
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="KOPIE (CC)" Foreground="#C5A059" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock Text="  ·  Enter = als Kachel hinzufügen" Foreground="#6B7280" FontSize="10.5" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Grid.Column="1" Click="CloseComposeCc_Click" Background="Transparent" Foreground="#9CA3AF" BorderThickness="0" Padding="5,1" Cursor="Hand" ToolTip="CC-Feld schließen &amp; leeren" Content="✕"/>
                            </Grid>
                            <Grid>
                                <Border x:Name="ComposeCcFieldBorder" Background="#0F1117" BorderBrush="#262A36" BorderThickness="1" CornerRadius="10" Padding="6,5" MinHeight="36" Cursor="IBeam" MouseLeftButtonDown="ComposeCcFieldBorder_MouseLeftButtonDown">
                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <WrapPanel x:Name="ComposeCcChipsPanel" Orientation="Horizontal" VerticalAlignment="Center"/>
                                        <TextBox x:Name="ComposeCcInput" Background="Transparent" Foreground="#F9FAFB" BorderThickness="0" Padding="4,3" FontSize="13" MinWidth="200" VerticalAlignment="Center"
                                                 TextChanged="ComposeCcInput_TextChanged"
                                                 PreviewKeyDown="ComposeCcInput_PreviewKeyDown"
                                                 LostFocus="ComposeCcInput_LostFocus"/>
                                    </WrapPanel>
                                </Border>
                                <Canvas HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="0" Panel.ZIndex="140">
                                    <Border x:Name="ComposeCcAutocompleteBorder"
                                            Canvas.Top="3"
                                            Canvas.Left="0"
                                            Width="{Binding ActualWidth, ElementName=ComposeCcFieldBorder}"
                                            MaxHeight="220"
                                            Visibility="Collapsed"
                                            Background="#13161F"
                                            BorderBrush="#C5A059"
                                            BorderThickness="1.5"
                                            CornerRadius="10"
                                            Padding="5">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="18" ShadowDepth="6" Opacity="0.55" Color="#000000"/>
                                        </Border.Effect>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                            <StackPanel x:Name="ComposeCcAutocompletePanel"/>
                                        </ScrollViewer>
                                    </Border>
                                </Canvas>
                            </Grid>
                        </StackPanel>

                        <!-- BLINDKOPIE (BCC) + KACHELN -->
                        <StackPanel x:Name="ComposeBccSection" Margin="0,0,0,10" Visibility="Collapsed" Panel.ZIndex="65">
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="BLINDKOPIE (BCC)" Foreground="#C5A059" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock Text="  ·  Enter = als Kachel hinzufügen" Foreground="#6B7280" FontSize="10.5" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Grid.Column="1" Click="CloseComposeBcc_Click" Background="Transparent" Foreground="#9CA3AF" BorderThickness="0" Padding="5,1" Cursor="Hand" ToolTip="BCC-Feld schließen &amp; leeren" Content="✕"/>
                            </Grid>
                            <Grid>
                                <Border x:Name="ComposeBccFieldBorder" Background="#0F1117" BorderBrush="#262A36" BorderThickness="1" CornerRadius="10" Padding="6,5" MinHeight="36" Cursor="IBeam" MouseLeftButtonDown="ComposeBccFieldBorder_MouseLeftButtonDown">
                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <WrapPanel x:Name="ComposeBccChipsPanel" Orientation="Horizontal" VerticalAlignment="Center"/>
                                        <TextBox x:Name="ComposeBccInput" Background="Transparent" Foreground="#F9FAFB" BorderThickness="0" Padding="4,3" FontSize="13" MinWidth="200" VerticalAlignment="Center"
                                                 TextChanged="ComposeBccInput_TextChanged"
                                                 PreviewKeyDown="ComposeBccInput_PreviewKeyDown"
                                                 LostFocus="ComposeBccInput_LostFocus"/>
                                    </WrapPanel>
                                </Border>
                                <Canvas HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="0" Panel.ZIndex="140">
                                    <Border x:Name="ComposeBccAutocompleteBorder"
                                            Canvas.Top="3"
                                            Canvas.Left="0"
                                            Width="{Binding ActualWidth, ElementName=ComposeBccFieldBorder}"
                                            MaxHeight="220"
                                            Visibility="Collapsed"
                                            Background="#13161F"
                                            BorderBrush="#C5A059"
                                            BorderThickness="1.5"
                                            CornerRadius="10"
                                            Padding="5">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="18" ShadowDepth="6" Opacity="0.55" Color="#000000"/>
                                        </Border.Effect>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                            <StackPanel x:Name="ComposeBccAutocompletePanel"/>
                                        </ScrollViewer>
                                    </Border>
                                </Canvas>
                            </Grid>
                        </StackPanel>

                        <!-- BETREFF -->
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="BETREFF" Foreground="#9CA3AF" FontSize="10.5" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBox x:Name="ComposeSubjectInput" Background="#0F1117" Foreground="#F9FAFB" BorderBrush="#262A36" Padding="10,8" FontSize="13.5"/>
                        </StackPanel>

                        <!-- NACHRICHT + FORMATIERUNGS-TOOLBAR -->
                        <StackPanel Margin="0,0,0,12">
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="NACHRICHT" Foreground="#9CA3AF" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Click="ComposeFormat_Click" Tag="bold" Background="#1F2430" Foreground="#D1D5DB" BorderThickness="0" Padding="7,2" Margin="0,0,4,0" Cursor="Hand" ToolTip="Fett markieren" FontWeight="Bold" FontSize="11" Content="B">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                                    </Button>
                                    <Button Click="ComposeFormat_Click" Tag="italic" Background="#1F2430" Foreground="#D1D5DB" BorderThickness="0" Padding="8,2" Margin="0,0,4,0" Cursor="Hand" ToolTip="Kursiv markieren" FontStyle="Italic" FontWeight="SemiBold" FontSize="11" Content="I">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                                    </Button>
                                    <Button Click="ComposeFormat_Click" Tag="bullet" Background="#1F2430" Foreground="#D1D5DB" BorderThickness="0" Padding="7,2" Margin="0,0,4,0" Cursor="Hand" ToolTip="Aufzählung einfügen" FontSize="11" Content="• Liste">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                                    </Button>
