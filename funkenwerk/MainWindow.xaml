                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                    <TextBlock Text="+ Plug" Foreground="#F9FAFB" FontSize="11" FontWeight="SemiBold"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- 1. IP Cameras List -->
                                <Grid Margin="2,2,2,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="IP-KAMERAS (DRAG &amp; DROP)" Foreground="#6B7280" FontSize="10.5" FontWeight="Bold"/>
                                    <TextBlock x:Name="SmartCamerasCountTxt" Grid.Column="1" Text="3" Foreground="#C5A059" FontSize="10.5" FontWeight="Bold"/>
                                </Grid>
                                <StackPanel x:Name="SmartCamerasSidebarPanel" Margin="0,0,0,16"/>

                                <!-- 2. Network Label Printer (MUNBYN ITPP941AP Shop-Bridge) -->
                                <Grid Margin="2,2,2,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="WLAN-LABELDRUCKER (SHOP-BRIDGE)" Foreground="#6B7280" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Click="SmartTestPrintLabel_Click" Background="Transparent" BorderThickness="0" Padding="4,0" Cursor="Hand" ToolTip="4x6 Zoll Test-Etikett direkt auf MUNBYN ITPP941AP drucken">
                                        <TextBlock Text="🖨 Test-Label" Foreground="#C5A059" FontSize="10.5" FontWeight="Bold"/>
                                    </Button>
                                </Grid>
                                <StackPanel x:Name="SmartPrinterSidebarPanel" Margin="0,0,0,16"/>

                                <!-- 3. Smart Plugs List -->
                                <Grid Margin="2,2,2,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="SMARTE STECKDOSEN" Foreground="#6B7280" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Click="SmartOpenTapoAuth_Click" Background="Transparent" BorderThickness="0" Padding="4,0" Cursor="Hand" ToolTip="Tapo Lokale KLAP-Zugangsdaten konfigurieren">
                                        <TextBlock Text="🔑 KLAP-Login" Foreground="#C5A059" FontSize="10.5" FontWeight="Bold"/>
                                    </Button>
                                </Grid>
                                <StackPanel x:Name="SmartPlugsSidebarPanel" Margin="0,0,0,16"/>

                                <!-- 3. Recorded Clips & Snapshots -->
                                <Grid Margin="2,2,2,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="AUFNAHMEN &amp; BEWEGUNG" Foreground="#6B7280" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Click="SmartRefreshRecordings_Click" Background="Transparent" BorderThickness="0" Padding="4,0" Cursor="Hand">
                                        <TextBlock Text="↻ Aktualisieren" Foreground="#9CA3AF" FontSize="10.5"/>
                                    </Button>
                                </Grid>
                                <StackPanel x:Name="SmartRecordingsSidebarPanel" Margin="0,0,0,10"/>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Splitter -->
                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE" DragCompleted="Splitter_DragCompleted"/>

                <!-- Right Main Area: Multi-Camera Live Matrix + PTZ & Audio Controls -->
                <Border x:Name="SmartHomeMainBorder" Grid.Column="2" Background="#0D0F14" Padding="20,18">
                    <DockPanel>
                        <!-- Top Toolbar -->
                        <Border x:Name="SmartHomeToolbarBorder" DockPanel.Dock="Top" Background="#141720" BorderBrush="#222634" BorderThickness="1" CornerRadius="14" Padding="16,12" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="9" Height="9" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="SmartHomeHeaderTitleTxt" Text="Live-Überwachung &amp; Kamerasteuerung" Foreground="#F9FAFB" FontSize="16" FontWeight="Bold"/>
                                    </StackPanel>
                                    <TextBlock x:Name="SmartHomeHeaderSubTxt" Text="RTSP Echtzeit-Stream · ONVIF PTZ-Steuerung · Automatische Bewegungsaufnahme · Live-Audio" Foreground="#9CA3AF" FontSize="11.5" Margin="17,2,0,0"/>
                                </StackPanel>

