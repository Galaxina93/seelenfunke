                                    </Button>
                                    <Button x:Name="CamSplitWindowShareBtn" Click="CamSplitMode_Click" Tag="windowshare" Background="#13161F" Foreground="#D1D5DB" FontWeight="SemiBold" BorderThickness="0" Padding="8,7" Margin="3,0,0,0" Cursor="Hand" FontSize="11.5" ToolTip="Geteiltes Bild / Fenster im Vollbild + Kamera als Zweitfenster (PiP)" Content="🎮 Teilen + Cam">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                    </Button>
                                </UniformGrid>

                                <!-- Secondary Source & Window Share Picker (32:9 Ultrawide + OBS Sources + Interactive Mouse PiP) -->
                                <StackPanel x:Name="CamSecondaryConfigPanel" Visibility="Visible">
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="FENSTER / MONITOR-QUELLE" Foreground="#9CA3AF" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,4,0"/>
                                        <Button Grid.Column="1" Click="CamRefreshWindows_Click" Background="Transparent" Foreground="#C5A059" BorderThickness="0" Padding="4,1" Cursor="Hand" FontSize="10.5" FontWeight="Bold" Content="↻ Aktualisieren"/>
                                    </Grid>
                                    <ComboBox x:Name="CamWindowTargetCombo" SelectionChanged="CamWindowTargetCombo_SelectionChanged" DisplayMemberPath="DisplayLabel" Padding="9,6" FontSize="11.5" Margin="0,0,0,6"/>

                                    <!-- Custom Screen Region, Tutorial Mouse-Follow & Mirror Shared Area (Discord Fix) -->
                                    <StackPanel Margin="0,0,0,7">
                                        <Grid Margin="0,0,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="CamDefineCustomRegionBtn" Grid.Column="0" Click="CamDefineCustomScreenRegion_Click" Background="#1E1F22" Foreground="#C5A059" BorderBrush="#C5A059" BorderThickness="1" Padding="6,5" Cursor="Hand" FontSize="10.5" FontWeight="Bold" ToolTip="Benutzerdefinierte Fläche auf dem Monitor per Maus-Rechteck auswählen" Content="📐 Fläche wählen">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style></Button.Resources>
                                            </Button>
                                            <Button x:Name="CamQuickMouseFollowBtn" Grid.Column="2" Click="CamQuickMouseFollow_Click" Background="#1E1F22" Foreground="#F2F3F5" BorderBrush="#2B2D31" BorderThickness="1" Padding="6,5" Cursor="Hand" FontSize="10.5" FontWeight="Bold" ToolTip="Tutorial Maus-Verfolgung: Kamera folgt deiner Maus butterweich mit einem definierten Bereich (Klick = Aktivieren / Zoom-Stufe wechseln)" Content="🎯 Maus-Follow">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style></Button.Resources>
                                            </Button>
                                        </Grid>
                                        <CheckBox x:Name="CamMirrorSharedCheck" Content="↔ Geteilten Bereich spiegeln (Discord-Fix)" Foreground="#34D399" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" Checked="CamMirrorSharedCheck_Changed" Unchecked="CamMirrorSharedCheck_Changed" Cursor="Hand" ToolTip="Spiegelt den geteilten Bildschirm/Fensterbereich horizontal (verhindert spiegelverkehrte Anzeige in Discord!)"/>
                                    </StackPanel>

                                    <TextBlock Text="ODER ZWEITE HARDWARE-KAMERA" Foreground="#9CA3AF" FontSize="10" FontWeight="Bold" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="CamSecondaryDeviceCombo" SelectionChanged="CamSecondaryDeviceCombo_SelectionChanged" Padding="9,6" FontSize="11.5" Margin="0,0,0,7"/>

                                    <!-- Interactive PiP Quick Controls (Replaces static PiP Corner Dropdown) -->
                                    <Border Background="#111214" BorderBrush="#2B2D31" BorderThickness="1" CornerRadius="9" Padding="8,7">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="🖱 ZWEITFENSTER" Foreground="#C5A059" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <Button x:Name="CamPipToggleVisibilityBtn" Grid.Column="1" Click="CamPipToggleVisibility_Click" Background="#1E1F22" Foreground="#34D399" BorderBrush="#2B2D31" BorderThickness="1" Padding="6,2" Margin="4,0,6,0" Cursor="Hand" FontSize="9.5" FontWeight="Bold" ToolTip="Zweitfenster (PiP) ein- oder ausblenden" Content="👁 An">
                                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                                                </Button>
                                                <Slider x:Name="CamPipScaleSlider" Grid.Column="2" Width="64" Minimum="0.14" Maximum="0.65" Value="0.30" VerticalAlignment="Center" ValueChanged="CamPipScaleSlider_ValueChanged" ToolTip="Größe des Zweitfensters (auch direkt per Mausrad/Ecke im Live-Bild änderbar)"/>
                                            </Grid>
                                            <UniformGrid Columns="4" Rows="1">
                                                <Button x:Name="CamPipQuickShapeBtn" Click="CamPipCycleShape_Click" Background="#1E1F22" Foreground="#E5E7EB" BorderBrush="#2B2D31" BorderThickness="1" Padding="4,4" Margin="0,0,2,0" Cursor="Hand" FontSize="10" FontWeight="SemiBold" ToolTip="Form des Zweitfensters wechseln (Abgerundet / Rund / Hexagon / Rechteck)" Content="⭕ Form">
                                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                                </Button>
                                                <Button x:Name="CamPipQuickCropBtn" Click="CamPipToggleScissors_Click" Background="#1E1F22" Foreground="#E5E7EB" BorderBrush="#2B2D31" BorderThickness="1" Padding="4,4" Margin="2,0,2,0" Cursor="Hand" FontSize="10" FontWeight="SemiBold" ToolTip="Scheren-Werkzeug: Zweitfenster im Live-Bild zuschneiden" Content="✂ Schere">
                                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                                </Button>
                                                <Button x:Name="CamPipQuickChromaBtn" Click="CamPipToggleChroma_Click" Background="#1E1F22" Foreground="#E5E7EB" BorderBrush="#2B2D31" BorderThickness="1" Padding="4,4" Margin="2,0,2,0" Cursor="Hand" FontSize="10" FontWeight="SemiBold" ToolTip="Greenscreen / Chroma Key auf das Zweitfenster anwenden" Content="🟩 Key">
                                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                                </Button>
                                                <Button Click="CamPipResetLayout_Click" Background="#1E1F22" Foreground="#9CA3AF" BorderBrush="#2B2D31" BorderThickness="1" Padding="4,4" Margin="2,0,0,0" Cursor="Hand" FontSize="10" ToolTip="Position, Größe &amp; Zuschnitt des Zweitfensters zurücksetzen" Content="↺ Reset">
                                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                                </Button>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- MEDIA GALLERY HEADER -->
                        <Grid DockPanel.Dock="Top" Margin="2,2,2,6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="AUFNAHMEN &amp; FOTOS" Foreground="#9CA3AF" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Border Background="#26231F" CornerRadius="7" Padding="6,1" Margin="6,0,0,0">
                                    <TextBlock x:Name="CamMediaCountBadge" Text="0" Foreground="#C5A059" FontSize="10.5" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Click="CamOpenMediaFolder_Click" Background="#1F2430" Foreground="#D1D5DB" BorderThickness="0" Padding="7,3" Margin="0,0,4,0" Cursor="Hand" FontSize="10.5" ToolTip="Medien-Ordner im Windows Explorer öffnen" Content="📂 Ordner">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                </Button>
                                <Button Click="CamRefreshGallery_Click" Background="#1F2430" Foreground="#C5A059" BorderThickness="0" Padding="6,3" Cursor="Hand" FontSize="10.5" ToolTip="Medienliste aktualisieren" Content="↻">
