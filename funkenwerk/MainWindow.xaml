                                        <Button x:Name="SmartGridBtn4" Click="SmartGridLayout_Click" Tag="4" Background="Transparent" Foreground="#9CA3AF" BorderThickness="0" Padding="11,6" Margin="0,0,3,0" Cursor="Hand" ToolTip="4er Raster (2×2 Kacheln)">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style></Button.Resources>
                                            <TextBlock x:Name="SmartGridTxt4" Text="⊞ 4er" Foreground="#9CA3AF" FontSize="11.5" FontWeight="Bold"/>
                                        </Button>
                                        <Button x:Name="SmartGridBtn6" Click="SmartGridLayout_Click" Tag="6" Background="Transparent" Foreground="#9CA3AF" BorderThickness="0" Padding="11,6" Margin="0,0,3,0" Cursor="Hand" ToolTip="6er Raster (3×2 Kacheln)">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style></Button.Resources>
                                            <TextBlock x:Name="SmartGridTxt6" Text="▦ 6er" Foreground="#9CA3AF" FontSize="11.5" FontWeight="Bold"/>
                                        </Button>
                                        <Button x:Name="SmartGridBtn8" Click="SmartGridLayout_Click" Tag="8" Background="Transparent" Foreground="#9CA3AF" BorderThickness="0" Padding="11,6" Cursor="Hand" ToolTip="8er Raster (4×2 Kacheln)">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style></Button.Resources>
                                            <TextBlock x:Name="SmartGridTxt8" Text="∷ 8er" Foreground="#9CA3AF" FontSize="11.5" FontWeight="Bold"/>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Right Action Buttons -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="SmartLanScanBtn" Click="SmartScanLan_Click" Background="#1E222D" Foreground="#C5A059" BorderThickness="0" Padding="11,7" Margin="0,0,8,0" Cursor="Hand" ToolTip="Heimnetz (192.168.188.x) nach Kameras &amp; Steckdosen scannen">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="9"/></Style></Button.Resources>
                                        <TextBlock x:Name="SmartLanScanBtnTxt" Text="🔍 Netzwerk scannen" Foreground="#C5A059" FontSize="11.5" FontWeight="Bold"/>
                                    </Button>
                                    <Button Click="SmartOpenRecordingsFolder_Click" Background="#1E222D" Foreground="#D1D5DB" BorderThickness="0" Padding="11,7" Cursor="Hand" ToolTip="Aufnahmen-Ordner im Windows Explorer öffnen">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="9"/></Style></Button.Resources>
                                        <TextBlock Text="📂 Aufnahmen" Foreground="#D1D5DB" FontSize="11.5" FontWeight="SemiBold"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Dynamic Live Camera Grid Matrix & Built-In MP4/Snapshot Player -->
                        <Grid>
                            <Grid x:Name="SmartCameraMatrixGrid"/>

                            <!-- Integrated Smart Home MP4 & Snapshot Player -->
                            <Border x:Name="SmartMediaPlayerBorder" Background="#141720" BorderBrush="#C5A059" BorderThickness="1.5" CornerRadius="16" Padding="18,16" Visibility="Collapsed">
                                <DockPanel>
                                    <!-- Player Top Bar -->
                                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="#26231F" BorderBrush="#C5A059" BorderThickness="1" CornerRadius="6" Padding="7,2" Margin="0,0,8,0">
                                                    <TextBlock x:Name="SmartPlayerBadgeTxt" Text="🎬 MP4 AUFNAHME-PLAYER" Foreground="#C5A059" FontSize="10" FontWeight="Bold"/>
                                                </Border>
                                                <TextBlock x:Name="SmartPlayerTitleTxt" Text="Kamera-Aufnahme" Foreground="#F9FAFB" FontSize="15.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock x:Name="SmartPlayerSubTxt" Text="Datum · Dateigröße" Foreground="#9CA3AF" FontSize="11.5" Margin="0,3,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Click="SmartMediaOpenExplorer_Click" Background="#1E222D" Foreground="#D1D5DB" BorderThickness="0" Padding="11,7" Margin="0,0,6,0" Cursor="Hand" ToolTip="Datei im Windows Explorer markieren">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                                <TextBlock Text="📂 Im Ordner" Foreground="#D1D5DB" FontSize="11.5" FontWeight="SemiBold"/>
                                            </Button>
                                            <Button Click="SmartMediaDelete_Click" Background="#2D161B" Foreground="#F87171" BorderThickness="0" Padding="11,7" Margin="0,0,8,0" Cursor="Hand" ToolTip="Diese Aufnahme dauerhaft löschen">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                                <TextBlock Text="🗑 Löschen" Foreground="#F87171" FontSize="11.5" FontWeight="SemiBold"/>
                                            </Button>
                                            <Button Click="SmartMediaClose_Click" Background="#C5A059" Foreground="#111827" BorderThickness="0" Padding="14,7" Cursor="Hand" ToolTip="Player schließen und zurück zur Live-Kamera-Matrix">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                                <TextBlock Text="← Zurück zur Live-Ansicht" Foreground="#111827" FontSize="11.5" FontWeight="Bold"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Bottom Transport Bar (for MP4 Videos) -->
