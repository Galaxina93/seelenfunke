                                    <Border Background="#66000000" VerticalAlignment="Bottom" Padding="12,6">
                                        <TextBlock x:Name="MusicCacheBadgeTxt" Text="⚡ Bereit für Sofort-Stream" Foreground="#34D399" FontSize="11" FontWeight="Bold"/>
