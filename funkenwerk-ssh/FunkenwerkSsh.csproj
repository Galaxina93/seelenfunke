<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>FunkenwerkSsh</AssemblyName>
    <RootNamespace>FunkenwerkSsh</RootNamespace>
    <ApplicationTitle>Funkenwerk SSH</ApplicationTitle>
    <Product>Funkenwerk SSH</Product>
    <Company>Mein-Seelenfunke</Company>
    <Version>1.0.0</Version>
    <ApplicationIcon>funkenwerk_ssh.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="funkenwerk_ssh.ico" />
    <Resource Include="funkenwerk_ssh.png" />
    <None Include="funkenwerk_ssh.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
