<Window x:Class="FunkenwerkSsh.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Funkenwerk SSH"
        Icon="funkenwerk_ssh.ico"
        Width="1280" Height="780"
        MinWidth="960" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="#0F1117"
        Foreground="#F9FAFB"
        FontFamily="Segoe UI"
        Closing="Window_Closing">

    <Grid x:Name="RootGrid" Background="#0F1117">
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="36"/>
        </Grid.RowDefinitions>

        <!-- ================================================================= -->
        <!-- ROW 0: COMPACT SSH CONNECTION BAR                                 -->
        <!-- ================================================================= -->
        <Border x:Name="TopBarBorder" Grid.Row="0" Background="#12151E" BorderBrush="#232734" BorderThickness="0,0,0,1" Padding="18,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="68"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="175"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                    <Image Source="funkenwerk_ssh.png" Width="30" Height="30" Margin="0,0,9,0"/>
                    <TextBlock Text="FUNKENWERK SSH" Foreground="#C5A059" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Host -->
                <TextBox x:Name="HostBox" Grid.Column="1" Height="34" VerticalContentAlignment="Center"
                         Background="#181C26" Foreground="#F9FAFB" BorderBrush="#2D3343" Padding="10,0" Margin="0,0,6,0"/>

                <!-- Port -->
                <TextBox x:Name="PortBox" Grid.Column="2" Height="34" VerticalContentAlignment="Center" Text="22"
                         Background="#181C26" Foreground="#F9FAFB" BorderBrush="#2D3343" Padding="6,0" Margin="0,0,6,0"
                         HorizontalContentAlignment="Center"/>

                <!-- Username -->
                <TextBox x:Name="UserBox" Grid.Column="3" Height="34" VerticalContentAlignment="Center"
                         Background="#181C26" Foreground="#F9FAFB" BorderBrush="#2D3343" Padding="9,0" Margin="0,0,6,0"/>

                <!-- Password + Mandatory Eye Icon -->
                <Border x:Name="PassContainerBorder" Grid.Column="4" Height="34" Background="#181C26" BorderBrush="#2D3343" BorderThickness="1" Margin="0,0,6,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="28"/>
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="PassBox" Grid.Column="0" Background="Transparent" Foreground="#F9FAFB"
                                     BorderThickness="0" VerticalContentAlignment="Center" Padding="7,0"
                                     PasswordChanged="PassBox_PasswordChanged"/>
                        <TextBox x:Name="PassVisibleBox" Grid.Column="0" Background="Transparent" Foreground="#F9FAFB"
                                 BorderThickness="0" VerticalContentAlignment="Center" Padding="7,0" Visibility="Collapsed"
                                 TextChanged="PassVisibleBox_TextChanged"/>
                        <Button x:Name="TogglePassEyeBtn" Grid.Column="1" Content="👁" Background="Transparent"
                                Foreground="#9CA3AF" BorderThickness="0" Cursor="Hand" Click="TogglePassEye_Click"/>
                    </Grid>
                </Border>

                <!-- SSH Private Key Picker -->
                <Button x:Name="PickKeyBtn" Grid.Column="5" Content="🔑" Width="34" Height="34" Click="PickKey_Click"
                        Background="#1B1F2B" Foreground="#C5A059" BorderBrush="#2D3343" Cursor="Hand" Margin="0,0,6,0"/>

                <!-- Save Profile -->
                <Button x:Name="SaveProfileBtn" Grid.Column="6" Content="💾" Width="34" Height="34" Click="SaveProfile_Click"
                        Background="#1B1F2B" Foreground="#C5A059" BorderBrush="#2D3343" Cursor="Hand" Margin="0,0,8,0"/>

                <!-- Connect / Disconnect -->
                <Button x:Name="ConnectBtn" Grid.Column="7" Content="⚡ VERBINDEN" Height="34" Padding="18,0"
                        Click="Connect_Click" Background="#C5A059" Foreground="#0F1117" FontWeight="Bold"
                        BorderThickness="0" Cursor="Hand" Margin="0,0,6,0"/>

                <!-- Clear Terminal -->
                <Button Content="CLS" Grid.Column="8" Height="34" Padding="10,0" Click="ClearTerminal_Click"
                        Background="#1B1F2B" Foreground="#9CA3AF" BorderBrush="#2D3343" Cursor="Hand" Margin="0,0,6,0"/>

                <!-- Theme Toggle -->
                <Button x:Name="ThemeToggleBtn" Grid.Column="9" Content="☀" Width="34" Height="34"
                        Click="ThemeToggle_Click" Background="#1B1F2B" Foreground="#C5A059" BorderBrush="#2D3343" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- ================================================================= -->
        <!-- ROW 1: CLEAN 2-TILE LAYOUT (LINKS: VERBINDUNGEN | RECHTS: CONSOLE)-->
        <!-- ================================================================= -->
        <Grid Grid.Row="1" Margin="18,14,18,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT TILE: SAVED SSH CONNECTIONS -->
            <Border x:Name="SidebarTileBorder" Grid.Column="0" Background="#141821" BorderBrush="#242938" BorderThickness="1" CornerRadius="14" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="VERBINDUNGEN" Foreground="#C5A059" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="+ NEU" Height="26" Padding="9,0" Click="NewProfile_Click"
                                    Background="#1D2230" Foreground="#C5A059" BorderBrush="#2D3343" FontWeight="Bold" Cursor="Hand" Margin="0,0,4,0"/>
                            <Button Content="✕" Width="26" Height="26" Click="DeleteProfile_Click"
                                    Background="#1D2230" Foreground="#F87171" BorderBrush="#2D3343" Cursor="Hand"/>
                        </StackPanel>
                    </Grid>

                    <ListBox x:Name="ProfilesListBox" Grid.Row="1" Background="Transparent" BorderThickness="0"
                             SelectionChanged="ProfilesListBox_SelectionChanged"
                             MouseDoubleClick="ProfilesListBox_MouseDoubleClick"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,7" Margin="0,2" CornerRadius="8" Background="#1A1F2C" BorderBrush="#262C3D" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" Foreground="#F9FAFB" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Subtitle}" Foreground="#9CA3AF" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- RIGHT TILE: PUTTY-STYLE ANSI TRUECOLOR INTERACTIVE CONSOLE -->
            <Border x:Name="TerminalTileBorder" Grid.Column="2" Background="#000000" BorderBrush="#242938" BorderThickness="1" CornerRadius="10" Padding="10"
                    Focusable="True" MouseDown="TerminalSurface_MouseDown">
                <RichTextBox x:Name="TerminalRichBox"
                             Background="#000000"
                             Foreground="#D9D9D9"
                             BorderThickness="0"
                             IsReadOnly="True"
                             IsReadOnlyCaretVisible="False"
                             IsDocumentEnabled="True"
                             Focusable="True"
                             FontFamily="Consolas, Cascadia Mono, Courier New"
                             FontSize="14"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             PreviewKeyDown="TerminalRichBox_PreviewKeyDown"
                             PreviewTextInput="TerminalRichBox_PreviewTextInput"
                             MouseRightButtonUp="TerminalRichBox_MouseRightButtonUp">
                    <RichTextBox.Resources>
                        <Style TargetType="{x:Type Paragraph}">
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="LineHeight" Value="19"/>
                            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
                        </Style>
                    </RichTextBox.Resources>
                    <FlowDocument x:Name="TerminalDoc" PagePadding="4,4,4,4" Background="#000000"/>
                </RichTextBox>
            </Border>
        </Grid>

        <!-- ================================================================= -->
        <!-- ROW 2: SECURITY & ENCRYPTION STATUS BAR                           -->
        <!-- ================================================================= -->
        <Border x:Name="BottomBarBorder" Grid.Row="2" Background="#12151E" BorderBrush="#232734" BorderThickness="0,1,0,0" Padding="18,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0"
                           Text="🔒 SSHv2 Outbound-Only (0 offene Ports) · AES-256-GCM + DPAPI Vault · SHA-256 Host-Key Pinning"
                           Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="KeepAliveBadgeTxt" Grid.Column="1"
                           Text="KeepAlive: 15s" Foreground="#C5A059" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
