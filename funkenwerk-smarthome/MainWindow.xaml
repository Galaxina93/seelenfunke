                    <TextBlock x:Name="ModalTitleTxt" Text="Verbinden" FontSize="17" FontWeight="Bold" Foreground="#F9FAFB" Margin="0,0,0,16"/>

                    <StackPanel x:Name="Field1Panel" Margin="0,0,0,12">
                        <TextBlock x:Name="Field1Label" Text="NAME / GATEWAY-IP" FontSize="10.5" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,4"/>
                        <TextBox x:Name="Field1Box" Background="#0F1117" Foreground="#F9FAFB" BorderBrush="#262A36" BorderThickness="1" CaretBrush="#C5A059" Padding="11,8" FontSize="13"/>
                    </StackPanel>

                    <StackPanel x:Name="Field2Panel" Margin="0,0,0,12">
                        <TextBlock x:Name="Field2Label" Text="IP / GATEWAY-PIN" FontSize="10.5" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,4"/>
                        <TextBox x:Name="Field2Box" Background="#0F1117" Foreground="#F9FAFB" BorderBrush="#262A36" BorderThickness="1" CaretBrush="#C5A059" Padding="11,8" FontSize="13"/>
                    </StackPanel>

                    <StackPanel x:Name="Field3Panel" Margin="0,0,0,12">
                        <TextBlock x:Name="Field3Label" Text="E-MAIL / RTSP-URL" FontSize="10.5" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,4"/>
