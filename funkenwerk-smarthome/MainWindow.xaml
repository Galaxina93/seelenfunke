                                                PreviewMouseLeftButtonUp="SmartClipTimelineSlider_PreviewMouseLeftButtonUp"
                                                ValueChanged="SmartClipTimelineSlider_ValueChanged"/>
                                        <TextBlock x:Name="SmartClipDurTxt" Grid.Column="4" Text="00:00" FontSize="11.5" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="10,0,10,0"/>
                                        <Button x:Name="SmartClipSpeedBtn" Grid.Column="5" Click="CycleSmartClipSpeed_Click" Background="#1E222D" Foreground="#C5A059" BorderBrush="#374151" BorderThickness="1" Padding="9,4" Cursor="Hand" FontSize="11.5" FontWeight="Bold" Content="1.0×" ToolTip="Abspielgeschwindigkeit wechseln">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ================================================================= -->
        <!-- CONFIG / CREDENTIALS MODAL OVERLAY (WITH EYE ICON)                -->
        <!-- ================================================================= -->
        <Grid x:Name="ModalOverlayGrid" Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="500" Background="#BF000000" Visibility="Collapsed">
            <Border x:Name="ModalCardBorder" Width="460" Background="#151821" BorderBrush="#C5A059" BorderThickness="1.2" CornerRadius="16" Padding="24,20" VerticalAlignment="Center" HorizontalAlignment="Center">
