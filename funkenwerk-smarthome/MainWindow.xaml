                    </StackPanel>

                    <StackPanel x:Name="SecretFieldPanel" Margin="0,0,0,14">
                        <TextBlock x:Name="SecretFieldLabel" Text="PASSWORT / LOKALES TOKEN" FontSize="10.5" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,4"/>
                        <Border x:Name="SecretInputBorder" Background="#0F1117" BorderBrush="#262A36" BorderThickness="1" CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <PasswordBox x:Name="ModalSecretPasswordBox" Grid.Column="0" Background="Transparent" Foreground="#F9FAFB" BorderThickness="0" CaretBrush="#C5A059" Padding="11,8" FontSize="13" PasswordChanged="ModalSecretPasswordBox_PasswordChanged"/>
                                <TextBox x:Name="ModalSecretVisibleBox" Grid.Column="0" Background="Transparent" Foreground="#F9FAFB" BorderThickness="0" CaretBrush="#C5A059" Padding="11,8" FontSize="13" Visibility="Collapsed" TextChanged="ModalSecretVisibleBox_TextChanged"/>
                                <Button Click="ToggleModalSecretEye_Click" Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="10,4" Cursor="Hand" Foreground="#C5A059" Content="👁" ToolTip="Anzeigen / Verbergen"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <TextBlock x:Name="ModalFeedbackTxt" Text="" FontSize="12" Foreground="#FCA5A5" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,12"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="CloseModalBtn" Click="CloseModal_Click" Background="#1E222D" Foreground="#D1D5DB" BorderThickness="0" Padding="16,8" Margin="0,0,8,0" Cursor="Hand" FontWeight="SemiBold" Content="Abbrechen">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                        <Button x:Name="ModalSaveBtn" Click="SaveModal_Click" Background="#C5A059" Foreground="#111827" BorderThickness="0" Padding="18,8" Cursor="Hand" FontWeight="Bold" Content="Speichern">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================================================================= -->
        <!-- DEVICE GROUP EDITOR MODAL OVERLAY                                 -->
        <!-- ================================================================= -->
        <Grid x:Name="GroupModalOverlayGrid" Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="510" Background="#BF000000" Visibility="Collapsed">
            <Border x:Name="GroupModalCardBorder" Width="500" MaxHeight="680" Background="#151821" BorderBrush="#C5A059" BorderThickness="1.2" CornerRadius="16" Padding="24,20" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="GroupModalTitleTxt" Text="Gruppe anlegen" FontSize="17" FontWeight="Bold" Foreground="#F9FAFB" Margin="0,0,0,16"/>

                    <StackPanel Margin="0,0,0,14">
                        <TextBlock x:Name="GroupNameFieldLabel" Text="GRUPPENNAME" FontSize="10.5" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,4"/>
                        <TextBox x:Name="GroupNameInputBox" Background="#0F1117" Foreground="#F9FAFB" BorderBrush="#262A36" BorderThickness="1" CaretBrush="#C5A059" Padding="11,8" FontSize="13"/>
                    </StackPanel>

                    <TextBlock x:Name="GroupShuttersSectionLabel" Text="ROLLLÄDEN &amp; FENSTER" FontSize="10.5" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,6"/>
                    <Border x:Name="GroupShuttersListBorder" Background="#0F1117" BorderBrush="#262A36" BorderThickness="1" CornerRadius="8" Padding="10,8" MaxHeight="165" Margin="0,0,0,8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="GroupShuttersCheckPanel"/>
                        </ScrollViewer>
                    </Border>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="GroupCustomShutterBox" Grid.Column="0" Background="#0F1117" Foreground="#F9FAFB" BorderBrush="#262A36" BorderThickness="1" CaretBrush="#C5A059" Padding="10,6" FontSize="12" ToolTip="Weiteren Rollladen-Namen manuell aufnehmen (z.B. Wohnzimmer oder Terrassentür)" KeyDown="GroupCustomShutterBox_KeyDown"/>
                        <Button x:Name="GroupAddCustomShutterBtn" Grid.Column="1" Click="AddCustomShutterToGroupModal_Click" Background="#1E222D" Foreground="#C5A059" BorderBrush="#374151" BorderThickness="1" Padding="12,6" Margin="8,0,0,0" Cursor="Hand" FontSize="12" FontWeight="Bold" Content="＋ Name">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        </Button>
                    </Grid>

                    <TextBlock x:Name="GroupPlugsSectionLabel" Text="STECKDOSEN" FontSize="10.5" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,6"/>
                    <Border x:Name="GroupPlugsListBorder" Background="#0F1117" BorderBrush="#262A36" BorderThickness="1" CornerRadius="8" Padding="10,8" MaxHeight="135" Margin="0,0,0,14">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="GroupPlugsCheckPanel"/>
                        </ScrollViewer>
                    </Border>

                    <TextBlock x:Name="GroupModalFeedbackTxt" Text="" FontSize="12" Foreground="#FCA5A5" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="GroupModalDeleteBtn" Grid.Column="0" Click="DeleteGroupModal_Click" Background="#2D161B" Foreground="#F87171" BorderThickness="0" Padding="14,8" Cursor="Hand" FontWeight="Bold" Content="Löschen" Visibility="Collapsed">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button x:Name="GroupModalCancelBtn" Click="CloseGroupModal_Click" Background="#1E222D" Foreground="#D1D5DB" BorderThickness="0" Padding="16,8" Margin="0,0,8,0" Cursor="Hand" FontWeight="SemiBold" Content="Abbrechen">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                            </Button>
                            <Button x:Name="GroupModalSaveBtn" Click="SaveGroupModal_Click" Background="#C5A059" Foreground="#111827" BorderThickness="0" Padding="18,8" Cursor="Hand" FontWeight="Bold" Content="Speichern">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================================================================= -->
        <!-- FULL CAMERA SETTINGS & PTZ / MOTION MODAL OVERLAY                 -->
        <!-- ================================================================= -->
        <Grid x:Name="CameraModalOverlayGrid" Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="520" Background="#BF000000" Visibility="Collapsed">
            <Border x:Name="CameraModalCardBorder" Width="560" MaxHeight="720" Background="#151821" BorderBrush="#C5A059" BorderThickness="1.2" CornerRadius="16" Padding="24,20" VerticalAlignment="Center" HorizontalAlignment="Center">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="CamModalTitleTxt" Text="Kamera konfigurieren" FontSize="17" FontWeight="Bold" Foreground="#F9FAFB" Margin="0,0,0,16"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="CamModalNameLabel" Text="KAMERANAME" FontSize="10.5" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,4"/>
                                <TextBox x:Name="CamModalNameBox" Background="#0F1117" Foreground="#F9FAFB" BorderBrush="#262A36" BorderThickness="1" CaretBrush="#C5A059" Padding="11,8" FontSize="13"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock x:Name="CamModalModelLabel" Text="GERÄTEMODELL" FontSize="10.5" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,4"/>
                                <TextBox x:Name="CamModalModelBox" Background="#0F1117" Foreground="#F9FAFB" BorderBrush="#262A36" BorderThickness="1" CaretBrush="#C5A059" Padding="11,8" FontSize="13" ToolTip="Wird über ONVIF automatisch erkannt oder frei benannt (z.B. Tapo C210 / Reolink)"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,0,0,12">
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="CamModalRtspLabel" Text="RTSP STREAM-URL (PRIVATES HEIMNETZ)" FontSize="10.5" FontWeight="Bold" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="CamModalSubStreamBtn" Click="SelectCamModalSubStream_Click" Background="#26231F" Foreground="#C5A059" BorderBrush="#C5A059" BorderThickness="1" Padding="8,2" Margin="0,0,5,0" Cursor="Hand" FontSize="10.5" FontWeight="Bold" Content="⚡ Substream (/stream2)" ToolTip="Niedrige CPU-Last &amp; sofortiger Start für Mehrkamera-Matrix">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                                    </Button>
                                    <Button x:Name="CamModalHdStreamBtn" Click="SelectCamModalHdStream_Click" Background="#1E222D" Foreground="#D1D5DB" BorderBrush="#374151" BorderThickness="1" Padding="8,2" Cursor="Hand" FontSize="10.5" FontWeight="SemiBold" Content="✦ HD (/stream1)" ToolTip="Volle HD/2K-Auflösung für Einzelansicht">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <Border x:Name="CamModalRtspInputBorder" Background="#0F1117" BorderBrush="#262A36" BorderThickness="1" CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox x:Name="CamModalRtspPasswordBox" Grid.Column="0" Background="Transparent" Foreground="#F9FAFB" BorderThickness="0" CaretBrush="#C5A059" Padding="11,8" FontSize="13" PasswordChanged="CamModalRtspPasswordBox_PasswordChanged" ToolTip="Format: rtsp://benutzer:passwort@192.168.188.x:554/stream2"/>
                                    <TextBox x:Name="CamModalRtspVisibleBox" Grid.Column="0" Background="Transparent" Foreground="#F9FAFB" BorderThickness="0" CaretBrush="#C5A059" Padding="11,8" FontSize="13" Visibility="Collapsed" TextChanged="CamModalRtspVisibleBox_TextChanged" ToolTip="Format: rtsp://benutzer:passwort@192.168.188.x:554/stream2"/>
                                    <Button Click="ToggleCamModalRtspEye_Click" Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="10,4" Cursor="Hand" Foreground="#C5A059" Content="👁" ToolTip="RTSP-URL &amp; Passwort anzeigen / verbergen"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,12">
                            <TextBlock x:Name="CamModalOnvifLabel" Text="ONVIF SERVICE-URL (PTZ PORT 2020 / OPTIONAL)" FontSize="10.5" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="CamModalOnvifUrlBox" Grid.Column="0" Background="#0F1117" Foreground="#F9FAFB" BorderBrush="#262A36" BorderThickness="1" CaretBrush="#C5A059" Padding="11,8" FontSize="12.5" ToolTip="Standard z.B. http://192.168.188.x:2020/onvif/device_service"/>
                                <Button x:Name="CamModalTestBtn" Grid.Column="1" Click="TestCameraConnectionModal_Click" Background="#1E222D" Foreground="#C5A059" BorderBrush="#374151" BorderThickness="1" Padding="12,8" Margin="8,0,0,0" Cursor="Hand" FontSize="12" FontWeight="Bold" Content="🔍 Prüfen" ToolTip="Prüft RTSP-Port 554 &amp; ONVIF-Geräteinfo live im Heimnetz">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,14">
                            <TextBlock x:Name="CamModalDescLabel" Text="STANDORT / NOTIZ" FontSize="10.5" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,4"/>
                            <TextBox x:Name="CamModalDescBox" Background="#0F1117" Foreground="#F9FAFB" BorderBrush="#262A36" BorderThickness="1" CaretBrush="#C5A059" Padding="11,8" FontSize="12.5"/>
                        </StackPanel>

                        <Border x:Name="CamModalOptionsBorder" Background="#0F1117" BorderBrush="#262A36" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,14">
                            <StackPanel>
                                <CheckBox x:Name="CamModalMotionCheck" Content="🎯 Automatische Bewegungs-Aufnahme (15s HD-Clip)" Foreground="#F9FAFB" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,10" Cursor="Hand"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="CamModalSensLabel" Grid.Column="0" Text="EMPFINDLICHKEIT" FontSize="10.5" FontWeight="Bold" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Slider x:Name="CamModalSensSlider" Grid.Column="1" Minimum="10" Maximum="100" Value="50" IsSnapToTickEnabled="True" TickFrequency="5" VerticalAlignment="Center" Cursor="Hand" ValueChanged="CamModalSensSlider_ValueChanged"/>
                                    <TextBlock x:Name="CamModalSensValueTxt" Grid.Column="2" Text="50 %" Width="42" TextAlignment="Right" FontSize="12" FontWeight="Bold" Foreground="#C5A059" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>

                                <CheckBox x:Name="CamModalHasPtzCheck" Content="🕹 Schwenk- &amp; Neigesteuerung (ONVIF PTZ)" Foreground="#F9FAFB" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,8" Cursor="Hand"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="CamModalInvertPanCheck" Grid.Column="0" Content="↔ Links/Rechts umkehren" Foreground="#D1D5DB" FontSize="12" Margin="0,0,8,0" Cursor="Hand" ToolTip="Kehrt horizontale PTZ-Schwenkrichtung um"/>
                                    <CheckBox x:Name="CamModalInvertTiltCheck" Grid.Column="1" Content="↕ Oben/Unten umkehren" Foreground="#D1D5DB" FontSize="12" Cursor="Hand" ToolTip="Kehrt vertikale PTZ-Neigerichtung um"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="CamModalFeedbackTxt" Text="" FontSize="12" Foreground="#FCA5A5" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="CamModalDeleteBtn" Grid.Column="0" Click="DeleteCameraModal_Click" Background="#2D161B" Foreground="#F87171" BorderThickness="0" Padding="14,8" Cursor="Hand" FontWeight="Bold" Content="Löschen" Visibility="Collapsed">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                            </Button>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button x:Name="CamModalCancelBtn" Click="CloseCameraModal_Click" Background="#1E222D" Foreground="#D1D5DB" BorderThickness="0" Padding="16,8" Margin="0,0,8,0" Cursor="Hand" FontWeight="SemiBold" Content="Abbrechen">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                </Button>
                                <Button x:Name="CamModalSaveBtn" Click="SaveCameraModal_Click" Background="#C5A059" Foreground="#111827" BorderThickness="0" Padding="18,8" Cursor="Hand" FontWeight="Bold" Content="Speichern">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
