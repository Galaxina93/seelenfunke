<Window x:Class="FunkenwerkSmartHome.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Funkenwerk SmartHome"
        Icon="funkenwerk_smarthome.ico"
        Width="1280" Height="810"
        MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#0F1117"
        Foreground="#F9FAFB"
        FontFamily="Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <Grid x:Name="RootGrid" Background="#0F1117">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Border x:Name="TopBarBorder" Grid.Row="0" Background="#0A0C10" BorderBrush="#1E222D" BorderThickness="0,0,0,1" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Image Source="pack://application:,,,/funkenwerk_smarthome.png" Width="28" Height="28" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock x:Name="HeaderTitleTxt" Text="FUNKENWERK SMARTHOME" FontSize="14" FontWeight="Bold" Foreground="#C5A059" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 4 Clean Tab Pills -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="TabShuttersBtn" Click="SwitchTab_Click" Tag="shutters" Background="#26231F" Foreground="#C5A059" BorderBrush="#C5A059" BorderThickness="1"
                            Padding="13,7" Margin="0,0,7,0" Cursor="Hand" FontSize="12.5" FontWeight="Bold" Content="🪟 Rollläden">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                    </Button>
                    <Button x:Name="TabGroupsBtn" Click="SwitchTab_Click" Tag="groups" Background="#161922" Foreground="#D1D5DB" BorderBrush="#262A36" BorderThickness="1"
                            Padding="13,7" Margin="0,0,7,0" Cursor="Hand" FontSize="12.5" FontWeight="SemiBold" Content="🗂 Gruppen">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                    </Button>
                    <Button x:Name="TabPlugsBtn" Click="SwitchTab_Click" Tag="plugs" Background="#161922" Foreground="#D1D5DB" BorderBrush="#262A36" BorderThickness="1"
                            Padding="13,7" Margin="0,0,7,0" Cursor="Hand" FontSize="12.5" FontWeight="SemiBold" Content="🔌 Steckdosen">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                    </Button>
                    <Button x:Name="TabCamerasBtn" Click="SwitchTab_Click" Tag="cameras" Background="#161922" Foreground="#D1D5DB" BorderBrush="#262A36" BorderThickness="1"
                            Padding="13,7" Cursor="Hand" FontSize="12.5" FontWeight="SemiBold" Content="📹 Kameras">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                    </Button>
                </StackPanel>

                <!-- Status Pill -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border x:Name="StatusBannerBorder" Background="#161922" BorderBrush="#262A36" BorderThickness="1" CornerRadius="8" Padding="12,5">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDotEllipse" Width="8" Height="8" Fill="#10B981" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusBannerTxt" Text="WLAN bereit" FontSize="12" FontWeight="SemiBold" Foreground="#D1D5DB" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right Controls -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="RefreshTopBtn" Click="RefreshCurrentTab_Click" Background="#161922" Foreground="#F9FAFB" BorderBrush="#262A36" BorderThickness="1"
                            Padding="12,7" Margin="0,0,8,0" Cursor="Hand" FontSize="12" FontWeight="SemiBold" Content="⟳ Aktualisieren">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                    </Button>
                    <Button x:Name="ThemeToggleBtn" Click="ThemeToggle_Click" Background="#161922" Foreground="#F9FAFB" BorderBrush="#262A36" BorderThickness="1"
                            Padding="11,7" Cursor="Hand" FontSize="12" FontWeight="Bold" Content="🌙" ToolTip="Light / Dark Mode">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================================================================= -->
        <!-- TAB 1: ROLLLÄDEN (CONNEXOON WINDOW · SOMFY 192.168.188.29)        -->
        <!-- ================================================================= -->
        <Grid x:Name="ShuttersViewGrid" Grid.Row="1" Visibility="Visible" Margin="22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Action Bar -->
            <Border x:Name="ShutterHeaderCard" Grid.Row="0" Background="#151821" BorderBrush="#262A36" BorderThickness="1" CornerRadius="14" Padding="18,14" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TahomaGatewayTitleTxt" Text="Connexoon Window · Somfy (192.168.188.29)" FontSize="15" FontWeight="Bold" Foreground="#F9FAFB" VerticalAlignment="Center"/>
                        <Border x:Name="PinBadgeBorder" Background="#26231F" BorderBrush="#C5A059" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center"
                                ToolTip="Somfy Connexoon Window (Box 0813-5321-9574, io / RTS): Rechts auf Connexoon verbinden klicken und mit Somfy E-Mail + Passwort koppeln.">
                            <TextBlock x:Name="TahomaPinBadgeTxt" Text="0813-5321-9574  !" FontSize="11.5" FontWeight="Bold" Foreground="#C5A059"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="AllShuttersOpenBtn" Click="AllShuttersOpen_Click" Background="#162A22" Foreground="#34D399" BorderBrush="#10B981" BorderThickness="1"
                                Padding="12,7" Margin="0,0,8,0" Cursor="Hand" FontSize="12" FontWeight="Bold" Content="▲ Alle Auf">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                        <Button x:Name="AllShuttersStopBtn" Click="AllShuttersStop_Click" Background="#1E222D" Foreground="#F9FAFB" BorderBrush="#374151" BorderThickness="1"
                                Padding="12,7" Margin="0,0,8,0" Cursor="Hand" FontSize="12" FontWeight="SemiBold" Content="■ Stopp">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                        <Button x:Name="AllShuttersCloseBtn" Click="AllShuttersClose_Click" Background="#1E222D" Foreground="#F9FAFB" BorderBrush="#374151" BorderThickness="1"
                                Padding="12,7" Margin="0,0,8,0" Cursor="Hand" FontSize="12" FontWeight="Bold" Content="▼ Alle Zu">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                        <Button x:Name="QuickAddGroupBtn" Click="OpenNewGroupModal_Click" Background="#1E222D" Foreground="#F9FAFB" BorderBrush="#374151" BorderThickness="1"
                                Padding="12,7" Margin="0,0,10,0" Cursor="Hand" FontSize="12" FontWeight="SemiBold" Content="＋ Gruppe" ToolTip="Mehrere Geräte (z.B. Wohnzimmer &amp; Terrassentür) zu einer Gruppe bündeln">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                        <Button x:Name="ConnectConnexoonBtn" Click="OpenTahomaAuthModal_Click" Background="#26231F" Foreground="#C5A059" BorderBrush="#C5A059" BorderThickness="1"
                                Padding="14,7" Cursor="Hand" FontSize="12" FontWeight="Bold" Content="🔑 Connexoon verbinden">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Shutters & Quick Groups Grid -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <WrapPanel x:Name="ShuttersQuickGroupsPanel" Orientation="Horizontal"/>
                    <WrapPanel x:Name="ShuttersWrapPanel" Orientation="Horizontal"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ================================================================= -->
        <!-- TAB 2: GRUPPEN (MEHRERE ROLLLÄDEN / STECKDOSEN GEMEINSAM STEUERN) -->
        <!-- ================================================================= -->
        <Grid x:Name="GroupsViewGrid" Grid.Row="1" Visibility="Collapsed" Margin="22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border x:Name="GroupsHeaderCard" Grid.Row="0" Background="#151821" BorderBrush="#262A36" BorderThickness="1" CornerRadius="14" Padding="18,14" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="GroupsTitleTxt" Text="Geräte-Gruppen" FontSize="15" FontWeight="Bold" Foreground="#F9FAFB" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="AddGroupBtn" Click="OpenNewGroupModal_Click" Background="#26231F" Foreground="#C5A059" BorderBrush="#C5A059" BorderThickness="1"
                                Padding="14,7" Cursor="Hand" FontSize="12" FontWeight="Bold" Content="＋ Gruppe anlegen">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <WrapPanel x:Name="GroupsWrapPanel" Orientation="Horizontal"/>
            </ScrollViewer>
        </Grid>

        <!-- ================================================================= -->
        <!-- TAB 3: STECKDOSEN (TAPO KLAP-V2)                                  -->
        <!-- ================================================================= -->
        <Grid x:Name="PlugsViewGrid" Grid.Row="1" Visibility="Collapsed" Margin="22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border x:Name="PlugsHeaderCard" Grid.Row="0" Background="#151821" BorderBrush="#262A36" BorderThickness="1" CornerRadius="14" Padding="18,14" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PlugsTitleTxt" Text="Smarte Steckdosen" FontSize="15" FontWeight="Bold" Foreground="#F9FAFB" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="ScanLanPlugsBtn" Click="ScanLanPlugs_Click" Background="#1E222D" Foreground="#F9FAFB" BorderBrush="#374151" BorderThickness="1"
                                Padding="13,7" Margin="0,0,8,0" Cursor="Hand" FontSize="12" FontWeight="SemiBold" Content="📡 WLAN Scan">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                        <Button x:Name="AddPlugBtn" Click="OpenAddPlugModal_Click" Background="#1E222D" Foreground="#F9FAFB" BorderBrush="#374151" BorderThickness="1"
                                Padding="13,7" Margin="0,0,8,0" Cursor="Hand" FontSize="12" FontWeight="SemiBold" Content="＋ Steckdose">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                        <Button x:Name="TapoAuthBtn" Click="OpenTapoAuthModal_Click" Background="#26231F" Foreground="#C5A059" BorderBrush="#C5A059" BorderThickness="1"
                                Padding="14,7" Cursor="Hand" FontSize="12" FontWeight="Bold" Content="🔑 Tapo-Zugang">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <WrapPanel x:Name="PlugsWrapPanel" Orientation="Horizontal"/>
            </ScrollViewer>
        </Grid>

        <!-- ================================================================= -->
        <!-- TAB 4: LIVE-ÜBERWACHUNG & KAMERASTEUERUNG (RTSP / ONVIF PTZ)      -->
        <!-- ================================================================= -->
        <Grid x:Name="CamerasViewGrid" Grid.Row="1" Visibility="Collapsed" Margin="22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border x:Name="CamerasHeaderCard" Grid.Row="0" Background="#151821" BorderBrush="#262A36" BorderThickness="1" CornerRadius="14" Padding="18,14" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="CamerasTitleTxt" Text="Live-Überwachung &amp; Kamerasteuerung" FontSize="15" FontWeight="Bold" Foreground="#F9FAFB" VerticalAlignment="Center"/>
                        <Border x:Name="CamerasOnlineBadgeBorder" Background="#26231F" BorderBrush="#C5A059" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center"
                                ToolTip="Pfeiltasten / WASD steuern die aktive PTZ-Kamera · Doppelklick auf ein Kamerabild wechselt zwischen Vollbild und Matrix · Drag &amp; Drop sortiert Kacheln.">
                            <TextBlock x:Name="CamerasOnlineBadgeTxt" Text="0 KAMERAS  !" FontSize="11" FontWeight="Bold" Foreground="#C5A059"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="CamGrid1Btn" Click="SetCameraGrid1_Click" Background="#26231F" Foreground="#C5A059" BorderBrush="#C5A059" BorderThickness="1"
                                Padding="11,7" Margin="0,0,6,0" Cursor="Hand" FontSize="12" FontWeight="Bold" Content="▢ 1 Groß" ToolTip="Einzelansicht (1×1)">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                        <Button x:Name="CamGrid4Btn" Click="SetCameraGrid4_Click" Background="#1E222D" Foreground="#F9FAFB" BorderBrush="#374151" BorderThickness="1"
                                Padding="11,7" Margin="0,0,6,0" Cursor="Hand" FontSize="12" FontWeight="SemiBold" Content="⊞ 4er" ToolTip="4er Matrix (2×2)">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                        <Button x:Name="CamGrid6Btn" Click="SetCameraGrid6_Click" Background="#1E222D" Foreground="#F9FAFB" BorderBrush="#374151" BorderThickness="1"
                                Padding="11,7" Margin="0,0,6,0" Cursor="Hand" FontSize="12" FontWeight="SemiBold" Content="▦ 6er" ToolTip="6er Matrix (3×2)">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                        <Button x:Name="CamGrid8Btn" Click="SetCameraGrid8_Click" Background="#1E222D" Foreground="#F9FAFB" BorderBrush="#374151" BorderThickness="1"
                                Padding="11,7" Margin="0,0,10,0" Cursor="Hand" FontSize="12" FontWeight="SemiBold" Content="∷ 8er" ToolTip="8er Matrix (4×2)">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                        <Button x:Name="CamScanLanBtn" Click="ScanLanCameras_Click" Background="#1E222D" Foreground="#F9FAFB" BorderBrush="#374151" BorderThickness="1"
                                Padding="12,7" Margin="0,0,8,0" Cursor="Hand" FontSize="12" FontWeight="SemiBold" Content="🔍 WLAN Scan" ToolTip="Sucht im lokalen Heimnetz nach RTSP/ONVIF-Kameras (Port 554 / 2020)">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                        <Button x:Name="CamOpenRecFolderBtn" Click="OpenRecordingsFolder_Click" Background="#1E222D" Foreground="#F9FAFB" BorderBrush="#374151" BorderThickness="1"
                                Padding="12,7" Margin="0,0,8,0" Cursor="Hand" FontSize="12" FontWeight="SemiBold" Content="📂 Aufnahmen" ToolTip="Lokalen Aufnahme- &amp; Snapshot-Ordner öffnen">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                        <Button x:Name="AddCameraBtn" Click="OpenAddCameraModal_Click" Background="#26231F" Foreground="#C5A059" BorderBrush="#C5A059" BorderThickness="1"
                                Padding="14,7" Cursor="Hand" FontSize="12" FontWeight="Bold" Content="＋ Kamera">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="290" MinWidth="230" MaxWidth="420"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Sidebar: Cameras + Recordings & Motion Clips -->
                <Border x:Name="CameraListSidebarBorder" Grid.Column="0" Background="#151821" BorderBrush="#262A36" BorderThickness="1" CornerRadius="14" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*" MinHeight="120"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*" MinHeight="140"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="2,0,2,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="CamSidebarListHeaderTxt" Text="IP-KAMERAS" FontSize="10.5" FontWeight="Bold" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CamSidebarCountTxt" Grid.Column="1" Text="0" FontSize="10.5" FontWeight="Bold" Foreground="#C5A059" VerticalAlignment="Center"/>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
                            <StackPanel>
                                <StackPanel x:Name="CameraSidebarStack"/>
                                <StackPanel x:Name="CameraDiscoveredLanStack"/>
                            </StackPanel>
                        </ScrollViewer>

                        <Border x:Name="CamSidebarDividerBorder" Grid.Row="2" BorderBrush="#262A36" BorderThickness="0,1,0,0" Padding="2,10,2,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="CamRecordingsHeaderTxt" Text="AUFNAHMEN &amp; BEWEGUNG" FontSize="10.5" FontWeight="Bold" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                                <Button x:Name="CamRefreshRecBtn" Grid.Column="1" Click="RefreshCameraRecordings_Click" Background="Transparent" Foreground="#C5A059" BorderThickness="0" Padding="6,1" Cursor="Hand" FontSize="12" FontWeight="Bold" Content="↻" ToolTip="Aufnahmeliste aktualisieren"/>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="CameraRecordingsSidebarStack"/>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <GridSplitter x:Name="CameraSidebarSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>

                <!-- Right Viewport: Live Camera Matrix + Integrated Clip & Snapshot Player -->
                <Border x:Name="CameraViewportBorder" Grid.Column="2" Background="#07090D" BorderBrush="#262A36" BorderThickness="1" CornerRadius="14" Padding="8">
                    <Grid>
                        <UniformGrid x:Name="CameraMatrixGrid" Columns="1" Rows="1"/>

                        <!-- Integrated MP4 & Snapshot Player Overlay -->
                        <Border x:Name="SmartMediaPlayerBorder" Background="#07090D" CornerRadius="10" Visibility="Collapsed" Panel.ZIndex="40">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Player Top Bar -->
                                <Border x:Name="SmartPlayerTopBarBorder" Grid.Row="0" Background="#11151E" BorderBrush="#262A36" BorderThickness="0,0,0,1" CornerRadius="10,10,0,0" Padding="14,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border x:Name="SmartPlayerBadgeBorder" Background="#26231F" BorderBrush="#C5A059" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="SmartPlayerBadgeTxt" Text="AUFNAHME" FontSize="10.5" FontWeight="Bold" Foreground="#C5A059"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock x:Name="SmartPlayerTitleTxt" Text="Kamera" FontSize="13.5" FontWeight="Bold" Foreground="#F9FAFB" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="SmartPlayerSubTxt" Text="" FontSize="11.5" Foreground="#9CA3AF" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="SmartPlayerRevealBtn" Click="RevealCurrentSmartMediaInExplorer_Click" Background="#1E222D" Foreground="#F9FAFB" BorderBrush="#374151" BorderThickness="1" Padding="10,5" Margin="0,0,6,0" Cursor="Hand" FontSize="11.5" FontWeight="SemiBold" Content="📂 Im Ordner">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style></Button.Resources>
                                            </Button>
                                            <Button x:Name="SmartPlayerDeleteBtn" Click="DeleteCurrentSmartMedia_Click" Background="#2D161B" Foreground="#F87171" BorderThickness="0" Padding="10,5" Margin="0,0,6,0" Cursor="Hand" FontSize="11.5" FontWeight="Bold" Content="🗑 Löschen">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style></Button.Resources>
                                            </Button>
                                            <Button x:Name="SmartPlayerCloseBtn" Click="CloseSmartMediaPlayer_Click" Background="#C5A059" Foreground="#111827" BorderThickness="0" Padding="12,5" Cursor="Hand" FontSize="11.5" FontWeight="Bold" Content="← Live-Ansicht">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style></Button.Resources>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Player Stage -->
                                <Grid Grid.Row="1" Background="#05070A">
                                    <MediaElement x:Name="SmartClipMediaElement" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform"
                                                  MediaOpened="SmartClipMediaElement_MediaOpened" MediaEnded="SmartClipMediaElement_MediaEnded"/>
                                    <Image x:Name="SmartClipSnapshotImage" Stretch="Uniform" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Grid>

                                <!-- Player Transport Bar -->
                                <Border x:Name="SmartClipTransportBar" Grid.Row="2" Background="#11151E" BorderBrush="#262A36" BorderThickness="0,1,0,0" CornerRadius="0,0,10,10" Padding="14,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Button x:Name="SmartClipPlayPauseBtn" Grid.Column="0" Click="ToggleSmartClipPlayPause_Click" Background="#C5A059" Foreground="#111827" BorderThickness="0" Padding="11,4" Margin="0,0,6,0" Cursor="Hand" FontSize="12" FontWeight="Bold" Content="⏸">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                        </Button>
                                        <Button x:Name="SmartClipReplayBtn" Grid.Column="1" Click="ReplaySmartClip_Click" Background="#1E222D" Foreground="#F9FAFB" BorderThickness="0" Padding="9,4" Margin="0,0,10,0" Cursor="Hand" FontSize="12" FontWeight="Bold" Content="⏮" ToolTip="Von vorne abspielen">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                        </Button>
                                        <TextBlock x:Name="SmartClipPosTxt" Grid.Column="2" Text="00:00" FontSize="11.5" FontWeight="SemiBold" Foreground="#D1D5DB" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <Slider x:Name="SmartClipTimelineSlider" Grid.Column="3" Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center" Cursor="Hand"
