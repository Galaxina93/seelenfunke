<Window x:Class="FunkenwerkVideo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Funkenwerk Video"
        Icon="funkenwerk_video.ico"
        Width="1280" Height="820"
        MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#0F1117"
        Foreground="#F9FAFB"
        FontFamily="Segoe UI"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="86"/>
        </Grid.RowDefinitions>

        <!-- ================================================================= -->
        <!-- ROW 0: MINIMALIST HEADER                                          -->
        <!-- ================================================================= -->
        <Border Grid.Row="0" Background="#11131A" BorderBrush="#232734" BorderThickness="0,0,0,1" Padding="24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Fill="#C5A059" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="FUNKENWERK VIDEO" FontSize="15.5" FontWeight="Bold" Foreground="#F9FAFB" VerticalAlignment="Center"/>
                </StackPanel>

                <Button x:Name="ThemeToggleBtn" Grid.Column="1" Click="ThemeToggle_Click"
                        Background="#181B24" Foreground="#F9FAFB" BorderBrush="#262A36" BorderThickness="1"
                        Padding="14,7" Cursor="Hand" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Content="🌙 Darkmode">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- ================================================================= -->
        <!-- ROW 1: 2 LARGE TILES (LINKS: PROJEKTE | RECHTS: VORSCHAU)         -->
        <!-- ================================================================= -->
        <Grid Grid.Row="1" Margin="24,20,24,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============================================================= -->
            <!-- LEFT TILE: PROJEKTE                                           -->
            <!-- ============================================================= -->
            <Border x:Name="ProjectsTileBorder" Grid.Column="0"
                    Background="#11131A" BorderBrush="#232734" BorderThickness="1" CornerRadius="16" Padding="20"
                    AllowDrop="True" DragEnter="ProjectsTile_DragEnter" DragLeave="ProjectsTile_DragLeave"
                    DragOver="Window_DragOver" Drop="Window_Drop">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Projekte Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="PROJEKTE" Foreground="#C5A059" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Click="AddProjectFolder_Click" Background="#181B24" Foreground="#F9FAFB" BorderBrush="#262A36" BorderThickness="1"
                                    Padding="12,6" Margin="0,0,8,0" Cursor="Hand" FontSize="11.5" FontWeight="Bold" Content="＋ Projektordner">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                            </Button>
                            <Button Click="AddRawFiles_Click" Background="#26231F" Foreground="#C5A059" BorderBrush="#C5A059" BorderThickness="1"
                                    Padding="12,6" Margin="0,0,8,0" Cursor="Hand" FontSize="11.5" FontWeight="Bold" Content="＋ Videos">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                            </Button>
                            <Button Click="RefreshRawClips_Click" Background="#181B24" Foreground="#D1D5DB" BorderBrush="#262A36" BorderThickness="1"
                                    Padding="10,6" Cursor="Hand" FontSize="11.5" FontWeight="Bold" Content="↻">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Project Folders List (Select with Checkbox) -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ProjectsStackPanel"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ============================================================= -->
            <!-- RIGHT TILE: VORSCHAU                                          -->
            <!-- ============================================================= -->
            <Border Grid.Column="2" Background="#11131A" BorderBrush="#232734" BorderThickness="1" CornerRadius="16" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Vorschau Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="VORSCHAU" Foreground="#C5A059" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="PlayPauseBtn" Click="PlayPause_Click"
                                    Background="#26231F" Foreground="#C5A059" BorderBrush="#C5A059" BorderThickness="1"
                                    Padding="14,6" Margin="0,0,8,0" Cursor="Hand" FontSize="11.5" FontWeight="Bold" Content="▶ Play">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                            </Button>
                            <Button Click="RevealCurrentVideo_Click"
                                    Background="#181B24" Foreground="#F9FAFB" BorderBrush="#262A36" BorderThickness="1"
                                    Padding="12,6" Cursor="Hand" FontSize="11.5" FontWeight="SemiBold" Content="📁 Desktop">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Video Player Stage -->
                    <Border Grid.Row="1" Background="#07090D" BorderBrush="#242936" BorderThickness="1" CornerRadius="14" ClipToBounds="True">
                        <Grid>
                            <MediaElement x:Name="PreviewMediaElement" LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                          Stretch="Uniform" MediaEnded="PreviewMediaElement_MediaEnded"/>

                            <StackPanel x:Name="PlayerEmptyOverlay" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="🎬" FontSize="42" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock x:Name="PlayerEmptyStatusTxt" Text="Vorschau" Foreground="#9CA3AF" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ================================================================= -->
        <!-- ROW 2: BOTTOM CENTER ACTION BUTTON ("VIRALES VIDEO SCHNEIDEN")    -->
        <!-- ================================================================= -->
        <Grid Grid.Row="2" Margin="24,0,24,18">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
                <Border x:Name="RenderProgressBorder" Visibility="Collapsed" Background="#181B24" BorderBrush="#C5A059" BorderThickness="1" CornerRadius="8" Padding="10,5" Margin="0,0,0,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="RenderStatusTxt" Grid.Column="0" Text="Schneide Video..." Foreground="#C5A059" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <ProgressBar x:Name="RenderProgressBar" Grid.Column="1" Height="6" Minimum="0" Maximum="100" Value="40" Foreground="#C5A059" Background="#11131A" BorderThickness="0" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </Grid>
                </Border>

                <Button x:Name="ProduceViralVideoBtn" Click="ProduceViralVideo_Click"
                        Background="#26231F" Foreground="#C5A059" BorderBrush="#C5A059" BorderThickness="1.5"
                        Height="50" Cursor="Hand" FontSize="14.5" FontWeight="Bold" Content="⚡ VIRALES VIDEO SCHNEIDEN">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="12"/></Style></Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
