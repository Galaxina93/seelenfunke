<Window x:Class="FunkenwerkVideo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Funkenwerk Video · KI-Schnittstudio für echte Manufaktur-Aufnahmen"
        Width="1580" Height="950"
        MinWidth="1240" MinHeight="760"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#000000"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" Background="#000000" BorderBrush="#262015" BorderThickness="1">
        <Grid x:Name="RootGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="54"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ========================================================================= -->
            <!-- TOP TITLE BAR                                                             -->
            <!-- ========================================================================= -->
            <Border x:Name="HeaderBar" Grid.Row="0" Background="#050505" BorderBrush="#1F1F1F" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Brand Logo & Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="8" Background="#0A0A0A" BorderBrush="#C5A059" BorderThickness="1" Margin="0,0,10,0">
                            <Image Source="funkenwerk.png" Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="BrandTitleTxt" Text="Funkenwerk Video" Foreground="#FFFFFF" FontSize="15.5" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Border Background="#14C5A059" BorderBrush="#C5A059" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center"
                                ToolTip="Garantie: Es werden zu 100 % nur deine eigenen, selbst gedrehten Videoaufnahmen geschnitten. Keine künstlichen KI-Videos.">
                            <TextBlock Text="✓ 100 % ECHTE EIGENE AUFNAHMEN · KEINE KI-VIDEOS" Foreground="#C5A059" FontSize="10.5" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>

                    <!-- Folder Quick Status -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                        <Ellipse Width="8" Height="8" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="WatcherStatusTxt" Text="Ordner-Überwachung aktiv: Rohmaterial" Foreground="#9CA3AF" FontSize="11.5" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Right Window Controls -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="RunSelfTestHeaderBtn" Click="RunSelfTest_Click" Cursor="Hand"
                                Background="#0D0D0D" Foreground="#10B981" BorderBrush="#10B981" BorderThickness="1"
                                Padding="10,5" Margin="0,0,8,0" FontSize="11" FontWeight="Bold"
                                ToolTip="Führt den automatisierten End-to-End Sicherheits-, Geschwindigkeits- &amp; Schnitt-Test durch">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="🧪 System-Test"/>
                        </Button>

                        <Button x:Name="OpenRawFolderHeaderBtn" Click="OpenRawFolder_Click" Cursor="Hand"
                                Background="#0D0D0D" Foreground="#E5E7EB" BorderBrush="#262626" BorderThickness="1"
                                Padding="11,5" Margin="0,0,8,0" FontSize="11.5" FontWeight="SemiBold"
                                ToolTip="Öffnet den Ordner 'Rohmaterial' im Windows Explorer">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="📂 Rohmaterial-Ordner"/>
                        </Button>

                        <Button x:Name="OpenOutputFolderHeaderBtn" Click="OpenOutputFolder_Click" Cursor="Hand"
                                Background="#0D0D0D" Foreground="#C5A059" BorderBrush="#C5A059" BorderThickness="1"
                                Padding="11,5" Margin="0,0,12,0" FontSize="11.5" FontWeight="SemiBold"
                                ToolTip="Öffnet den Ordner 'Fertige Videos' im Windows Explorer">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="🎬 Fertige Videos"/>
                        </Button>

                        <!-- Theme Switch -->
                        <Button x:Name="ThemeToggleBtn" Click="ToggleTheme_Click" Cursor="Hand"
                                Width="34" Height="30" Background="#0D0D0D" BorderBrush="#262626" BorderThickness="1" Margin="0,0,10,0"
                                ToolTip="Zwischen Darkmode (Tiefschwarz) und Lightmode wechseln">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                                        <TextBlock x:Name="ThemeIconTxt" Text="☀" Foreground="#C5A059" FontSize="13.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Click="MinimizeWindow_Click" Width="32" Height="28" Background="Transparent" BorderThickness="0" Foreground="#9CA3AF" FontSize="13" Cursor="Hand" Content="—"/>
                        <Button Click="MaximizeRestoreWindow_Click" Width="32" Height="28" Background="Transparent" BorderThickness="0" Foreground="#9CA3AF" FontSize="13" Cursor="Hand" Content="□"/>
                        <Button Click="CloseWindow_Click" Width="32" Height="28" Background="Transparent" BorderThickness="0" Foreground="#EF4444" FontSize="13" FontWeight="Bold" Cursor="Hand" Content="✕"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ========================================================================= -->
            <!-- MAIN 3-COLUMN WORKSPACE                                                   -->
            <!-- ========================================================================= -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="345" MinWidth="290" MaxWidth="450"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="375" MinWidth="330" MaxWidth="460"/>
                </Grid.ColumnDefinitions>

                <!-- ===================================================================== -->
                <!-- COLUMN 1 (LEFT): ROHMATERIAL & KAMERA-CLIPS                           -->
                <!-- ===================================================================== -->
                <Border x:Name="LeftSidebarBorder" Grid.Column="0" Background="#050505" Padding="14,14,14,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Section Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="1. DEIN ROHMATERIAL" Foreground="#C5A059" FontSize="11" FontWeight="Bold"/>
                                <TextBlock x:Name="RawClipsCountTitle" Text="0 Kamera-Aufnahmen geladen" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Click="RefreshRawFolder_Click" Cursor="Hand"
                                    Background="#0F0F0F" Foreground="#C5A059" BorderBrush="#C5A059" BorderThickness="1"
                                    Padding="9,5" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"
                                    ToolTip="Ordner 'Rohmaterial' erneut scannen und KI-Analyse aktualisieren">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="🔄 Scannen"/>
                            </Button>
                        </Grid>

                        <!-- Drag & Drop Zone -->
                        <Border x:Name="DropZoneBorder" Grid.Row="1" Background="#0A0A0A" BorderBrush="#C5A059" BorderThickness="1.5" CornerRadius="12" Padding="12,12" Margin="0,0,0,10" Cursor="Hand"
                                MouseLeftButtonUp="AddRawVideosDialog_Click"
                                ToolTip="Klicken, um eigene Videodateien auszuwählen, oder Dateien einfach per Drag &amp; Drop hierher ziehen">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="📥 Eigene Rohvideos hierher ziehen" Foreground="#C5A059" FontSize="12.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="oder klicken · legt Dateien direkt in 'Rohmaterial' ab" Foreground="#9CA3AF" FontSize="10.5" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Action Row -->
                        <Grid Grid.Row="2" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Click="OpenRawFolder_Click" Cursor="Hand"
                                    Background="#0F0F0F" Foreground="#E5E7EB" BorderBrush="#262626" BorderThickness="1" Padding="8,6" FontSize="11" FontWeight="SemiBold">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="📂 Ordner öffnen"/>
                            </Button>
                            <Button Grid.Column="2" Click="ImportSampleFromVideos_Click" Cursor="Hand"
                                    Background="#0F0F0F" Foreground="#C5A059" BorderBrush="#382D18" BorderThickness="1" Padding="10,6" FontSize="11" FontWeight="SemiBold"
                                    ToolTip="Kopiert eine deiner bestehenden Aufnahmen aus C:\Users\konta\Videos zum sofortigen Testen in den Rohmaterial-Ordner">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="⚡ Aus 'Videos' laden"/>
                            </Button>
                        </Grid>

                        <!-- Raw Clips Scroll List -->
                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="RawClipsStackPanel"/>
                        </ScrollViewer>

                        <!-- Bottom Summary -->
                        <Border Grid.Row="4" Background="#0A0A0A" BorderBrush="#1F1F1F" BorderThickness="1" CornerRadius="9" Padding="10,8" Margin="0,10,0,0">
                            <TextBlock x:Name="RawClipsSummaryTxt" Text="Lege deine Kamera- oder Handy-Videos in den Ordner 'Rohmaterial'." Foreground="#9CA3AF" FontSize="11" TextWrapping="Wrap"/>
                        </Border>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#141414"/>

                <!-- ===================================================================== -->
                <!-- COLUMN 2 (CENTER): STUDIO-VORSCHAU & KI-SCHNITT-TIMELINE              -->
                <!-- ===================================================================== -->
                <Border x:Name="CenterWorkspaceBorder" Grid.Column="2" Background="#000000" Padding="16,14,16,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="330"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 1. KI-Regie-Modus Auswahl (6 Virale Regie-Modi) -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="2. VIRALE KI-REGIE (WANN, WIE LANGE &amp; MIT WELCHEM ÜBERGANG WIRD GESCHNITTEN?)" Foreground="#C5A059" FontSize="11" FontWeight="Bold"/>
                                <TextBlock x:Name="ActiveModeRuleHintTxt" Grid.Column="1" Text="4-Phasen Packaging: Teaser (1,4s) → Hero-Unikat → Micro-ASMR → Box-Snap Finale" Foreground="#9CA3AF" FontSize="11"/>
                            </Grid>

                            <UniformGrid Rows="1" Columns="6">
                                <Border x:Name="ModeBtnPackaging" Tag="packaging_pov" MouseLeftButtonUp="DirectorMode_Click" Cursor="Hand"
                                        Background="#1A150B" BorderBrush="#C5A059" BorderThickness="1.5" CornerRadius="9" Padding="7,7" Margin="0,0,5,0"
                                        ToolTip="Virale Luxury-Packaging-Formel: 1. Fertiger Reveal-Teaser (0–1,4s) → 2. Hero-Unikat → 3. Schnelle ASMR-Micro-Cuts mit 2-Cam-Zoom → 4. Samt-Finale">
                                    <StackPanel>
                                        <TextBlock Text="📦 Packaging Viral" Foreground="#C5A059" FontSize="11" FontWeight="Bold"/>
                                        <TextBlock Text="Teaser → ASMR → Box" Foreground="#9CA3AF" FontSize="9" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="ModeBtnAsmr" Tag="asmr_laser" MouseLeftButtonUp="DirectorMode_Click" Cursor="Hand"
                                        Background="#0A0A0A" BorderBrush="#262626" BorderThickness="1" CornerRadius="9" Padding="7,7" Margin="0,0,5,0"
                                        ToolTip="Ideal für UV-Laser &amp; weiße Handschuhe: Starker Action-Hook (0–1,8s), knackige Schnitte auf den Takt und edler Reveal">
                                    <StackPanel>
                                        <TextBlock Text="🔥 Laser &amp; ASMR" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold"/>
                                        <TextBlock Text="Hook → Takt → Reveal" Foreground="#9CA3AF" FontSize="9" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="ModeBtnViralDrop" Tag="viral_drop" MouseLeftButtonUp="DirectorMode_Click" Cursor="Hand"
                                        Background="#0A0A0A" BorderBrush="#262626" BorderThickness="1" CornerRadius="9" Padding="7,7" Margin="0,0,5,0"
                                        ToolTip="Exakt auf den Shimmer-Drop bei Sekunde 4,0 abgestimmt: Spannungsaufbau + Licht-Impuls-Drop auf das fertige Unikat">
                                    <StackPanel>
                                        <TextBlock Text="⚡ 4s Shimmer-Drop" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold"/>
                                        <TextBlock Text="Drop exakt bei ~4,0s" Foreground="#9CA3AF" FontSize="9" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="ModeBtnUnboxing" Tag="unboxing_reveal" MouseLeftButtonUp="DirectorMode_Click" Cursor="Hand"
                                        Background="#0A0A0A" BorderBrush="#262626" BorderThickness="1" CornerRadius="9" Padding="7,7" Margin="0,0,5,0"
                                        ToolTip="Vorher/Nachher &amp; Unboxing: Zeigt erst den Rohling, dann dynamische Veredelung mit Whip-Flow und das fertige Unikat">
                                    <StackPanel>
                                        <TextBlock Text="✨ Vorher / Nachher" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold"/>
                                        <TextBlock Text="Rohling → Veredelung" Foreground="#9CA3AF" FontSize="9" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="ModeBtnSpeech" Tag="story_speech" MouseLeftButtonUp="DirectorMode_Click" Cursor="Hand"
                                        Background="#0A0A0A" BorderBrush="#262626" BorderThickness="1" CornerRadius="9" Padding="7,7" Margin="0,0,5,0"
                                        ToolTip="Gling/Opus-Stil für Sprachvideos: Entfernt Sprechpausen automatisch &amp; wechselt sanft zwischen 1.0x und 1.06x gegen Jump-Cuts">
                                    <StackPanel>
                                        <TextBlock Text="🎙️ Sprache / Story" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold"/>
                                        <TextBlock Text="Silence-Cut + 2-Cam" Foreground="#9CA3AF" FontSize="9" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="ModeBtnCleanAll" Tag="clean_all" MouseLeftButtonUp="DirectorMode_Click" Cursor="Hand"
                                        Background="#0A0A0A" BorderBrush="#262626" BorderThickness="1" CornerRadius="9" Padding="7,7"
                                        ToolTip="Nimmt alle aktiven Roh-Clips in ihrer Reihenfolge, entfernt Wackler am Anfang/Ende und verbindet sie im Takt">
                                    <StackPanel>
                                        <TextBlock Text="🎬 Alle Verbinden" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold"/>
                                        <TextBlock Text="Chronologisch sauber" Foreground="#9CA3AF" FontSize="9" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>

                        <!-- 2. Video Preview Player Header -->
                        <Grid Grid.Row="1" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PreviewTitleTxt" Text="Studio-Vorschau (Klicke links auf einen Roh-Clip oder unten auf ein Schnitt-Segment)" Foreground="#E5E7EB" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button x:Name="PlayFullCutPreviewBtn" Grid.Column="1" Click="PlayFullCutSequencePreview_Click" Cursor="Hand"
                                    Background="#C5A059" Foreground="#000000" BorderThickness="0" Padding="12,5" FontSize="11.5" FontWeight="Bold"
                                    ToolTip="Spielt alle unten berechneten KI-Schnitte nahtlos nacheinander inklusive ausgewählter Hintergrundmusik als Live-Vorschau ab">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="▶ Komplette KI-Schnitt-Vorschau abspielen"/>
                            </Button>
                        </Grid>

                        <!-- 3. Studio Video Player Box -->
                        <Border Grid.Row="2" Background="#070707" BorderBrush="#1F1F1F" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                            <Grid>
                                <MediaElement x:Name="PreviewPlayer" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform"
                                              MediaOpened="PreviewPlayer_MediaOpened" MediaEnded="PreviewPlayer_MediaEnded"/>

                                <!-- Empty State Overlay -->
                                <StackPanel x:Name="PlayerEmptyOverlay" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock Text="🎥" FontSize="34" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Deine echten Kamera-Aufnahmen im Studio-Player" Foreground="#FFFFFF" FontSize="13.5" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    <TextBlock Text="Ziehe links Rohvideos hinein oder klicke unten auf ein KI-Schnitt-Segment" Foreground="#9CA3AF" FontSize="11.5" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>

                                <!-- Active Cut Role Badge Overlay (Top Left) -->
                                <Border x:Name="PlayerActiveRoleBadge" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Background="#D9000000" BorderBrush="#C5A059" BorderThickness="1" CornerRadius="7" Padding="10,4" Margin="12,12,0,0">
                                    <TextBlock x:Name="PlayerActiveRoleTxt" Text="⚡ HOOK" Foreground="#C5A059" FontSize="11" FontWeight="Bold"/>
                                </Border>

                                <!-- Bottom Transport Bar -->
                                <Border VerticalAlignment="Bottom" Background="#CC000000" Padding="12,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="PlayerPlayPauseBtn" Grid.Column="0" Click="PlayerPlayPause_Click" Cursor="Hand"
                                                Width="30" Height="26" Background="#C5A059" Foreground="#000000" BorderThickness="0" FontWeight="Bold" Content="▶">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <TextBlock x:Name="PlayerTimeTxt" Grid.Column="1" Text="0:00.0 / 0:00.0" Foreground="#E5E7EB" FontSize="11.5" VerticalAlignment="Center" Margin="10,0,10,0"/>
                                        <Slider x:Name="PlayerTimelineSlider" Grid.Column="2" Minimum="0" Maximum="10" Value="0" VerticalAlignment="Center"
                                                PreviewMouseLeftButtonUp="PlayerTimelineSlider_MouseUp"/>
                                        <TextBlock x:Name="PlayerClipNameTxt" Grid.Column="3" Text="" Foreground="#C5A059" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- 4. KI-Schnitt-Timeline Header + Viralitäts-Score -->
                        <Grid Grid.Row="3" Margin="0,10,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="✂️ KI-SCHNITT-TIMELINE" Foreground="#C5A059" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock x:Name="CutListSummaryTxt" Text=" (0 Schnitte · 0,0 Sek.)" Foreground="#9CA3AF" FontSize="11.5" VerticalAlignment="Center" Margin="6,0,12,0"/>
                            </StackPanel>

                            <Border x:Name="ViralScoreBadgeBorder" Grid.Column="1" Background="#1410B981" BorderBrush="#10B981" BorderThickness="1" CornerRadius="6" Padding="8,2" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock x:Name="ViralScoreBadgeTxt" Text="🔥 VIRAL-POTENZIAL: 96/100" Foreground="#10B981" FontSize="10.5" FontWeight="Bold"/>
                            </Border>

                            <TextBlock x:Name="ViralPacingHintTxt" Grid.Column="2" Text="" Foreground="#9CA3AF" FontSize="10.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>

                            <Button Grid.Column="3" Click="RecalculateAiCuts_Click" Cursor="Hand"
                                    Background="#0F0F0F" Foreground="#C5A059" BorderBrush="#C5A059" BorderThickness="1" Padding="10,4" FontSize="11" FontWeight="Bold"
                                    ToolTip="Berechnet die optimalen Schnittpunkte aus deinen Rohvideos nach dem gewählten Regie-Modus neu">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="✨ Neu berechnen"/>
                            </Button>
                        </Grid>

                        <!-- 5. KI-Schnitt-Timeline Cards -->
                        <Border Grid.Row="4" Background="#050505" BorderBrush="#1F1F1F" BorderThickness="1" CornerRadius="11" Padding="10">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="CutDecisionsStackPanel"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="#141414"/>

                <!-- ===================================================================== -->
                <!-- COLUMN 3 (RIGHT): FORMAT, ÜBERGÄNGE, MUSIK & 1-KLICK MP4 EXPORT       -->
                <!-- ===================================================================== -->
                <Border x:Name="RightInspectorBorder" Grid.Column="4" Background="#050505" Padding="14,14,14,14">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="3. ÜBERGÄNGE, MUSIK &amp; EXPORT" Foreground="#C5A059" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="Studio-Mastering &amp; MP4-Ausgabe" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold" Margin="0,2,0,12"/>

                            <!-- Ziel-Format & Saubere Luxus-Übergänge -->
                            <Border Background="#0A0A0A" BorderBrush="#1F1F1F" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Ziel-Format (Seitenverhältnis)" Foreground="#C5A059" FontSize="11.5" FontWeight="Bold" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="AspectRatioCombo" SelectionChanged="SettingsCombo_SelectionChanged" Height="32" FontSize="12">
                                        <ComboBoxItem Tag="9_16_crop" Content="📱 9:16 Hochformat Vollbild (Reel / TikTok / Shorts)" IsSelected="True"/>
                                        <ComboBoxItem Tag="9_16_pad" Content="🖼️ 9:16 Studio-Rahmen (Ganzes Bild + Edler Hintergrund)"/>
                                        <ComboBoxItem Tag="16_9" Content="🖥️ 16:9 Querformat (Shop-Video / YouTube 1920×1080)"/>
                                    </ComboBox>

                                    <TextBlock Text="Schnitt-Übergänge &amp; 2-Kamera-Logik" Foreground="#C5A059" FontSize="11.5" FontWeight="Bold" Margin="0,10,0,6"/>
                                    <ComboBox x:Name="TransitionCombo" SelectionChanged="SettingsCombo_SelectionChanged" Height="32" FontSize="12">
                                        <ComboBoxItem Tag="auto_director" Content="🤖 KI-Regie-Automatik (2-Cam Zoom + Action-Cut + Samt-Finale)" IsSelected="True"/>
                                        <ComboBoxItem Tag="punch_zoom" Content="🔍 2-Kamera Makro-Wechsel (1.00x ↔ 1.08x gegen Jump-Cuts)"/>
                                        <ComboBoxItem Tag="hard_action" Content="⚡ Hard-Cut on Action (Direkter Takt-Schnitt + J/L-Ton)"/>
                                        <ComboBoxItem Tag="velvet_dip" Content="🖤 Atelier Samt-Blende (Kurze Micro-Schwarzblende)"/>
                                        <ComboBoxItem Tag="whip_flow" Content="💨 Whip-Flow (Dynamischer Szenen-Impuls)"/>
                                        <ComboBoxItem Tag="flash_luma" Content="✨ Licht-Impuls (Sanfte Kristall- &amp; Gold-Blende)"/>
                                    </ComboBox>

                                    <TextBlock Text="Echtbild-Farbkorrektur (Kein KI-Filter)" Foreground="#C5A059" FontSize="11.5" FontWeight="Bold" Margin="0,10,0,6"/>
                                    <ComboBox x:Name="ColorGradingCombo" SelectionChanged="SettingsCombo_SelectionChanged" Height="32" FontSize="12">
                                        <ComboBoxItem Tag="atelier_gold" Content="✨ Seelenfunke Atelier (Matte Tiefen &amp; Warme Lichter)" IsSelected="True"/>
                                        <ComboBoxItem Tag="matte_luxury" Content="🖤 Matte Luxury (Tiefschwarz &amp; Edler Gold-Kontrast)"/>
                                        <ComboBoxItem Tag="crystal_bright" Content="☀️ Manufaktur Tageslicht (Klar &amp; Hell für Handschuhe)"/>
                                        <ComboBoxItem Tag="none" Content="📷 Original-Kamerafarben (100 % unverändert)"/>
                                    </ComboBox>
                                </StackPanel>
                            </Border>

                            <!-- KI-Schnitt-Kriterien -->
                            <Border Background="#0A0A0A" BorderBrush="#1F1F1F" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Virale Schnitt- &amp; Audio-Kriterien" Foreground="#C5A059" FontSize="11.5" FontWeight="Bold" Margin="0,0,0,8"/>

                                    <CheckBox x:Name="SnapToBeatCheck" Content="Schnitte exakt auf Musik-Beat &amp; ASMR-Peaks legen" IsChecked="True"
                                              Foreground="#E5E7EB" FontSize="11.5" Margin="0,0,0,6" Checked="CriteriaCheck_Changed" Unchecked="CriteriaCheck_Changed"/>

                                    <CheckBox x:Name="AutoTrimShakeCheck" Content="Kamera-Wackler am Anfang/Ende automatisch wegschneiden" IsChecked="True"
                                              Foreground="#E5E7EB" FontSize="11.5" Margin="0,0,0,6" Checked="CriteriaCheck_Changed" Unchecked="CriteriaCheck_Changed"/>

                                    <CheckBox x:Name="AsmrMasteringCheck" Content="ASMR- &amp; Stimm-Mastering (J/L-Overlap &amp; Box-Snap Boost)" IsChecked="True"
                                              Foreground="#E5E7EB" FontSize="11.5" Margin="0,0,0,10"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Ziel-Gesamtlänge:" Foreground="#E5E7EB" FontSize="12"/>
                                        <TextBlock x:Name="TargetDurationLabelTxt" Grid.Column="1" Text="15 Sek." Foreground="#C5A059" FontSize="12" FontWeight="Bold"/>
                                    </Grid>
                                    <Slider x:Name="TargetDurationSlider" Minimum="7" Maximum="45" Value="15" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Margin="0,5,0,0" ValueChanged="TargetDurationSlider_ValueChanged"/>
                                </StackPanel>
                            </Border>

                            <!-- Seelenfunke Studio-Musik & Originalton-Mix -->
                            <Border Background="#0A0A0A" BorderBrush="#1F1F1F" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Seelenfunke Studio-Musik" Foreground="#C5A059" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button x:Name="PreviewMusicBtn" Click="ToggleMusicPreview_Click" Cursor="Hand"
                                                    Background="#141414" Foreground="#C5A059" BorderBrush="#C5A059" BorderThickness="1"
                                                    Padding="8,3" Margin="0,0,6,0" FontSize="10.5" FontWeight="Bold">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <TextBlock x:Name="PreviewMusicBtnTxt" Text="▶ Anhören"/>
                                            </Button>
                                            <Button Click="SelectCustomMusicFile_Click" Cursor="Hand"
                                                    Background="#141414" Foreground="#E5E7EB" BorderBrush="#262626" BorderThickness="1"
                                                    Padding="8,3" FontSize="10.5" ToolTip="Eigene MP3/WAV/M4A Audiodatei wählen">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <TextBlock Text="📂 Eigene"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <ComboBox x:Name="MusicTrackCombo" SelectionChanged="MusicTrackCombo_SelectionChanged" Height="32" FontSize="11.5"/>
                                    <TextBlock x:Name="MusicTrackHintTxt" Text="86 BPM · Drop bei 4,2s" Foreground="#9CA3AF" FontSize="10.5" Margin="0,5,0,8" TextWrapping="Wrap"/>

                                    <!-- Musik-Lautstärke -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="🎵 Hintergrundmusik:" Foreground="#E5E7EB" FontSize="11.5"/>
                                        <TextBlock x:Name="MusicVolLabelTxt" Grid.Column="1" Text="75 %" Foreground="#C5A059" FontSize="11.5" FontWeight="Bold"/>
                                    </Grid>
                                    <Slider x:Name="MusicVolSlider" Minimum="0" Maximum="100" Value="75" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Margin="0,4,0,8" ValueChanged="AudioMixSlider_ValueChanged"/>

                                    <!-- Originalton-Lautstärke (ASMR / Sprache) -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="🎙️ Dein Originalton (ASMR / Sprache):" Foreground="#E5E7EB" FontSize="11.5"/>
                                        <TextBlock x:Name="OrigAudioVolLabelTxt" Grid.Column="1" Text="35 %" Foreground="#C5A059" FontSize="11.5" FontWeight="Bold"/>
                                    </Grid>
                                    <Slider x:Name="OrigAudioVolSlider" Minimum="0" Maximum="100" Value="35" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Margin="0,4,0,0" ValueChanged="AudioMixSlider_ValueChanged"/>
                                </StackPanel>
                            </Border>

                            <!-- RENDER PROGRESS & MASTER EXPORT BUTTON -->
                            <Border x:Name="RenderProgressCard" Visibility="Collapsed" Background="#120E07" BorderBrush="#C5A059" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="RenderStatusTxt" Text="Rendern läuft..." Foreground="#FFFFFF" FontSize="11.5" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="RenderPercentTxt" Grid.Column="1" Text="0 %" Foreground="#C5A059" FontSize="11.5" FontWeight="Bold"/>
                                    </Grid>
                                    <ProgressBar x:Name="RenderProgressBar" Minimum="0" Maximum="100" Value="0" Height="7" Foreground="#C5A059" Background="#1F1F1F" BorderThickness="0" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <Button x:Name="RenderExportMasterBtn" Click="RenderExportMaster_Click" Cursor="Hand"
                                    Background="#C5A059" Foreground="#000000" BorderThickness="0" Padding="14,13" FontSize="13" FontWeight="Bold"
                                    ToolTip="Schneidet deine echten Kamera-Aufnahmen exakt nach der KI-Schnittliste und speichert das fertige Full-HD MP4 im Ordner 'Fertige Videos'">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="🎬 KI-VIDEO SCHNEIDEN &amp; ALS MP4 SPEICHERN"/>
                            </Button>

                            <!-- Zuletzt exportierte Videos -->
                            <Border Background="#0A0A0A" BorderBrush="#1F1F1F" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,12,0,0">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Fertige Videos (Ausgabe-Ordner)" Foreground="#C5A059" FontSize="11.5" FontWeight="Bold"/>
                                        <TextBlock Text="Ordner öffnen ↗" Foreground="#9CA3AF" FontSize="10.5" Cursor="Hand" MouseLeftButtonUp="OpenOutputFolder_Click"/>
                                    </Grid>
                                    <StackPanel x:Name="FinishedVideosStackPanel"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
