<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Funkenwerk Video</AssemblyName>
    <RootNamespace>FunkenwerkVideo</RootNamespace>
    <ApplicationIcon>funkenwerk.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>Funkenwerk Video</Product>
    <Company>Mein Seelenfunke</Company>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="funkenwerk.ico" />
    <Resource Include="funkenwerk.png" />
    <None Include="Assets\MarketingMusic\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
