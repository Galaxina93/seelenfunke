<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>FunkenwerkVideo</AssemblyName>
    <RootNamespace>FunkenwerkVideo</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>funkenwerk_video.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="funkenwerk_video.ico" />
    <Resource Include="funkenwerk_video.png" />
    <None Include="funkenwerk_video.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
