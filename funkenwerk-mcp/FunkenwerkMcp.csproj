<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>FunkenwerkMcp</AssemblyName>
    <RootNamespace>FunkenwerkMcp</RootNamespace>
    <Product>Funkenwerk MCP</Product>
    <Company>Mein-Seelenfunke</Company>
    <Version>1.5.0</Version>
    <AssemblyVersion>1.5.0.16</AssemblyVersion>
    <FileVersion>1.5.0.16</FileVersion>
    <InformationalVersion>1.5.0+b16</InformationalVersion>
    <DefineConstants>$(DefineConstants);FUNKENWERK_NO_WPF</DefineConstants>
    <NoWarn>CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\funkenwerk\FunkenwerkVersioning.cs" Link="Shared\FunkenwerkVersioning.cs" />
    <PackageReference Include="PDFsharp-wpf" Version="6.2.4" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>

</Project>
