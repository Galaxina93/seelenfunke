<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>FunkenwerkPlayer</AssemblyName>
    <RootNamespace>FunkenwerkPlayer</RootNamespace>
    <ApplicationTitle>Funkenwerk Player</ApplicationTitle>
    <Product>Funkenwerk Player</Product>
    <Company>Mein-Seelenfunke</Company>
    <Version>1.0.0</Version>
    <ApplicationIcon>funkenwerk_player.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="funkenwerk_player.ico" />
    <Resource Include="funkenwerk_player.png" />
    <None Include="funkenwerk_player.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
