<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>FunkenwerkMarketing</AssemblyName>
    <RootNamespace>Funkenwerk</RootNamespace>
    <ApplicationTitle>Funkenwerk Marketing</ApplicationTitle>
    <Product>Funkenwerk Marketing</Product>
    <Company>Mein-Seelenfunke</Company>
    <Version>1.3.0</Version>
    <AssemblyVersion>1.3.0.10</AssemblyVersion>
    <FileVersion>1.3.0.10</FileVersion>
    <InformationalVersion>1.3.0+b10</InformationalVersion>
    <ApplicationIcon>funkenwerk_marketing.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\funkenwerk\FunkenwerkVersioning.cs" Link="Shared\FunkenwerkVersioning.cs" />
    <Compile Include="..\funkenwerk\FunkenwerkSharedSession.cs" Link="Shared\FunkenwerkSharedSession.cs" />
    <Compile Include="..\funkenwerk\SmartHomeEngine.cs" Link="Shared\SmartHomeEngine.cs" />
    <Resource Include="funkenwerk_marketing.ico" />
    <Resource Include="funkenwerk_marketing.png" />
    <None Include="funkenwerk_marketing.ico" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\MarketingMusic\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
