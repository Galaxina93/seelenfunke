                                <TextBlock x:Name="MktFocusHookTxt" Text="„Wenn eine Handschrift für die Ewigkeit in 14k Gold gebrannt wird ✨“"
                                           Foreground="#9CA3AF" FontSize="14.5" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,22"/>

                                <!-- 3 Crisp Side-by-Side Step Cards -->
                                <UniformGrid Columns="3" Margin="0,0,0,16">
                                    <Border Background="#0B0D12" BorderBrush="#222634" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="1. BEREITLEGEN" Foreground="#D4AF37" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                                            <TextBlock x:Name="MktFocusStep1Txt" Text="Weiße Handschuhe · Goldenes Seelen-Herz · xTool F2 Ultra · Westpack-Box"
                                                       Foreground="#F9FAFB" FontSize="13" FontWeight="SemiBold" LineHeight="19" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#0B0D12" BorderBrush="#222634" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="3,0,3,0">
                                        <StackPanel>
                                            <TextBlock Text="2. KURZ-DREH" Foreground="#D4AF37" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                                            <TextBlock x:Name="MktFocusStep2Txt" Text="Clip 1: 4s Laser-Makro · Clip 2: 5s Weiße Handschuhe · Clip 3: 5s Westpack-Box"
                                                       Foreground="#F9FAFB" FontSize="13" FontWeight="SemiBold" LineHeight="19" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#0B0D12" BorderBrush="#222634" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="6,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="3. POSTEN" Foreground="#D4AF37" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                                            <TextBlock x:Name="MktFocusStep3Txt" Text="Vorlage A (14s) · 18:30–20:00 Uhr posten · /l/goldenes-seelen-herz"
                                                       Foreground="#F9FAFB" FontSize="13" FontWeight="SemiBold" LineHeight="19" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <!-- Dynamic Sound Recommendation for Today ("Soundempfehlung für heute: Song XY" + Play + Download) -->
                                <Border x:Name="MktFocusSoundRecBorder" Background="#0B0D12" BorderBrush="#C5A059" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,20">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock x:Name="MktFocusSoundRecTitleTxt"
                                                       Text="🎵 Soundempfehlung für heute: Golden Shimmer Drop (Viral Reveal)"
                                                       Foreground="#D4AF37" FontSize="13" FontWeight="Bold" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="MktFocusSoundRecMetaTxt"
                                                       Text="92 BPM · D-Moll · 1:12 · Shimmer-Drop bei Sek. 4,0 (100 % rechtsfrei aus deinem Seelenfunke-Album)"
                                                       Foreground="#9CA3AF" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                                            <Button x:Name="MktFocusSoundPlayBtn" Click="MktPlayRecommendedPlanTrack_Click" Background="#1E222D" Foreground="#F9FAFB" BorderBrush="#C5A059" BorderThickness="1" Padding="12,7" Margin="0,0,6,0" Cursor="Hand" FontSize="11.5" FontWeight="Bold" Content="▶ Anhören">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                            </Button>
                                            <Button x:Name="MktFocusSoundDownloadBtn" Click="MktDownloadRecommendedPlanTrack_Click" Background="#C5A059" Foreground="#111827" BorderThickness="0" Padding="13,7" Margin="0,0,6,0" Cursor="Hand" FontSize="11.5" FontWeight="Bold" Content="⬇ Download">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                            </Button>
                                            <Button x:Name="MktFocusSoundRotateBtn" Click="MktRotateRecommendedPlanTrack_Click" Background="#1E222D" Foreground="#D4AF37" BorderBrush="#2A3042" BorderThickness="1" Padding="10,7" Cursor="Hand" FontSize="11.5" FontWeight="Bold" ToolTip="Anderen passenden Song aus deinem Musikkatalog wählen" Content="🔄 Song">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Clean Action Buttons Row -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="MktFocusDoneBtn" Grid.Column="0" Click="MktToggleDailyDone_Click"
                                            Background="#C5A059" Foreground="#111827" BorderThickness="0" Padding="20,12" Margin="0,0,10,0"
                                            Cursor="Hand" FontSize="13.5" FontWeight="Bold" HorizontalAlignment="Stretch" Content="✓ Heute als erledigt markieren">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                                    </Button>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Click="MktCopyDailyCaption_Click" Background="#1E222D" Foreground="#F9FAFB" BorderBrush="#2A3042" BorderThickness="1" Padding="16,12" Margin="0,0,8,0" Cursor="Hand" FontSize="13" FontWeight="SemiBold" Content="📋 Caption kopieren">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                                        </Button>
                                        <Button Click="MktOpenCameraStudio_Click" Background="#1E222D" Foreground="#F9FAFB" BorderBrush="#2A3042" BorderThickness="1" Padding="15,12" Margin="0,0,8,0" Cursor="Hand" FontSize="13" FontWeight="SemiBold" Content="🎥 Kamera">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                                        </Button>
                                        <Button Click="MktAddDailyToTodo_Click" Background="#1E222D" Foreground="#F9FAFB" BorderBrush="#2A3042" BorderThickness="1" Padding="15,12" Cursor="Hand" FontSize="13" FontWeight="SemiBold" Content="➕ In To-Do">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ================================================================= -->
                        <!-- DROPDOWN BELOW FOCUS CARD: "Deine Virale Idee für heute"          -->
                        <!-- ================================================================= -->
                        <Border x:Name="MktFocusViralWrapperBorder" Background="#141720" BorderBrush="#232734" BorderThickness="1.5" CornerRadius="16" Margin="0,14,0,0">
                            <StackPanel>
                                <!-- Clickable Dropdown Header -->
                                <Button x:Name="MktFocusViralToggleBtn" Click="MktToggleFocusViralDropdown_Click"
                                        Background="Transparent" BorderThickness="0" Padding="24,15" Cursor="Hand" HorizontalContentAlignment="Stretch">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🔥 Deine Virale Idee für heute" Foreground="#D4AF37" FontSize="14.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="MktFocusViralHeaderPreviewTxt" Grid.Column="1"
                                                   Text="✂️ #1 Handy in Schleife durchschneiden (9 Sek. · Taylor Swift Piano)"
                                                   Foreground="#9CA3AF" FontSize="12.5" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Margin="14,0,14,0" TextTrimming="CharacterEllipsis"/>
                                        <Border Grid.Column="2" Background="#1E222D" BorderBrush="#2A3042" BorderThickness="1" CornerRadius="8" Padding="10,4">
                                            <TextBlock x:Name="MktFocusViralChevronTxt" Text="▼ Aufklappen" Foreground="#E5E7EB" FontSize="11.5" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>
                                </Button>

                                <!-- Collapsible Dropdown Body -->
                                <Border x:Name="MktFocusViralBodyBorder" Visibility="Collapsed" BorderBrush="#232734" BorderThickness="0,1,0,0" Padding="26,20,26,22">
                                    <StackPanel>
                                        <!-- Top Row: Song Badge + Switcher Buttons -->
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="#1E222D" BorderBrush="#C5A059" BorderThickness="1" CornerRadius="8" Padding="10,4" Margin="0,0,8,0">
                                                    <TextBlock x:Name="MktFocusViralDurationBadgeTxt" Text="🔥 9 Sek. · 5 Min. Dreh" Foreground="#D4AF37" FontSize="11.5" FontWeight="Bold"/>
                                                </Border>
                                                <Border Background="#132226" BorderBrush="#104E3B" BorderThickness="1" CornerRadius="8" Padding="10,4">
                                                    <TextBlock x:Name="MktFocusViralSeasonBadgeTxt" Text="🍂 Saison- &amp; Feiertags-Logik aktiv" Foreground="#34D399" FontSize="11" FontWeight="SemiBold"/>
                                                </Border>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Click="MktPrevViralIdea_Click" Background="#1E222D" Foreground="#E5E7EB" BorderBrush="#2A3042" BorderThickness="1" Padding="10,4" Margin="0,0,5,0" Cursor="Hand" ToolTip="Vorherige Virale Idee" FontWeight="Bold" Content="◀">
                                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style></Button.Resources>
                                                </Button>
                                                <Button Click="MktNextViralIdea_Click" Background="#1E222D" Foreground="#E5E7EB" BorderBrush="#2A3042" BorderThickness="1" Padding="10,4" Margin="0,0,6,0" Cursor="Hand" ToolTip="Nächste Virale Idee" FontWeight="Bold" Content="▶">
                                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style></Button.Resources>
                                                </Button>
                                                <Button Click="MktRotateSelectedViralProduct_Click" Background="#1E222D" Foreground="#E5E7EB" BorderBrush="#2A3042" BorderThickness="1" Padding="10,4" Margin="0,0,6,0" Cursor="Hand" ToolTip="Anderes Shop-Produkt in diese Viral-Idee einsetzen" FontSize="11" FontWeight="SemiBold" Content="🔄 Produkt">
                                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style></Button.Resources>
                                                </Button>
                                                <Button Click="MktCopySelectedViralSong_Click" Background="#1E222D" Foreground="#D4AF37" BorderBrush="#2A3042" BorderThickness="1" Padding="10,4" Margin="0,0,6,0" Cursor="Hand" ToolTip="TikTok/Instagram Song-Namen kopieren" FontSize="11" FontWeight="Bold" Content="🎵 Song kopieren">
                                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style></Button.Resources>
                                                </Button>
                                                <Button Click="MktCopySelectedViralCaption_Click" Background="#C5A059" Foreground="#111827" BorderThickness="0" Padding="11,4" Cursor="Hand" ToolTip="Fertige Viral-Caption &amp; Tags kopieren" FontSize="11" FontWeight="Bold" Content="📋 Caption">
                                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style></Button.Resources>
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Viral Title, Hook & Trending Song Banner -->
                                        <TextBlock x:Name="MktFocusViralTitleTxt" Text="Handy in Schleife durchschneiden (Online Grand Opening)"
                                                   Foreground="#F9FAFB" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="MktFocusViralHookTxt" Text="On-Screen-Text: „Wenn man eine Online-Manufaktur eröffnet und trotzdem feierlich das Band durchschneidet ✨✂️“"
                                                   Foreground="#9CA3AF" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"/>

                                        <Border Background="#0B0D12" BorderBrush="#2A3042" BorderThickness="1" CornerRadius="10" Padding="13,8" Margin="0,0,0,14">
                                            <TextBlock x:Name="MktFocusViralSongTxt"
                                                       Text="🎵 Viraler TikTok / IG Song: Taylor Swift · The Fate of Ophelia (Piano)  oder  Bridgerton Strings (-8 dB) + 100 % echter Scherenschnitt (0 dB)"
                                                       Foreground="#D4AF37" FontSize="12" FontWeight="Bold" TextWrapping="Wrap"/>
                                        </Border>

                                        <!-- 3 Crisp Steps (Identical Structure to Focus Card Above) -->
                                        <UniformGrid Columns="3" Margin="0,0,0,14">
                                            <Border Background="#0B0D12" BorderBrush="#222634" BorderThickness="1" CornerRadius="12" Padding="15,13" Margin="0,0,6,0">
                                                <StackPanel>
                                                    <TextBlock Text="1. SETUP &amp; SONG" Foreground="#D4AF37" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                                                    <TextBlock x:Name="MktFocusViralStep1Txt" Foreground="#F9FAFB" FontSize="12.5" FontWeight="SemiBold" LineHeight="18.5" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Background="#0B0D12" BorderBrush="#222634" BorderThickness="1" CornerRadius="12" Padding="15,13" Margin="3,0,3,0">
                                                <StackPanel>
                                                    <TextBlock Text="2. DREH IN 3 SÄTZEN" Foreground="#D4AF37" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                                                    <TextBlock x:Name="MktFocusViralStep2Txt" Foreground="#F9FAFB" FontSize="12.5" FontWeight="SemiBold" LineHeight="18.5" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Background="#0B0D12" BorderBrush="#222634" BorderThickness="1" CornerRadius="12" Padding="15,13" Margin="6,0,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="3. SAISON-MOTTO &amp; POSTEN" Foreground="#D4AF37" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                                                    <TextBlock x:Name="MktFocusViralStep3Txt" Foreground="#F9FAFB" FontSize="12.5" FontWeight="SemiBold" LineHeight="18.5" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>

                                        <!-- Bottom Music Recommendation for the Viral Idea ("Musik-Empfehlung für diese Virale Idee: Song XY" + Play + Download) -->
                                        <Border x:Name="MktFocusViralSoundRecBorder" Background="#0B0D12" BorderBrush="#C5A059" BorderThickness="1" CornerRadius="12" Padding="15,11">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock x:Name="MktFocusViralSoundRecTxt"
                                                               Text="🎵 Musik-Empfehlung für diese Virale Idee: Golden Shimmer Drop (Viral Reveal)"
                                                               Foreground="#D4AF37" FontSize="12.5" FontWeight="Bold" TextWrapping="Wrap"/>
                                                    <TextBlock x:Name="MktFocusViralSoundMetaTxt"
                                                               Text="92 BPM · D-Moll · 1:12 · Shimmer-Drop bei Sek. 4,0 (100 % rechtsfrei aus deinem Seelenfunke-Album)"
                                                               Foreground="#9CA3AF" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                    <Button x:Name="MktFocusViralSoundPlayBtn" Click="MktPlayRecommendedViralTrack_Click" Background="#1E222D" Foreground="#F9FAFB" BorderBrush="#C5A059" BorderThickness="1" Padding="11,6" Margin="0,0,6,0" Cursor="Hand" FontSize="11" FontWeight="Bold" Content="▶ Anhören">
                                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style></Button.Resources>
                                                    </Button>
                                                    <Button x:Name="MktFocusViralSoundDownloadBtn" Click="MktDownloadRecommendedViralTrack_Click" Background="#C5A059" Foreground="#111827" BorderThickness="0" Padding="12,6" Margin="0,0,6,0" Cursor="Hand" FontSize="11" FontWeight="Bold" Content="⬇ Download">
                                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style></Button.Resources>
                                                    </Button>
                                                    <Button x:Name="MktFocusViralSoundRotateBtn" Click="MktRotateRecommendedViralTrack_Click" Background="#1E222D" Foreground="#D4AF37" BorderBrush="#2A3042" BorderThickness="1" Padding="9,6" Cursor="Hand" FontSize="11" FontWeight="Bold" ToolTip="Anderen passenden Song aus deinem Musikkatalog wählen" Content="🔄 Song">
                                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style></Button.Resources>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ===================================================================== -->
                <!-- BOTTOM-RIGHT MODE SWITCHER: NORMAL / FOKUS MODUS                      -->
                <!-- ===================================================================== -->
                <Border x:Name="MktModeToggleContainer" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,22,18" Panel.ZIndex="60"
                        Background="#151822" BorderBrush="#C5A059" BorderThickness="1.5" CornerRadius="12" Padding="4">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="MktModeNormalBtn" Click="MktSetNormalMode_Click"
                                Background="#C5A059" Foreground="#111827" BorderThickness="0" Padding="13,6" Cursor="Hand"
                                FontSize="12" FontWeight="Bold" Content="📊 Normal" ToolTip="Umfangreiche Gesamt-Ansicht mit 14-Tage-Plan, Routine, 20 Accounts &amp; 37-Punkte-Röntgen">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="9"/></Style></Button.Resources>
                        </Button>
                        <Button x:Name="MktModeFocusBtn" Click="MktSetFocusMode_Click"
                                Background="Transparent" Foreground="#D1D5DB" BorderThickness="0" Padding="13,6" Margin="3,0,0,0" Cursor="Hand"
                                FontSize="12" FontWeight="Bold" Content="🎯 Fokus" ToolTip="Klare Fokus-Ansicht: Zeigt groß &amp; mittig nur das, was du heute machen musst">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="9"/></Style></Button.Resources>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

    </Grid>
</Window>
