<Window x:Class="Funkenwerk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Funkenwerk Marketing"
        Icon="funkenwerk_marketing.ico"
        Width="1360" Height="860"
        MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#0F1117"
        Foreground="#F9FAFB"
        FontFamily="Segoe UI">
    <Grid Background="#0F1117">
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#0B0D12" BorderBrush="#222634" BorderThickness="0,0,0,1" Padding="20,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="funkenwerk_marketing.png" Width="24" Height="24" Margin="0,0,10,0"/>
                    <TextBlock Text="FUNKENWERK MARKETING" FontSize="14" FontWeight="Bold" Foreground="#C5A059" VerticalAlignment="Center"/>
                </StackPanel>
                <Button x:Name="StandaloneThemeBtn" Click="StandaloneThemeToggle_Click" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="#181B24" Foreground="#F9FAFB" BorderBrush="#262A36" BorderThickness="1" Padding="10,5" Cursor="Hand" FontSize="12" Content="ðŸŒ™">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                </Button>
            </Grid>
        </Border>
            <Grid x:Name="MarketingViewGrid" Grid.Row="1" Visibility="Visible" Background="#0F1117">
                <!-- ===================================================================== -->
                <!-- A: SCHLANKE NORMAL-ANSICHT (Clean Design ohne Button- & Text-Overload) -->
                <!-- ===================================================================== -->
                <Grid x:Name="MktNormalModeGrid" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ROW 0: COLLAPSED LEGACY HERO HOLDER (Fokus-Modus übernimmt „Heute drehen“) -->
                <StackPanel Grid.Row="0" Visibility="Collapsed">
                    <TextBlock x:Name="MktHeroDayBadgeTxt"/>
                    <TextBlock x:Name="MktHeroCategoryBadgeTxt"/>
                    <Border x:Name="MktHeroSeasonBadgeBorder"><TextBlock x:Name="MktHeroSeasonBadgeTxt"/></Border>
                    <TextBlock x:Name="MktHeroTitleTxt"/>
                    <TextBlock x:Name="MktHeroHookPreviewTxt"/>
                    <Button x:Name="MktApplySeasonMottoBtn"/>
                    <Button x:Name="MktHeroDoneBtn"/>
                    <TextBlock x:Name="MktHeroSeasonMottoTxt"/>
                    <TextBlock x:Name="MktHeroShopSyncMetaTxt"/>
                    <TextBlock x:Name="MktHeroStep1Txt"/>
                    <TextBlock x:Name="MktHeroStep2Txt"/>
                    <TextBlock x:Name="MktHeroStep3Txt"/>
                    <TextBlock x:Name="MktHeroStep4Txt"/>
                    <TextBlock x:Name="MktOfflineStatusTxt"/>
                </StackPanel>

                <!-- ROW 1: CLEAN SINGLE-LINE TOP BAR (8 Short Tabs + Search + Shop-Sync) -->
                <Border Grid.Row="1" Background="#13161F" BorderBrush="#222634" BorderThickness="1" CornerRadius="12" Margin="18,14,18,12" Padding="10,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="210"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                            <Button x:Name="MktTabPlanBtn" Click="MktSubTab_Click" Tag="plan" Background="#C5A059" Foreground="#111827" FontWeight="Bold" BorderThickness="0" Padding="12,7" Margin="0,0,5,0" Cursor="Hand" FontSize="12" Content="📅 Drehplan">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                            </Button>
                            <Button x:Name="MktTabRoutineBtn" Click="MktSubTab_Click" Tag="routine" Background="#181B24" Foreground="#D1D5DB" FontWeight="SemiBold" BorderThickness="0" Padding="12,7" Margin="0,0,5,0" Cursor="Hand" FontSize="12" Content="⚡ Routine">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                            </Button>
                            <Button x:Name="MktTabViralBtn" Click="MktSubTab_Click" Tag="viral" Background="#181B24" Foreground="#D1D5DB" FontWeight="SemiBold" BorderThickness="0" Padding="12,7" Margin="0,0,5,0" Cursor="Hand" FontSize="12" Content="🔥 Viral">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                            </Button>
                            <Button x:Name="MktTabMusicBtn" Click="MktSubTab_Click" Tag="music" Background="#181B24" Foreground="#D1D5DB" FontWeight="SemiBold" BorderThickness="0" Padding="12,7" Margin="0,0,5,0" Cursor="Hand" FontSize="12" Content="🎵 Musik">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                            </Button>
                            <Button x:Name="MktTabAccountsBtn" Click="MktSubTab_Click" Tag="accounts" Background="#181B24" Foreground="#D1D5DB" FontWeight="SemiBold" BorderThickness="0" Padding="12,7" Margin="0,0,5,0" Cursor="Hand" FontSize="12" Content="🏆 Vorbilder">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                            </Button>
                            <Button x:Name="MktTabQuestionsBtn" Click="MktSubTab_Click" Tag="questions" Background="#181B24" Foreground="#D1D5DB" FontWeight="SemiBold" BorderThickness="0" Padding="12,7" Margin="0,0,5,0" Cursor="Hand" FontSize="12" Content="🔬 37 Regeln">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                            </Button>
                            <Button x:Name="MktTabTemplatesBtn" Click="MktSubTab_Click" Tag="templates" Background="#181B24" Foreground="#D1D5DB" FontWeight="SemiBold" BorderThickness="0" Padding="12,7" Margin="0,0,5,0" Cursor="Hand" FontSize="12" Content="✂️ Vorlagen &amp; Bio">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                            </Button>
                            <Button x:Name="MktTabAdsBtn" Click="MktSubTab_Click" Tag="ads" Background="#181B24" Foreground="#D1D5DB" FontWeight="SemiBold" BorderThickness="0" Padding="12,7" Cursor="Hand" FontSize="12" Content="🚀 Ads &amp; Budget">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                            </Button>
                        </WrapPanel>

                        <Grid Grid.Column="1" VerticalAlignment="Center" Margin="8,0,8,0">
                            <TextBox x:Name="MktSearchBox" Padding="10,6" FontSize="12" TextChanged="MktSearchBox_TextChanged"/>
                            <TextBlock x:Name="MktSearchPlaceholder" Text="🔍 Suchen..." Foreground="#6B7280" FontSize="11.5" VerticalAlignment="Center" Margin="11,0,0,0" IsHitTestVisible="False"/>
                        </Grid>

                        <Button x:Name="MktSyncShopBtn" Grid.Column="2" Click="MktSyncWithShop_Click" Background="#1F2430" Foreground="#F9FAFB" BorderThickness="0" Padding="11,7" VerticalAlignment="Center" Cursor="Hand" ToolTip="Produkte, Preise &amp; Saison live aus dem Mein-Seelenfunke Shop synchronisieren" FontSize="11.5" FontWeight="SemiBold" Content="🔄 Shop-Sync">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                    </Grid>
                </Border>

                <!-- ROW 2: CONTENT PANES -->
                <Grid Grid.Row="2" Margin="18,0,18,16">

                    <!-- =============================================================== -->
                    <!-- PANE 1: 14-TAGE DREHPLAN (SCHLANK & AUFGERÄUMT)                 -->
                    <!-- =============================================================== -->
                    <Grid x:Name="MktPanePlan" Visibility="Visible">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: 14 Recipes List -->
                        <Border Grid.Column="0" Background="#13161F" BorderBrush="#222634" BorderThickness="1" CornerRadius="12" Padding="10">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="MktPlanListPanel"/>
                            </ScrollViewer>
                        </Border>

                        <!-- Right: Selected Recipe Blueprint -->
                        <Border Grid.Column="2" Background="#13161F" BorderBrush="#222634" BorderThickness="1" CornerRadius="12" Padding="20,16">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock x:Name="MktPlanDetailBadgeTxt" Text="TAG 01 · MONTAG · 14 SEK." Foreground="#D4AF37" FontSize="11" FontWeight="Bold"/>
                                            <TextBlock x:Name="MktPlanDetailTitleTxt" Text="Das Goldene Seelen-Herz" Foreground="#F9FAFB" FontSize="19" FontWeight="Bold" Margin="0,3,0,4" TextWrapping="Wrap"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="MktPlanDetailProductTxt" Foreground="#9CA3AF" FontSize="11.5" FontWeight="SemiBold"/>
                                                <TextBlock Text="  ·  " Foreground="#6B7280" FontSize="11.5"/>
                                                <TextBlock x:Name="MktPlanDetailTemplateTxt" Foreground="#D4AF37" FontSize="11.5" FontWeight="SemiBold"/>
                                                <TextBlock Text="  ·  " Foreground="#6B7280" FontSize="11.5"/>
                                                <TextBlock x:Name="MktPlanDetailLandingTxt" Foreground="#34D399" FontSize="11.5" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Click="MktRotateSelectedPlanProduct_Click" Background="#26231F" Foreground="#D4AF37" BorderBrush="#4D3D1E" BorderThickness="1" Padding="11,7" Margin="0,0,6,0" Cursor="Hand" ToolTip="Nächstes Produkt aus dem Sortiment wählen" FontSize="11.5" FontWeight="Bold" Content="🔄 Produkt">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                            </Button>
                                            <Button Click="MktSetSelectedAsToday_Click" Background="#C5A059" Foreground="#111827" FontWeight="Bold" BorderThickness="0" Padding="13,7" Cursor="Hand" FontSize="11.5" Content="★ Als Heute">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <UniformGrid Columns="2" Margin="0,0,0,12">
                                        <Border Background="#0F1117" BorderBrush="#C5A059" BorderThickness="1" CornerRadius="9" Padding="12,9" Margin="0,0,6,0">
                                            <StackPanel>
                                                <TextBlock Text="HOOK IM BILD (0–2 SEK.)" Foreground="#D4AF37" FontSize="10" FontWeight="Bold"/>
                                                <TextBlock x:Name="MktPlanDetailHookTxt" Foreground="#F9FAFB" FontSize="13" FontWeight="Bold" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#0F1117" BorderBrush="#1E222D" BorderThickness="1" CornerRadius="9" Padding="12,9" Margin="6,0,0,0">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="SOUNDEMPFEHLUNG" Foreground="#D4AF37" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <Button x:Name="MktPlanSoundPlayBtn" Click="MktPlayRecommendedPlanTrack_Click" Background="#1E222D" Foreground="#F9FAFB" BorderBrush="#C5A059" BorderThickness="1" Padding="8,2" Margin="0,0,4,0" Cursor="Hand" FontSize="10.5" FontWeight="Bold" Content="▶ Anhören">
                                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                                                        </Button>
                                                        <Button x:Name="MktPlanSoundDownloadBtn" Click="MktDownloadRecommendedPlanTrack_Click" Background="#C5A059" Foreground="#111827" BorderThickness="0" Padding="8,2" Margin="0,0,4,0" Cursor="Hand" FontSize="10.5" FontWeight="Bold" Content="⬇ Download">
                                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                                                        </Button>
                                                        <Button x:Name="MktPlanSoundRotateBtn" Click="MktRotateRecommendedPlanTrack_Click" Background="#1E222D" Foreground="#D4AF37" BorderBrush="#2A3042" BorderThickness="1" Padding="7,2" Cursor="Hand" FontSize="10.5" FontWeight="Bold" ToolTip="Nächsten Song wählen" Content="🔄">
                                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock x:Name="MktPlanDetailSoundRecTxt" Foreground="#F9FAFB" FontSize="12" FontWeight="Bold" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                <TextBlock x:Name="MktPlanDetailAudioTxt" Visibility="Collapsed"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <UniformGrid Columns="2" Rows="2" Margin="0,0,0,12">
                                        <Border Background="#0F1117" BorderBrush="#1E222D" BorderThickness="1" CornerRadius="9" Padding="12,9" Margin="0,0,6,8">
                                            <StackPanel>
                                                <TextBlock Text="1. BEREITLEGEN" Foreground="#D4AF37" FontSize="10" FontWeight="Bold"/>
                                                <TextBlock x:Name="MktPlanDetailStep1Txt" Foreground="#E5E7EB" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#0F1117" BorderBrush="#1E222D" BorderThickness="1" CornerRadius="9" Padding="12,9" Margin="6,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="2. START-BILD (HOOK)" Foreground="#D4AF37" FontSize="10" FontWeight="Bold"/>
                                                <TextBlock x:Name="MktPlanDetailStep2Txt" Foreground="#E5E7EB" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#0F1117" BorderBrush="#1E222D" BorderThickness="1" CornerRadius="9" Padding="12,9" Margin="0,0,6,0">
                                            <StackPanel>
                                                <TextBlock Text="3. AUFNAHME (3 CLIPS)" Foreground="#D4AF37" FontSize="10" FontWeight="Bold"/>
                                                <TextBlock x:Name="MktPlanDetailStep3Txt" Foreground="#E5E7EB" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#0F1117" BorderBrush="#1E222D" BorderThickness="1" CornerRadius="9" Padding="12,9" Margin="6,0,0,0">
                                            <StackPanel>
                                                <TextBlock Text="4. SCHNITT &amp; POST" Foreground="#D4AF37" FontSize="10" FontWeight="Bold"/>
                                                <TextBlock x:Name="MktPlanDetailStep4Txt" Foreground="#E5E7EB" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <Grid Margin="0,2,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="CAPTION &amp; HASHTAGS" Foreground="#9CA3AF" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Click="MktCopySelectedPlanCaption_Click" Background="#C5A059" Foreground="#111827" FontWeight="Bold" BorderThickness="0" Padding="12,5" Cursor="Hand" FontSize="11.5" Content="📋 Kopieren">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style></Button.Resources>
                                        </Button>
                                    </Grid>
                                    <TextBox x:Name="MktPlanDetailCaptionBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="96" Padding="12,9" FontSize="12" Background="#0F1117" Foreground="#F9FAFB" BorderBrush="#232734"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- =============================================================== -->
                    <!-- PANE 2: VORBILDER (TOP 20 ACCOUNTS)                             -->
                    <!-- =============================================================== -->
                    <Grid x:Name="MktPaneAccounts" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Cluster Filter + 20 Accounts List -->
                        <Border Grid.Column="0" Background="#13161F" BorderBrush="#222634" BorderThickness="1" CornerRadius="12" Padding="10">
                            <DockPanel LastChildFill="True">
                                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <Button x:Name="MktClusterAllBtn" Click="MktAccountClusterFilter_Click" Tag="all" Background="#C5A059" Foreground="#111827" FontWeight="Bold" BorderThickness="0" Padding="8,4" Margin="0,0,4,4" Cursor="Hand" FontSize="11" Content="Alle">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                    </Button>
                                    <Button x:Name="MktClusterSchmuckBtn" Click="MktAccountClusterFilter_Click" Tag="schmuck" Background="#181B24" Foreground="#D1D5DB" BorderThickness="0" Padding="8,4" Margin="0,0,4,4" Cursor="Hand" FontSize="11" Content="Schmuck">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                    </Button>
                                    <Button x:Name="MktClusterKristallBtn" Click="MktAccountClusterFilter_Click" Tag="kristall" Background="#181B24" Foreground="#D1D5DB" BorderThickness="0" Padding="8,4" Margin="0,0,4,4" Cursor="Hand" FontSize="11" Content="Kristall">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                    </Button>
                                    <Button x:Name="MktClusterLaserBtn" Click="MktAccountClusterFilter_Click" Tag="laser" Background="#181B24" Foreground="#D1D5DB" BorderThickness="0" Padding="8,4" Margin="0,0,4,4" Cursor="Hand" FontSize="11" Content="Laser">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                    </Button>
                                    <Button x:Name="MktClusterLuxuryBtn" Click="MktAccountClusterFilter_Click" Tag="luxury" Background="#181B24" Foreground="#D1D5DB" BorderThickness="0" Padding="8,4" Margin="0,0,0,4" Cursor="Hand" FontSize="11" Content="White-Glove">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                    </Button>
                                </WrapPanel>

                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="MktAccountsListPanel"/>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <!-- Right: Account Profile + 10 Viral Videos -->
                        <Border Grid.Column="2" Background="#13161F" BorderBrush="#222634" BorderThickness="1" CornerRadius="12" Padding="18,14">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock x:Name="MktAccDetailTitleTxt" Text="#01 PicturesOnGold (@picturesongold)" Foreground="#F9FAFB" FontSize="18" FontWeight="Bold"/>
                                    <TextBlock x:Name="MktAccDetailMetaTxt" Text="TikTok &amp; IG · 485K Follower · Ø 16s" Foreground="#D4AF37" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,10"/>

                                    <UniformGrid Columns="2" Margin="0,0,0,12">
                                        <Border Background="#0F1117" BorderBrush="#1E222D" BorderThickness="1" CornerRadius="9" Padding="12,8" Margin="0,0,6,0">
                                            <StackPanel>
                                                <TextBlock Text="BIO &amp; SHOP-FUNNEL" Foreground="#D4AF37" FontSize="10" FontWeight="Bold"/>
                                                <TextBlock x:Name="MktAccBioTxt" Foreground="#E5E7EB" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                <TextBlock x:Name="MktAccWebTxt" Visibility="Collapsed"/>
                                                <TextBlock x:Name="MktAccGoogleTxt" Visibility="Collapsed"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#0F1117" BorderBrush="#1E222D" BorderThickness="1" CornerRadius="9" Padding="12,8" Margin="6,0,0,0">
                                            <StackPanel>
                                                <TextBlock Text="ERFOLGSMETHODEN" Foreground="#34D399" FontSize="10" FontWeight="Bold"/>
                                                <TextBlock x:Name="MktAccSecretsTxt" Foreground="#F9FAFB" FontSize="11.5" FontWeight="SemiBold" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <TextBlock Text="TOP 10 VIDEOS" Foreground="#9CA3AF" FontSize="10.5" FontWeight="Bold" Margin="0,2,0,6"/>
                                    <StackPanel x:Name="MktAccVideosListPanel"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- =============================================================== -->
                    <!-- PANE 3: 37 REGELN (SCHLANK)                                     -->
                    <!-- =============================================================== -->
                    <Grid x:Name="MktPaneQuestions" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Top: Category Filter Pills + Quick Scanner -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="MktQCatAllBtn" Click="MktQuestionCategory_Click" Tag="all" Background="#C5A059" Foreground="#111827" FontWeight="Bold" BorderThickness="0" Padding="10,6" Margin="0,0,5,0" Cursor="Hand" FontSize="11.5" Content="Alle (37)">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style></Button.Resources>
                                </Button>
                                <Button x:Name="MktQCatBaseBtn" Click="MktQuestionCategory_Click" Tag="base" Background="#181B24" Foreground="#D1D5DB" BorderThickness="0" Padding="10,6" Margin="0,0,5,0" Cursor="Hand" FontSize="11.5" Content="Basis">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style></Button.Resources>
                                </Button>
                                <Button x:Name="MktQCatHookBtn" Click="MktQuestionCategory_Click" Tag="hook" Background="#181B24" Foreground="#D1D5DB" BorderThickness="0" Padding="10,6" Margin="0,0,5,0" Cursor="Hand" FontSize="11.5" Content="Hook">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style></Button.Resources>
                                </Button>
                                <Button x:Name="MktQCatCameraBtn" Click="MktQuestionCategory_Click" Tag="camera" Background="#181B24" Foreground="#D1D5DB" BorderThickness="0" Padding="10,6" Margin="0,0,5,0" Cursor="Hand" FontSize="11.5" Content="Kamera">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style></Button.Resources>
                                </Button>
                                <Button x:Name="MktQCatStoryBtn" Click="MktQuestionCategory_Click" Tag="story" Background="#181B24" Foreground="#D1D5DB" BorderThickness="0" Padding="10,6" Margin="0,0,5,0" Cursor="Hand" FontSize="11.5" Content="Story">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style></Button.Resources>
                                </Button>
                                <Button x:Name="MktQCatAlgoBtn" Click="MktQuestionCategory_Click" Tag="algo" Background="#181B24" Foreground="#D1D5DB" BorderThickness="0" Padding="10,6" Margin="0,0,5,0" Cursor="Hand" FontSize="11.5" Content="Algorithmus">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style></Button.Resources>
                                </Button>
                                <Button x:Name="MktQCatFunnelBtn" Click="MktQuestionCategory_Click" Tag="funnel" Background="#181B24" Foreground="#D1D5DB" BorderThickness="0" Padding="10,6" Margin="0,0,5,0" Cursor="Hand" FontSize="11.5" Content="Bio &amp; Shop">
