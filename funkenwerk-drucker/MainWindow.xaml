<Window x:Class="FunkenwerkDrucker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Funkenwerk Drucker"
        Icon="funkenwerk_drucker.ico"
        Width="1320" Height="820"
        MinWidth="680" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="#0F1117"
        Foreground="#F9FAFB"
        FontFamily="Segoe UI"
        AllowDrop="True"
        PreviewDragOver="Window_PreviewDragOver"
        PreviewDrop="Window_PreviewDrop"
        PreviewMouseWheel="Window_PreviewMouseWheel"
        KeyDown="Window_KeyDown">

    <Grid x:Name="RootGrid" Background="#0F1117">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- ================================================================= -->
        <!-- ROW 0: ADAPTIVE RESPONSIVE TOP BAR                                -->
        <!-- ================================================================= -->
        <Border x:Name="TopBarBorder" Grid.Row="0" Background="#12151E" BorderBrush="#232734" BorderThickness="0,0,0,1" Padding="10,6">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                <Button x:Name="ToggleSidebarBtn" Content="☰" Width="28" Height="28" Click="ToggleSidebar_Click"
                        Background="#1B1F2B" Foreground="#C5A059" BorderBrush="#2D3343" FontWeight="Bold" Cursor="Hand" Margin="0,2,6,2"
                        ToolTip="Seitenleiste ein-/ausblenden"/>
                <Image Source="funkenwerk_drucker.png" Width="24" Height="24" VerticalAlignment="Center" Margin="0,2,7,2"/>
                <TextBlock x:Name="BrandTitleTxt" Text="FUNKENWERK DRUCKER" Foreground="#F9FAFB" FontSize="12.5" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="0,2,12,2"/>

                <!-- Mode Switcher Pills -->
                <Button x:Name="ModePrintBtn" Content="DRUCKEN" Height="28" Padding="11,0" FontSize="11.5" Click="ModePrint_Click"
                        Background="#C5A059" Foreground="#0F1117" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,2,4,2"/>
                <Button x:Name="ModeScanBtn" Content="SCANNEN" Height="28" Padding="11,0" FontSize="11.5" Click="ModeScan_Click"
                        Background="#1B1F2B" Foreground="#F9FAFB" BorderBrush="#2D3343" FontWeight="SemiBold" Cursor="Hand" Margin="0,2,4,2"/>
                <Button x:Name="ModeCopyBtn" Content="KOPIEREN" Height="28" Padding="11,0" FontSize="11.5" Click="ModeCopy_Click"
                        Background="#1B1F2B" Foreground="#F9FAFB" BorderBrush="#2D3343" FontWeight="SemiBold" Cursor="Hand" Margin="0,2,4,2"/>
                <Button x:Name="ModeQueueBtn" Content="GERÄT &amp; QUEUE" Height="28" Padding="11,0" FontSize="11.5" Click="ModeQueue_Click"
                        Background="#1B1F2B" Foreground="#F9FAFB" BorderBrush="#2D3343" FontWeight="SemiBold" Cursor="Hand" Margin="0,2,8,2"/>

                <Border Width="1" Height="20" Background="#2A3042" VerticalAlignment="Center" Margin="2,2,8,2"/>

                <!-- Document & Ecosystem Quick Actions -->
                <Button x:Name="OpenFileBtn" Content="Öffnen" Height="28" Padding="10,0" FontSize="12" Click="OpenFile_Click"
                        Background="#1B1F2B" Foreground="#F9FAFB" BorderBrush="#2D3343" FontWeight="SemiBold" Cursor="Hand" Margin="0,2,4,2"
                        ToolTip="PDF oder Bild zum Drucken öffnen (Strg+O)"/>
                <Button x:Name="SavePdfTopBtn" Content="PDF speichern" Height="28" Padding="10,0" FontSize="12" Click="SaveAsPdf_Click"
                        Background="#1B1F2B" Foreground="#E5E7EB" BorderBrush="#2D3343" Cursor="Hand" Margin="0,2,4,2"
                        ToolTip="Alle aktuellen Seiten als PDF speichern (Strg+S)"/>
                <Button x:Name="OpenInFwPdfBtn" Content="✍ Funkenwerk PDF" Height="28" Padding="10,0" FontSize="12" Click="OpenInFunkenwerkPdf_Click"
                        Background="#1D2230" Foreground="#C5A059" BorderBrush="#C5A059" BorderThickness="1" FontWeight="Bold" Cursor="Hand" Margin="0,2,4,2"
                        ToolTip="Aktuelles Dokument direkt in Funkenwerk PDF zum Ausfüllen oder Unterschreiben öffnen"/>
                <Button x:Name="SaveReceiptBtn" Content="Beleg ablegen" Height="28" Padding="10,0" FontSize="12" Click="SaveToAccountingReceipts_Click"
                        Background="#1B1F2B" Foreground="#E5E7EB" BorderBrush="#2D3343" Cursor="Hand" Margin="0,2,8,2"
                        ToolTip="Direkt im Seelenfunke Buchhaltungs-Belegordner speichern"/>

                <!-- Zoom Stepper -->
                <Border x:Name="ZoomStepperBorder" Background="#181C26" BorderBrush="#2D3343" BorderThickness="1" CornerRadius="5" Height="28" Margin="0,2,6,2"
                        ToolTip="Vorschau-Zoom (Strg + Mausrad / Klick auf % zum Zurücksetzen)">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="ZoomOutBtn" Content="−" Width="22" Height="26" Click="ZoomOut_Click"
                                Background="Transparent" Foreground="#E5E7EB" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                        <TextBlock x:Name="ZoomLabel" Text="100%" Width="38" TextAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#E5E7EB" FontSize="11.5" FontWeight="SemiBold" Cursor="Hand"
                                   MouseLeftButtonDown="ZoomReset_Click"/>
                        <Button x:Name="ZoomInBtn" Content="+" Width="22" Height="26" Click="ZoomIn_Click"
                                Background="Transparent" Foreground="#E5E7EB" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                    </StackPanel>
                </Border>

                <!-- Light/Dark Theme Toggle -->
                <Button x:Name="ThemeToggleBtn" Content="☀" Width="28" Height="28" Click="ThemeToggle_Click"
                        Background="#1B1F2B" Foreground="#C5A059" BorderBrush="#2D3343" FontWeight="Bold" Cursor="Hand" Margin="0,2,0,2"
                        ToolTip="Light- / Dark-Mode umschalten"/>
            </WrapPanel>
        </Border>

        <!-- ================================================================= -->
        <!-- ROW 1: 3-ZONE STUDIO (PAGES | LIVE PREVIEW | PRINTER & SETTINGS)  -->
        <!-- ================================================================= -->
        <Grid Grid.Row="1" Margin="10,8,10,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarCol" Width="184"/>
                <ColumnDefinition x:Name="SidebarGapCol" Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition x:Name="RightCol" Width="314"/>
            </Grid.ColumnDefinitions>

            <!-- ============================================================= -->
            <!-- LEFT TILE: PAGES & SCAN/DOCUMENT TRANSFORMS                   -->
            <!-- ============================================================= -->
            <Border x:Name="PagesTileBorder" Grid.Column="0" Background="#141821" BorderBrush="#242938" BorderThickness="1" CornerRadius="12" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="SEITEN" Foreground="#C5A059" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="PageCountBadgeTxt" Grid.Column="1" Text="0" Foreground="#9CA3AF" FontSize="11" FontWeight="Bold"/>
                    </Grid>

                    <!-- Transform Tools Row 1 -->
                    <Grid Grid.Row="1" Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="RotatePageBtn" Grid.Column="0" Content="↻ 90°" Height="26" FontSize="11" Click="RotatePage_Click"
                                Background="#1D2230" Foreground="#E5E7EB" BorderBrush="#2D3343" Cursor="Hand" Margin="0,0,4,0"
                                ToolTip="Aktuelle Seite um 90° drehen"/>
                        <Button x:Name="CropToggleBtn" Grid.Column="1" Content="✂ Schnitt" Height="26" FontSize="11" Click="ToggleCropMode_Click"
                                Background="#1D2230" Foreground="#E5E7EB" BorderBrush="#2D3343" Cursor="Hand" Margin="0,0,4,0"
                                ToolTip="Seite interaktiv zuschneiden"/>
                        <Button x:Name="DeletePageBtn" Grid.Column="2" Content="✕" Height="26" FontSize="11" Click="DeletePage_Click"
                                Background="#1D2230" Foreground="#F87171" BorderBrush="#2D3343" FontWeight="Bold" Cursor="Hand"
                                ToolTip="Aktuelle Seite entfernen (Entf)"/>
                    </Grid>

                    <!-- Transform Tools Row 2 -->
                    <Grid Grid.Row="2" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="28"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ReceiptContrastBtn" Grid.Column="0" Content="Beleg-Kontrast" Height="26" FontSize="11" Click="ToggleReceiptContrast_Click"
                                Background="#1D2230" Foreground="#E5E7EB" BorderBrush="#2D3343" Cursor="Hand" Margin="0,0,4,0"
                                ToolTip="Grauen Papierhintergrund weiß aufhellen und Schrift schärfen (spart Tinte)"/>
                        <Button x:Name="MovePageUpBtn" Grid.Column="1" Content="↑" Height="26" FontSize="11" Click="MovePageUp_Click"
                                Background="#1D2230" Foreground="#E5E7EB" BorderBrush="#2D3343" Cursor="Hand" Margin="0,0,4,0"
                                ToolTip="Seite nach oben schieben"/>
                        <Button x:Name="MovePageDownBtn" Grid.Column="2" Content="↓" Height="26" FontSize="11" Click="MovePageDown_Click"
                                Background="#1D2230" Foreground="#E5E7EB" BorderBrush="#2D3343" Cursor="Hand"
                                ToolTip="Seite nach unten schieben"/>
                    </Grid>

                    <!-- Pages ListBox -->
                    <ListBox x:Name="PagesListBox" Grid.Row="3" Background="Transparent" BorderThickness="0"
                             SelectionChanged="PagesListBox_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder" Padding="10,7" CornerRadius="8" Background="#1A1F2C" BorderBrush="#262C3D" BorderThickness="1" Cursor="Hand">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#C5A059"/>
                                                    <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1.5"/>
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#222838"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Title}" Foreground="#F9FAFB" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Badge}" Foreground="#C5A059" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Append / Clear Bottom Row -->
                    <Grid Grid.Row="4" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="AppendFilesBtn" Grid.Column="0" Content="+ Datei anhängen" Height="28" FontSize="11.5" Click="AppendFiles_Click"
                                Background="#1D2230" Foreground="#C5A059" BorderBrush="#2D3343" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,5,0"
                                ToolTip="Weitere PDF- oder Bildseiten an dieses Dokument anhängen"/>
                        <Button x:Name="ClearAllPagesBtn" Grid.Column="1" Content="Leeren" Height="28" Padding="9,0" FontSize="11.5" Click="ClearAllPages_Click"
                                Background="#1D2230" Foreground="#9CA3AF" BorderBrush="#2D3343" Cursor="Hand"
                                ToolTip="Alle geladenen Seiten schließen"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- ============================================================= -->
            <!-- CENTER TILE: PAPER PREVIEW / CROP / QUEUE MANAGEMENT          -->
            <!-- ============================================================= -->
            <Border x:Name="ViewportTileBorder" Grid.Column="2" Background="#141821" BorderBrush="#242938" BorderThickness="1" CornerRadius="12" Padding="8">
                <Grid>

                    <!-- Paper Preview ScrollViewer -->
                    <ScrollViewer x:Name="PreviewScrollViewer"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  Background="Transparent">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                            <!-- Physical White Paper Sheet -->
                            <Border x:Name="PaperSheetBorder"
                                    Width="520" Height="735"
                                    Background="White"
                                    BorderBrush="#374151"
                                    BorderThickness="1"
                                    CornerRadius="2">
                                <Grid x:Name="PaperContentGrid" ClipToBounds="True">
                                    <Image x:Name="PreviewPageImage"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>

                                    <!-- Interactive Crop Canvas -->
                                    <Canvas x:Name="CropOverlayCanvas"
                                            Background="#55000000"
                                            Visibility="Collapsed"
                                            Cursor="Cross"
                                            MouseLeftButtonDown="CropCanvas_MouseLeftButtonDown"
                                            MouseMove="CropCanvas_MouseMove"
                                            MouseLeftButtonUp="CropCanvas_MouseLeftButtonUp">
                                        <Rectangle x:Name="CropSelectionRect"
                                                   Stroke="#C5A059"
                                                   StrokeThickness="2.2"
                                                   Fill="#22C5A059"/>
                                    </Canvas>
                                </Grid>
                            </Border>
                        </Grid>
                    </ScrollViewer>

                    <!-- Floating Crop Action Bar -->
                    <Border x:Name="CropActionPill"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,16"
                            Padding="10,6"
                            CornerRadius="10"
                            Background="#F2141822"
                            BorderBrush="#C5A059"
                            BorderThickness="1.5"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="✓ Zuschnitt übernehmen" Height="28" Padding="12,0" Click="ApplyCrop_Click"
                                    Background="#C5A059" Foreground="#0F1117" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,0,6,0"/>
                            <Button Content="Original wiederherstellen" Height="28" Padding="10,0" Click="ResetCrop_Click"
                                    Background="#1D2230" Foreground="#E5E7EB" BorderBrush="#2D3343" Cursor="Hand" Margin="0,0,6,0"/>
                            <Button Content="✕" Width="28" Height="28" Click="CancelCrop_Click"
                                    Background="#1D2230" Foreground="#9CA3AF" BorderBrush="#2D3343" Cursor="Hand"/>
                        </StackPanel>
                    </Border>

                    <!-- Empty State Overlay -->
                    <Border x:Name="EmptyStateOverlay" Background="#141821" CornerRadius="10" Visibility="Visible">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="390">
                            <Image Source="funkenwerk_drucker.png" Width="72" Height="72" Margin="0,0,0,16"/>
                            <TextBlock x:Name="EmptyTitleTxt" Text="PDF oder Bild hierher ziehen" Foreground="#F9FAFB" FontSize="15.5" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,18"/>
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="DATEI ÖFFNEN" Height="36" Padding="16,0" Click="OpenFile_Click"
                                        Background="#C5A059" Foreground="#0F1117" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="4"/>
                                <Button x:Name="EmptyScanBtn" Content="JETZT SCANNEN" Height="36" Padding="16,0" Click="StartScanNew_Click"
                                        Background="#1D2230" Foreground="#C5A059" BorderBrush="#C5A059" BorderThickness="1.2" FontWeight="Bold" Cursor="Hand" Margin="4"/>
                                <Button x:Name="EmptyTestPageBtn" Content="PRÜFBLATT" Height="36" Padding="14,0" Click="LoadCalibrationPage_Click"
                                        Background="#1D2230" Foreground="#E5E7EB" BorderBrush="#2D3343" FontWeight="SemiBold" Cursor="Hand" Margin="4"
                                        ToolTip="Sparsames Düsen- &amp; 100-mm-Maßstabsblatt laden"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- ===================================================== -->
                    <!-- DEVICE, QUEUE & HP-DECOUPLING VIEW                    -->
                    <!-- ===================================================== -->
                    <Border x:Name="QueueWorkspaceOverlay" Background="#141821" CornerRadius="10" Padding="18" Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Header + Queue Actions -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="DRUCK-WARTESCHLANGE" Foreground="#C5A059" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="↻ Aktualisieren" Height="30" Padding="12,0" Click="RefreshPrintersAndQueue_Click"
                                            Background="#1D2230" Foreground="#E5E7EB" BorderBrush="#2D3343" Cursor="Hand" Margin="0,0,6,0"/>
                                    <Button Content="Warteschlange leeren" Height="30" Padding="12,0" Click="PurgeQueue_Click"
                                            Background="#EF4444" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                                            ToolTip="Bricht hängende Windows-Druckaufträge sofort ab"/>
                                </StackPanel>
                            </Grid>

                            <!-- Queue List -->
                            <Border x:Name="QueueListContainerBorder" Grid.Row="1" Background="#10131B" BorderBrush="#242938" BorderThickness="1" CornerRadius="10" Padding="10">
                                <Grid>
                                    <ListBox x:Name="QueueJobsListBox" Background="Transparent" BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Margin" Value="0,3"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border Padding="12,9" CornerRadius="8" Background="#181C27" BorderBrush="#262C3D" BorderThickness="1">
                                                                <ContentPresenter/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="130"/>
                                                        <ColumnDefinition Width="65"/>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="32"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding DocumentName}" Foreground="#F9FAFB" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="#C5A059" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding PagesText}" Foreground="#9CA3AF" FontSize="11.5" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding SubmittedText}" Foreground="#9CA3AF" FontSize="11.5" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="4" Content="✕" Width="26" Height="24" Tag="{Binding JobId}" Click="CancelSingleJob_Click"
                                                            Background="#2A161B" Foreground="#F87171" BorderBrush="#4C1D24" FontWeight="Bold" Cursor="Hand"
                                                            ToolTip="Diesen Druckauftrag abbrechen"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <TextBlock x:Name="EmptyQueuePlaceholderTxt"
                                               Text="Keine offenen Druckaufträge"
                                               Foreground="#6B7280"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Hardware Maintenance & LAN Direct Config -->
                            <Border x:Name="HardwareMaintCardBorder" Grid.Row="2" Background="#10131B" BorderBrush="#242938" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="DIREKTVERBINDUNG &amp; WARTUNG" Foreground="#C5A059" FontSize="11.5" FontWeight="Bold" Margin="0,0,0,10"/>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="LAN-IP / Host:" Foreground="#D1D5DB" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox x:Name="CustomIpTextBox" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Padding="8,0"
                                                 Background="#181C27" Foreground="#F9FAFB" BorderBrush="#2D3343" CaretBrush="#C5A059" FontSize="12"
                                                 ToolTip="Optional feste Drucker-IP (z. B. 192.168.188.26) oder leer für Auto-Erkennung"/>
                                        <Button Grid.Column="2" Content="IP übernehmen" Height="28" Padding="11,0" Click="SaveCustomIp_Click"
                                                Background="#C5A059" Foreground="#0F1117" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="8,0,0,0"/>
                                        <TextBlock x:Name="HpAppStatusBadgeTxt" Grid.Column="3" Text="" Foreground="#9CA3AF" FontSize="11.5"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <WrapPanel Orientation="Horizontal">
                                        <Button Content="Prüfblatt (100 mm) öffnen" Height="30" Padding="12,0" Click="LoadCalibrationPage_Click"
                                                Background="#1D2230" Foreground="#E5E7EB" BorderBrush="#2D3343" Cursor="Hand" Margin="0,0,6,4"
                                                ToolTip="Lädt das Funkenwerk Prüfblatt mit CMYK-Test und 100-mm-Lineal"/>
                                        <Button Content="Drucker-Webseite (LAN)" Height="30" Padding="12,0" Click="OpenPrinterWebUi_Click"
                                                Background="#1D2230" Foreground="#C5A059" BorderBrush="#2D3343" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,6,4"
                                                ToolTip="Öffnet die lokale Weboberfläche des Druckers im Heimnetz (ohne Cloud)"/>
                                        <Button Content="Windows-Druckereinstellungen" Height="30" Padding="12,0" Click="OpenWindowsPrintersSettings_Click"
                                                Background="#1D2230" Foreground="#E5E7EB" BorderBrush="#2D3343" Cursor="Hand" Margin="0,0,6,4"/>
                                        <Button x:Name="OpenWindowsAppsBtn" Content="Installierte Apps (HP Smart entfernen)" Height="30" Padding="12,0" Click="OpenWindowsAppsSettings_Click"
                                                Background="#1D2230" Foreground="#F87171" BorderBrush="#3B2328" Cursor="Hand" Margin="0,0,0,4"
                                                ToolTip="Öffnet die Windows App-Verwaltung zum Deinstallieren von HP Smart"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Busy / Scan Progress Overlay -->
                    <Border x:Name="BusyOverlayBorder" Background="#CC090B10" CornerRadius="10" Visibility="Collapsed">
                        <Border Padding="24,18" CornerRadius="12" Background="#151923" BorderBrush="#C5A059" BorderThickness="1.5"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="BusyOverlayTitleTxt" Text="Scanner arbeitet …" Foreground="#C5A059" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock x:Name="BusyOverlaySubTxt" Text="Direktverbindung über LAN" Foreground="#E5E7EB" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                <Button Content="Abbrechen" Height="28" Padding="14,0" Click="CancelBusyOperation_Click"
                                        Background="#1D2230" Foreground="#F87171" BorderBrush="#2D3343" Cursor="Hand" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Border>

                    <!-- Non-Blocking Toast Pill -->
                    <Border x:Name="ViewerToastBorder"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Center"
                            Margin="0,14,0,0"
                            Padding="16,8"
                            CornerRadius="20"
                            Background="#F2151923"
                            BorderBrush="#C5A059"
                            BorderThickness="1.5"
                            Visibility="Collapsed"
                            IsHitTestVisible="False">
                        <TextBlock x:Name="ViewerToastText"
                                   Text="✓ Bereit"
                                   Foreground="#F9FAFB"
                                   FontSize="12.5"
                                   FontWeight="Bold"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ============================================================= -->
            <!-- RIGHT TILE: PRINTER SELECTOR, INK TELEMETRY & MODE CONTROLS   -->
            <!-- ============================================================= -->
            <Border x:Name="RightTileBorder" Grid.Column="4" Background="#141821" BorderBrush="#242938" BorderThickness="1" CornerRadius="12" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>

                        <!-- Printer Header + Refresh -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="GERÄT" Foreground="#C5A059" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button x:Name="RefreshPrintersBtn" Grid.Column="1" Content="↻ Prüfen" Height="24" Padding="8,0" FontSize="11" Click="RefreshPrintersAndQueue_Click"
                                    Background="#1D2230" Foreground="#C5A059" BorderBrush="#2D3343" FontWeight="SemiBold" Cursor="Hand"
                                    ToolTip="Druckerstatus, LAN-IP und Tintenstand lokal abfragen"/>
                        </Grid>

                        <!-- Clean Themed Printer List (No ugly white OS ComboBox!) -->
                        <ListBox x:Name="PrintersListBox" MaxHeight="164" Background="Transparent" BorderThickness="0"
                                 SelectionChanged="PrintersListBox_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 Margin="0,0,0,10">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,2"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="PrnItemBorder" Padding="9,7" CornerRadius="8" Background="#1A1F2C" BorderBrush="#262C3D" BorderThickness="1" Cursor="Hand">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="PrnItemBorder" Property="BorderBrush" Value="#C5A059"/>
                                                        <Setter TargetName="PrnItemBorder" Property="BorderThickness" Value="1.5"/>
                                                        <Setter TargetName="PrnItemBorder" Property="Background" Value="#222838"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{Binding StatusDotBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" Foreground="#F9FAFB" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding EffectiveStatusLabel}" Foreground="#9CA3AF" FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" Background="#12151E" BorderBrush="#2D3343" BorderThickness="1" CornerRadius="5" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding BadgeText}" Foreground="#C5A059" FontSize="9.5" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Subscription-Free Local Ink Telemetry Bars -->
                        <Border x:Name="InkCardBorder" Background="#10131B" BorderBrush="#242938" BorderThickness="1" CornerRadius="9" Padding="10,8" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="TINTENSTAND (LOKAL)" Foreground="#9CA3AF" FontSize="10.5" FontWeight="Bold"/>
                                    <TextBlock x:Name="InkSummaryRightTxt" Grid.Column="1" Text="Standby" Foreground="#C5A059" FontSize="10.5" FontWeight="Bold"/>
                                </Grid>

                                <!-- Black Ink -->
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="58"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="36"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Schwarz" Foreground="#D1D5DB" FontSize="11" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Height="7" Background="#1E2433" CornerRadius="3.5" VerticalAlignment="Center" ClipToBounds="True">
                                        <Border x:Name="BlackInkFillBar" HorizontalAlignment="Left" Width="0" Background="#E5E7EB" CornerRadius="3.5"/>
                                    </Border>
                                    <TextBlock x:Name="BlackInkPctTxt" Grid.Column="2" Text="—" Foreground="#9CA3AF" FontSize="11" TextAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Color CMY Ink -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="58"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="36"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Farbe" Foreground="#D1D5DB" FontSize="11" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Height="7" Background="#1E2433" CornerRadius="3.5" VerticalAlignment="Center" ClipToBounds="True">
                                        <Border x:Name="ColorInkFillBar" HorizontalAlignment="Left" Width="0" Background="#C5A059" CornerRadius="3.5"/>
                                    </Border>
                                    <TextBlock x:Name="ColorInkPctTxt" Grid.Column="2" Text="—" Foreground="#9CA3AF" FontSize="11" TextAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ================================================= -->
                        <!-- PANEL A: PRINT CONTROLS                           -->
                        <!-- ================================================= -->
                        <StackPanel x:Name="PrintSettingsPanel" Visibility="Visible">

                            <Button x:Name="PrimaryPrintBtn" Content="JETZT DRUCKEN" Height="40" Click="ExecutePrint_Click"
                                    Background="#C5A059" Foreground="#0F1117" FontSize="13" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,0,0,14"
                                    ToolTip="Druckauftrag starten (Strg+P)"/>

                            <!-- Copies -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="KOPIEN" Foreground="#9CA3AF" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Background="#181C26" BorderBrush="#2D3343" BorderThickness="1" CornerRadius="6" Height="28">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="−" Width="28" Height="26" Click="CopiesDown_Click" Background="Transparent" Foreground="#E5E7EB" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                                        <TextBlock x:Name="CopiesValueTxt" Text="1" Width="32" TextAlignment="Center" VerticalAlignment="Center" Foreground="#C5A059" FontWeight="Bold" FontSize="12"/>
                                        <Button Content="+" Width="28" Height="26" Click="CopiesUp_Click" Background="Transparent" Foreground="#E5E7EB" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Color Mode -->
                            <TextBlock Text="FARBMODUS" Foreground="#9CA3AF" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>
                            <UniformGrid Columns="2" Margin="0,0,0,10">
                                <Button x:Name="PrintColorBtn" Content="Farbe" Height="28" FontSize="11.5" Click="SetPrintColor_Click"
                                        Background="#C5A059" Foreground="#0F1117" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,0,3,0"/>
                                <Button x:Name="PrintGrayBtn" Content="S/W" Height="28" FontSize="11.5" Click="SetPrintGray_Click"
                                        Background="#1B1F2B" Foreground="#E5E7EB" BorderBrush="#2D3343" Cursor="Hand" Margin="3,0,0,0"
                                        ToolTip="Reiner Schwarzdruck · Schont die Farbpatrone"/>
                            </UniformGrid>

                            <!-- Duplex -->
                            <TextBlock Text="BEIDSEITIG" Foreground="#9CA3AF" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>
                            <UniformGrid Columns="3" Margin="0,0,0,10">
                                <Button x:Name="DuplexOffBtn" Content="Einseitig" Height="28" FontSize="11" Click="DuplexOff_Click"
                                        Background="#C5A059" Foreground="#0F1117" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,0,3,0"/>
                                <Button x:Name="DuplexLongBtn" Content="Lang" Height="28" FontSize="11" Click="DuplexLong_Click"
                                        Background="#1B1F2B" Foreground="#E5E7EB" BorderBrush="#2D3343" Cursor="Hand" Margin="2,0,2,0"
                                        ToolTip="Beidseitig über lange Kante spiegeln (Standard Buch)"/>
                                <Button x:Name="DuplexShortBtn" Content="Kurz" Height="28" FontSize="11" Click="DuplexShort_Click"
                                        Background="#1B1F2B" Foreground="#E5E7EB" BorderBrush="#2D3343" Cursor="Hand" Margin="3,0,0,0"
                                        ToolTip="Beidseitig über kurze Kante spiegeln (Block/Querformat)"/>
                            </UniformGrid>

                            <!-- Paper Size -->
                            <TextBlock Text="PAPIERFORMAT" Foreground="#9CA3AF" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>
                            <UniformGrid Columns="3" Margin="0,0,0,10">
                                <Button x:Name="FormatA4Btn" Content="DIN A4" Height="28" FontSize="11" Click="FormatA4_Click"
                                        Background="#C5A059" Foreground="#0F1117" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,0,3,0"/>
                                <Button x:Name="FormatA5Btn" Content="DIN A5" Height="28" FontSize="11" Click="FormatA5_Click"
                                        Background="#1B1F2B" Foreground="#E5E7EB" BorderBrush="#2D3343" Cursor="Hand" Margin="2,0,2,0"/>
                                <Button x:Name="FormatLabelBtn" Content="10×15" Height="28" FontSize="11" Click="FormatLabel_Click"
                                        Background="#1B1F2B" Foreground="#E5E7EB" BorderBrush="#2D3343" Cursor="Hand" Margin="3,0,0,0"
                                        ToolTip="DHL Versandetikett / 10×15 cm Fotoformat"/>
                            </UniformGrid>

                            <!-- Orientation -->
                            <TextBlock Text="AUSRICHTUNG" Foreground="#9CA3AF" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>
                            <UniformGrid Columns="3" Margin="0,0,0,10">
                                <Button x:Name="OrientAutoBtn" Content="Auto" Height="28" FontSize="11" Click="OrientAuto_Click"
                                        Background="#C5A059" Foreground="#0F1117" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,0,3,0"/>
                                <Button x:Name="OrientPortraitBtn" Content="Hoch" Height="28" FontSize="11" Click="OrientPortrait_Click"
                                        Background="#1B1F2B" Foreground="#E5E7EB" BorderBrush="#2D3343" Cursor="Hand" Margin="2,0,2,0"/>
                                <Button x:Name="OrientLandscapeBtn" Content="Quer" Height="28" FontSize="11" Click="OrientLandscape_Click"
                                        Background="#1B1F2B" Foreground="#E5E7EB" BorderBrush="#2D3343" Cursor="Hand" Margin="3,0,0,0"/>
                            </UniformGrid>

                            <!-- Scale -->
                            <TextBlock Text="SKALIERUNG" Foreground="#9CA3AF" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>
                            <UniformGrid Columns="2" Margin="0,0,0,10">
                                <Button x:Name="ScaleFitBtn" Content="Einpassen" Height="28" FontSize="11" Click="ScaleFit_Click"
                                        Background="#C5A059" Foreground="#0F1117" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,0,3,0"
                                        ToolTip="Sicher in den bedruckbaren Bereich einpassen (keine abgeschnittenen Ränder)"/>
                                <Button x:Name="Scale100Btn" Content="100 % Maßtreu" Height="28" FontSize="11" Click="Scale100_Click"
                                        Background="#1B1F2B" Foreground="#E5E7EB" BorderBrush="#2D3343" Cursor="Hand" Margin="3,0,0,0"
                                        ToolTip="Exakte 1:1 Millimeter-Größe für Laser-Vorlagen &amp; Maßblätter"/>
                            </UniformGrid>

                            <!-- Page Range -->
                            <TextBlock Text="SEITENBEREICH" Foreground="#9CA3AF" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>
                            <UniformGrid Columns="3" Margin="0,0,0,6">
                                <Button x:Name="RangeAllBtn" Content="Alle" Height="28" FontSize="11" Click="RangeAll_Click"
                                        Background="#C5A059" Foreground="#0F1117" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,0,3,0"/>
                                <Button x:Name="RangeCurrentBtn" Content="Aktuelle" Height="28" FontSize="11" Click="RangeCurrent_Click"
                                        Background="#1B1F2B" Foreground="#E5E7EB" BorderBrush="#2D3343" Cursor="Hand" Margin="2,0,2,0"/>
                                <Button x:Name="RangeCustomBtn" Content="Auswahl" Height="28" FontSize="11" Click="RangeCustom_Click"
                                        Background="#1B1F2B" Foreground="#E5E7EB" BorderBrush="#2D3343" Cursor="Hand" Margin="3,0,0,0"/>
                            </UniformGrid>
                            <TextBox x:Name="CustomPageRangeBox" Height="28" VerticalContentAlignment="Center" Padding="8,0" Text="1-2"
                                     Background="#181C27" Foreground="#F9FAFB" BorderBrush="#2D3343" CaretBrush="#C5A059" FontSize="12"
                                     Visibility="Collapsed" ToolTip="Beispiel: 1-3, 5"/>
                        </StackPanel>

                        <!-- ================================================= -->
                        <!-- PANEL B: SUBSCRIPTION-FREE SCANNER CONTROLS       -->
                        <!-- ================================================= -->
                        <StackPanel x:Name="ScanSettingsPanel" Visibility="Collapsed">

                            <Button x:Name="PrimaryScanBtn" Content="NEU SCANNEN" Height="40" Click="StartScanNew_Click"
                                    Background="#C5A059" Foreground="#0F1117" FontSize="13" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,0,0,6"
                                    ToolTip="Neuen Scan starten (ohne HP-Konto &amp; ohne Cloud)"/>

                            <Button x:Name="AppendScanBtn" Content="+ WEITERE SEITE ANHÄNGEN" Height="32" Click="StartScanAppend_Click"
                                    Background="#1D2230" Foreground="#C5A059" BorderBrush="#C5A059" BorderThickness="1" FontSize="11.5" FontWeight="Bold" Cursor="Hand" Margin="0,0,0,14"
                                    ToolTip="Nächstes Blatt scannen und als weitere PDF-Seite anfügen"/>

                            <!-- Source -->
                            <TextBlock Text="QUELLE" Foreground="#9CA3AF" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>
                            <UniformGrid Columns="3" Margin="0,0,0,10">
                                <Button x:Name="ScanSrcFlatbedBtn" Content="Glas" Height="28" FontSize="11" Click="ScanSrcFlatbed_Click"
                                        Background="#C5A059" Foreground="#0F1117" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,0,3,0"
                                        ToolTip="Flachbett-Vorlagenglas"/>
                                <Button x:Name="ScanSrcAdfBtn" Content="Einzug" Height="28" FontSize="11" Click="ScanSrcAdf_Click"
                                        Background="#1B1F2B" Foreground="#E5E7EB" BorderBrush="#2D3343" Cursor="Hand" Margin="2,0,2,0"
                                        ToolTip="Automatischer Dokumenteneinzug (ADF Stapel-Scan)"/>
                                <Button x:Name="ScanSrcDuplexBtn" Content="ADF 2-seitig" Height="28" FontSize="10.5" Click="ScanSrcDuplex_Click"
                                        Background="#1B1F2B" Foreground="#E5E7EB" BorderBrush="#2D3343" Cursor="Hand" Margin="3,0,0,0"/>
                            </UniformGrid>

                            <!-- Resolution -->
                            <TextBlock Text="AUFLÖSUNG" Foreground="#9CA3AF" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>
                            <UniformGrid Columns="3" Margin="0,0,0,10">
                                <Button x:Name="ScanDpi150Btn" Content="150 DPI" Height="28" FontSize="11" Click="ScanDpi150_Click"
                                        Background="#1B1F2B" Foreground="#E5E7EB" BorderBrush="#2D3343" Cursor="Hand" Margin="0,0,3,0"/>
                                <Button x:Name="ScanDpi300Btn" Content="300 DPI" Height="28" FontSize="11" Click="ScanDpi300_Click"
                                        Background="#C5A059" Foreground="#0F1117" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="2,0,2,0"/>
                                <Button x:Name="ScanDpi600Btn" Content="600 DPI" Height="28" FontSize="11" Click="ScanDpi600_Click"
                                        Background="#1B1F2B" Foreground="#E5E7EB" BorderBrush="#2D3343" Cursor="Hand" Margin="3,0,0,0"/>
                            </UniformGrid>

                            <!-- Scan Color -->
                            <TextBlock Text="MODUS" Foreground="#9CA3AF" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>
                            <UniformGrid Columns="3" Margin="0,0,0,10">
                                <Button x:Name="ScanColColorBtn" Content="Farbe" Height="28" FontSize="11" Click="ScanColColor_Click"
                                        Background="#C5A059" Foreground="#0F1117" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,0,3,0"/>
                                <Button x:Name="ScanColGrayBtn" Content="Grau" Height="28" FontSize="11" Click="ScanColGray_Click"
                                        Background="#1B1F2B" Foreground="#E5E7EB" BorderBrush="#2D3343" Cursor="Hand" Margin="2,0,2,0"/>
                                <Button x:Name="ScanColBwBtn" Content="Beleg S/W" Height="28" FontSize="11" Click="ScanColBw_Click"
                                        Background="#1B1F2B" Foreground="#E5E7EB" BorderBrush="#2D3343" Cursor="Hand" Margin="3,0,0,0"
                                        ToolTip="Optimiert Briefe &amp; Kassenbons mit klarem weißem Hintergrund"/>
                            </UniformGrid>

                            <!-- Scan Protocol -->
                            <TextBlock Text="VERBINDUNG" Foreground="#9CA3AF" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>
                            <UniformGrid Columns="3" Margin="0,0,0,14">
                                <Button x:Name="ProtoAutoBtn" Content="Auto" Height="28" FontSize="11" Click="ProtoAuto_Click"
                                        Background="#C5A059" Foreground="#0F1117" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,0,3,0"
                                        ToolTip="Nutzt bevorzugt treiberloses LAN eSCL, sonst Windows WIA"/>
                                <Button x:Name="ProtoEsclBtn" Content="LAN Direkt" Height="28" FontSize="11" Click="ProtoEscl_Click"
                                        Background="#1B1F2B" Foreground="#E5E7EB" BorderBrush="#2D3343" Cursor="Hand" Margin="2,0,2,0"/>
                                <Button x:Name="ProtoWiaBtn" Content="USB / WIA" Height="28" FontSize="11" Click="ProtoWia_Click"
                                        Background="#1B1F2B" Foreground="#E5E7EB" BorderBrush="#2D3343" Cursor="Hand" Margin="3,0,0,0"/>
                            </UniformGrid>

                            <!-- 1-Click Export Actions -->
                            <TextBlock Text="WEITERVERARBEITUNG" Foreground="#9CA3AF" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                            <UniformGrid Columns="2" Margin="0,0,0,6">
                                <Button Content="Als PDF speichern" Height="30" FontSize="11.5" Click="SaveAsPdf_Click"
                                        Background="#1D2230" Foreground="#F9FAFB" BorderBrush="#2D3343" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,3,0"/>
                                <Button Content="Als PNG speichern" Height="30" FontSize="11.5" Click="SaveCurrentPageImage_Click"
                                        Background="#1D2230" Foreground="#F9FAFB" BorderBrush="#2D3343" FontWeight="SemiBold" Cursor="Hand" Margin="3,0,0,0"/>
                            </UniformGrid>
                            <Button Content="✍ In Funkenwerk PDF unterschreiben" Height="32" FontSize="11.5" Click="OpenInFunkenwerkPdf_Click"
                                    Background="#1D2230" Foreground="#C5A059" BorderBrush="#C5A059" BorderThickness="1" FontWeight="Bold" Cursor="Hand" Margin="0,0,0,6"/>
                            <Button Content="Beleg → Buchhaltung ablegen" Height="30" FontSize="11.5" Click="SaveToAccountingReceipts_Click"
                                    Background="#1D2230" Foreground="#E5E7EB" BorderBrush="#2D3343" Cursor="Hand"/>
                        </StackPanel>

                        <!-- ================================================= -->
                        <!-- PANEL C: 1-CLICK DIRECT COPIER                    -->
                        <!-- ================================================= -->
                        <StackPanel x:Name="CopySettingsPanel" Visibility="Collapsed">

                            <Button Content="S/W KOPIE STARTEN" Height="40" Click="StartBwCopy_Click"
                                    Background="#C5A059" Foreground="#0F1117" FontSize="13" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,0,0,8"
                                    ToolTip="Scannt mit Beleg-Kontrast und druckt sofort rein schwarzweiß"/>

                            <Button Content="FARBKOPIE STARTEN" Height="36" Click="StartColorCopy_Click"
                                    Background="#1D2230" Foreground="#F9FAFB" BorderBrush="#2D3343" FontSize="12.5" FontWeight="Bold" Cursor="Hand" Margin="0,0,0,14"/>

                            <!-- Copy Count -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="ANZAHL KOPIEN" Foreground="#9CA3AF" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Background="#181C26" BorderBrush="#2D3343" BorderThickness="1" CornerRadius="6" Height="28">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="−" Width="28" Height="26" Click="CopiesDown_Click" Background="Transparent" Foreground="#E5E7EB" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                                        <TextBlock x:Name="CopyTabCountTxt" Text="1" Width="32" TextAlignment="Center" VerticalAlignment="Center" Foreground="#C5A059" FontWeight="Bold" FontSize="12"/>
                                        <Button Content="+" Width="28" Height="26" Click="CopiesUp_Click" Background="Transparent" Foreground="#E5E7EB" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <TextBlock Text="VORLAGENQUELLE" Foreground="#9CA3AF" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>
                            <UniformGrid Columns="2" Margin="0,0,0,10">
                                <Button x:Name="CopySrcFlatbedBtn" Content="Flachbett" Height="28" FontSize="11.5" Click="ScanSrcFlatbed_Click"
                                        Background="#C5A059" Foreground="#0F1117" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,0,3,0"/>
                                <Button x:Name="CopySrcAdfBtn" Content="Einzug (ADF)" Height="28" FontSize="11.5" Click="ScanSrcAdf_Click"
                                        Background="#1B1F2B" Foreground="#E5E7EB" BorderBrush="#2D3343" Cursor="Hand" Margin="3,0,0,0"/>
                            </UniformGrid>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ================================================================= -->
        <!-- ROW 2: MINIMAL STATUS FOOTER                                      -->
        <!-- ================================================================= -->
        <Border x:Name="FooterBorder" Grid.Row="2" Background="#12151E" BorderBrush="#232734" BorderThickness="0,1,0,0" Padding="12,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
