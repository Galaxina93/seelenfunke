<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>funkenwerk_drucker.ico</ApplicationIcon>
    <AssemblyName>FunkenwerkDrucker</AssemblyName>
    <RootNamespace>FunkenwerkDrucker</RootNamespace>
    <Product>Funkenwerk Drucker</Product>
    <Company>Mein-Seelenfunke</Company>
    <Version>1.2.0</Version>
    <AssemblyVersion>1.2.0.8</AssemblyVersion>
    <FileVersion>1.2.0.8</FileVersion>
    <InformationalVersion>1.2.0+b8</InformationalVersion>
    <NoWarn>NU1701;CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\funkenwerk\FunkenwerkVersioning.cs" Link="Shared\FunkenwerkVersioning.cs" />
    <Resource Include="funkenwerk_drucker.ico" />
    <Resource Include="funkenwerk_drucker.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PDFsharp-WPF" Version="6.2.4" />
  </ItemGroup>

</Project>
