<Window x:Class="Funkenwerk3D.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Funkenwerk 3D"
        Width="1280" Height="820"
        MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown"
        Background="{DynamicResource AppBgBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="AppBgBrush" Color="#0E121B"/>
        <SolidColorBrush x:Key="TopBarBgBrush" Color="#131824"/>
        <SolidColorBrush x:Key="SidebarBgBrush" Color="#131824"/>
        <SolidColorBrush x:Key="CardBgBrush" Color="#181F2E"/>
        <SolidColorBrush x:Key="BorderBrushColor" Color="#263044"/>
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F3F4F6"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#9CA3AF"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#6B7280"/>
        <SolidColorBrush x:Key="HoverBgBrush" Color="#1F293D"/>
        <SolidColorBrush x:Key="ActivePillBgBrush" Color="#2A2315"/>
        <SolidColorBrush x:Key="GoldBrush" Color="#C5A059"/>

        <!-- Slim ScrollBar -->
        <Style x:Key="SlimThumb" TargetType="Thumb">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bd" Background="#64748B" CornerRadius="3" Opacity="0.65"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C5A059"/>
                                <Setter TargetName="Bd" Property="Opacity" Value="0.95"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="7"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent" Width="7" Margin="1,2">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                                        <Track.Thumb><Thumb Style="{StaticResource SlimThumb}"/></Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="7"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent" Height="7" Margin="2,1">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False" Focusable="False">
                                        <Track.Thumb><Thumb Style="{StaticResource SlimThumb}"/></Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBgBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#C5A059"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GoldPrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#C5A059"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="BorderBrush" Value="#A8843E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D4B26E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Theme-consistent ComboBox & ComboBoxItem (100% Dark & Light Mode) -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBd" Property="Background" Value="{DynamicResource HoverBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBd" Property="Background" Value="{DynamicResource ActivePillBgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          ClickMode="Press"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd"
                                                Background="{DynamicResource CardBgBrush}"
                                                BorderBrush="{DynamicResource BorderBrushColor}"
                                                BorderThickness="1"
                                                CornerRadius="5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="1"
                                                           Text="▾"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#C5A059"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="8,2,22,2"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{DynamicResource CardBgBrush}"
                                        BorderBrush="#C5A059"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Margin="0,2,0,0">
                                    <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Border Grid.Row="0"
                Background="{DynamicResource TopBarBgBrush}"
                BorderBrush="{DynamicResource BorderBrushColor}"
                BorderThickness="0,0,0,1"
                Padding="12,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Brand + Open + Prev/Next -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image x:Name="BrandLogoImg" Width="24" Height="24" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Funkenwerk 3D" FontSize="14.5" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>

                    <Button Content="📂 Öffnen" Style="{StaticResource GoldPrimaryBtn}" Click="OpenFile_Click" ToolTip="3D-Modell öffnen (Strg+O)"/>

                    <Button x:Name="PrevModelBtn" Content="◀" Style="{StaticResource ActionBtn}" Width="30" Padding="0,5" Margin="8,0,3,0" IsEnabled="False" Click="PrevModel_Click" ToolTip="Vorherige 3D-Datei im Ordner (Alt+Links)"/>
                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                        <TextBlock x:Name="FolderIndexText" Text="0 / 0" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                    </Border>
                    <Button x:Name="NextModelBtn" Content="▶" Style="{StaticResource ActionBtn}" Width="30" Padding="0,5" Margin="3,0,0,0" IsEnabled="False" Click="NextModel_Click" ToolTip="Nächste 3D-Datei im Ordner (Alt+Rechts)"/>
                </StackPanel>

                <!-- Center: Active File Name -->
                <TextBlock x:Name="CurrentFileTitleText"
                           Grid.Column="1"
                           Text="Keine Datei geladen"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="14,0"
                           TextTrimming="CharacterEllipsis"/>

                <!-- Right: Quick Viewport Tools + Exoskeleton + Default App + Theme + Details -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ExoskeletonTopBtn" Content="🦴 Exoskelett" Style="{StaticResource ActionBtn}" Margin="0,0,5,0" Click="ExoskeletonTopBtn_Click" ToolTip="Exoskelett / Auto-Rigging erzeugen oder Knochen ein-/ausblenden (E)"/>
                    <Button x:Name="ExportGlbTopBtn" Content="💾 .glb" Style="{StaticResource ActionBtn}" Margin="0,0,5,0" IsEnabled="False" Click="SaveRiggedGlb_Click" ToolTip="Geriggtes 3D-Modell inkl. Animationen als .glb speichern (Strg+E)"/>
                    <Button x:Name="DimToggleBtn" Content="📐 Maße" Style="{StaticResource ActionBtn}" Margin="0,0,5,0" Click="ToggleDimensions_Click" ToolTip="3D-Maßrahmen &amp; Millimeter-Anzeige ein-/ausblenden (M)"/>
                    <Button x:Name="WireframeToggleBtn" Content="🕸 Gitter" Style="{StaticResource ActionBtn}" Margin="0,0,5,0" Click="ToggleWireframe_Click" ToolTip="Drahtgitter-Modus ein-/ausblenden (W)"/>
                    <Button x:Name="TurntableToggleBtn" Content="⟳ Drehen" Style="{StaticResource ActionBtn}" Margin="0,0,5,0" Click="ToggleTurntable_Click" ToolTip="Automatischer 360°-Drehteller (Leertaste)"/>
                    <Button Content="🎯 Zentrieren" Style="{StaticResource ActionBtn}" Margin="0,0,5,0" Click="ResetCamera_Click" ToolTip="Kamera zentrieren (R)"/>
                    <Button Content="📸 PNG" Style="{StaticResource ActionBtn}" Margin="0,0,5,0" Click="ExportPng_Click" ToolTip="Hochauflösendes PNG-Bild speichern (Strg+S)"/>
                    <Button Content="Standard-App" Style="{StaticResource ActionBtn}" Margin="0,0,5,0" Click="SetDefaultApp_Click" ToolTip="Funkenwerk 3D als Windows Standard-Programm verwalten"/>
                    <Button x:Name="ThemeToggleBtn" Content="☀" Style="{StaticResource ActionBtn}" Width="32" Padding="0,5" Margin="0,0,5,0" Click="ThemeToggle_Click" ToolTip="Light- / Dark-Mode umschalten"/>
                    <Button x:Name="SidebarToggleBtn" Content="☷ Details" Style="{StaticResource ActionBtn}" Click="ToggleSidebar_Click" ToolTip="Inspektor-Seitenleiste ein-/ausblenden"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN WORKSPACE: 3D VIEWPORT + INSPECTOR SIDEBAR -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="SidebarColumn" Width="290"/>
            </Grid.ColumnDefinitions>

            <!-- 3D WebGL Viewport -->
            <Grid Grid.Column="0" Background="{DynamicResource AppBgBrush}">
                <wv2:WebView2 x:Name="ViewportWebView" DefaultBackgroundColor="Transparent"/>

                <!-- Toast Banner -->
                <Border x:Name="ViewerToastBorder"
                        Visibility="Collapsed"
                        IsHitTestVisible="False"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,18"
                        Background="#E6131824"
                        BorderBrush="#C5A059"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14,7">
                    <TextBlock x:Name="ViewerToastText" Text="" FontSize="12" FontWeight="SemiBold" Foreground="#F3F4F6"/>
                </Border>
            </Grid>

            <!-- RIGHT INSPECTOR SIDEBAR -->
            <Border x:Name="InspectorSidebar"
                    Grid.Column="1"
                    Background="{DynamicResource SidebarBgBrush}"
                    BorderBrush="{DynamicResource BorderBrushColor}"
                    BorderThickness="1,0,0,0"
                    Padding="12,12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- 1. Abmessungen -->
                        <DockPanel Margin="0,0,0,6">
                            <ComboBox x:Name="UnitModeCombo"
                                      DockPanel.Dock="Right"
                                      Width="92" Height="23"
                                      FontSize="11"
                                      SelectionChanged="UnitModeCombo_SelectionChanged"
                                      ToolTip="Maßeinheit der Quelldatei">
                                <ComboBoxItem Content="Auto" Tag="auto" IsSelected="True"/>
                                <ComboBoxItem Content="Meter -> mm" Tag="m"/>
                                <ComboBoxItem Content="1 Einh. = mm" Tag="mm"/>
                            </ComboBox>
                            <TextBlock Text="ABMESSUNGEN" FontSize="11" FontWeight="Bold" Foreground="#C5A059" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Breite (X)" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="StatWidthText" Grid.Row="0" Grid.Column="1" Text="-" FontSize="12" FontWeight="Bold" Margin="0,0,0,4"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Höhe (Y)" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="StatHeightText" Grid.Row="1" Grid.Column="1" Text="-" FontSize="12" FontWeight="Bold" Margin="0,0,0,4"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Tiefe (Z)" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock x:Name="StatDepthText" Grid.Row="2" Grid.Column="1" Text="-" FontSize="12" FontWeight="Bold"/>
                            </Grid>
                        </Border>

                        <!-- 2. Geometrie -->
                        <TextBlock Text="GEOMETRIE" FontSize="11" FontWeight="Bold" Foreground="#C5A059" Margin="0,0,0,6"/>
                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Format" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="StatFormatText" Grid.Row="0" Grid.Column="1" Text="-" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Dateigröße" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="StatFileSizeText" Grid.Row="1" Grid.Column="1" Text="-" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Dreiecke" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="StatTrianglesText" Grid.Row="2" Grid.Column="1" Text="-" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Vertices" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="StatVerticesText" Grid.Row="3" Grid.Column="1" Text="-" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Bauteile / Mat." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock x:Name="StatMeshesText" Grid.Row="4" Grid.Column="1" Text="-" FontSize="12" FontWeight="SemiBold"/>
                            </Grid>
                        </Border>

                        <!-- 3. Kamera-Ansichten -->
                        <TextBlock Text="KAMERA" FontSize="11" FontWeight="Bold" Foreground="#C5A059" Margin="0,0,0,6"/>
                        <UniformGrid Columns="3" Margin="0,0,0,12">
                            <Button Content="3D Iso" Style="{StaticResource ActionBtn}" Padding="4,5" Margin="0,0,4,4" Click="CamIso_Click"/>
                            <Button Content="Vorne" Style="{StaticResource ActionBtn}" Padding="4,5" Margin="2,0,2,4" Click="CamFront_Click"/>
                            <Button Content="Hinten" Style="{StaticResource ActionBtn}" Padding="4,5" Margin="4,0,0,4" Click="CamBack_Click"/>
                            <Button Content="Links" Style="{StaticResource ActionBtn}" Padding="4,5" Margin="0,0,4,0" Click="CamLeft_Click"/>
                            <Button Content="Rechts" Style="{StaticResource ActionBtn}" Padding="4,5" Margin="2,0,2,0" Click="CamRight_Click"/>
                            <Button Content="Oben" Style="{StaticResource ActionBtn}" Padding="4,5" Margin="4,0,0,0" Click="CamTop_Click"/>
                        </UniformGrid>

                        <!-- 4. Studio & Licht -->
                        <TextBlock Text="STUDIO" FontSize="11" FontWeight="Bold" Foreground="#C5A059" Margin="0,0,0,6"/>
                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,12">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="Hintergrund" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="BackdropCombo" DockPanel.Dock="Right" Width="136" Height="24" FontSize="11.5" SelectionChanged="BackdropCombo_SelectionChanged">
                                        <ComboBoxItem Content="Auto (Theme)" Tag="auto" IsSelected="True"/>
                                        <ComboBoxItem Content="Shop Hell" Tag="shop_light"/>
                                        <ComboBoxItem Content="Atelier Dunkel" Tag="atelier_dark"/>
                                        <ComboBoxItem Content="Kristall Schwarz" Tag="crystal_black"/>
                                        <ComboBoxItem Content="Reinweiß" Tag="pure_white"/>
                                    </ComboBox>
                                </DockPanel>

                                <DockPanel Margin="0,2,0,4">
                                    <TextBlock x:Name="ExposureValueText" DockPanel.Dock="Right" Text="1,05" FontSize="11.5" FontWeight="SemiBold"/>
                                    <TextBlock Text="Belichtung" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </DockPanel>
                                <Slider x:Name="ExposureSlider" Minimum="0.3" Maximum="2.5" Value="1.05" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="ExposureSlider_ValueChanged" Margin="0,0,0,8"/>

                                <CheckBox x:Name="GridFloorCheckBox" Content="Bodenraster anzeigen" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" IsChecked="True" Checked="GridFloorCheckBox_Changed" Unchecked="GridFloorCheckBox_Changed" Margin="0,0,0,6"/>
                                <CheckBox x:Name="TransparentPngCheckBox" Content="PNG freigestellt (transparent)" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" IsChecked="False"/>
                            </StackPanel>
                        </Border>

                        <!-- 5. Exoskelett / Auto-Rigging -->
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock x:Name="RigStatusBadgeText" DockPanel.Dock="Right" Text="Statisch" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="EXOSKELETT" FontSize="11" FontWeight="Bold" Foreground="#C5A059" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,12">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="Profil" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="RigProfileCombo" DockPanel.Dock="Right" Width="154" Height="24" FontSize="11.5">
                                        <ComboBoxItem Content="Auto-Erkennung" Tag="auto" IsSelected="True"/>
                                        <ComboBoxItem Content="Funki / Chibi" Tag="funki_chibi"/>
                                        <ComboBoxItem Content="Humanoid" Tag="humanoid"/>
                                    </ComboBox>
                                </DockPanel>

                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="Stil" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="RigVariantCombo" DockPanel.Dock="Right" Width="154" Height="24" FontSize="11.5">
                                        <ComboBoxItem Content="Original" Tag="original" IsSelected="True"/>
                                        <ComboBoxItem Content="Funki Schwarz-Gold" Tag="funki_male"/>
                                        <ComboBoxItem Content="Funkira + Diadem" Tag="funkira_female"/>
                                    </ComboBox>
                                </DockPanel>

                                <CheckBox x:Name="StripPedestalCheckBox" Content="Sockel automatisch entfernen" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" IsChecked="True" Margin="0,0,0,8"/>

                                <Button x:Name="GenerateRigBtn" Content="⚡ Exoskelett erzeugen" Style="{StaticResource GoldPrimaryBtn}" Click="GenerateExoskeleton_Click"/>

                                <StackPanel x:Name="RigActiveControlsPanel" Visibility="Collapsed" Margin="0,8,0,0">
                                    <CheckBox x:Name="ShowBonesCheckBox" Content="Knochen anzeigen" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" IsChecked="False" Checked="ShowBonesCheckBox_Changed" Unchecked="ShowBonesCheckBox_Changed" Margin="0,0,0,6"/>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="PoseBoneCombo" Grid.Column="0" Height="25" FontSize="11.5" SelectionChanged="PoseBoneCombo_SelectionChanged" ToolTip="Knochen zum Drehen im 3D-Fenster auswählen"/>
                                        <Button Content="Reset" Grid.Column="1" Style="{StaticResource ActionBtn}" Padding="8,3" Margin="6,0,0,0" Click="PoseReset_Click" ToolTip="Standard-Pose wiederherstellen"/>
                                    </Grid>

                                    <Button x:Name="SaveRiggedGlbBtn" Content="💾 Geriggtes .glb speichern" Style="{StaticResource ActionBtn}" Click="SaveRiggedGlb_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 6. Animationen (nur sichtbar wenn im Modell vorhanden) -->
                        <StackPanel x:Name="AnimationsSection" Visibility="Collapsed" Margin="0,0,0,12">
                            <TextBlock Text="ANIMATION" FontSize="11" FontWeight="Bold" Foreground="#C5A059" Margin="0,0,0,6"/>
                            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="AnimationCombo" Grid.Column="0" Height="25" FontSize="11.5" SelectionChanged="AnimationCombo_SelectionChanged"/>
                                    <Button x:Name="AnimPlayPauseBtn" Grid.Column="1" Content="⏸" Style="{StaticResource ActionBtn}" Width="32" Padding="0" Margin="6,0,0,0" Click="AnimPlayPause_Click"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- 6. Bauteile / Meshes -->
                        <TextBlock Text="BAUTEILE" FontSize="11" FontWeight="Bold" Foreground="#C5A059" Margin="0,0,0,6"/>
                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="6" Padding="6,6">
                            <StackPanel x:Name="MeshesListPanel">
                                <TextBlock Text="Noch kein Modell geladen" FontSize="11.5" Foreground="{DynamicResource MutedTextBrush}" Margin="4,2"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- BOTTOM STATUS BAR -->
        <Border Grid.Row="2"
                Background="{DynamicResource TopBarBgBrush}"
                BorderBrush="{DynamicResource BorderBrushColor}"
                BorderThickness="0,1,0,0"
                Padding="12,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0" Text="Bereit · .glb, .gltf, .stl, .obj, .3mf, .ply, .fbx" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="UnitHintText" Grid.Column="1" Text="Offline PBR Engine" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
