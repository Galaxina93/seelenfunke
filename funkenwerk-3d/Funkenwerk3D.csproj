<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Funkenwerk3D</AssemblyName>
    <RootNamespace>Funkenwerk3D</RootNamespace>
    <ApplicationTitle>Funkenwerk 3D</ApplicationTitle>
    <Product>Funkenwerk 3D</Product>
    <Company>Mein-Seelenfunke</Company>
    <Version>1.4.2</Version>
    <AssemblyVersion>1.4.2.14</AssemblyVersion>
    <FileVersion>1.4.2.14</FileVersion>
    <InformationalVersion>1.4.2+b14</InformationalVersion>
    <ApplicationIcon>funkenwerk_3d.ico</ApplicationIcon>
    <NoWarn>NU1701;CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\funkenwerk\FunkenwerkVersioning.cs" Link="Shared\FunkenwerkVersioning.cs" />
    <Resource Include="funkenwerk_3d.ico" />
    <Resource Include="funkenwerk_3d.png" />
    <None Include="funkenwerk_3d.ico" CopyToOutputDirectory="PreserveNewest" />
    <None Include="funkenwerk_3d.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

</Project>
