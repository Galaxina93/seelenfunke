<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>FunkenwerkTresor</AssemblyName>
    <RootNamespace>FunkenwerkTresor</RootNamespace>
    <ApplicationTitle>Funkenwerk Tresor</ApplicationTitle>
    <Product>Funkenwerk Tresor</Product>
    <Company>Mein-Seelenfunke</Company>
    <Version>1.0.0</Version>
    <ApplicationIcon>funkenwerk_tresor.ico</ApplicationIcon>
    <NoWarn>NU1701;CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="funkenwerk_tresor.ico" />
    <Resource Include="funkenwerk_tresor.png" />
    <None Include="funkenwerk_tresor.ico" CopyToOutputDirectory="PreserveNewest" />
    <None Include="funkenwerk_tresor.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
