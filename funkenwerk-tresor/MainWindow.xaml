<Window x:Class="FunkenwerkTresor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tresor"
        Width="1180" Height="780"
        MinWidth="820" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseMove="Window_UserActivity"
        PreviewMouseDown="Window_UserActivity"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- Klassischer KeePass Light-Mode (Standard wie auf Alinas Screenshot) -->
        <SolidColorBrush x:Key="AppBgBrush" Color="#F0F0F0"/>
        <SolidColorBrush x:Key="MenuBgBrush" Color="#F8F8F8"/>
        <SolidColorBrush x:Key="ToolbarBgBrush" Color="#F3F3F3"/>
        <SolidColorBrush x:Key="PaneBgBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="HeaderBgBrush" Color="#F7F7F7"/>
        <SolidColorBrush x:Key="BorderBrushColor" Color="#D0D0D0"/>
        <SolidColorBrush x:Key="GridLineBrush" Color="#E5E5E5"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#111111"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#555555"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#777777"/>
        <SolidColorBrush x:Key="GoldBrush" Color="#C5A059"/>
        <SolidColorBrush x:Key="SelectionBgBrush" Color="#DCEBFC"/>
        <SolidColorBrush x:Key="SelectionBorderBrush" Color="#7DA2CE"/>
        <SolidColorBrush x:Key="HoverBgBrush" Color="#EEF5FD"/>
        <SolidColorBrush x:Key="ModalCardBgBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="InputBgBrush" Color="#FFFFFF"/>

        <!-- Kompakte Toolbar-Buttons wie in KeePass -->
        <Style x:Key="ToolbarIconBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SelectionBgBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource SelectionBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primärer Gold-Button für Dialoge -->
        <Style x:Key="GoldBtn" TargetType="Button">
            <Setter Property="Background" Value="#C5A059"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="BorderBrush" Value="#A8843E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#D4B26E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sekundärer Dialog-Button -->
        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource HeaderBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SelectionBgBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource SelectionBorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Kompakter TreeView Expander Pfeil (⌄ / › wie im KeePass-Screenshot) -->
        <Style x:Key="TreeExpanderToggleStyle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Width="16" Height="16">
                            <Path x:Name="ExpandPath"
                                  Stroke="{DynamicResource TextSecondaryBrush}"
                                  StrokeThickness="1.3"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M 5,4 L 9,8 L 5,12"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ExpandPath" Property="Data" Value="M 3,6 L 7,10 L 11,6"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ExpandPath" Property="Stroke" Value="#0284C7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Kompaktes TreeViewItem (Klein & fein mit Icons und exakter Auswahl-Umrandung wie im Screenshot) -->
        <Style TargetType="TreeViewItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="3,1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition MinWidth="16" Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <!-- Durchgehende Drop-Zone über die gesamte Zeilenbreite -->
                            <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Background="Transparent"/>

                            <ToggleButton x:Name="Expander"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                          Style="{StaticResource TreeExpanderToggleStyle}"/>

                            <Border x:Name="Bd"
                                    Grid.Column="1"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="2"
                                    Padding="{TemplateBinding Padding}"
                                    Margin="0,0.5"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter x:Name="PART_Header"
                                                  ContentSource="Header"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>

                            <ItemsPresenter x:Name="ItemsHost"
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Grid.ColumnSpan="2"
                                            Margin="2,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBgBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource SelectionBorderBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBgBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox & PasswordBox Styles für Modals -->
        <Style x:Key="TresorTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>

        <Style x:Key="TresorPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Schlanke Menüleiste (nur sichtbar nach Passworteingabe) -->
            <RowDefinition Height="Auto"/> <!-- 1: Kompakte Icon-Toolbar (nur sichtbar nach Passworteingabe) -->
            <RowDefinition Height="Auto"/> <!-- 2: 12s Zwischenablage-Schutz Banner (nur beim Kopieren sichtbar) -->
            <RowDefinition Height="*"/>    <!-- 3: Hauptbereich (Gatekeeper vor Entsperrung, danach Strukturbaum + Tabelle) -->
            <RowDefinition Height="Auto"/> <!-- 4: Statusleiste unten (nur sichtbar nach Passworteingabe) -->
        </Grid.RowDefinitions>

        <!-- ================================================================== -->
        <!-- ROW 0: MENÜLEISTE (ERST NACH PASSWORTEINGABE SICHTBAR)             -->
        <!-- ================================================================== -->
        <Border x:Name="MainMenuBorder" Grid.Row="0" Height="24" Visibility="Collapsed" Background="{DynamicResource MenuBgBrush}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="0,0,0,1">
            <Menu Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center" Padding="4,0">
                <MenuItem Header="_Datei">
                    <MenuItem Header="Neue Datenbank (.kdbx)..." Click="NewDatabaseMenu_Click"/>
                    <MenuItem Header="Datenbank öffnen (.kdbx)..." Click="OpenDatabaseMenu_Click"/>
                    <MenuItem Header="Alte .kdbx importieren / zusammenführen..." Click="OpenImportModal_Click"/>
                    <Separator/>
                    <MenuItem Header="Speichern (Strg+S)" Click="SaveDatabase_Click"/>
                    <MenuItem Header="Tresor sperren (Strg+L)" Click="LockVault_Click"/>
                    <Separator/>
                    <MenuItem Header="Beenden" Click="ExitApp_Click"/>
                </MenuItem>
                <MenuItem Header="_Gruppe">
                    <MenuItem Header="Untergruppe hinzufügen..." Click="AddGroup_Click"/>
                    <MenuItem Header="Gruppe bearbeiten (Name &amp; Icon)..." Click="EditGroup_Click"/>
                    <Separator/>
                    <MenuItem Header="Gruppe nach oben" Click="MoveGroupUp_Click"/>
                    <MenuItem Header="Gruppe nach unten" Click="MoveGroupDown_Click"/>
                    <Separator/>
                    <MenuItem Header="Gruppe löschen" Click="DeleteGroup_Click"/>
                </MenuItem>
                <MenuItem Header="_Eintrag">
                    <MenuItem Header="Neuer Eintrag (Strg+I)..." Click="NewEntry_Click"/>
                    <MenuItem Header="Eintrag bearbeiten (Enter)..." Click="EditSelectedEntry_Click"/>
                    <MenuItem Header="Eintrag duplizieren" Click="DuplicateEntry_Click"/>
                    <MenuItem Header="Eintrag löschen (Entf)" Click="DeleteEntry_Click"/>
                    <Separator/>
                    <MenuItem Header="Benutzername kopieren (Strg+B)" Click="CopyUser_Click"/>
                    <MenuItem Header="Passwort kopieren (Strg+C)" Click="CopyPass_Click"/>
                    <MenuItem Header="2FA / TOTP-Code kopieren" Click="CopyTotp_Click"/>
                    <MenuItem Header="URL öffnen (Strg+U)" Click="OpenUrl_Click"/>
                    <MenuItem Header="Auto-Fill in letztes Fenster (Strg+V)" Click="AutoType_Click"/>
                </MenuItem>
                <MenuItem Header="_Suchen">
                    <MenuItem Header="Suchfeld fokussieren (Strg+F)" Click="FocusSearch_Click"/>
                    <MenuItem Header="Alle Einträge der Datenbank anzeigen" Click="ShowAllEntries_Click"/>
                </MenuItem>
                <MenuItem Header="_Ansicht">
                    <MenuItem Header="Passwörter in Tabelle ein-/ausblenden (👁)" Click="ToggleTablePasswords_Click"/>
                    <Separator/>
                    <MenuItem Header="Alle Gruppen ausklappen" Click="ExpandAllGroups_Click"/>
                    <MenuItem Header="Alle Gruppen einklappen" Click="CollapseAllGroups_Click"/>
                    <Separator/>
                    <MenuItem Header="Design wechseln (Hell / Dunkel)" Click="ToggleTheme_Click"/>
                </MenuItem>
                <MenuItem Header="_Extras">
                    <MenuItem Header="Passwort-Generator..." Click="OpenGeneratorModal_Click"/>
                    <MenuItem Header="Sicherheits-Audit (Schwache &amp; Doppelte Passwörter)..." Click="OpenAuditModal_Click"/>
                    <MenuItem Header="Datenbank auf Argon2id (KDBX 4) härten" Click="UpgradeToArgon2id_Click"/>
                    <Separator/>
                    <MenuItem x:Name="MenuScreenShield" Header="Screenshot-Schutz aktiv" IsCheckable="True" IsChecked="True" Click="MenuScreenShield_Click"/>
                    <MenuItem x:Name="MenuLockOnWinLock" Header="Bei Windows-Sperre (Win+L) automatisch sperren" IsCheckable="True" IsChecked="True" Click="MenuLockOnWinLock_Click"/>
                </MenuItem>
            </Menu>
        </Border>

        <!-- ================================================================== -->
        <!-- ROW 1: KOMPAKTE ICON-TOOLBAR (ERST NACH PASSWORTEINGABE SICHTBAR)  -->
        <!-- ================================================================== -->
        <Border x:Name="MainToolbarBorder" Grid.Row="1" MinHeight="30" Visibility="Collapsed" Background="{DynamicResource ToolbarBgBrush}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="0,0,0,1" Padding="4,2">
            <DockPanel LastChildFill="False">
                <!-- Datei-Aktionen -->
                <Button DockPanel.Dock="Left" Style="{StaticResource ToolbarIconBtn}" Click="NewDatabaseMenu_Click" ToolTip="Neue .kdbx Datenbank anlegen">
                    <Image Width="16" Height="16" x:Name="TbIconNew"/>
                </Button>
                <Button DockPanel.Dock="Left" Style="{StaticResource ToolbarIconBtn}" Click="OpenDatabaseMenu_Click" ToolTip=".kdbx Datenbank öffnen">
                    <Image Width="16" Height="16" x:Name="TbIconOpen"/>
                </Button>
                <Button x:Name="TbBtnSave" DockPanel.Dock="Left" Style="{StaticResource ToolbarIconBtn}" Click="SaveDatabase_Click" ToolTip="Datenbank speichern (Strg+S)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TbSaveIconText" Text="💾" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock x:Name="DirtyStarText" Text=" *" Foreground="#D97706" FontWeight="Bold" Visibility="Collapsed"/>
                        <TextBlock x:Name="TbSaveFeedbackText" Text=" ✓ Gespeichert" Foreground="#15803D" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" Visibility="Collapsed" Margin="3,0,2,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="TbBtnImport" DockPanel.Dock="Left" Style="{StaticResource ToolbarIconBtn}" Click="OpenImportModal_Click" ToolTip="Einträge aus einer anderen .kdbx importieren / zusammenführen">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📥" FontSize="12" Margin="0,0,3,0"/>
                        <TextBlock Text="Import" FontSize="11.5" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Rectangle DockPanel.Dock="Left" Width="1" Fill="{DynamicResource BorderBrushColor}" Margin="4,3"/>

                <!-- Eintrags- & Gruppen-Aktionen -->
                <Button x:Name="TbBtnAddEntry" DockPanel.Dock="Left" Style="{StaticResource ToolbarIconBtn}" Click="NewEntry_Click" ToolTip="Neuer Eintrag in ausgewählter Gruppe (Strg+I)">
                    <StackPanel Orientation="Horizontal">
                        <Image Width="15" Height="15" x:Name="TbIconAddEntry" Margin="0,0,4,0"/>
                        <TextBlock Text="Neuer Eintrag" FontSize="11.5" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="TbBtnAddGroup" DockPanel.Dock="Left" Style="{StaticResource ToolbarIconBtn}" Click="AddGroup_Click" ToolTip="Neue Untergruppe im Strukturbaum anlegen">
                    <StackPanel Orientation="Horizontal">
                        <Image Width="15" Height="15" x:Name="TbIconAddGroup" Margin="0,0,4,0"/>
                        <TextBlock Text="Neue Gruppe" FontSize="11.5" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Rectangle DockPanel.Dock="Left" Width="1" Fill="{DynamicResource BorderBrushColor}" Margin="4,3"/>

                <!-- Kopieren / URL / Auto-Fill / Generator / Sperren -->
                <Button x:Name="TbBtnCopyUser" DockPanel.Dock="Left" Style="{StaticResource ToolbarIconBtn}" Click="CopyUser_Click" ToolTip="Benutzername kopieren (Strg+B)">
                    <TextBlock Text="👤 Benutzer" FontSize="11.5"/>
                </Button>
                <Button x:Name="TbBtnCopyPass" DockPanel.Dock="Left" Style="{StaticResource ToolbarIconBtn}" Click="CopyPass_Click" ToolTip="Passwort kopieren (Strg+C)">
                    <TextBlock Text="🔑 Passwort" FontSize="11.5"/>
                </Button>
                <Button x:Name="TbBtnOpenUrl" DockPanel.Dock="Left" Style="{StaticResource ToolbarIconBtn}" Click="OpenUrl_Click" ToolTip="URL öffnen (Strg+U)">
                    <TextBlock Text="🌐 URL" FontSize="11.5"/>
                </Button>
                <Button x:Name="TbBtnAutoType" DockPanel.Dock="Left" Style="{StaticResource ToolbarIconBtn}" Click="AutoType_Click" ToolTip="Auto-Fill in letztes Fenster tippen (Strg+V)">
                    <TextBlock Text="⌨ Auto-Fill" FontSize="11.5"/>
                </Button>
                <Button x:Name="TbBtnRevealTablePass" DockPanel.Dock="Left" Style="{StaticResource ToolbarIconBtn}" Click="ToggleTablePasswords_Click" ToolTip="Passwörter in der Tabelle ein-/ausblenden">
                    <TextBlock x:Name="TbRevealPassText" Text="👁" FontSize="12"/>
                </Button>
                <Button DockPanel.Dock="Left" Style="{StaticResource ToolbarIconBtn}" Click="OpenGeneratorModal_Click" ToolTip="Passwort-Generator öffnen">
                    <TextBlock Text="🎲" FontSize="12"/>
                </Button>
                <Button x:Name="TbBtnLock" DockPanel.Dock="Left" Style="{StaticResource ToolbarIconBtn}" Click="LockVault_Click" ToolTip="Tresor sperren (Strg+L)">
                    <TextBlock Text="🔒" FontSize="12"/>
                </Button>

                <Rectangle DockPanel.Dock="Left" Width="1" Fill="{DynamicResource BorderBrushColor}" Margin="4,3"/>

                <!-- Suchfeld ("Search..." wie auf dem Screenshot direkt neben dem Schloss) -->
                <Border DockPanel.Dock="Left" Width="210" Height="22" Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="2" Margin="2,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox"
                                 Background="Transparent"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 CaretBrush="{DynamicResource TextPrimaryBrush}"
                                 BorderThickness="0"
                                 Padding="5,2"
                                 FontSize="12"
                                 VerticalContentAlignment="Center"
                                 TextChanged="SearchBox_TextChanged"/>
                        <TextBlock x:Name="SearchPlaceholder"
                                   Text="Search..."
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="12"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                        <Button x:Name="ClearSearchBtn"
                                Grid.Column="1"
                                Content="✕"
                                Visibility="Collapsed"
                                Style="{StaticResource ToolbarIconBtn}"
                                Width="20" Height="20" Padding="0"
                                Click="ClearSearch_Click"
                                ToolTip="Suche leeren"/>
                    </Grid>
                </Border>

                <!-- Rechts: Optionaler Auto-Sperre Schalter (Standardmäßig AUS -> bleibt geöffnet!) & Theme -->
                <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarIconBtn}" Click="ToggleTheme_Click" ToolTip="Design wechseln (Hell / Dunkel)">
                    <TextBlock x:Name="ThemeBtnIcon" Text="🌙" FontSize="12"/>
                </Button>

                <Button x:Name="UpgradeArgonBtn"
                        DockPanel.Dock="Right"
                        Visibility="Collapsed"
                        Style="{StaticResource ToolbarIconBtn}"
                        Click="UpgradeToArgon2id_Click"
                        ToolTip="Datenbank mit 1 Klick auf KDBX 4 Argon2id härten"
                        Margin="4,0">
                    <TextBlock Text="⚡ Argon2id Härten" Foreground="#B45309" FontWeight="SemiBold" FontSize="11.5"/>
                </Button>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                    <CheckBox x:Name="AutoLockCheckBox"
                              Content="Auto-Sperre"
                              Foreground="{DynamicResource TextSecondaryBrush}"
                              FontSize="11.5"
                              VerticalAlignment="Center"
                              Margin="0,0,5,0"
                              Checked="AutoLockCheckBox_Changed"
                              Unchecked="AutoLockCheckBox_Changed"
                              ToolTip="Optional: Wenn deaktiviert, bleibt der Tresor dauerhaft geöffnet."/>
                    <ComboBox x:Name="AutoLockCombo"
                              Width="68" Height="21"
                              FontSize="11"
                              VerticalContentAlignment="Center"
                              SelectionChanged="AutoLockCombo_SelectionChanged"
                              ToolTip="Inaktivitäts-Zeit bis zur automatischen Sperre">
                        <ComboBoxItem Content="2 Min." Tag="2"/>
                        <ComboBoxItem Content="5 Min." Tag="5" IsSelected="True"/>
                        <ComboBoxItem Content="10 Min." Tag="10"/>
                        <ComboBoxItem Content="30 Min." Tag="30"/>
                    </ComboBox>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================================================================== -->
        <!-- ROW 2: 12S CLIPBOARD AUTO-CLEAR BANNER                             -->
        <!-- ================================================================== -->
        <Border x:Name="ClipboardGuardBar"
                Grid.Row="2"
                Visibility="Collapsed"
                Background="#FEF3C7"
                BorderBrush="#F59E0B"
                BorderThickness="0,0,0,1"
                Padding="10,3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ClipboardGuardLabel"
                           Text="🛡 Zwischenablage wird in 12s automatisch geleert"
                           Foreground="#92400E"
                           FontSize="11.5"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                <ProgressBar x:Name="ClipboardGuardProgress"
                             Grid.Column="1"
                             Height="5"
                             Minimum="0" Maximum="100" Value="100"
                             Foreground="#D97706"
                             Background="#FDE68A"
                             BorderThickness="0"
                             VerticalAlignment="Center"
                             Margin="0,0,12,0"/>
                <Button Grid.Column="2"
                        Content="Sofort leeren"
                        Style="{StaticResource ToolbarIconBtn}"
                        Height="20" Padding="6,0"
                        Click="ClearClipboardNow_Click"/>
            </Grid>
        </Border>

        <!-- ================================================================== -->
        <!-- ROW 3: HAUPTBEREICH (VOR ENTSPERRUNG NUR PASSWORTEINGABE SICHTBAR) -->
        <!-- ================================================================== -->
        <Grid Grid.Row="3">
            <!-- ==================== WORKSPACE: MULTI-DB TABS + STRUKTURBAUM + TABELLE + UNTERES DETAILFELD ==================== -->
            <Grid x:Name="VaultWorkspaceGrid" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>              <!-- 0: Multi-DB Tab-Leiste (gleichzeitig geöffnete Datenbanken) -->
                    <RowDefinition Height="*" MinHeight="180"/> <!-- 1: Strukturbaum links + Tabelle rechts -->
                    <RowDefinition Height="7"/>                 <!-- 2: Ziehbare Trennleiste (Splitter) mit Maus-Griff -->
                    <RowDefinition Height="185" MinHeight="75"/><!-- 3: Detail- & Notizenbereich unten (größer + per Maus regelbar) -->
                </Grid.RowDefinitions>

                <!-- MULTI-DATENBANK TAB-LEISTE (Mehrere .kdbx gleichzeitig geöffnet halten & wechseln) -->
                <Border x:Name="OpenDatabasesTabBorder"
                        Grid.Row="0"
                        Margin="2,2,2,0"
                        Background="{DynamicResource HeaderBgBrush}"
                        BorderBrush="{DynamicResource BorderBrushColor}"
                        BorderThickness="1"
                        Padding="4,2">
                    <DockPanel LastChildFill="False">
                        <WrapPanel x:Name="OpenDatabasesTabsPanel" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Left"
                                Style="{StaticResource ToolbarIconBtn}"
                                Padding="8,2"
                                Margin="2,0,0,0"
                                Click="OpenDatabaseMenu_Click"
                                ToolTip="Weitere .kdbx Datenbank parallel öffnen">
                            <TextBlock Text="+ Weitere DB öffnen" FontSize="11.5" FontWeight="SemiBold" Foreground="#B45309"/>
                        </Button>
                    </DockPanel>
                </Border>

                <!-- OBERER BEREICH: LINKS STRUKTURBAUM | RECHTS 5-SPALTEN-TABELLE -->
                <Grid Grid.Row="1" Margin="2,2,2,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="310" MinWidth="180"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*" MinWidth="360"/>
                    </Grid.ColumnDefinitions>

                    <!-- LINKS: DER STRUKTURBAUM (KLEIN & FEIN MIT ICONS WIE IM SCREENSHOT) -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource PaneBgBrush}"
                            BorderBrush="{DynamicResource BorderBrushColor}"
                            BorderThickness="1">
                        <TreeView x:Name="GroupTreeView"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Padding="3,4"
                                  AllowDrop="True"
                                  SelectedItemChanged="GroupTreeView_SelectedItemChanged"
                                  MouseDoubleClick="GroupTreeView_MouseDoubleClick"
                                  PreviewMouseLeftButtonDown="GroupTreeView_PreviewMouseLeftButtonDown"
                                  PreviewMouseMove="GroupTreeView_PreviewMouseMove"
                                  DragOver="GroupTreeView_DragOver"
                                  DragLeave="GroupTreeView_DragLeave"
                                  Drop="GroupTreeView_Drop">
                            <TreeView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Untergruppe hinzufügen..." Click="AddGroup_Click"/>
                                    <MenuItem Header="Gruppe bearbeiten (Name &amp; Icon)..." Click="EditGroup_Click"/>
                                    <Separator/>
                                    <MenuItem Header="Neuer Eintrag in dieser Gruppe..." Click="NewEntry_Click"/>
                                    <Separator/>
                                    <MenuItem Header="Nach oben verschieben" Click="MoveGroupUp_Click"/>
                                    <MenuItem Header="Nach unten verschieben" Click="MoveGroupDown_Click"/>
                                    <Separator/>
                                    <MenuItem Header="Gruppe löschen" Click="DeleteGroup_Click"/>
                                </ContextMenu>
                            </TreeView.ContextMenu>
                        </TreeView>
                    </Border>

                    <!-- VERTIKALER SPLITTER (Mit Maus ziehbar zur Breitenanpassung) -->
                    <GridSplitter Grid.Column="1"
                                  Width="6"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  ResizeDirection="Columns"
                                  ResizeBehavior="PreviousAndNext"
                                  Background="Transparent"
                                  Cursor="SizeWE"
                                  ToolTip="Mit der Maus ziehen, um die Breite der Ordnerstruktur anzupassen"/>

                    <!-- RECHTS: KLASSISCHE 5-SPALTEN-TABELLE (Title | User Name | Password | URL | Notes) -->
                    <Border Grid.Column="2"
                            Background="{DynamicResource PaneBgBrush}"
                            BorderBrush="{DynamicResource BorderBrushColor}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24"/> <!-- Spaltenköpfe -->
                                <RowDefinition Height="*"/>  <!-- Eintragszeilen + Vertikale Spaltenlinien -->
                            </Grid.RowDefinitions>

                            <!-- SPALTENKÖPFE (Title | User Name | Password | URL | Notes) -->
                            <Border Grid.Row="0"
                                    Background="{DynamicResource HeaderBgBrush}"
                                    BorderBrush="{DynamicResource BorderBrushColor}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="165"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" BorderBrush="{DynamicResource GridLineBrush}" BorderThickness="0,0,1,0" Padding="6,0" Cursor="Hand" MouseLeftButtonDown="SortByTitle_Click">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Text="Title" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock x:Name="SortArrowText" Text="⌃" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,1,0,0"/>
                                        </DockPanel>
                                    </Border>
                                    <Border Grid.Column="1" BorderBrush="{DynamicResource GridLineBrush}" BorderThickness="0,0,1,0" Padding="6,0" Cursor="Hand" MouseLeftButtonDown="SortByUser_Click">
                                        <TextBlock Text="User Name" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </Border>
                                    <Border Grid.Column="2" BorderBrush="{DynamicResource GridLineBrush}" BorderThickness="0,0,1,0" Padding="6,0">
                                        <TextBlock Text="Password" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </Border>
                                    <Border Grid.Column="3" BorderBrush="{DynamicResource GridLineBrush}" BorderThickness="0,0,1,0" Padding="6,0" Cursor="Hand" MouseLeftButtonDown="SortByUrl_Click">
                                        <TextBlock Text="URL" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </Border>
                                    <Border Grid.Column="4" Padding="6,0">
                                        <TextBlock Text="Notes" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- HINTERGRUND-SPALTENLINIEN (damit die vertikalen Linien wie im Screenshot durchgehend sind) -->
                            <Grid Grid.Row="1" IsHitTestVisible="False">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="165"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" BorderBrush="{DynamicResource GridLineBrush}" BorderThickness="0,0,1,0"/>
                                <Border Grid.Column="1" BorderBrush="{DynamicResource GridLineBrush}" BorderThickness="0,0,1,0"/>
                                <Border Grid.Column="2" BorderBrush="{DynamicResource GridLineBrush}" BorderThickness="0,0,1,0"/>
                                <Border Grid.Column="3" BorderBrush="{DynamicResource GridLineBrush}" BorderThickness="0,0,1,0"/>
                            </Grid>

                            <!-- EINTRAGS-LISTE (INKL. DRAG & DROP IN ORDNER) -->
                            <ListBox x:Name="EntriesListBox"
                                     Grid.Row="1"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     SelectionMode="Extended"
                                     AllowDrop="True"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     SelectionChanged="EntriesListBox_SelectionChanged"
                                     MouseDoubleClick="EntriesListBox_MouseDoubleClick"
                                     PreviewMouseLeftButtonDown="EntriesListBox_PreviewMouseLeftButtonDown"
                                     PreviewMouseMove="EntriesListBox_PreviewMouseMove"
                                     DragOver="EntriesListBox_DragOver"
                                     Drop="EntriesListBox_Drop">
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Passwort kopieren (Strg+C)" FontWeight="SemiBold" Click="CopyPass_Click"/>
                                        <MenuItem Header="Benutzername kopieren (Strg+B)" Click="CopyUser_Click"/>
                                        <MenuItem Header="2FA / TOTP-Code kopieren" Click="CopyTotp_Click"/>
                                        <MenuItem Header="URL öffnen (Strg+U)" Click="OpenUrl_Click"/>
                                        <MenuItem Header="Auto-Fill in letztes Fenster (Strg+V)" Click="AutoType_Click"/>
                                        <Separator/>
                                        <MenuItem Header="Neuer Eintrag (Strg+I)..." Click="NewEntry_Click"/>
                                        <MenuItem Header="Eintrag bearbeiten (Enter)..." Click="EditSelectedEntry_Click"/>
                                        <MenuItem Header="Eintrag duplizieren" Click="DuplicateEntry_Click"/>
                                        <MenuItem Header="Eintrag löschen (Entf)" Click="DeleteEntry_Click"/>
                                    </ContextMenu>
                                </ListBox.ContextMenu>

                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="RowBd"
                                                            Background="Transparent"
                                                            BorderBrush="{DynamicResource GridLineBrush}"
                                                            BorderThickness="0,0,0,1"
                                                            Height="22">
                                                        <ContentPresenter VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="RowBd" Property="Background" Value="{DynamicResource SelectionBgBrush}"/>
                                                            <Setter TargetName="RowBd" Property="BorderBrush" Value="{DynamicResource SelectionBorderBrush}"/>
                                                        </Trigger>
                                                        <MultiTrigger>
                                                            <MultiTrigger.Conditions>
                                                                <Condition Property="IsMouseOver" Value="True"/>
                                                                <Condition Property="IsSelected" Value="False"/>
                                                            </MultiTrigger.Conditions>
                                                            <Setter TargetName="RowBd" Property="Background" Value="{DynamicResource HoverBgBrush}"/>
                                                        </MultiTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>

                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220"/>
                                                <ColumnDefinition Width="165"/>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="190"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Col 0: Icon + Title -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="5,0" VerticalAlignment="Center">
                                                <Image Width="16" Height="16" Source="{Binding IconImage}" Margin="0,0,5,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <TextBlock Text="{Binding Title}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Col 1: User Name -->
                                            <TextBlock Grid.Column="1" Text="{Binding UserName}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="6,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                                            <!-- Col 2: Password -->
                                            <TextBlock Grid.Column="2" Text="{Binding PasswordDisplay}" FontSize="12" FontFamily="Consolas" Foreground="{DynamicResource TextPrimaryBrush}" Margin="6,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                                            <!-- Col 3: URL -->
                                            <TextBlock Grid.Column="3" Text="{Binding Url}" FontSize="12" Foreground="#0284C7" Margin="6,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                                            <!-- Col 4: Notes -->
                                            <TextBlock Grid.Column="4" Text="{Binding NotesSingleLine}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="6,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- EMPTY PLACEHOLDER ("Empty." kursiv in der Mitte wie im Screenshot) -->
                            <TextBlock x:Name="EmptyTableText"
                                       Grid.Row="1"
                                       Text="Empty."
                                       FontStyle="Italic"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="Visible"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- HORIZONTALER SPLITTER ZWISCHEN TABELLE UND UNTEREM DETAIL-/NOTIZENFELD -->
                <Grid Grid.Row="2">
                    <Border Background="{DynamicResource HeaderBgBrush}"
                            CornerRadius="2"
                            Margin="2,1"
                            IsHitTestVisible="False">
                        <Border Width="38"
                                Height="3"
                                CornerRadius="1.5"
                                Background="#C5A059"
                                Opacity="0.65"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                    </Border>
                    <GridSplitter Height="7"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  ResizeDirection="Rows"
                                  ResizeBehavior="PreviousAndNext"
                                  Background="Transparent"
                                  Cursor="SizeNS"
                                  ToolTip="Am Rand mit der Maus ziehen, um die Höhe des unteren Notizen- &amp; Detailbereichs anzupassen"/>
                </Grid>

                <!-- UNTERES DETAILFELD ("Group: Emails." bzw. Eintrags-Vorschau & Notizen) -->
                <Border Grid.Row="3"
                        Margin="2,0,2,2"
                        Background="{DynamicResource AppBgBrush}"
                        BorderBrush="{DynamicResource BorderBrushColor}"
                        BorderThickness="1"
                        Padding="6,5">
                    <Grid>
                        <!-- Wenn kein Eintrag ausgewählt ist: "Group: Emails." exakt wie im Screenshot -->
                        <StackPanel x:Name="BottomGroupSummaryPane" Orientation="Horizontal" VerticalAlignment="Top">
                            <TextBlock Text="Group: " FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="BottomGroupNameText" Text="Emails." FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <!-- Wenn ein Eintrag ausgewählt ist: Kompakte Detailansicht + großes Notizenfeld unten + Schnellaktionen -->
                        <Grid x:Name="BottomEntryDetailPane" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                                    <Image x:Name="BottomEntryIcon" Width="16" Height="16" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="BottomEntryTitle" Text="Titel" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock x:Name="BottomEntryGroupPath" Text=" (Gruppe)" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <WrapPanel Grid.Row="1" Margin="0,0,0,4">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,18,2">
                                        <TextBlock Text="User Name: " FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock x:Name="BottomEntryUser" Text="-" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,18,2">
                                        <TextBlock Text="Password: " FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock x:Name="BottomEntryPassword" Text="••••••••" FontSize="11.5" FontFamily="Consolas" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,18,2">
                                        <TextBlock Text="URL: " FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock x:Name="BottomEntryUrl" Text="-" FontSize="11.5" Foreground="#0284C7" Cursor="Hand" MouseLeftButtonDown="BottomEntryUrl_Click"/>
                                    </StackPanel>
                                    <StackPanel x:Name="BottomTotpWrap" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,18,2">
                                        <TextBlock Text="2FA / TOTP: " FontWeight="SemiBold" FontSize="11.5" Foreground="#B45309"/>
                                        <TextBlock x:Name="BottomTotpCode" Text="000 000" FontWeight="Bold" FontSize="12" FontFamily="Consolas" Foreground="#B45309"/>
                                        <TextBlock x:Name="BottomTotpCountdown" Text=" (30s)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </WrapPanel>

                                <Border Grid.Row="2"
                                        Background="{DynamicResource PaneBgBrush}"
                                        BorderBrush="{DynamicResource BorderBrushColor}"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        Padding="4,2">
                                    <TextBox x:Name="BottomEntryNotes"
                                             Text=""
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             FontSize="12"
                                             Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </Border>
                            </Grid>

                            <!-- Schnellbuttons rechts im Detailfeld -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,0,0,0">
                                <Button Style="{StaticResource SecondaryBtn}" Padding="8,3" Margin="0,0,4,0" Click="CopyUser_Click" ToolTip="Benutzername kopieren (Strg+B)">
                                    <TextBlock Text="👤 Benutzer"/>
                                </Button>
                                <Button Style="{StaticResource GoldBtn}" Padding="10,3" Margin="0,0,4,0" Click="CopyPass_Click" ToolTip="Passwort kopieren (Strg+C)">
                                    <TextBlock Text="📋 Passwort kopieren"/>
                                </Button>
                                <Button x:Name="BottomCopyTotpBtn" Visibility="Collapsed" Style="{StaticResource SecondaryBtn}" Padding="8,3" Margin="0,0,4,0" Click="CopyTotp_Click" ToolTip="6-stelligen 2FA-Code kopieren">
                                    <TextBlock Text="🕒 2FA kopieren"/>
                                </Button>
                                <Button Style="{StaticResource SecondaryBtn}" Padding="8,3" Margin="0,0,4,0" Click="EditSelectedEntry_Click" ToolTip="Eintrag bearbeiten (Doppelklick / Enter)">
                                    <TextBlock Text="✏ Bearbeiten"/>
                                </Button>
                                <Button Style="{StaticResource SecondaryBtn}" Padding="8,3" Click="DeleteEntry_Click" ToolTip="Eintrag löschen (Entf)">
                                    <TextBlock Text="🗑"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- VISUELLES SPEICHER-FEEDBACK TOAST BEIM KLICK AUF SPEICHERN / STRG+S -->
                <Border x:Name="SaveFeedbackToast"
                        Grid.Row="1"
                        Visibility="Collapsed"
                        IsHitTestVisible="False"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,10,14,0"
                        Background="#15803D"
                        BorderBrush="#166534"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✓ " Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SaveFeedbackToastText" Text="Datenbank gespeichert" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============================================================== -->
            <!-- SPERR- / DATENBANK-ÖFFNEN OVERLAY (GATEKEEPER - VOLLFLÄCHIG)   -->
            <!-- ============================================================== -->
            <Border x:Name="GatekeeperOverlay"
                    Visibility="Visible"
                    Background="{DynamicResource AppBgBrush}">
                <Border Width="520"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource ModalCardBgBrush}"
                        BorderBrush="#C5A059"
                        BorderThickness="1.5"
                        CornerRadius="8"
                        Padding="24,20">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <Image x:Name="GatekeeperLogoImg" Width="28" Height="28" Margin="0,0,10,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Tresor" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="KeePass .kdbx kompatibel (KDBX 4 Argon2id &amp; KDBX 3.1)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                            <Button x:Name="GatekeeperCloseBtn"
                                    DockPanel.Dock="Right"
                                    Content="✕"
                                    Visibility="Collapsed"
                                    Style="{StaticResource ToolbarIconBtn}"
                                    Width="26" Height="26"
                                    Click="CloseGatekeeper_Click"
                                    ToolTip="Abbrechen und zur geöffneten Datenbank zurückkehren"/>
                        </DockPanel>

                        <UniformGrid Columns="2" Margin="0,0,0,14">
                            <Button x:Name="GateTabOpenBtn" Content="📂 Bestehende .kdbx öffnen" Style="{StaticResource GoldBtn}" Margin="0,0,4,0" Click="GateTabOpen_Click"/>
                            <Button x:Name="GateTabCreateBtn" Content="✨ Neuen Tresor anlegen" Style="{StaticResource SecondaryBtn}" Margin="4,0,0,0" Click="GateTabCreate_Click"/>
                        </UniformGrid>

                        <!-- TAB 1: BESTEHENDE .KDBX ÖFFNEN -->
                        <StackPanel x:Name="GateOpenPanel">
                            <TextBlock Text="DATENBANK-DATEI (.KDBX)" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="OpenDbPathBox" Style="{StaticResource TresorTextBox}"/>
                                <Button Grid.Column="1" Content="📂 Durchsuchen" Style="{StaticResource SecondaryBtn}" Margin="6,0,0,0" Click="BrowseOpenDb_Click"/>
                            </Grid>

                            <WrapPanel x:Name="RecentFilesPanel" Margin="0,0,0,10"/>

                            <TextBlock Text="MASTER-PASSWORT" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <PasswordBox x:Name="OpenMasterPassBox" Style="{StaticResource TresorPasswordBox}" KeyDown="OpenMasterPassBox_KeyDown"/>
                                <TextBox x:Name="OpenMasterPassTextBox" Style="{StaticResource TresorTextBox}" Visibility="Collapsed" KeyDown="OpenMasterPassBox_KeyDown"/>
                                <Button Grid.Column="1" Content="👁" Style="{StaticResource SecondaryBtn}" Width="34" Margin="6,0,0,0" Click="ToggleOpenMasterEye_Click" ToolTip="Passwort ein-/ausblenden"/>
                            </Grid>

                            <TextBlock Text="SCHLÜSSELDATEI (.KEYX / .KEY - OPTIONAL)" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="OpenKeyfilePathBox" Style="{StaticResource TresorTextBox}"/>
                                <Button Grid.Column="1" Content="🗝 Wählen" Style="{StaticResource SecondaryBtn}" Margin="6,0,0,0" Click="BrowseOpenKeyfile_Click"/>
                                <Button Grid.Column="2" Content="✕" Style="{StaticResource SecondaryBtn}" Width="28" Margin="4,0,0,0" Click="ClearOpenKeyfile_Click"/>
                            </Grid>

                            <Button Content="🔓 Tresor entsperren" Style="{StaticResource GoldBtn}" Height="36" Click="UnlockDatabase_Click"/>
                        </StackPanel>

                        <!-- TAB 2: NEUEN TRESOR ANLEGEN -->
                        <StackPanel x:Name="GateCreatePanel" Visibility="Collapsed">
                            <TextBlock Text="NAME DER DATENBANK" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="CreateDbNameBox" Text="DB" Style="{StaticResource TresorTextBox}" Margin="0,0,0,8" TextChanged="CreateDbNameBox_TextChanged"/>

                            <TextBlock Text="SPEICHERORT (.KDBX)" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="CreateDbPathBox" Style="{StaticResource TresorTextBox}"/>
                                <Button Grid.Column="1" Content="💾 Ziel..." Style="{StaticResource SecondaryBtn}" Margin="6,0,0,0" Click="BrowseCreateDb_Click"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="NEUES MASTER-PASSWORT" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <PasswordBox x:Name="CreateMasterPassBox" Style="{StaticResource TresorPasswordBox}" KeyDown="CreateMasterPassBox_KeyDown"/>
                                    <TextBox x:Name="CreateMasterPassTextBox" Style="{StaticResource TresorTextBox}" Visibility="Collapsed" KeyDown="CreateMasterPassBox_KeyDown"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="WIEDERHOLEN" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <PasswordBox x:Name="CreateMasterRepeatBox" Style="{StaticResource TresorPasswordBox}" KeyDown="CreateMasterPassBox_KeyDown"/>
                                    <TextBox x:Name="CreateMasterRepeatTextBox" Style="{StaticResource TresorTextBox}" Visibility="Collapsed" KeyDown="CreateMasterPassBox_KeyDown"/>
                                </StackPanel>
                                <Button Grid.Column="3" Content="👁" Style="{StaticResource SecondaryBtn}" Width="34" VerticalAlignment="Bottom" Margin="6,0,0,0" Click="ToggleCreateMasterEye_Click"/>
                            </Grid>

                            <TextBlock Text="OPTIONALE 2-FAKTOR SCHLÜSSELDATEI (.KEYX)" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="CreateKeyfilePathBox" Style="{StaticResource TresorTextBox}"/>
                                <Button Grid.Column="1" Content="✨ .keyx erzeugen" Style="{StaticResource SecondaryBtn}" Margin="6,0,0,0" Click="GenerateNewKeyfile_Click"/>
                            </Grid>

                            <Button Content="🛡 KDBX 4 Tresor (mit Strukturbaum) erstellen" Style="{StaticResource GoldBtn}" Height="36" Click="CreateDatabase_Click"/>
                        </StackPanel>

                        <Border x:Name="GatekeeperErrorBorder"
                                Visibility="Collapsed"
                                Background="#FEE2E2"
                                BorderBrush="#EF4444"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10,7"
                                Margin="0,12,0,0">
                            <TextBlock x:Name="GatekeeperErrorText" Foreground="#991B1B" FontSize="11.5" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Border>

            <!-- ============================================================== -->
            <!-- MODAL: EINTRAG ERSTELLEN / BEARBEITEN                          -->
            <!-- ============================================================== -->
            <Border x:Name="EntryEditorModal"
                    Visibility="Collapsed"
                    Background="#AA0F172A">
                <Border x:Name="EntryEditorModalCard"
                        Width="640"
                        MinWidth="460"
                        MaxWidth="1100"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource ModalCardBgBrush}"
                        BorderBrush="#C5A059"
                        BorderThickness="1.5"
                        CornerRadius="6"
                        Padding="20,16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="820">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock x:Name="EntryModalHeaderText" Text="Eintrag bearbeiten" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource ToolbarIconBtn}" Width="24" Height="24" Click="CloseEntryModal_Click"/>
                        </DockPanel>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="210"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Title (Bezeichnung)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                <TextBox x:Name="EditTitleBox" Style="{StaticResource TresorTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Gruppe im Strukturbaum" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                <ComboBox x:Name="EditGroupCombo" Height="29" FontSize="12" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Icon-Auswahl für Eintrag -->
                        <TextBlock Text="Icon" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                        <ListBox x:Name="EditEntryIconPicker"
                                 Height="36"
                                 Margin="0,0,0,8"
                                 Background="{DynamicResource InputBgBrush}"
                                 BorderBrush="{DynamicResource BorderBrushColor}"
                                 BorderThickness="1"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Image Width="16" Height="16" Source="{Binding Image}" ToolTip="{Binding Name}" Margin="2"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="User Name (Benutzer / E-Mail)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                <TextBox x:Name="EditUserBox"
                                         Style="{StaticResource TresorTextBox}"
                                         TextChanged="EditUserBox_TextChanged"
                                         PreviewKeyDown="EditUserBox_PreviewKeyDown"
                                         GotFocus="EditUserBox_GotFocus"
                                         LostFocus="EditUserBox_LostFocus"/>
                                <Border x:Name="UserSuggestionsPopupBorder"
                                        Visibility="Collapsed"
                                        Background="{DynamicResource InputBgBrush}"
                                        BorderBrush="#C5A059"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        Margin="0,2,0,0"
                                        MaxHeight="105">
                                    <ListBox x:Name="UserSuggestionsListBox"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Focusable="False"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             PreviewMouseLeftButtonUp="UserSuggestionsListBox_PreviewMouseLeftButtonUp">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="4,1.5">
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding UserName}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding ContextHint}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Margin="8,0,0,0" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="URL (Webseite / IP)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                <TextBox x:Name="EditUrlBox" Style="{StaticResource TresorTextBox}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Password" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="EditPassBox" Style="{StaticResource TresorPasswordBox}" FontFamily="Consolas"/>
                            <TextBox x:Name="EditPassTextBox" Style="{StaticResource TresorTextBox}" FontFamily="Consolas" Visibility="Collapsed"/>
                            <Button Grid.Column="1" Content="👁" Style="{StaticResource SecondaryBtn}" Width="32" Margin="5,0,0,0" Click="ToggleEditPassEye_Click" ToolTip="Passwort zeigen"/>
                            <Button Grid.Column="2" Content="🎲 Generieren" Style="{StaticResource SecondaryBtn}" Margin="5,0,0,0" Click="GenerateInlinePassword_Click"/>
                        </Grid>

                        <TextBlock Text="2FA / TOTP Secret (Optional - Base32 oder otpauth://)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="EditTotpBox" Style="{StaticResource TresorPasswordBox}" FontFamily="Consolas"/>
                            <TextBox x:Name="EditTotpTextBox" Style="{StaticResource TresorTextBox}" FontFamily="Consolas" Visibility="Collapsed"/>
                            <Button Grid.Column="1" Content="👁" Style="{StaticResource SecondaryBtn}" Width="32" Margin="5,0,0,0" Click="ToggleEditTotpEye_Click"/>
                        </Grid>

                        <DockPanel Margin="0,0,0,3">
                            <TextBlock DockPanel.Dock="Left" Text="Notes (Notizen)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock DockPanel.Dock="Right" Text="↕ Am unteren Rand mit der Maus ziehbar" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                            </Grid.RowDefinitions>
                            <TextBox x:Name="EditNotesBox"
                                     Grid.Row="0"
                                     Style="{StaticResource TresorTextBox}"
                                     Height="165"
                                     MinHeight="80"
                                     MaxHeight="560"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Padding="8,6"/>

                            <!-- Ziehbarer unterer Rand (Maus-Größenregler für das Notizen-Feld nach unten/oben) -->
                            <Grid Grid.Row="1">
                                <Border Background="{DynamicResource HeaderBgBrush}"
                                        BorderBrush="{DynamicResource BorderBrushColor}"
                                        BorderThickness="1,0,1,1"
                                        CornerRadius="0,0,4,4"
                                        IsHitTestVisible="False">
                                    <Grid>
                                        <Border Width="42"
                                                Height="3"
                                                CornerRadius="1.5"
                                                Background="#C5A059"
                                                Opacity="0.8"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                                        <TextBlock Text="◢"
                                                   FontSize="9"
                                                   Foreground="#C5A059"
                                                   Opacity="0.85"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Bottom"
                                                   Margin="0,0,3,0"/>
                                    </Grid>
                                </Border>
                                <Thumb x:Name="EditNotesResizeThumb"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch"
                                       Margin="0,0,18,0"
                                       Opacity="0.01"
                                       Cursor="SizeNS"
                                       DragDelta="EditNotesResizeThumb_DragDelta"
                                       ToolTip="Am unteren Rand mit der Maus ziehen, um das Notizen-Feld höher oder niedriger zu machen"/>
                                <Thumb x:Name="EditNotesCornerResizeThumb"
                                       Width="18"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Stretch"
                                       Opacity="0.01"
                                       Cursor="SizeNWSE"
                                       DragDelta="EntryModalCornerResizeThumb_DragDelta"
                                       ToolTip="An der Ecke ziehen, um Höhe und Breite gleichzeitig anzupassen"/>
                            </Grid>
                        </Grid>

                        <!-- Anhänge -->
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="Dateianhänge:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button DockPanel.Dock="Right" Content="+ Datei anhängen" Style="{StaticResource SecondaryBtn}" Padding="8,3" Click="AddAttachment_Click"/>
                            <ItemsControl x:Name="EditAttachmentsList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource HeaderBgBrush}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="0,0,5,3">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding FileName}" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                <Button Content="💾" Style="{StaticResource ToolbarIconBtn}" Height="18" Padding="2,0" Click="SaveAttachment_Click" ToolTip="Anhang speichern"/>
                                                <Button Content="✕" Style="{StaticResource ToolbarIconBtn}" Height="18" Padding="2,0" Click="RemoveAttachment_Click" ToolTip="Anhang löschen"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>

                        <DockPanel>
                            <Button DockPanel.Dock="Left" Content="Abbrechen" Style="{StaticResource SecondaryBtn}" Click="CloseEntryModal_Click"/>
                            <Button DockPanel.Dock="Right" Content="💾 OK / Übernehmen" Style="{StaticResource GoldBtn}" Click="SaveEntryModal_Click"/>
                        </DockPanel>
                    </StackPanel>
                    </ScrollViewer>
                </Border>
            </Border>

            <!-- ============================================================== -->
            <!-- MODAL: GRUPPE ERSTELLEN / BEARBEITEN (INKL. ICON-AUSWAHL)      -->
            <!-- ============================================================== -->
            <Border x:Name="GroupEditorModal"
                    Visibility="Collapsed"
                    Background="#AA0F172A">
                <Border Width="440"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource ModalCardBgBrush}"
                        BorderBrush="#C5A059"
                        BorderThickness="1.5"
                        CornerRadius="6"
                        Padding="20,16">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock x:Name="GroupModalHeaderText" Text="Gruppe bearbeiten" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource ToolbarIconBtn}" Width="24" Height="24" Click="CloseGroupModal_Click"/>
                        </DockPanel>

                        <TextBlock Text="Gruppenname" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="GroupModalNameBox" Style="{StaticResource TresorTextBox}" Margin="0,0,0,10" KeyDown="GroupModalNameBox_KeyDown"/>

                        <TextBlock Text="Icon im Strukturbaum wählen" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <ListBox x:Name="GroupModalIconPicker"
                                 Height="145"
                                 Margin="0,0,0,14"
                                 Background="{DynamicResource InputBgBrush}"
                                 BorderBrush="{DynamicResource BorderBrushColor}"
                                 BorderThickness="1">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Width="180" Margin="3,2">
                                        <Image Width="16" Height="16" Source="{Binding Image}" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding Name}" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <DockPanel>
                            <Button DockPanel.Dock="Left" Content="Abbrechen" Style="{StaticResource SecondaryBtn}" Click="CloseGroupModal_Click"/>
                            <Button DockPanel.Dock="Right" Content="✓ Speichern" Style="{StaticResource GoldBtn}" Click="SaveGroupModal_Click"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Border>

            <!-- ============================================================== -->
            <!-- MODAL: ALTE .KDBX IMPORTIEREN / ZUSAMMENFÜHREN                 -->
            <!-- ============================================================== -->
            <Border x:Name="ImportModalOverlay"
                    Visibility="Collapsed"
                    Background="#AA0F172A">
                <Border Width="480"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource ModalCardBgBrush}"
                        BorderBrush="#C5A059"
                        BorderThickness="1.5"
                        CornerRadius="6"
                        Padding="20,16">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="📥 .kdbx Datenbank importieren / zusammenführen" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource ToolbarIconBtn}" Width="24" Height="24" Click="CloseImportModal_Click"/>
                        </DockPanel>

                        <TextBlock Text="QUELL-DATENBANK (.KDBX)" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ImportSourceDbBox" Style="{StaticResource TresorTextBox}"/>
                            <Button Grid.Column="1" Content="📂 Wählen" Style="{StaticResource SecondaryBtn}" Margin="6,0,0,0" Click="BrowseImportSourceDb_Click"/>
                        </Grid>

                        <TextBlock Text="MASTER-PASSWORT DER QUELL-DATENBANK" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="ImportSourcePassBox" Style="{StaticResource TresorPasswordBox}"/>
                            <TextBox x:Name="ImportSourcePassTextBox" Style="{StaticResource TresorTextBox}" Visibility="Collapsed"/>
                            <Button Grid.Column="1" Content="👁" Style="{StaticResource SecondaryBtn}" Width="32" Margin="6,0,0,0" Click="ToggleImportPassEye_Click"/>
                        </Grid>

                        <TextBlock Text="SCHLÜSSELDATEI DER QUELL-DB (OPTIONAL)" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ImportSourceKeyfileBox" Style="{StaticResource TresorTextBox}"/>
                            <Button Grid.Column="1" Content="🗝 Wählen" Style="{StaticResource SecondaryBtn}" Margin="6,0,0,0" Click="BrowseImportSourceKeyfile_Click"/>
                        </Grid>

                        <DockPanel>
                            <Button DockPanel.Dock="Left" Content="Abbrechen" Style="{StaticResource SecondaryBtn}" Click="CloseImportModal_Click"/>
                            <Button DockPanel.Dock="Right" Content="📥 Jetzt importieren" Style="{StaticResource GoldBtn}" Click="ExecuteImportMerge_Click"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Border>

            <!-- ============================================================== -->
            <!-- MODAL: PASSWORT-GENERATOR                                      -->
            <!-- ============================================================== -->
            <Border x:Name="GeneratorModalOverlay"
                    Visibility="Collapsed"
                    Background="#AA0F172A">
                <Border Width="440"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource ModalCardBgBrush}"
                        BorderBrush="#C5A059"
                        BorderThickness="1.5"
                        CornerRadius="6"
                        Padding="20,16">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="🎲 Passwort- &amp; Passphrasen-Generator" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource ToolbarIconBtn}" Width="24" Height="24" Click="CloseGeneratorModal_Click"/>
                        </DockPanel>

                        <Border Background="{DynamicResource InputBgBrush}" BorderBrush="#C5A059" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,10">
                            <TextBox x:Name="GenOutputBox"
                                     Background="Transparent"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderThickness="0"
                                     FontFamily="Consolas"
                                     FontSize="14"
                                     FontWeight="Bold"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"/>
                        </Border>

                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="Länge:" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="GenLenLabel" DockPanel.Dock="Right" Text="20 Zeichen" FontSize="11.5" FontWeight="Bold"/>
                        </DockPanel>
                        <Slider x:Name="GenLengthSlider" Minimum="8" Maximum="64" Value="20" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="GenOptions_Changed" Margin="0,0,0,10"/>

                        <UniformGrid Columns="2" Margin="0,0,0,12">
                            <CheckBox x:Name="GenUpperCheck" Content="A-Z (Groß)" IsChecked="True" Margin="0,3" Checked="GenOptions_Changed" Unchecked="GenOptions_Changed"/>
                            <CheckBox x:Name="GenLowerCheck" Content="a-z (Klein)" IsChecked="True" Margin="0,3" Checked="GenOptions_Changed" Unchecked="GenOptions_Changed"/>
                            <CheckBox x:Name="GenDigitsCheck" Content="0-9 (Ziffern)" IsChecked="True" Margin="0,3" Checked="GenOptions_Changed" Unchecked="GenOptions_Changed"/>
                            <CheckBox x:Name="GenSymbolsCheck" Content="!@#$ (Symbole)" IsChecked="True" Margin="0,3" Checked="GenOptions_Changed" Unchecked="GenOptions_Changed"/>
                        </UniformGrid>

                        <DockPanel>
                            <Button DockPanel.Dock="Left" Content="↻ Neu würfeln" Style="{StaticResource SecondaryBtn}" Click="RegeneratePassword_Click"/>
                            <Button DockPanel.Dock="Left" Content="🗣 4-Wort Passphrase" Style="{StaticResource SecondaryBtn}" Margin="6,0,0,0" Click="GeneratePassphraseBtn_Click"/>
                            <Button DockPanel.Dock="Right" Content="📋 Kopieren" Style="{StaticResource GoldBtn}" Click="CopyGeneratedPassword_Click"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>

        <!-- ================================================================== -->
        <!-- ROW 4: STATUSLEISTE UNTEN (ERST NACH PASSWORTEINGABE SICHTBAR)     -->
        <!-- ================================================================== -->
        <Border x:Name="MainStatusBarBorder" Grid.Row="4" Height="24" Visibility="Collapsed" Background="{DynamicResource AppBgBrush}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="0,1,0,0" Padding="6,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="135"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="0,0,1,0" VerticalAlignment="Stretch">
                    <TextBlock x:Name="StatusSelectedText" Text="0 of 0 selected" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </Border>

                <TextBlock x:Name="StatusReadyText"
                           Grid.Column="1"
                           Text="Ready."
                           FontSize="11.5"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"
                           Margin="8,0"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusSecurityBadge" Text="KDBX 4.0 · Argon2id" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="StatusAutoLockText" Text="Geöffnet (Auto-Sperre: Aus)" FontSize="11" Foreground="#15803D" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
