<Window x:Class="FunkenwerkRemote.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Funkenwerk Remote"
        Icon="funkenwerk_remote.ico"
        Width="1380" Height="840"
        MinWidth="1020" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource RdpBgRoot}"
        Foreground="{DynamicResource RdpFgPrimary}"
        FontFamily="Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">

    <Grid x:Name="RootGrid" Background="{DynamicResource RdpBgRoot}">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TopBarRow" Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition x:Name="BottomBarRow" Height="36"/>
        </Grid.RowDefinitions>

        <!-- ================================================================= -->
        <!-- ROW 0: COMPACT RDP CONNECTION & CONTROL BAR                       -->
        <!-- ================================================================= -->
        <Border x:Name="TopBarBorder" Grid.Row="0"
                Background="{DynamicResource RdpBgBar}"
                BorderBrush="{DynamicResource RdpBorderSubtle}"
                BorderThickness="0,0,0,1" Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="155"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="125"/>
                    <ColumnDefinition Width="158"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <Image Source="funkenwerk_remote.png" Width="30" Height="30" Margin="0,0,9,0"/>
                    <TextBlock Text="FUNKENWERK REMOTE" Foreground="#C5A059" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Profile Name -->
                <TextBox x:Name="NameBox" Grid.Column="1" Height="34" VerticalContentAlignment="Center"
                         Background="{DynamicResource RdpBgInput}"
                         Foreground="{DynamicResource RdpFgPrimary}"
                         CaretBrush="{DynamicResource RdpFgPrimary}"
                         BorderBrush="{DynamicResource RdpBorderStrong}"
                         Padding="9,0" Margin="0,0,6,0" ToolTip="Verbindungsname"/>

                <!-- Host -->
                <TextBox x:Name="HostBox" Grid.Column="2" Height="34" VerticalContentAlignment="Center"
                         Background="{DynamicResource RdpBgInput}"
                         Foreground="{DynamicResource RdpFgPrimary}"
                         CaretBrush="{DynamicResource RdpFgPrimary}"
                         BorderBrush="{DynamicResource RdpBorderStrong}"
                         Padding="9,0" Margin="0,0,6,0" ToolTip="Hostname oder lokale IP-Adresse"/>

                <!-- Port -->
                <TextBox x:Name="PortBox" Grid.Column="3" Height="34" VerticalContentAlignment="Center" Text="3389"
                         Background="{DynamicResource RdpBgInput}"
                         Foreground="{DynamicResource RdpFgPrimary}"
                         CaretBrush="{DynamicResource RdpFgPrimary}"
                         BorderBrush="{DynamicResource RdpBorderStrong}"
                         Padding="5,0" Margin="0,0,6,0"
                         HorizontalContentAlignment="Center" ToolTip="RDP-Port (Standard: 3389)"/>

                <!-- Username -->
                <TextBox x:Name="UserBox" Grid.Column="4" Height="34" VerticalContentAlignment="Center"
                         Background="{DynamicResource RdpBgInput}"
                         Foreground="{DynamicResource RdpFgPrimary}"
                         CaretBrush="{DynamicResource RdpFgPrimary}"
                         BorderBrush="{DynamicResource RdpBorderStrong}"
                         Padding="8,0" Margin="0,0,6,0" ToolTip="Benutzername"/>

                <!-- Password + Mandatory Eye Icon -->
                <Border x:Name="PassContainerBorder" Grid.Column="5" Height="34"
                        Background="{DynamicResource RdpBgInput}"
                        BorderBrush="{DynamicResource RdpBorderStrong}"
                        BorderThickness="1" Margin="0,0,6,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="28"/>
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="PassBox" Grid.Column="0" Background="Transparent"
                                     Foreground="{DynamicResource RdpFgPrimary}"
                                     CaretBrush="{DynamicResource RdpFgPrimary}"
                                     BorderThickness="0" VerticalContentAlignment="Center" Padding="7,0"
                                     PasswordChanged="PassBox_PasswordChanged"
                                     ToolTip="RDP-Passwort"/>
                        <TextBox x:Name="PassVisibleBox" Grid.Column="0" Background="Transparent"
                                 Foreground="{DynamicResource RdpFgPrimary}"
                                 CaretBrush="{DynamicResource RdpFgPrimary}"
                                 BorderThickness="0" VerticalContentAlignment="Center" Padding="7,0" Visibility="Collapsed"
                                 TextChanged="PassVisibleBox_TextChanged"
                                 ToolTip="RDP-Passwort"/>
                        <Button x:Name="TogglePassEyeBtn" Grid.Column="1" Content="👁" Background="Transparent"
                                Foreground="{DynamicResource RdpFgSecondary}" BorderThickness="0" Cursor="Hand"
                                ToolTip="Passwort ein-/ausblenden" Click="TogglePassEye_Click"/>
                    </Grid>
                </Border>

                <!-- NLA Toggle (Windows NLA vs Linux xrdp TLS) -->
                <Button x:Name="NlaToggleBtn" Grid.Column="6" Content="TLS" Height="34" Padding="9,0"
                        Click="NlaToggle_Click"
                        Background="{DynamicResource RdpBgButton}" Foreground="{DynamicResource RdpFgSecondary}"
                        BorderBrush="{DynamicResource RdpBorderStrong}" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,6,0"
                        ToolTip="Authentifizierungsmodus: Standard-TLS (Linux xrdp) oder NLA/CredSSP (Windows)"/>

                <!-- Save Profile -->
                <Button x:Name="SaveProfileBtn" Grid.Column="7" Content="💾" Width="34" Height="34" Click="SaveProfile_Click"
                        Background="{DynamicResource RdpBgButton}" Foreground="#C5A059"
                        BorderBrush="{DynamicResource RdpBorderStrong}" Cursor="Hand" Margin="0,0,6,0"
                        ToolTip="Profil AES-256-GCM verschlüsselt speichern"/>

                <!-- Connect -->
                <Button x:Name="ConnectBtn" Grid.Column="8" Content="⚡ VERBINDEN" Height="34" Padding="15,0"
                        Click="Connect_Click" Background="#C5A059" Foreground="#0F1117" FontWeight="Bold"
                        BorderThickness="0" Cursor="Hand" Margin="0,0,6,0"
                        ToolTip="Verbindung im Fenster öffnen"/>

                <!-- View-Only vs Interactive Control Toggle -->
                <Button x:Name="ViewOnlyToggleBtn" Grid.Column="9" Content="👁 NUR ANSICHT" Height="34" Padding="12,0"
                        Click="ViewOnlyToggle_Click"
                        Background="{DynamicResource RdpBgButton}" Foreground="#C5A059"
                        BorderBrush="#C5A059" BorderThickness="1" FontWeight="Bold" Cursor="Hand" Margin="0,0,6,0"
                        ToolTip="Umschalten zwischen geschütztem Zuschauen (keine Fehlklicks) und aktiver Maus-/Tastatur-Steuerung"/>

                <!-- Fullscreen (F11) -->
                <Button x:Name="FullscreenBtn" Grid.Column="10" Content="⛶" Width="34" Height="34"
                        Click="Fullscreen_Click"
                        Background="{DynamicResource RdpBgButton}" Foreground="{DynamicResource RdpFgPrimary}"
                        BorderBrush="{DynamicResource RdpBorderStrong}" Cursor="Hand" Margin="0,0,6,0"
                        ToolTip="Vollbild umschalten (F11)"/>

                <!-- External mstsc -->
                <Button x:Name="ExternalMstscBtn" Grid.Column="11" Content="↗" Width="34" Height="34"
                        Click="ExternalMstsc_Click"
                        Background="{DynamicResource RdpBgButton}" Foreground="{DynamicResource RdpFgSecondary}"
                        BorderBrush="{DynamicResource RdpBorderStrong}" Cursor="Hand" Margin="0,0,6,0"
                        ToolTip="Im externen Windows-Remotedesktop (mstsc) öffnen"/>

                <!-- Theme Toggle -->
                <Button x:Name="ThemeToggleBtn" Grid.Column="12" Content="☀" Width="34" Height="34"
                        Click="ThemeToggle_Click" Background="{DynamicResource RdpBgButton}" Foreground="#C5A059"
                        BorderBrush="{DynamicResource RdpBorderStrong}" Cursor="Hand"
                        ToolTip="Light-/Dark-Mode umschalten"/>
            </Grid>
        </Border>

        <!-- ================================================================= -->
        <!-- ROW 1: CLEAN 2-TILE LAYOUT (LINKS: VERBINDUNGEN | RECHTS: SCREEN) -->
        <!-- ================================================================= -->
        <Grid x:Name="MainWorkspaceGrid" Grid.Row="1" Margin="16,14,16,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarCol" Width="280"/>
                <ColumnDefinition x:Name="SpacerCol" Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT TILE: SAVED RDP PROFILES -->
            <Border x:Name="SidebarTileBorder" Grid.Column="0"
                    Background="{DynamicResource RdpBgSidebar}"
                    BorderBrush="{DynamicResource RdpBorderSubtle}"
                    BorderThickness="1" CornerRadius="14" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="VERBINDUNGEN" Foreground="#C5A059" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="RefreshStatusBtn" Content="↻" Width="26" Height="26" Click="RefreshStatus_Click"
                                    Background="{DynamicResource RdpBgButton}" Foreground="{DynamicResource RdpFgSecondary}"
                                    BorderBrush="{DynamicResource RdpBorderStrong}" Cursor="Hand" Margin="0,0,4,0"
                                    ToolTip="Netzwerkstatus prüfen"/>
                            <Button x:Name="NewProfileBtn" Content="+ NEU" Height="26" Padding="9,0" Click="NewProfile_Click"
                                    Background="{DynamicResource RdpBgButton}" Foreground="#C5A059"
                                    BorderBrush="{DynamicResource RdpBorderStrong}" FontWeight="Bold" Cursor="Hand" Margin="0,0,4,0"
                                    ToolTip="Neue Verbindung anlegen"/>
                            <Button x:Name="DeleteProfileBtn" Content="✕" Width="26" Height="26" Click="DeleteProfile_Click"
                                    Background="{DynamicResource RdpBgButton}" Foreground="#EF4444"
                                    BorderBrush="{DynamicResource RdpBorderStrong}" Cursor="Hand"
                                    ToolTip="Verbindung entfernen"/>
                        </StackPanel>
                    </Grid>

                    <ListBox x:Name="ProfilesListBox" Grid.Row="1" Background="Transparent" BorderThickness="0"
                             SelectionChanged="ProfilesListBox_SelectionChanged"
                             MouseDoubleClick="ProfilesListBox_MouseDoubleClick"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemCardBorder"
                                                    Padding="10,8" Margin="0,3" CornerRadius="9"
                                                    Background="{DynamicResource RdpBgCard}"
                                                    BorderBrush="{DynamicResource RdpBorderSubtle}"
                                                    BorderThickness="1"
                                                    Cursor="Hand">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemCardBorder" Property="Background" Value="{DynamicResource RdpBgCardHover}"/>
                                                    <Setter TargetName="ItemCardBorder" Property="BorderBrush" Value="#C5A059"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemCardBorder" Property="Background" Value="{DynamicResource RdpBgCardSelected}"/>
                                                    <Setter TargetName="ItemCardBorder" Property="BorderBrush" Value="#C5A059"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ToolTip="{Binding StatusTooltip}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="9" Height="9"
                                             Fill="{Binding StatusDotColorHex}"
                                             VerticalAlignment="Center"
                                             HorizontalAlignment="Left"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource RdpFgPrimary}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource RdpFgSecondary}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Contextual 1-Click Mini-PC RDP Provisioner Button -->
                    <Button x:Name="SetupMiniPcSidebarBtn" Grid.Row="2"
                            Content="🛠 Mini-PC RDP aktivieren"
                            Height="34" Margin="0,10,0,0"
                            Click="OpenMiniPcSetupModal_Click"
                            Background="{DynamicResource RdpBgButton}"
                            Foreground="#C5A059"
                            BorderBrush="#C5A059"
                            BorderThickness="1"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Visibility="Collapsed"
                            ToolTip="Richtet xrdp + Live-Kiosk-Spiegelung (:0) einmalig per SSH auf 192.168.188.151 ein"/>
                </Grid>
            </Border>

            <!-- RIGHT TILE: MULTI-TAB EMBEDDED RDP STAGE -->
            <Border x:Name="StageTileBorder" Grid.Column="2"
                    Background="#0B0D12"
                    BorderBrush="{DynamicResource RdpBorderSubtle}"
                    BorderThickness="1" CornerRadius="14" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Active Session Tabs Bar -->
                    <Border x:Name="SessionTabsBar" Grid.Row="0"
                            Background="{DynamicResource RdpBgBar}"
                            BorderBrush="{DynamicResource RdpBorderSubtle}"
                            BorderThickness="0,0,0,1"
                            Padding="10,6"
                            Visibility="Collapsed">
                        <DockPanel>
                            <Button x:Name="ExitFullscreenFloatingBtn" DockPanel.Dock="Right"
                                    Content="⛶ Vollbild beenden (F11)"
                                    Height="26" Padding="10,0" Margin="8,0,0,0"
                                    Click="Fullscreen_Click"
                                    Background="{DynamicResource RdpBgButton}"
                                    Foreground="#C5A059"
                                    BorderBrush="#C5A059"
                                    BorderThickness="1"
                                    FontWeight="SemiBold"
                                    Cursor="Hand"
                                    Visibility="Collapsed"/>
                            <WrapPanel x:Name="SessionTabsWrapPanel" Orientation="Horizontal"/>
                        </DockPanel>
                    </Border>

                    <!-- Empty State (Shown when 0 sessions are open) -->
                    <StackPanel x:Name="EmptyStagePanel" Grid.Row="1"
                                VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Image Source="funkenwerk_remote.png" Width="68" Height="68" Opacity="0.92" Margin="0,0,0,14"/>
                        <TextBlock x:Name="EmptyStageTitleTxt" Text="Bereit für lokalen Netzwerk-Blick"
                                   Foreground="#F9FAFB" FontSize="16" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,0,0,14"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="QuickConnectMiniPcBtn"
                                    Content="⚡ Werkstatt Mini-PC öffnen"
                                    Height="38" Padding="22,0"
                                    Click="QuickConnectSelected_Click"
                                    Background="#C5A059" Foreground="#0F1117"
                                    FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                            <Button x:Name="EmptySetupMiniPcBtn"
                                    Content="🛠 RDP-Dienst einrichten"
                                    Height="38" Padding="18,0" Margin="10,0,0,0"
                                    Click="OpenMiniPcSetupModal_Click"
                                    Background="#181C26" Foreground="#C5A059"
                                    BorderBrush="#C5A059" BorderThickness="1"
                                    FontWeight="Bold" Cursor="Hand"
                                    Visibility="Collapsed"
                                    ToolTip="Einmalige Einrichtung von xrdp + Live-Kiosk-Spiegelung (:0) auf dem Mini-PC"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Active Embedded RDP Host Container -->
                    <Grid x:Name="SessionHostContainer" Grid.Row="1" Visibility="Collapsed" Background="#0B0D12"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ================================================================= -->
        <!-- ROW 2: CLEAN STATUS BAR (FunkenwerkVersioning attaches on right)  -->
        <!-- ================================================================= -->
        <Border x:Name="BottomBarBorder" Grid.Row="2"
                Background="{DynamicResource RdpBgBar}"
                BorderBrush="{DynamicResource RdpBorderSubtle}"
                BorderThickness="0,1,0,0" Padding="18,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0"
                           Text="🔒 Tresor AES-256-GCM + DPAPI bereit · Lokal im Netzwerk"
                           Foreground="{DynamicResource RdpFgSecondary}"
                           FontSize="11.5" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>

        <!-- ================================================================= -->
        <!-- MODAL 1: 1-CLICK MINI-PC LIVE-KIOSK RDP PROVISIONING              -->
        <!-- ================================================================= -->
        <Grid x:Name="SetupModalOverlayGrid" Grid.Row="0" Grid.RowSpan="3"
              Background="#B8080A0F" Visibility="Collapsed" Panel.ZIndex="2000">
            <Border Width="460" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{DynamicResource RdpBgSidebar}"
                    BorderBrush="#C5A059" BorderThickness="1.5" CornerRadius="16" Padding="24">
                <StackPanel>
                    <TextBlock Text="Werkstatt Mini-PC · RDP aktivieren"
                               Foreground="#C5A059" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>

                    <TextBlock Text="Linux-Passwort (alina) für einmalige Einrichtung &amp; RDP-Zugang:"
                               Foreground="{DynamicResource RdpFgPrimary}" FontSize="12.5" Margin="0,0,0,8"/>

                    <Border Height="38" Background="{DynamicResource RdpBgInput}"
                            BorderBrush="{DynamicResource RdpBorderStrong}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="34"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="SetupSudoPassBox" Grid.Column="0" Background="Transparent"
                                         Foreground="{DynamicResource RdpFgPrimary}" CaretBrush="{DynamicResource RdpFgPrimary}"
                                         BorderThickness="0" VerticalContentAlignment="Center" Padding="10,0"
                                         PasswordChanged="SetupSudoPassBox_PasswordChanged"/>
                            <TextBox x:Name="SetupSudoPassVisibleBox" Grid.Column="0" Background="Transparent"
                                     Foreground="{DynamicResource RdpFgPrimary}" CaretBrush="{DynamicResource RdpFgPrimary}"
                                     BorderThickness="0" VerticalContentAlignment="Center" Padding="10,0"
                                     Visibility="Collapsed" TextChanged="SetupSudoPassVisibleBox_TextChanged"/>
                            <Button x:Name="ToggleSetupEyeBtn" Grid.Column="1" Content="👁" Background="Transparent"
                                    Foreground="{DynamicResource RdpFgSecondary}" BorderThickness="0" Cursor="Hand"
                                    ToolTip="Passwort ein-/ausblenden" Click="ToggleSetupEye_Click"/>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="SetupProgressText"
                               Text=""
                               Foreground="{DynamicResource RdpFgSecondary}"
                               FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14"
                               Visibility="Collapsed"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="CancelSetupModalBtn" Content="Abbrechen" Height="34" Padding="16,0" Margin="0,0,8,0"
                                Click="CancelSetupModal_Click"
                                Background="{DynamicResource RdpBgButton}" Foreground="{DynamicResource RdpFgPrimary}"
                                BorderBrush="{DynamicResource RdpBorderStrong}" Cursor="Hand"/>
                        <Button x:Name="RunSetupModalBtn" Content="⚡ Aktivieren &amp; Verbinden" Height="34" Padding="18,0"
                                Click="RunSetupModal_Click"
                                Background="#C5A059" Foreground="#0F1117" FontWeight="Bold"
                                BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================================================================= -->
        <!-- MODAL 2: CLEAN CONFIRMATION DIALOG                                -->
        <!-- ================================================================= -->
        <Grid x:Name="ConfirmModalOverlayGrid" Grid.Row="0" Grid.RowSpan="3"
              Background="#B8080A0F" Visibility="Collapsed" Panel.ZIndex="2100">
            <Border Width="400" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{DynamicResource RdpBgSidebar}"
                    BorderBrush="{DynamicResource RdpBorderStrong}" BorderThickness="1.2" CornerRadius="14" Padding="22">
                <StackPanel>
                    <TextBlock x:Name="ConfirmTitleTxt" Text="Bestätigung"
                               Foreground="#C5A059" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock x:Name="ConfirmBodyTxt" Text=""
                               Foreground="{DynamicResource RdpFgPrimary}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,18"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Abbrechen" Height="32" Padding="14,0" Margin="0,0,8,0"
                                Click="ConfirmCancel_Click"
                                Background="{DynamicResource RdpBgButton}" Foreground="{DynamicResource RdpFgPrimary}"
                                BorderBrush="{DynamicResource RdpBorderStrong}" Cursor="Hand"/>
                        <Button x:Name="ConfirmAcceptBtn" Content="Entfernen" Height="32" Padding="16,0"
                                Click="ConfirmAccept_Click"
                                Background="#EF4444" Foreground="#FFFFFF" FontWeight="Bold"
                                BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
