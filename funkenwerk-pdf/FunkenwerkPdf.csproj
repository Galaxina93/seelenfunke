<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>funkenwerk_pdf.ico</ApplicationIcon>
    <AssemblyName>FunkenwerkPdf</AssemblyName>
    <RootNamespace>FunkenwerkPdf</RootNamespace>
    <ApplicationTitle>Funkenwerk PDF</ApplicationTitle>
    <Product>Funkenwerk PDF</Product>
    <Company>Mein-Seelenfunke</Company>
    <Version>1.3.0</Version>
    <AssemblyVersion>1.3.0.12</AssemblyVersion>
    <FileVersion>1.3.0.12</FileVersion>
    <InformationalVersion>1.3.0+b12</InformationalVersion>
    <NoWarn>NU1701;CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\funkenwerk\FunkenwerkVersioning.cs" Link="Shared\FunkenwerkVersioning.cs" />
    <Resource Include="funkenwerk_pdf.ico" />
    <Resource Include="funkenwerk_pdf.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PDFsharp-WPF" Version="6.2.4" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
  </ItemGroup>

</Project>
