# ==============================================================================
# Mein-Seelenfunke | Synology NAS Watchtower Konfiguration (Vorlage)
# Kopiere diese Datei zu "watchtower.env" und trage das Read-Only Token ein.
# ==============================================================================

SHOP_PULSE_URL="https://mein-seelenfunke.de/api/system/health-pulse?source=synology_nas"

# Read-Only Monitor-Token (Scope: monitor:pulse, ausstellbar via /api/system/health-pulse/issue-token)
WATCHTOWER_BEARER_TOKEN=""

# Optionaler Direkt-Notruf ans Handy (funktioniert selbst bei komplettem Mittwald-Ausfall)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
ALERT_WEBHOOK_URL=""

# Mindestabstand zwischen Wiederholungs-Alarmen in Sekunden (Standard: 3600 = 60 Minuten)
COOLDOWN_SECONDS=3600
