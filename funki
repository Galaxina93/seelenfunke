#!/bin/bash

# ==========================================
# UMGEBUNGSERKENNUNG (Lokal vs. Stage/Live)
# ==========================================
if command -v docker &> /dev/null; then
    IS_LOCAL=true
    PREFIX_DEFAULT="docker compose exec web"
    PREFIX_USER="docker compose exec --user $(id -u):$(id -g) web"
else
    IS_LOCAL=false
    PREFIX_DEFAULT=""
    PREFIX_USER=""
fi

# Helper-Funktion: Blockiert Docker-Befehle auf dem Live-Server
require_local() {
    if [ "$IS_LOCAL" = false ]; then
        echo -e "⚠️  \033[1;33mHinweis:\033[0m Der Befehl '\033[1;32m$1\033[0m' steuert die Docker-Container und ist nur auf deinem lokalen Rechner verfügbar."
        exit 1
    fi
}

# Helper-Funktion: Wählt automatisch das aktuellste lokale FunkenwerkMcp.exe Binary
resolve_mcp_exe() {
    local cli_exe="/mnt/c/Users/konta/AppData/Local/Funkenwerk/SentinelCli/FunkenwerkMcp.exe"
    local mod_exe="/mnt/c/Users/konta/Desktop/Funkenwerk Collection/Module/Funkenwerk MCP/FunkenwerkMcp.exe"
    local col_exe="/mnt/c/Users/konta/Desktop/Funkenwerk Collection/Funkenwerk MCP/FunkenwerkMcp.exe"
    local best_col="$mod_exe"
    if [ ! -f "$best_col" ] && [ -f "$col_exe" ]; then
        best_col="$col_exe"
    fi
    if [ -f "$cli_exe" ] && [ -f "$best_col" ]; then
        if [ "$cli_exe" -nt "$best_col" ]; then
            echo "$cli_exe"
        else
            echo "$best_col"
        fi
    elif [ -f "$cli_exe" ]; then
        echo "$cli_exe"
    else
        echo "$best_col"
    fi
}

# Helper-Funktion: Repariert Datei-Berechtigungen und optimiert Caches
run_rights() {
    echo "🔐 Repariere Datei-Berechtigungen..."
    if [ "$IS_LOCAL" = true ]; then
        docker compose exec -u www-data web php artisan optimize:clear
        docker compose exec -u root web bash -c "chown -R www-data:www-data storage/ bootstrap/cache/ && chmod -R 777 storage/ bootstrap/cache/"
    else
        php artisan optimize:clear
        chmod -R 775 storage/ bootstrap/cache/
    fi
    echo "✅ Berechtigungen und Cache erfolgreich erneuert!"
}

case "$1" in
    info)
        echo -e "\n\033[1;34m✨ Funki - Dein intelligenter Projekt-Assistent ✨\033[0m"

        if [ "$IS_LOCAL" = true ]; then
            echo -e "Status: \033[1;32mLokale Entwicklungsumgebung (Docker erkannt)\033[0m\n"
        else
            echo -e "Status: \033[1;36mLive/Stage Server (Direktes PHP erkannt)\033[0m\n"
        fi

        echo -e "Hier ist eine Übersicht aller verfügbaren Befehle:\n"
        echo -e "  \033[1;32m🚀 start\033[0m         Startet alle Docker-Container im Hintergrund."
        echo -e "  \033[1;32m⚡ start all\033[0m     Startet Docker + WebSocket + Queue-Worker + NPM Watch in einem Tab!"
        echo -e "  \033[1;32m🛑 stop\033[0m          Stoppt alle laufenden Container sanft."
        echo -e "  \033[1;32m🔄 restart\033[0m       Startet alle Docker-Container neu."
        echo -e "  \033[1;32m🏗️ bauen\033[0m         Baut die Container (Images) komplett neu auf."
        echo -e "  \033[1;32m💥 löschen\033[0m       Löscht alle Container und Volumes (Achtung: Datenbank wird resettet!)."
        echo -e "  \033[1;32m🗄️ migrate\033[0m       Führt inkrementelle Laravel Migrationen aus (oder 'migrate fresh' zum Zurücksetzen)."
        echo -e "  \033[1;32m🔑 key\033[0m           Generiert einen neuen Laravel Application Key."
        echo -e "  \033[1;32m🗂️ storage\033[0m       Repariert und erneuert den öffentlichen Storage-Link restlos."
        echo -e "  \033[1;32m📦 export\033[0m        Exportiert Projektdateien (z.B. 'funki export ticket, mail' oder 'funki export \"langer string\"')."
        echo -e "  \033[1;32m🎨 templates\033[0m     Sichert UI-Vorlagen automatisch als persistente Seeder-Dateien."
        echo -e "  \033[1;32m🗺️ aimap\033[0m         Generiert eine Architektur-Map (ai_map.md) für KI-Agenten."
        echo -e "  \033[1;32m🧠 systemmap\033[0m     Generiert die Neurale System Brain Map für die 3D Fehleranalyse."
        echo -e "  \033[1;32m⚙️ uploadlimit\033[0m   Setzt das PHP Upload-Limit im Container (z.B. 'funki uploadlimit 150M')."
        echo -e "  \033[1;32m👷 worker\033[0m        Startet den Queue-Worker (für Mails, PDFs und Hintergrund-Jobs)."
        echo -e "  \033[1;32m⏱️ clock\033[0m         Startet den internen System-Takt (führt z.B. automatische minütliche Abrufe aus)."
        echo -e "  \033[1;32m🌐 websocket\033[0m     Starte den Reverb WebSocket-Server (Echtzeit-Verbindungen)."
        echo -e "  \033[1;32m💾 backup\033[0m        Sichert die Datenbank als ZIP-Datei (Spatie Backup)."
        echo -e "  \033[1;32m📧 mails\033[0m         Ruft per IMAP neue E-Mails von Konten ab."
        echo -e "  \033[1;32m🤖 mailworker\033[0m    Lässt die KI autonom E-Mails lesen, sortieren und beantworten."
        echo -e "  \033[1;32m📞 telefon\033[0m       Startet die KI-Telefonie Audio-Bridge (Twilio WebSocket)."
        echo -e "  \033[1;32m🛡️ security\033[0m      Prüft Pakete & CVEs (oder 'funki security update' für sichere Paket-Updates + Test)."
        echo -e "  \033[1;32m✅ check\033[0m         Schnelltest aller Frontend-, Backend- & Portal-Routen inkl. Projekt-Gehirn."
        echo -e "  \033[1;32m🧪 test\033[0m          Führt automatisierte Tests aus (z.B. 'funki test --filter ShopProcessTest')."
        echo -e "  \033[1;32m🔐 rights\033[0m        Repariere die Dateiberechtigungen (www-data) und leert Caches sicher."
        echo -e "  \033[1;32m🧹 cache\033[0m         Leert alle Anwendungs- und System-Caches auf einen Schlag restlos aus."
        echo -e "  \033[1;32m🔄 sync-worker\033[0m   Kopiert den aktuellen Code in den isolierten Worker-Stage-Container."
        echo -e "  \033[1;32m🚢 stage-deploy\033[0m  Spielt gepushte Änderungen & reine Shop-Assets sicher auf Stage ein (Live gesperrt)."
        echo -e "  \033[1;32m🛍️ shop-manifest\033[0m Erzeugt das reine Shop-Asset-Manifest (ohne Musik, Buchhaltung & Privatdaten)."
        echo -e "  \033[1;32m🛠️ artisan\033[0m       Führt beliebige Artisan-Befehle aus."
        echo -e "  \033[1;32mℹ️ info\033[0m          Zeigt genau dieses schicke Hilfemenü an.\n"
        echo -e "💡 \033[1;33mBeispiel:\033[0m funki artisan make:model Product -m"
        echo -e "💡 \033[1;33mBeispiel:\033[0m funki migrate fresh"
        echo -e "💡 \033[1;33mBeispiel:\033[0m funki export ticket, profil --short"
        echo -e "💡 \033[1;33mBeispiel:\033[0m funki test --filter ShopProcessTest\n"
        ;;
    start|all)
        require_local "start"
        echo "⚠️  Prüfe auf blockierende Docker-Container..."
        # Finde alle Container, die Port 80, 3306, 3307, 8080, 8082, 8002, 6001 oder 6002 auf dem Host belegen
        CONFLICTS=$(docker ps --format "{{.ID}} {{.Ports}}" | grep -E ":(80|3306|3307|8080|8082|8002|6001|6002)->" | cut -d' ' -f1 | sort -u)
        CURRENT_IDS=$(docker compose ps -q 2>/dev/null)
        
        STOP_LIST=""
        for id in $CONFLICTS; do
            if ! echo "$CURRENT_IDS" | grep -q "$id"; then
                STOP_LIST="$STOP_LIST $id"
            fi
        done
        
        if [ ! -z "$STOP_LIST" ]; then
            echo "🛑 Stoppe blockierende Container von anderen Projekten..."
            docker stop $STOP_LIST
        fi

        echo "🚀 Starte Funki..."
        docker compose up -d

        echo "⏳ Warte auf Datenbank..."
        MAX_TRIES=45
        COUNT=0
        until docker compose exec -T db mysql -uroot -proot -e "SELECT 1;" &>/dev/null; do
            sleep 1
            COUNT=$((COUNT+1))
            if [ $COUNT -ge $MAX_TRIES ]; then
                echo "⚠️ Datenbank braucht ungewöhnlich lange zum Starten. Fahre fort..."
                break
            fi
        done
        sleep 2

        # Prüfen ob Testdatenbank existiert, falls nicht erstellen
        docker compose exec -T db mysql -uroot -proot -e "CREATE DATABASE IF NOT EXISTS seelenfunke_testing;" &>/dev/null || true

        # Intelligente automatische DB-Initialisierung falls Tabellen fehlen
        TABLE_COUNT=$(docker compose exec -T db mysql -uroot -proot -N -s -e "SELECT count(*) FROM information_schema.tables WHERE table_schema='seelenfunke';" 2>/dev/null || echo "0")
        
        if [ "$TABLE_COUNT" = "0" ] || [ -z "$TABLE_COUNT" ]; then
            echo "🌱 Leere Datenbank erkannt! Initialisiere Tabellen & Daten..."
            SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
            if [ -f "$SCRIPT_DIR/init_db_backup.sql" ]; then
                echo "📥 Spiele bestehendes Datenbank-Backup ein..."
                docker compose exec -T db mysql -uroot -proot seelenfunke < "$SCRIPT_DIR/init_db_backup.sql"
                $PREFIX_DEFAULT php artisan migrate --force
            else
                $PREFIX_DEFAULT php artisan migrate --force --seed
            fi
            echo "✅ Datenbank erfolgreich initialisiert!"
        else
            # Prüfen ob ausstehende Migrationen existieren
            if $PREFIX_DEFAULT php artisan migrate:status 2>/dev/null | grep -q "Pending"; then
                echo "🗄️ Neue ausstehende Migration(en) gefunden. Führe php artisan migrate aus..."
                $PREFIX_DEFAULT php artisan migrate --force
            fi
        fi

        # Storage-Link sicherstellen
        if [ ! -L "public/storage" ]; then
            echo "🔗 Erstelle Storage-Link..."
            $PREFIX_DEFAULT php artisan storage:link &>/dev/null || true
        fi

        # Rechte und Caches aktualisieren
        run_rights

        # 24/7 Stage-Auffang-Pool beim Start nahtlos synchronisieren (nicht-blockierend)
        MCP_WIN_EXE="$(resolve_mcp_exe)"
        if [ -f "$MCP_WIN_EXE" ]; then
            echo "🛡️ Synchronisiere 24/7 Funkira-Auffang-Pool von Stage..."
            "$MCP_WIN_EXE" --sentinel-sync || true
        elif [ -f "storage/app/private/antigravity_inbox.json" ]; then
            $PREFIX_DEFAULT php artisan system:sentinel-inbox --import-file=storage/app/private/antigravity_inbox.json &>/dev/null || true
        fi

        echo -e "\n\033[1;32m🎉 Funki ist einsatzbereit!\033[0m"
        echo -e "👉 Shop & Web:    \033[1;34mhttp://127.0.0.1/\033[0m"
        echo -e "👉 phpMyAdmin:    \033[1;34mhttp://127.0.0.1:8080/\033[0m\n"

        if [ "$1" = "all" ] || [ "$2" = "all" ]; then
            echo -e "\033[1;33m⚡ Starte alle Entwicklungs-Dienste parallel in diesem Terminal:\033[0m"
            echo -e "   \033[1;36m[WEBSOCKET]\033[0m php artisan reverb:start"
            echo -e "   \033[1;33m[WORKER]   \033[0m php artisan queue:listen --timeout=900"
            echo -e "   \033[1;35m[NPM WATCH]\033[0m npm run watch"
            echo -e "💡 \033[1;32mDrücke STRG + C, um alle 3 Prozesse sauber gemeinsam zu beenden.\033[0m\n"

            # NVM / Node sicherstellen (falls in Subshell noch nicht geladen)
            export NVM_DIR="$HOME/.nvm"
            [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"

            cleanup_all() {
                echo -e "\n\033[1;31m🛑 Beende WebSocket, Queue-Worker und NPM Watch...\033[0m"
                kill 0 2>/dev/null
                echo -e "\033[1;32m✅ Alle Hintergrundprozesse wurden sauber gestoppt.\033[0m"
                exit 0
            }
            trap cleanup_all SIGINT SIGTERM

            # 1. Reverb WebSocket
            (
                docker compose exec -T web php artisan reverb:start 2>&1 | while IFS= read -r line; do
                    echo -e "\033[1;36m[WEBSOCKET]\033[0m $line"
                done
            ) &

            # 2. Queue Worker
            (
                docker compose exec -T web php artisan queue:listen --timeout=900 2>&1 | while IFS= read -r line; do
                    echo -e "\033[1;33m[WORKER]   \033[0m $line"
                done
            ) &

            # 3. NPM Watch
            (
                npm run watch 2>&1 | while IFS= read -r line; do
                    echo -e "\033[1;35m[NPM WATCH]\033[0m $line"
                done
            ) &

            wait
        fi
        ;;
    stop)
        require_local "stop"
        echo "🛑 Stoppe Funki..."
        docker compose down --remove-orphans
        ;;
    restart)
        require_local "restart"
        echo "🔄 Starte Funki neu..."
        docker compose restart
        ;;
    bauen)
        require_local "bauen"
        echo "🏗️ Baue Funki neu..."
        docker compose up -d --build
        ;;
    löschen)
        require_local "löschen"
        echo "💥 Lösche Funki (inkl. Volumes)..."
        docker compose down -v
        ;;
    uploadlimit)
        require_local "uploadlimit"
        LIMIT=${2:-100M}
        echo "⚙️ Setze PHP Upload-Limit im Container auf $LIMIT..."
        docker compose exec -u root web bash -c "echo 'upload_max_filesize = $LIMIT' > /usr/local/etc/php/conf.d/99-uploads.ini && echo 'post_max_size = $LIMIT' >> /usr/local/etc/php/conf.d/99-uploads.ini"
        docker compose restart web
        echo "✅ Upload-Limit erfolgreich auf $LIMIT gesetzt!"
        ;;
    migrate)
        if [ "$2" = "fresh" ]; then
            echo "🗄️ Setze Datenbank komplett zurück (migrate:fresh --seed)..."
            $PREFIX_DEFAULT php artisan down --retry=5 &>/dev/null || true
            trap '$PREFIX_DEFAULT php artisan up &>/dev/null || true' EXIT
            $PREFIX_DEFAULT php artisan migrate:fresh --seed
            $PREFIX_DEFAULT php artisan up &>/dev/null || true
            trap - EXIT
        else
            echo "🗄️ Führe inkrementelle Migrationen aus (php artisan migrate)..."
            $PREFIX_DEFAULT php artisan migrate
        fi
        run_rights
        ;;
    key)
        echo "🔑 Führe Key Generate aus..."
        $PREFIX_DEFAULT php artisan key:generate
        ;;
    storage)
        echo "🗂️ Lösche alten Storage-Link restlos..."
        $PREFIX_DEFAULT rm -rf public/storage
        echo "🔗 Erstelle neuen Storage-Link..."
        $PREFIX_DEFAULT php artisan storage:link
        echo "✅ Storage-Link erfolgreich erneuert!"
        ;;
    export)
        shift
        OPTIONS=()
        SEARCH_TERMS=()

        # Argumente filtern (Flags vs Suchbegriffe)
        for arg in "$@"; do
            if [[ "$arg" == search=* ]]; then
                SEARCH_TERMS+=("${arg#search=}")
            elif [[ "$arg" == --* ]]; then
                OPTIONS+=("$arg")
            else
                # Entfernt ein versehentliches Komma am Ende eines Wortes,
                # falls der User "funki export wort1, wort2" tippt.
                clean_arg=$(echo "$arg" | sed 's/,$//')
                SEARCH_TERMS+=("$clean_arg")
            fi
        done

        # Array der Suchbegriffe zu einem kommagetrennten String verbinden
        if [ ${#SEARCH_TERMS[@]} -gt 0 ]; then
            SEARCH_STRING=$(IFS=,; echo "${SEARCH_TERMS[*]}")
            OPTIONS+=("--search=$SEARCH_STRING")
        fi

        echo "📦 Exportiere Projektdateien..."
        $PREFIX_DEFAULT php artisan project:export "${OPTIONS[@]}"
        ;;
    templates)
        echo "🎨 Exportiere UI Produkt-Vorlagen sicher in den Code..."
        $PREFIX_DEFAULT php artisan shop:export-templates
        ;;
    aimap)
        echo "🗺️ Generiere System-Architektur Map für KI Agenten..."
        $PREFIX_DEFAULT php artisan ai:generate-map
        ;;
    systemmap)
        echo "🧠 Generiere Neurale System Brain Map für die 3D Analyse..."
        $PREFIX_DEFAULT php artisan system:brain:generate
        ;;
    worker)
        echo "👷 Starte Funki Queue-Worker (lauscht auf Hintergrund-Jobs)..."
        $PREFIX_DEFAULT php artisan queue:listen --timeout=900
        ;;
    clock)
        echo "⏱️ Starte Funki Scheduler (führt zeitgesteuerte Cron-Jobs in Echtzeit aus)..."
        $PREFIX_DEFAULT php artisan schedule:work
        ;;
    websocket)
        echo "🌐 Starte Reverb WebSocket-Server..."
        $PREFIX_DEFAULT php artisan reverb:start
        ;;
    mails)
        echo "📧 Rufe neue E-Mails per IMAP ab..."
        $PREFIX_DEFAULT php artisan crm:fetch-mails
        ;;
    mailworker)
        shift
        echo "🤖 Starte den autonomen KI-Mail-Worker (Funki)..."
        $PREFIX_DEFAULT php artisan crm:ai-process-mails "$@"
        ;;
    telefon)
        echo "📞 Starte die Echtzeit Audio-Bridge für Telefonie (Node.js)..."
        echo "💡 Hinweis: Dieser Prozess muss aktiv bleiben, während telefoniert wird!"
        node server-twilio.js
        ;;
    backup)
        echo "💾 Erstelle sicheres Datenbank-Backup..."
        $PREFIX_DEFAULT php artisan backup:run --only-db
        echo "🔧 Repariere Zugriffsrechte für das Dashboard..."

        if [ "$IS_LOCAL" = true ]; then
            docker compose exec -u root web chmod -R 777 storage/
        else
            chmod -R 775 storage/
        fi

        echo "✅ Backup erfolgreich abgeschlossen!"
        ;;
    rights)
        run_rights
        ;;
    sync-worker)
        if [ "$IS_LOCAL" = true ]; then
            echo -e "⚠️  \033[1;33mHinweis:\033[0m Der Befehl '\033[1;32msync-worker\033[0m' wird nur auf dem Live-Server benötigt, um Code in den isolierten Worker-Container zu kopieren. Lokal läuft bereits alles über denselben Codeordner."
            exit 1
        fi

        SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
        SRC_DIR="$SCRIPT_DIR/"
        DEST_DIR="$(dirname "$SCRIPT_DIR")/worker-stage-3/"

        if [ ! -d "$DEST_DIR" ]; then
            echo -e "❌ \033[1;31mFehler:\033[0m Das Zielverzeichnis '$DEST_DIR' existiert nicht!"
            exit 1
        fi

        echo "🔄 Kopiere Projektdateien..."
        echo "   👉 Quelle: $SRC_DIR"
        echo "   👉 Ziel:   $DEST_DIR"

        rsync -a --stats --delete \
          --exclude='storage' \
          --exclude='.env' \
          --exclude='.git' \
          --exclude='node_modules' \
          "$SRC_DIR" "$DEST_DIR"

        if [ -f "$SCRIPT_DIR/storage/app/vertex-service-account.json" ]; then
            mkdir -p "$DEST_DIR/storage/app"
            cp -f "$SCRIPT_DIR/storage/app/vertex-service-account.json" "$DEST_DIR/storage/app/vertex-service-account.json"
            chmod 600 "$DEST_DIR/storage/app/vertex-service-account.json" || true
        fi

        echo "🧹 Bereinige Cache im Worker..."
        cd "$DEST_DIR"
        php artisan config:clear
        php artisan cache:clear

        TWILIO_BRIDGE_DIR="$(dirname "$SCRIPT_DIR")/twilio-bridge"
        if [ -d "$TWILIO_BRIDGE_DIR" ] && [ -f "$SCRIPT_DIR/server-twilio.js" ]; then
            echo "🔄 Synchronisiere server-twilio.js & Bridge-Secret mit twilio-bridge..."
            cp -f "$SCRIPT_DIR/server-twilio.js" "$TWILIO_BRIDGE_DIR/server-twilio.js"
            if [ -f "$SCRIPT_DIR/storage/app/vertex-service-account.json" ]; then
                cp -f "$SCRIPT_DIR/storage/app/vertex-service-account.json" "$TWILIO_BRIDGE_DIR/vertex-service-account.json"
                chmod 600 "$TWILIO_BRIDGE_DIR/vertex-service-account.json" || true
            fi
            if [ -f "$SCRIPT_DIR/.env" ] && [ -f "$TWILIO_BRIDGE_DIR/.env" ]; then
                STAGE_BRIDGE_SECRET="$(grep -E '^GEMINI_BRIDGE_SECRET=' "$SCRIPT_DIR/.env" | tail -n 1 | cut -d'=' -f2- | tr -d ' "\r' || true)"
                if [ -z "$STAGE_BRIDGE_SECRET" ]; then
                    STAGE_BRIDGE_SECRET="$(php -r 'echo bin2hex(random_bytes(32));')"
                    printf '\nGEMINI_BRIDGE_SECRET=%s\n' "$STAGE_BRIDGE_SECRET" >> "$SCRIPT_DIR/.env"
                    php "$SCRIPT_DIR/artisan" config:clear >/dev/null 2>&1 || true
                fi
                if grep -qE '^GEMINI_BRIDGE_SECRET=' "$TWILIO_BRIDGE_DIR/.env"; then
                    sed -i "s|^GEMINI_BRIDGE_SECRET=.*|GEMINI_BRIDGE_SECRET=${STAGE_BRIDGE_SECRET}|" "$TWILIO_BRIDGE_DIR/.env"
                else
                    printf '\nGEMINI_BRIDGE_SECRET=%s\n' "$STAGE_BRIDGE_SECRET" >> "$TWILIO_BRIDGE_DIR/.env"
                fi
                if [ -f "$DEST_DIR/.env" ]; then
                    if grep -qE '^GEMINI_BRIDGE_SECRET=' "$DEST_DIR/.env"; then
                        sed -i "s|^GEMINI_BRIDGE_SECRET=.*|GEMINI_BRIDGE_SECRET=${STAGE_BRIDGE_SECRET}|" "$DEST_DIR/.env"
                    else
                        printf '\nGEMINI_BRIDGE_SECRET=%s\n' "$STAGE_BRIDGE_SECRET" >> "$DEST_DIR/.env"
                    fi
                fi
            fi
        fi

        echo "✅ Sync erfolgreich abgeschlossen!"
        echo "💡 Beim Aufruf über './funki stage-deploy' (bzw. 'FunkenwerkMcp.exe --stage-restart-workers') werden beide Container automatisch neu gestartet:"
        echo "   - WORKER - Websocket Stage (a-iurgq8): mittnitectl job restart"
        echo "   - seelenfunke-nodejs / twilio-bridge (a-yeq7el): mittnitectl job restart"
        ;;
    shop-manifest)
        shift
        $PREFIX_DEFAULT php artisan system:shop-asset-manifest --write "$@"
        ;;
    stage-deploy)
        shift
        if [ "$IS_LOCAL" = true ]; then
            echo "🛍️ Aktualisiere reines Shop-Asset-Manifest (Musik, Buchhaltung & Privatdaten bleiben 100 % lokal)..."
            $PREFIX_DEFAULT php artisan system:shop-asset-manifest --write
            LOCAL_VERTEX_SA="storage/app/vertex-service-account.json"
            STAGE_SSH_KEY="/home/ubuntuxina/.ssh/id_ed25519"
            STAGE_SSH_TARGET="kontakt@mein-seelenfunke.de@a-lc6tkm@ssh.altgemeinde.project.host"
            STAGE_REMOTE_ROOT="/home/p-g27wim/html/seelenfunke-stage"
            if [ -f "$LOCAL_VERTEX_SA" ] && [ -f "$STAGE_SSH_KEY" ]; then
                echo "🔐 Synchronisiere Vertex-AI-Service-Account verschlüsselt nach Stage (chmod 600)..."
                ssh -i "$STAGE_SSH_KEY" -o BatchMode=yes -o ConnectTimeout=12 "$STAGE_SSH_TARGET" \
                    "mkdir -p '$STAGE_REMOTE_ROOT/storage/app' && cat > '$STAGE_REMOTE_ROOT/storage/app/vertex-service-account.json' && chmod 600 '$STAGE_REMOTE_ROOT/storage/app/vertex-service-account.json'" < "$LOCAL_VERTEX_SA"
            fi
            MCP_EXE="$(resolve_mcp_exe)"
            if [ -f "$MCP_EXE" ]; then
                echo "🚢 Starte verschlüsselten Stage-Autopilot über Funkenwerk MCP..."
                "$MCP_EXE" --stage-deploy "$@"
                exit $?
            elif [ -f "$STAGE_SSH_KEY" ]; then
                echo "🚢 Starte Stage-Deploy direkt per Ed25519-SSH auf '$STAGE_REMOTE_ROOT'..."
                ssh -i "$STAGE_SSH_KEY" -o BatchMode=yes -o ConnectTimeout=15 "$STAGE_SSH_TARGET" \
