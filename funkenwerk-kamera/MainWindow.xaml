                                                <TextBlock x:Name="CamDeepFakeOpacityTxt" Grid.Column="2" Text="100 %" Foreground="#C5A059" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>

                                            <Border Height="1" Background="#232734" Margin="0,0,0,10"/>

                                            <!-- 106-Point Facial Landmark AR Special Effects -->
                                            <TextBlock Text="🤖 KI GESICHTS-TRACKING AR-EFFEKTE (106 LANDMARKS)" Foreground="#9CA3AF" FontSize="10.5" FontWeight="Bold" Margin="0,0,0,6"/>
                                            <UniformGrid x:Name="CamDeepFakeArGrid" Columns="2" Rows="3">
                                                <Button Click="CamDeepFakeArMode_Click" Tag="none" Background="#C5A059" Foreground="#111827" FontWeight="Bold" BorderThickness="0" Padding="6,6" Margin="0,0,3,4" Cursor="Hand" FontSize="11" Content="🙂 Kein AR-Overlay">
                                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style></Button.Resources>
                                                </Button>
                                                <Button Click="CamDeepFakeArMode_Click" Tag="cyber_visor" Background="#13161F" Foreground="#D1D5DB" BorderThickness="0" Padding="6,6" Margin="3,0,0,4" Cursor="Hand" FontSize="11" Content="🕶 Cyber-Laser Visor">
                                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style></Button.Resources>
                                                </Button>
                                                <Button Click="CamDeepFakeArMode_Click" Tag="anime_eyes" Background="#13161F" Foreground="#D1D5DB" BorderThickness="0" Padding="6,6" Margin="0,0,3,4" Cursor="Hand" FontSize="11" Content="👀 Anime Big Eyes">
                                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style></Button.Resources>
                                                </Button>
                                                <Button Click="CamDeepFakeArMode_Click" Tag="alien_morph" Background="#13161F" Foreground="#D1D5DB" BorderThickness="0" Padding="6,6" Margin="3,0,0,4" Cursor="Hand" FontSize="11" Content="👽 Alien Face Morph">
                                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style></Button.Resources>
                                                </Button>
                                                <Button Click="CamDeepFakeArMode_Click" Tag="terminator" Background="#13161F" Foreground="#D1D5DB" BorderThickness="0" Padding="6,6" Margin="0,0,3,0" Cursor="Hand" FontSize="11" Content="🔴 Terminator HUD">
                                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style></Button.Resources>
                                                </Button>
                                                <Button Click="CamDeepFakeArMode_Click" Tag="pixel_anon" Background="#13161F" Foreground="#D1D5DB" BorderThickness="0" Padding="6,6" Margin="3,0,0,0" Cursor="Hand" FontSize="11" Content="🕵️‍♂️ KI Anonymisierer">
                                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style></Button.Resources>
                                                </Button>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- ======================================================= -->
                                <!-- INSPECTOR PANE 4: GREENSCREEN / CHROMA KEY + PIPETTE    -->
                                <!-- (Requirement 14 - Upgraded YCbCr + Spill Suppression)   -->
                                <!-- ======================================================= -->
                                <StackPanel x:Name="CamInspectorChromaPane" Visibility="Collapsed">
                                    <Border Background="#181B24" BorderBrush="#262A36" BorderThickness="1" CornerRadius="12" Padding="12,12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <!-- Master Enable -->
                                            <Grid Margin="0,0,0,10" ToolTip="Präzise YCbCr-Farbentfernung inklusive grüner Kanten-Entfärbung (Despill)">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="🟩 Studio Chroma Key (YCbCr + Despill)" Foreground="#F9FAFB" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                                <CheckBox x:Name="CamChromaEnableCheck" Grid.Column="1" VerticalAlignment="Center" Checked="CamChromaEnableCheck_Changed" Unchecked="CamChromaEnableCheck_Changed" Cursor="Hand">
                                                    <CheckBox.LayoutTransform><ScaleTransform ScaleX="1.2" ScaleY="1.2"/></CheckBox.LayoutTransform>
                                                </CheckBox>
                                            </Grid>

                                            <!-- Color Swatch + Eyedropper Pipette Button -->
                                            <TextBlock Text="SCHLÜSSELFARBE &amp; PIPETTE (5x5 MEDIAN-SAMPLE)" Foreground="#9CA3AF" FontSize="10.5" FontWeight="Bold" Margin="0,0,0,5"/>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="42"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border x:Name="CamChromaColorSwatch" Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#00B43C" BorderBrush="#F9FAFB" BorderThickness="1.5" HorizontalAlignment="Left"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0">
                                                    <TextBlock x:Name="CamChromaHexTxt" Text="#00B43C" Foreground="#F9FAFB" FontSize="12.5" FontWeight="Bold"/>
                                                    <TextBlock x:Name="CamChromaRgbTxt" Text="R: 0  G: 180  B: 60" Foreground="#9CA3AF" FontSize="10.5"/>
                                                </StackPanel>
                                                <Button x:Name="CamEyedropperPipetteBtn" Grid.Column="2" Click="CamStartEyedropper_Click" Background="#C5A059" Foreground="#111827" FontWeight="Bold" BorderThickness="0" Padding="12,8" Cursor="Hand" FontSize="11.5" ToolTip="Klicke hier und danach im Live-Kamerabild auf die gewünschte Hintergrundfarbe" Content="💧 Pipette">
                                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                                </Button>
                                            </Grid>

                                            <!-- Quick Color Presets -->
                                            <UniformGrid Columns="3" Rows="1" Margin="0,0,0,12">
                                                <Button Click="CamChromaPresetColor_Click" Tag="0,180,60" Background="#13161F" Foreground="#34D399" BorderThickness="0" Padding="6,5" Margin="0,0,3,0" Cursor="Hand" FontSize="10.5" FontWeight="Bold" Content="🟩 Grün">
                                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                                </Button>
                                                <Button Click="CamChromaPresetColor_Click" Tag="0,95,210" Background="#13161F" Foreground="#60A5FA" BorderThickness="0" Padding="6,5" Margin="2,0,2,0" Cursor="Hand" FontSize="10.5" FontWeight="Bold" Content="🟦 Bluescreen">
                                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                                </Button>
                                                <Button Click="CamChromaPresetColor_Click" Tag="215,215,215" Background="#13161F" Foreground="#E5E7EB" BorderThickness="0" Padding="6,5" Margin="3,0,0,0" Cursor="Hand" FontSize="10.5" FontWeight="Bold" Content="⬜ Weiße Wand">
                                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                                </Button>
                                            </UniformGrid>

                                            <!-- Tolerance & Edge Smoothness -->
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Toleranz:" Foreground="#D1D5DB" FontSize="11.5" VerticalAlignment="Center"/>
                                                <Slider x:Name="CamChromaToleranceSlider" Grid.Column="1" Minimum="5" Maximum="100" Value="38" ValueChanged="CamChromaSlider_ValueChanged" Cursor="Hand"/>
                                                <TextBlock x:Name="CamChromaToleranceTxt" Grid.Column="2" Text="38 %" Foreground="#C5A059" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>

                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Kantenglättung:" Foreground="#D1D5DB" FontSize="11.5" VerticalAlignment="Center"/>
                                                <Slider x:Name="CamChromaSmoothSlider" Grid.Column="1" Minimum="0" Maximum="60" Value="18" ValueChanged="CamChromaSlider_ValueChanged" Cursor="Hand"/>
                                                <TextBlock x:Name="CamChromaSmoothTxt" Grid.Column="2" Text="18 %" Foreground="#C5A059" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>

                                            <Border Height="1" Background="#232734" Margin="0,0,0,10"/>

                                            <!-- Replacement Background Selection -->
                                            <TextBlock Text="ERSATZ-HINTERGRUND" Foreground="#9CA3AF" FontSize="10.5" FontWeight="Bold" Margin="0,0,0,5"/>
                                            <ComboBox x:Name="CamChromaBgModeCombo" SelectionChanged="CamChromaBgModeCombo_SelectionChanged" SelectedIndex="0" Padding="8,6" FontSize="12" Margin="0,0,0,8">
                                                <ComboBoxItem Content="🌌 Funkenwerk Cyber-Studio" Tag="studio_cyber"/>
                                                <ComboBoxItem Content="✨ Seelenfunke Gold-Lounge" Tag="studio_gold"/>
                                                <ComboBoxItem Content="🌫 Portrait-Unschärfe (Bokeh Blur)" Tag="blur"/>
                                                <ComboBoxItem Content="🎮 Geteiltes Fenster / Gaming-Bild" Tag="secondary"/>
                                                <ComboBoxItem Content="🖼 Eigenes Hintergrundbild..." Tag="image"/>
                                            </ComboBox>

                                            <Button Click="CamChooseChromaImage_Click" Background="#1F2430" Foreground="#C5A059" BorderThickness="0" Padding="10,7" Cursor="Hand" FontSize="11.5" FontWeight="Bold" Content="🖼 Eigenes Hintergrundbild wählen...">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

        <Grid x:Name="CamSettingsModalOverlay" Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="999" Visibility="Collapsed" Background="#BF000000">
            <Border Width="480" VerticalAlignment="Center" HorizontalAlignment="Center" Background="#141720" BorderBrush="#C5A059" BorderThickness="1.5" CornerRadius="14" Padding="22">
                <StackPanel>
                    <TextBlock Text="Kamera-Einstellungen" FontSize="16" FontWeight="Bold" Foreground="#F9FAFB" Margin="0,0,0,14"/>
                    <TextBlock Text="MEDIEN-ORDNER" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="CamSettingsPathBox" Background="#0F1117" Foreground="#F9FAFB" BorderBrush="#262A36" Padding="10,7" FontSize="12"/>
                        <Button Grid.Column="1" Click="BrowseCamSettingsFolder_Click" Background="#1E222D" Foreground="#C5A059" BorderThickness="0" Padding="12,7" Margin="8,0,0,0" Cursor="Hand" FontWeight="Bold" Content="Ordner..."/>
                    </Grid>
                    <Button Click="RegisterVirtualCamFromModal_Click" Background="#26231F" Foreground="#C5A059" BorderBrush="#C5A059" BorderThickness="1" Padding="12,8" Margin="0,0,0,16" Cursor="Hand" FontWeight="Bold" Content="🎥 Virtuelle Kamera in Windows registrieren"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Click="CloseCamSettingsModal_Click" Background="#1E222D" Foreground="#D1D5DB" BorderThickness="0" Padding="14,8" Margin="0,0,8,0" Cursor="Hand" FontWeight="SemiBold" Content="Abbrechen"/>
                        <Button Click="SaveCamSettingsModal_Click" Background="#C5A059" Foreground="#111827" BorderThickness="0" Padding="16,8" Cursor="Hand" FontWeight="Bold" Content="Speichern"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
