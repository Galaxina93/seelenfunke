<Window x:Class="FunkenwerkFtp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Funkenwerk FTP"
        Icon="funkenwerk_ftp.ico"
        Width="1360" Height="820"
        MinWidth="1020" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#0F1117"
        Foreground="#F9FAFB"
        FontFamily="Segoe UI"
        Closing="Window_Closing">

    <Grid x:Name="RootGrid" Background="#0F1117">
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="38"/>
        </Grid.RowDefinitions>

        <!-- ================================================================= -->
        <!-- ROW 0: COMPACT CONNECTION BAR                                     -->
        <!-- ================================================================= -->
        <Border x:Name="TopBarBorder" Grid.Row="0" Background="#12151E" BorderBrush="#232734" BorderThickness="0,0,0,1" Padding="18,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="82"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="155"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <Image Source="funkenwerk_ftp.png" Width="30" Height="30" Margin="0,0,9,0"/>
                    <TextBlock x:Name="BrandTitleTxt" Text="FUNKENWERK FTP" Foreground="#C5A059" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Saved Profiles Dropdown -->
                <ComboBox x:Name="ProfilesCombo" Grid.Column="1" Height="34" VerticalContentAlignment="Center"
                          DisplayMemberPath="Name" SelectionChanged="ProfilesCombo_SelectionChanged"
                          Margin="0,0,6,0" Padding="8,0"/>

                <!-- Save / Delete Profile -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button x:Name="SaveProfileBtn" Content="💾" Width="32" Height="34" Click="SaveProfile_Click"
                            Background="#1B1F2B" Foreground="#C5A059" BorderBrush="#2D3343" Cursor="Hand" Margin="0,0,4,0"/>
                    <Button x:Name="DeleteProfileBtn" Content="✕" Width="32" Height="34" Click="DeleteProfile_Click"
                            Background="#1B1F2B" Foreground="#9CA3AF" BorderBrush="#2D3343" Cursor="Hand"/>
                </StackPanel>

                <!-- Protocol -->
                <ComboBox x:Name="ProtocolCombo" Grid.Column="3" Height="34" VerticalContentAlignment="Center"
                          SelectionChanged="ProtocolCombo_SelectionChanged" Margin="0,0,6,0" Padding="6,0">
                    <ComboBoxItem Content="SFTP" IsSelected="True"/>
                    <ComboBoxItem Content="FTPS"/>
                    <ComboBoxItem Content="FTP"/>
                </ComboBox>

                <!-- Host -->
                <TextBox x:Name="HostBox" Grid.Column="4" Height="34" VerticalContentAlignment="Center"
                         Background="#181C26" Foreground="#F9FAFB" BorderBrush="#2D3343" Padding="9,0" Margin="0,0,6,0"
                         Tag="Host"/>

                <!-- Port -->
                <TextBox x:Name="PortBox" Grid.Column="5" Height="34" VerticalContentAlignment="Center" Text="22"
                         Background="#181C26" Foreground="#F9FAFB" BorderBrush="#2D3343" Padding="6,0" Margin="0,0,6,0"
                         HorizontalContentAlignment="Center"/>

                <!-- Username -->
                <TextBox x:Name="UserBox" Grid.Column="6" Height="34" VerticalContentAlignment="Center"
                         Background="#181C26" Foreground="#F9FAFB" BorderBrush="#2D3343" Padding="8,0" Margin="0,0,6,0"/>

                <!-- Password + Mandatory Eye Icon -->
                <Border x:Name="PassContainerBorder" Grid.Column="7" Height="34" Background="#181C26" BorderBrush="#2D3343" BorderThickness="1" Margin="0,0,6,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="28"/>
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="PassBox" Grid.Column="0" Background="Transparent" Foreground="#F9FAFB"
                                     BorderThickness="0" VerticalContentAlignment="Center" Padding="7,0"
                                     PasswordChanged="PassBox_PasswordChanged"/>
                        <TextBox x:Name="PassVisibleBox" Grid.Column="0" Background="Transparent" Foreground="#F9FAFB"
                                 BorderThickness="0" VerticalContentAlignment="Center" Padding="7,0" Visibility="Collapsed"
                                 TextChanged="PassVisibleBox_TextChanged"/>
                        <Button x:Name="TogglePassEyeBtn" Grid.Column="1" Content="👁" Background="Transparent"
                                Foreground="#9CA3AF" BorderThickness="0" Cursor="Hand" Click="TogglePassEye_Click"/>
                    </Grid>
                </Border>

                <!-- SSH Private Key Picker -->
                <Button x:Name="PickKeyBtn" Grid.Column="8" Content="🔑" Width="34" Height="34" Click="PickKey_Click"
                        Background="#1B1F2B" Foreground="#C5A059" BorderBrush="#2D3343" Cursor="Hand" Margin="0,0,8,0"/>

                <!-- Connect / Disconnect Button -->
                <Button x:Name="ConnectBtn" Grid.Column="9" Content="⚡ VERBINDEN" Height="34" Padding="16,0"
                        Click="Connect_Click" Background="#C5A059" Foreground="#0F1117" FontWeight="Bold"
                        BorderThickness="0" Cursor="Hand" Margin="0,0,8,0"/>

                <!-- Theme Toggle -->
                <Button x:Name="ThemeToggleBtn" Grid.Column="10" Content="☀" Width="34" Height="34"
                        Click="ThemeToggle_Click" Background="#1B1F2B" Foreground="#C5A059" BorderBrush="#2D3343" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- ================================================================= -->
        <!-- ROW 1: CLEAN 2-TILE SPLIT VIEW (LINKS: LOKAL | RECHTS: SERVER)    -->
        <!-- ================================================================= -->
        <Grid Grid.Row="1" Margin="18,14,18,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT TILE: LOKAL -->
            <Border x:Name="LocalTileBorder" Grid.Column="0" Background="#141821" BorderBrush="#242938" BorderThickness="1" CornerRadius="14" Padding="16"
                    AllowDrop="True" PreviewDragOver="LocalTile_PreviewDragOver" PreviewDrop="LocalTile_PreviewDrop" DragLeave="LocalTile_DragLeave">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Tile Header + Action Buttons -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LocalHeaderTxt" Text="LOKAL" Foreground="#C5A059" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="⬆" Width="30" Height="28" Click="LocalUp_Click" Background="#1D2230" Foreground="#E5E7EB" BorderBrush="#2D3343" Cursor="Hand" Margin="0,0,5,0"/>
                            <Button Content="⟳" Width="30" Height="28" Click="LocalRefresh_Click" Background="#1D2230" Foreground="#E5E7EB" BorderBrush="#2D3343" Cursor="Hand" Margin="0,0,5,0"/>
                            <Button Content="+ Ordner" Height="28" Padding="10,0" Click="LocalMkdir_Click" Background="#1D2230" Foreground="#E5E7EB" BorderBrush="#2D3343" Cursor="Hand" Margin="0,0,5,0"/>
                            <Button Content="🗑" Width="30" Height="28" Click="LocalDelete_Click" Background="#1D2230" Foreground="#F87171" BorderBrush="#2D3343" Cursor="Hand" Margin="0,0,8,0"/>
                            <Button Content="HOCHLADEN →" Height="28" Padding="12,0" Click="UploadSelected_Click" Background="#C5A059" Foreground="#0F1117" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                        </StackPanel>
                    </Grid>

                    <!-- Local Path Box -->
                    <TextBox x:Name="LocalPathBox" Grid.Row="1" Height="32" VerticalContentAlignment="Center"
                             Background="#0F1117" Foreground="#E5E7EB" BorderBrush="#252A3A" Padding="10,0" Margin="0,0,0,10"
                             KeyDown="LocalPathBox_KeyDown"/>

                    <!-- Local Files List -->
                    <ListView x:Name="LocalFilesList" Grid.Row="2" Background="#01000000" Foreground="#F3F4F6"
                              BorderThickness="0" MouseDoubleClick="LocalFilesList_MouseDoubleClick"
                              AllowDrop="True"
                              PreviewMouseLeftButtonDown="LocalFilesList_PreviewMouseLeftButtonDown"
                              PreviewMouseMove="LocalFilesList_PreviewMouseMove"
                              PreviewDragOver="LocalTile_PreviewDragOver"
                              PreviewDrop="LocalTile_PreviewDrop"
                              SelectionMode="Extended">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name" Width="280" DisplayMemberBinding="{Binding DisplayName}"/>
                                <GridViewColumn Header="Größe" Width="100" DisplayMemberBinding="{Binding SizeFormatted}"/>
                                <GridViewColumn Header="Geändert" Width="140" DisplayMemberBinding="{Binding ModifiedFormatted}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>

            <!-- RIGHT TILE: SERVER -->
            <Border x:Name="RemoteTileBorder" Grid.Column="2" Background="#141821" BorderBrush="#242938" BorderThickness="1" CornerRadius="14" Padding="16"
                    AllowDrop="True" PreviewDragOver="RemoteTile_PreviewDragOver" PreviewDrop="RemoteTile_PreviewDrop" DragLeave="RemoteTile_DragLeave">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Tile Header + Action Buttons -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="RemoteHeaderTxt" Text="SERVER" Foreground="#C5A059" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="OpenSshBtn" Content="SSH" Height="28" Padding="12,0" Click="OpenSsh_Click" Background="#1D2230" Foreground="#C5A059" FontWeight="Bold" BorderBrush="#C5A059" BorderThickness="1" Cursor="Hand" Margin="0,0,8,0" Visibility="Collapsed"/>
                            <Button Content="← HERUNTERLADEN" Height="28" Padding="12,0" Click="DownloadSelected_Click" Background="#C5A059" Foreground="#0F1117" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0"/>
                            <Button Content="⬆" Width="30" Height="28" Click="RemoteUp_Click" Background="#1D2230" Foreground="#E5E7EB" BorderBrush="#2D3343" Cursor="Hand" Margin="0,0,5,0"/>
                            <Button Content="⟳" Width="30" Height="28" Click="RemoteRefresh_Click" Background="#1D2230" Foreground="#E5E7EB" BorderBrush="#2D3343" Cursor="Hand" Margin="0,0,5,0"/>
                            <Button Content="+ Ordner" Height="28" Padding="10,0" Click="RemoteMkdir_Click" Background="#1D2230" Foreground="#E5E7EB" BorderBrush="#2D3343" Cursor="Hand" Margin="0,0,5,0"/>
                            <Button Content="🗑" Width="30" Height="28" Click="RemoteDelete_Click" Background="#1D2230" Foreground="#F87171" BorderBrush="#2D3343" Cursor="Hand"/>
                        </StackPanel>
                    </Grid>

                    <!-- Remote Path Box -->
                    <TextBox x:Name="RemotePathBox" Grid.Row="1" Height="32" VerticalContentAlignment="Center" Text="/"
                             Background="#0F1117" Foreground="#E5E7EB" BorderBrush="#252A3A" Padding="10,0" Margin="0,0,0,10"
                             KeyDown="RemotePathBox_KeyDown"/>

                    <!-- Remote Files List -->
                    <ListView x:Name="RemoteFilesList" Grid.Row="2" Background="#01000000" Foreground="#F3F4F6"
                              BorderThickness="0" MouseDoubleClick="RemoteFilesList_MouseDoubleClick"
                              AllowDrop="True"
                              PreviewMouseLeftButtonDown="RemoteFilesList_PreviewMouseLeftButtonDown"
                              PreviewMouseMove="RemoteFilesList_PreviewMouseMove"
                              PreviewDragOver="RemoteTile_PreviewDragOver"
                              PreviewDrop="RemoteTile_PreviewDrop"
                              SelectionMode="Extended">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name" Width="260" DisplayMemberBinding="{Binding DisplayName}"/>
                                <GridViewColumn Header="Größe" Width="95" DisplayMemberBinding="{Binding SizeFormatted}"/>
                                <GridViewColumn Header="Rechte" Width="85" DisplayMemberBinding="{Binding Permissions}"/>
                                <GridViewColumn Header="Geändert" Width="135" DisplayMemberBinding="{Binding ModifiedFormatted}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <!-- ================================================================= -->
        <!-- ROW 2: MINIMAL SECURITY & TRANSFER STATUS BAR                     -->
        <!-- ================================================================= -->
        <Border x:Name="BottomBarBorder" Grid.Row="2" Background="#12151E" BorderBrush="#232734" BorderThickness="0,1,0,0" Padding="18,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="240"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0" Text="🔒 AES-256-GCM + DPAPI Vault aktiv"
                           Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <ProgressBar x:Name="TransferProgressBar" Grid.Column="1" Height="8" Minimum="0" Maximum="100" Value="0"
                             Background="#1E2330" Foreground="#C5A059" BorderThickness="0" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
