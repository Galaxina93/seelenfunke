<Window x:Class="FunkenwerkFtp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Funkenwerk FTP"
        Icon="funkenwerk_ftp.ico"
        Width="1400" Height="840"
        MinWidth="1040" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource FwBgRoot}"
        Foreground="{DynamicResource FwFgPrimary}"
        FontFamily="Segoe UI"
        Closing="Window_Closing">

    <Grid x:Name="RootGrid" Background="{DynamicResource FwBgRoot}" AllowDrop="True" PreviewDragOver="RootGrid_PreviewDragOver">
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="38"/>
        </Grid.RowDefinitions>

        <!-- ================================================================= -->
        <!-- ROW 0: COMPACT CONNECTION BAR                                     -->
        <!-- ================================================================= -->
        <Border x:Name="TopBarBorder" Grid.Row="0" Background="{DynamicResource FwBgBar}" BorderBrush="{DynamicResource FwBorderSubtle}" BorderThickness="0,0,0,1" Padding="18,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="82"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="155"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <Image Source="funkenwerk_ftp.png" Width="30" Height="30" Margin="0,0,9,0"/>
                    <TextBlock x:Name="BrandTitleTxt" Text="FUNKENWERK FTP" Foreground="#C5A059" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Saved Profiles Dropdown -->
                <ComboBox x:Name="ProfilesCombo" Grid.Column="1" Height="34" VerticalContentAlignment="Center"
                          DisplayMemberPath="Name" SelectionChanged="ProfilesCombo_SelectionChanged"
                          Margin="0,0,6,0" Padding="8,0" ToolTip="Gespeichertes Server-Profil"/>

                <!-- Save / Delete Profile -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button x:Name="SaveProfileBtn" Content="💾" Width="32" Height="34" Click="SaveProfile_Click"
                            Style="{StaticResource FwTileActionButton}" Foreground="#C5A059" Padding="0" Margin="0,0,4,0" ToolTip="Profil speichern"/>
                    <Button x:Name="DeleteProfileBtn" Content="✕" Width="32" Height="34" Click="DeleteProfile_Click"
                            Style="{StaticResource FwTileActionButton}" Foreground="{DynamicResource FwFgSecondary}" Padding="0" ToolTip="Profil entfernen"/>
                </StackPanel>

                <!-- Protocol -->
                <ComboBox x:Name="ProtocolCombo" Grid.Column="3" Height="34" VerticalContentAlignment="Center"
                          SelectionChanged="ProtocolCombo_SelectionChanged" Margin="0,0,6,0" Padding="6,0" ToolTip="Übertragungsprotokoll">
                    <ComboBoxItem Content="SFTP" IsSelected="True"/>
                    <ComboBoxItem Content="FTPS"/>
                    <ComboBoxItem Content="FTP"/>
                </ComboBox>

                <!-- Host -->
                <TextBox x:Name="HostBox" Grid.Column="4" Height="34" VerticalContentAlignment="Center"
                         Background="{DynamicResource FwBgInput}" Foreground="{DynamicResource FwFgPrimary}" CaretBrush="#C5A059"
                         BorderBrush="{DynamicResource FwBorderStrong}" Padding="9,0" Margin="0,0,6,0"
                         KeyDown="ConnectionInput_KeyDown" ToolTip="Server-Host oder IP"/>

                <!-- Port -->
                <TextBox x:Name="PortBox" Grid.Column="5" Height="34" VerticalContentAlignment="Center" Text="22"
                         Background="{DynamicResource FwBgInput}" Foreground="{DynamicResource FwFgPrimary}" CaretBrush="#C5A059"
                         BorderBrush="{DynamicResource FwBorderStrong}" Padding="6,0" Margin="0,0,6,0"
                         HorizontalContentAlignment="Center" KeyDown="ConnectionInput_KeyDown" ToolTip="Port"/>

                <!-- Username -->
                <TextBox x:Name="UserBox" Grid.Column="6" Height="34" VerticalContentAlignment="Center"
                         Background="{DynamicResource FwBgInput}" Foreground="{DynamicResource FwFgPrimary}" CaretBrush="#C5A059"
                         BorderBrush="{DynamicResource FwBorderStrong}" Padding="8,0" Margin="0,0,6,0"
                         KeyDown="ConnectionInput_KeyDown" ToolTip="Benutzername"/>

                <!-- Password + Mandatory Eye Icon -->
                <Border x:Name="PassContainerBorder" Grid.Column="7" Height="34" Background="{DynamicResource FwBgInput}" BorderBrush="{DynamicResource FwBorderStrong}" BorderThickness="1" Margin="0,0,6,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="28"/>
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="PassBox" Grid.Column="0" Background="Transparent" Foreground="{DynamicResource FwFgPrimary}"
                                     BorderThickness="0" VerticalContentAlignment="Center" Padding="7,0"
                                     PasswordChanged="PassBox_PasswordChanged" KeyDown="ConnectionInput_KeyDown"/>
                        <TextBox x:Name="PassVisibleBox" Grid.Column="0" Background="Transparent" Foreground="{DynamicResource FwFgPrimary}" CaretBrush="#C5A059"
                                 BorderThickness="0" VerticalContentAlignment="Center" Padding="7,0" Visibility="Collapsed"
                                 TextChanged="PassVisibleBox_TextChanged" KeyDown="ConnectionInput_KeyDown"/>
                        <Button x:Name="TogglePassEyeBtn" Grid.Column="1" Content="👁" Background="Transparent"
                                Foreground="{DynamicResource FwFgSecondary}" BorderThickness="0" Cursor="Hand" Click="TogglePassEye_Click" ToolTip="Passwort ein-/ausblenden"/>
                    </Grid>
                </Border>

                <!-- SSH Private Key Picker -->
                <Button x:Name="PickKeyBtn" Grid.Column="8" Content="🔑" Width="34" Height="34" Click="PickKey_Click"
                        Style="{StaticResource FwTileActionButton}" Foreground="#C5A059" Padding="0" Margin="0,0,8,0"/>

                <!-- Connect / Disconnect Button -->
                <Button x:Name="ConnectBtn" Grid.Column="9" Content="⚡ VERBINDEN" Height="34" Padding="16,0"
                        Click="Connect_Click" Style="{StaticResource FwGoldPrimaryButton}" Margin="0,0,8,0"/>

                <!-- Theme Toggle -->
                <Button x:Name="ThemeToggleBtn" Grid.Column="10" Content="☀" Width="34" Height="34"
                        Click="ThemeToggle_Click" Style="{StaticResource FwTileActionButton}" Foreground="#C5A059" Padding="0" ToolTip="Light-/Dark-Mode umschalten"/>
            </Grid>
        </Border>

        <!-- ================================================================= -->
        <!-- ROW 1: CLEAN 2-TILE SPLIT VIEW (LINKS: LOKAL | RECHTS: SERVER)    -->
        <!-- ================================================================= -->
        <Grid Grid.Row="1" Margin="18,14,18,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT TILE: LOKAL -->
            <Border x:Name="LocalTileBorder" Grid.Column="0" Background="{DynamicResource FwBgTile}" BorderBrush="{DynamicResource FwBorderSubtle}" BorderThickness="1.2" CornerRadius="14" Padding="16"
                    AllowDrop="True" PreviewDragOver="LocalTile_PreviewDragOver" PreviewDrop="LocalTile_PreviewDrop" DragLeave="LocalTile_DragLeave">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Tile Header + Action Buttons -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LocalHeaderTxt" Text="LOKAL" Foreground="#C5A059" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="⬆" Width="30" Click="LocalUp_Click" Style="{StaticResource FwTileActionButton}" Padding="0" Margin="0,0,4,0" ToolTip="Übergeordneter Ordner (Rücktaste)"/>
                            <Button Content="⟳" Width="30" Click="LocalRefresh_Click" Style="{StaticResource FwTileActionButton}" Padding="0" Margin="0,0,4,0" ToolTip="Aktualisieren (F5)"/>
                            <Button Content="✎" Width="30" Click="LocalEdit_Click" Style="{StaticResource FwTileActionButton}" Foreground="#C5A059" Padding="0" Margin="0,0,4,0" ToolTip="Datei bearbeiten (F4)"/>
                            <Button Content="+ Datei" Click="LocalNewFile_Click" Style="{StaticResource FwTileActionButton}" Margin="0,0,4,0" ToolTip="Neue Datei anlegen (Umschalt+F4)"/>
                            <Button Content="+ Ordner" Click="LocalMkdir_Click" Style="{StaticResource FwTileActionButton}" Margin="0,0,4,0" ToolTip="Neuer Ordner (F7)"/>
                            <Button Content="🗑" Width="30" Click="LocalDelete_Click" Style="{StaticResource FwTileActionButton}" Foreground="#F87171" Padding="0" Margin="0,0,7,0" ToolTip="Löschen (Entf)"/>
                            <Button Content="HOCHLADEN →" Click="UploadSelected_Click" Style="{StaticResource FwGoldPrimaryButton}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Local Path Box -->
                    <TextBox x:Name="LocalPathBox" Grid.Row="1" Height="32" VerticalContentAlignment="Center"
                             Background="{DynamicResource FwBgRoot}" Foreground="{DynamicResource FwFgPrimary}" CaretBrush="#C5A059"
                             BorderBrush="{DynamicResource FwBorderSubtle}" Padding="10,0" Margin="0,0,0,10"
                             KeyDown="LocalPathBox_KeyDown"/>

                    <!-- Local Files List -->
                    <ListView x:Name="LocalFilesList" Grid.Row="2" Background="#01000000" Foreground="{DynamicResource FwFgPrimary}"
                              BorderThickness="0"
                              ItemContainerStyle="{StaticResource FwFileListViewItem}"
                              GridViewColumnHeader.Click="LocalFilesList_ColumnHeaderClick"
                              MouseDoubleClick="LocalFilesList_MouseDoubleClick"
                              AllowDrop="True"
                              PreviewMouseLeftButtonDown="LocalFilesList_PreviewMouseLeftButtonDown"
                              PreviewMouseLeftButtonUp="LocalFilesList_PreviewMouseLeftButtonUp"
                              PreviewMouseRightButtonDown="LocalFilesList_PreviewMouseRightButtonDown"
                              PreviewMouseMove="LocalFilesList_PreviewMouseMove"
                              PreviewDragOver="LocalTile_PreviewDragOver"
                              PreviewDrop="LocalTile_PreviewDrop"
                              DragLeave="LocalTile_DragLeave"
                              KeyDown="LocalFilesList_KeyDown"
                              ContextMenuOpening="LocalFilesList_ContextMenuOpening"
                              SelectionMode="Extended">
                        <ListView.ContextMenu>
                            <ContextMenu x:Name="LocalContextMenu">
                                <MenuItem x:Name="MenuLocalEdit" Header="✎  Bearbeiten" InputGestureText="F4" Click="LocalEdit_Click"/>
                                <MenuItem x:Name="MenuLocalOpen" Header="📂  Öffnen" InputGestureText="Enter" Click="MenuLocalOpen_Click"/>
                                <MenuItem x:Name="MenuLocalOpenSystem" Header="💻  Im Standardprogramm öffnen" Click="MenuLocalOpenSystem_Click"/>
                                <MenuItem x:Name="MenuLocalUpload" Header="→  Auf Server hochladen" Click="UploadSelected_Click"/>
                                <Separator/>
                                <MenuItem x:Name="MenuLocalNewFile" Header="+  Neue Datei..." InputGestureText="Umschalt+F4" Click="LocalNewFile_Click"/>
                                <MenuItem x:Name="MenuLocalNewFolder" Header="+  Neuer Ordner..." InputGestureText="F7" Click="LocalMkdir_Click"/>
                                <MenuItem x:Name="MenuLocalRename" Header="🏷  Umbenennen..." InputGestureText="F2" Click="MenuLocalRename_Click"/>
                                <MenuItem x:Name="MenuLocalDuplicate" Header="⧉  Duplizieren" Click="MenuLocalDuplicate_Click"/>
                                <Separator/>
                                <MenuItem x:Name="MenuLocalCopy" Header="📋  Kopieren" InputGestureText="Strg+C" Click="MenuLocalCopy_Click"/>
                                <MenuItem x:Name="MenuLocalPaste" Header="📥  Einfügen" InputGestureText="Strg+V" Click="MenuLocalPaste_Click"/>
                                <MenuItem x:Name="MenuLocalCopyPath" Header="🔗  Pfad kopieren" Click="MenuLocalCopyPath_Click"/>
                                <MenuItem x:Name="MenuLocalRevealExplorer" Header="🧭  Im Windows Explorer zeigen" Click="MenuLocalRevealExplorer_Click"/>
                                <MenuItem x:Name="MenuLocalRefresh" Header="⟳  Aktualisieren" InputGestureText="F5" Click="LocalRefresh_Click"/>
                                <Separator/>
                                <MenuItem x:Name="MenuLocalDelete" Header="🗑  Löschen..." InputGestureText="Entf" Foreground="#F87171" Click="LocalDelete_Click"/>
                            </ContextMenu>
                        </ListView.ContextMenu>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name" Width="290" DisplayMemberBinding="{Binding DisplayName}"/>
                                <GridViewColumn Header="Größe" Width="95" DisplayMemberBinding="{Binding SizeFormatted}"/>
                                <GridViewColumn Header="Geändert" Width="140" DisplayMemberBinding="{Binding ModifiedFormatted}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>

            <!-- RIGHT TILE: SERVER -->
            <Border x:Name="RemoteTileBorder" Grid.Column="2" Background="{DynamicResource FwBgTile}" BorderBrush="{DynamicResource FwBorderSubtle}" BorderThickness="1.2" CornerRadius="14" Padding="16"
                    AllowDrop="True" PreviewDragOver="RemoteTile_PreviewDragOver" PreviewDrop="RemoteTile_PreviewDrop" DragLeave="RemoteTile_DragLeave">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Tile Header + Action Buttons -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="RemoteHeaderTxt" Text="SERVER" Foreground="#C5A059" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="OpenSshBtn" Content="SSH" Click="OpenSsh_Click" Style="{StaticResource FwTileActionButton}" Foreground="#C5A059" FontWeight="Bold" BorderBrush="#C5A059" Margin="0,0,7,0" Visibility="Collapsed" ToolTip="Aktuellen Server-Ordner direkt in Funkenwerk SSH öffnen"/>
                            <Button Content="← HERUNTERLADEN" Click="DownloadSelected_Click" Style="{StaticResource FwGoldPrimaryButton}" Margin="0,0,7,0"/>
                            <Button Content="⬆" Width="30" Click="RemoteUp_Click" Style="{StaticResource FwTileActionButton}" Padding="0" Margin="0,0,4,0" ToolTip="Übergeordneter Ordner (Rücktaste)"/>
                            <Button Content="⟳" Width="30" Click="RemoteRefresh_Click" Style="{StaticResource FwTileActionButton}" Padding="0" Margin="0,0,4,0" ToolTip="Aktualisieren (F5)"/>
                            <Button Content="✎" Width="30" Click="RemoteEdit_Click" Style="{StaticResource FwTileActionButton}" Foreground="#C5A059" Padding="0" Margin="0,0,4,0" ToolTip="Server-Datei bearbeiten (F4)"/>
                            <Button Content="+ Datei" Click="RemoteNewFile_Click" Style="{StaticResource FwTileActionButton}" Margin="0,0,4,0" ToolTip="Neue Datei auf Server (Umschalt+F4)"/>
                            <Button Content="+ Ordner" Click="RemoteMkdir_Click" Style="{StaticResource FwTileActionButton}" Margin="0,0,4,0" ToolTip="Neuer Ordner auf Server (F7)"/>
                            <Button Content="🗑" Width="30" Click="RemoteDelete_Click" Style="{StaticResource FwTileActionButton}" Foreground="#F87171" Padding="0" ToolTip="Löschen (Entf)"/>
                        </StackPanel>
                    </Grid>

                    <!-- Remote Path Box -->
                    <TextBox x:Name="RemotePathBox" Grid.Row="1" Height="32" VerticalContentAlignment="Center" Text="/"
                             Background="{DynamicResource FwBgRoot}" Foreground="{DynamicResource FwFgPrimary}" CaretBrush="#C5A059"
                             BorderBrush="{DynamicResource FwBorderSubtle}" Padding="10,0" Margin="0,0,0,10"
                             KeyDown="RemotePathBox_KeyDown"/>

                    <!-- Remote Files List -->
                    <ListView x:Name="RemoteFilesList" Grid.Row="2" Background="#01000000" Foreground="{DynamicResource FwFgPrimary}"
                              BorderThickness="0"
                              ItemContainerStyle="{StaticResource FwFileListViewItem}"
                              GridViewColumnHeader.Click="RemoteFilesList_ColumnHeaderClick"
                              MouseDoubleClick="RemoteFilesList_MouseDoubleClick"
                              AllowDrop="True"
                              PreviewMouseLeftButtonDown="RemoteFilesList_PreviewMouseLeftButtonDown"
                              PreviewMouseLeftButtonUp="RemoteFilesList_PreviewMouseLeftButtonUp"
                              PreviewMouseRightButtonDown="RemoteFilesList_PreviewMouseRightButtonDown"
                              PreviewMouseMove="RemoteFilesList_PreviewMouseMove"
                              PreviewDragOver="RemoteTile_PreviewDragOver"
                              PreviewDrop="RemoteTile_PreviewDrop"
                              DragLeave="RemoteTile_DragLeave"
                              KeyDown="RemoteFilesList_KeyDown"
                              ContextMenuOpening="RemoteFilesList_ContextMenuOpening"
                              SelectionMode="Extended">
                        <ListView.ContextMenu>
                            <ContextMenu x:Name="RemoteContextMenu">
                                <MenuItem x:Name="MenuRemoteEdit" Header="✎  Bearbeiten" InputGestureText="F4" Click="RemoteEdit_Click"/>
                                <MenuItem x:Name="MenuRemoteEditExternal" Header="💻  Extern bearbeiten (Auto-Upload)" Click="MenuRemoteEditExternal_Click"/>
                                <MenuItem x:Name="MenuRemoteOpen" Header="📂  Öffnen" InputGestureText="Enter" Click="MenuRemoteOpen_Click"/>
                                <MenuItem x:Name="MenuRemoteDownload" Header="←  Herunterladen" Click="DownloadSelected_Click"/>
                                <Separator/>
                                <MenuItem x:Name="MenuRemoteNewFile" Header="+  Neue Datei..." InputGestureText="Umschalt+F4" Click="RemoteNewFile_Click"/>
                                <MenuItem x:Name="MenuRemoteNewFolder" Header="+  Neuer Ordner..." InputGestureText="F7" Click="RemoteMkdir_Click"/>
                                <MenuItem x:Name="MenuRemoteRename" Header="🏷  Umbenennen / Verschieben..." InputGestureText="F2" Click="MenuRemoteRename_Click"/>
                                <MenuItem x:Name="MenuRemoteDuplicate" Header="⧉  Duplizieren" Click="MenuRemoteDuplicate_Click"/>
                                <MenuItem x:Name="MenuRemoteChmod" Header="🔐  Berechtigungen (CHMOD)..." Click="MenuRemoteChmod_Click"/>
                                <Separator/>
                                <MenuItem x:Name="MenuRemotePasteUpload" Header="📥  Aus Zwischenablage hochladen" InputGestureText="Strg+V" Click="MenuRemotePasteUpload_Click"/>
                                <MenuItem x:Name="MenuRemoteCopyPath" Header="🔗  Server-Pfad kopieren" Click="MenuRemoteCopyPath_Click"/>
                                <MenuItem x:Name="MenuRemoteOpenSsh" Header="💻  Hier in SSH öffnen" Click="MenuRemoteOpenSshHere_Click"/>
                                <MenuItem x:Name="MenuRemoteRefresh" Header="⟳  Aktualisieren" InputGestureText="F5" Click="RemoteRefresh_Click"/>
                                <Separator/>
                                <MenuItem x:Name="MenuRemoteDelete" Header="🗑  Löschen..." InputGestureText="Entf" Foreground="#F87171" Click="RemoteDelete_Click"/>
                            </ContextMenu>
                        </ListView.ContextMenu>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name" Width="265" DisplayMemberBinding="{Binding DisplayName}"/>
                                <GridViewColumn Header="Größe" Width="90" DisplayMemberBinding="{Binding SizeFormatted}"/>
                                <GridViewColumn Header="Rechte" Width="85" DisplayMemberBinding="{Binding Permissions}"/>
                                <GridViewColumn Header="Geändert" Width="135" DisplayMemberBinding="{Binding ModifiedFormatted}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <!-- ================================================================= -->
        <!-- ROW 2: MINIMAL SECURITY & TRANSFER STATUS BAR                     -->
        <!-- ================================================================= -->
        <Border x:Name="BottomBarBorder" Grid.Row="2" Background="{DynamicResource FwBgBar}" BorderBrush="{DynamicResource FwBorderSubtle}" BorderThickness="0,1,0,0" Padding="18,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="240"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0" Text="🔒 AES-256-GCM + DPAPI Vault aktiv"
                           Foreground="{DynamicResource FwFgSecondary}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <ProgressBar x:Name="TransferProgressBar" Grid.Column="1" Height="8" Minimum="0" Maximum="100" Value="0"
                             Background="{DynamicResource FwBgButton}" Foreground="#C5A059" BorderThickness="0" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
