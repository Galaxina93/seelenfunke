<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Public internet traffic must always use encrypted HTTPS -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Allow cleartext HTTP exclusively for local development / ADB / Emulator hosts & local Wi-Fi Smart Home Plugs -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">192.168.188.119</domain>
        <domain includeSubdomains="false">192.168.188.109</domain>
        <domain includeSubdomains="false">192.168.188.106</domain>
        <domain includeSubdomains="false">192.168.188.123</domain>
        <domain includeSubdomains="false">192.168.188.101</domain>
        <domain includeSubdomains="false">192.168.188.102</domain>
        <domain includeSubdomains="false">192.168.188.103</domain>
        <domain includeSubdomains="false">192.168.188.104</domain>
        <domain includeSubdomains="false">192.168.188.105</domain>
        <domain includeSubdomains="false">192.168.188.107</domain>
        <domain includeSubdomains="false">192.168.188.108</domain>
        <domain includeSubdomains="false">192.168.188.110</domain>
    </domain-config>
</network-security-config>
