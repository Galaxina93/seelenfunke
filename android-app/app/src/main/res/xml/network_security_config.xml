<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Public internet and API traffic must always use encrypted HTTPS -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Deterministic Let's Encrypt Generation-Y (YR1 -> Root YR -> ISRG Root X1) trust for Seelenfunke Stage & Live -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">mein-seelenfunke.de</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/isrg_root_x1" />
            <certificates src="@raw/isrg_root_yr" />
        </trust-anchors>
    </domain-config>

    <!-- Local Wi-Fi Smart Home KLAP v2 hardware plugs (no Sanctum API tokens sent here) -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.188.100</domain>
        <domain includeSubdomains="false">192.168.188.101</domain>
        <domain includeSubdomains="false">192.168.188.102</domain>
        <domain includeSubdomains="false">192.168.188.103</domain>
        <domain includeSubdomains="false">192.168.188.104</domain>
        <domain includeSubdomains="false">192.168.188.105</domain>
        <domain includeSubdomains="false">192.168.188.106</domain>
        <domain includeSubdomains="false">192.168.188.107</domain>
        <domain includeSubdomains="false">192.168.188.108</domain>
        <domain includeSubdomains="false">192.168.188.109</domain>
        <domain includeSubdomains="false">192.168.188.110</domain>
        <domain includeSubdomains="false">192.168.188.111</domain>
        <domain includeSubdomains="false">192.168.188.112</domain>
        <domain includeSubdomains="false">192.168.188.113</domain>
        <domain includeSubdomains="false">192.168.188.114</domain>
        <domain includeSubdomains="false">192.168.188.115</domain>
        <domain includeSubdomains="false">192.168.188.120</domain>
        <domain includeSubdomains="false">192.168.188.121</domain>
        <domain includeSubdomains="false">192.168.188.122</domain>
        <domain includeSubdomains="false">192.168.188.123</domain>
        <domain includeSubdomains="false">192.168.188.124</domain>
        <domain includeSubdomains="false">192.168.188.125</domain>
    </domain-config>

    <!-- Local development / ADB / Emulator API hosts restricted strictly to debug builds -->
    <debug-overrides>
        <domain-config cleartextTrafficPermitted="true">
            <domain includeSubdomains="false">127.0.0.1</domain>
            <domain includeSubdomains="false">localhost</domain>
            <domain includeSubdomains="false">10.0.2.2</domain>
            <domain includeSubdomains="false">192.168.188.119</domain>
        </domain-config>
    </debug-overrides>
</network-security-config>
