<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/subtask_item_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/widget_badge_shape"
    android:layout_marginStart="24dp"
    android:paddingVertical="5dp"
    android:paddingHorizontal="8dp"
    android:gravity="center_vertical">

    <!-- Subtask Checkbox Touch Area -->
    <FrameLayout
        android:id="@+id/subtask_checkbox_container"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:padding="4dp">

        <ImageView
            android:id="@+id/subtask_checkbox_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_checkbox_unchecked"
            android:scaleType="fitCenter"
            android:contentDescription="Unter-Schritt umschalten" />
    </FrameLayout>

    <!-- Subtask Title -->
    <TextView
        android:id="@+id/subtask_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingStart="6dp"
        android:text="Unter-Schritt"
        android:textColor="#CBD5E1"
        android:textSize="12sp"
        android:maxLines="2"
        android:ellipsize="end" />

</LinearLayout>
