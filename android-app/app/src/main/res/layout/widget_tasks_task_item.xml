<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/task_item_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/widget_item_card_shape"
    android:paddingVertical="8dp"
    android:paddingStart="6dp"
    android:paddingEnd="6dp"
    android:gravity="center_vertical">

    <!-- Checkbox Touch Area -->
    <FrameLayout
        android:id="@+id/task_checkbox_container"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:padding="6dp">

        <ImageView
            android:id="@+id/task_checkbox_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_checkbox_unchecked"
            android:scaleType="fitCenter"
            android:contentDescription="Status umschalten" />
    </FrameLayout>

    <!-- Task Title & Metadata Area -->
    <LinearLayout
        android:id="@+id/task_content_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingEnd="6dp">

        <TextView
            android:id="@+id/task_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aufgabe"
            android:textColor="#F8FAFC"
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/task_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text=""
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Priority Dot Touch Area -->
    <FrameLayout
        android:id="@+id/task_priority_container"
        android:layout_width="28dp"
        android:layout_height="32dp">

        <ImageView
            android:id="@+id/task_priority_dot"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_gravity="center"
            android:src="@drawable/selected_circle"
            android:tint="#3B82F6"
            android:contentDescription="Priorität ändern" />
    </FrameLayout>

    <!-- Edit Task Button -->
    <FrameLayout
        android:id="@+id/task_edit_button_container"
        android:layout_width="30dp"
        android:layout_height="32dp"
        android:padding="6dp">

        <ImageView
            android:id="@+id/task_edit_button"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_widget_edit"
            android:tint="#94A3B8"
            android:scaleType="fitCenter"
            android:contentDescription="Aufgabe bearbeiten" />
    </FrameLayout>

</LinearLayout>
