<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/music_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background_shape"
    android:padding="14dp">

    <!-- Header Row -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp">

        <LinearLayout
            android:id="@+id/music_widget_header_click"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_alignParentStart="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@mipmap/ic_launcher_round"
                android:layout_marginEnd="8dp"
                android:contentDescription="Funkenwerk" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FUNKENWERK MUSIK"
                    android:textColor="#C5A059"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/music_widget_playlist_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lieblingssongs · 148 Titel"
                    android:textColor="#94A3B8"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_music_widget_refresh"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_popup_sync"
            android:tint="#94A3B8"
            android:contentDescription="Synchronisieren" />
    </RelativeLayout>

    <!-- Track Title & Artist -->
    <LinearLayout
        android:id="@+id/music_widget_track_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingVertical="2dp">

        <TextView
            android:id="@+id/music_widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Funkenwerk Soundplayer bereit"
            android:textColor="#F8FAFC"
            android:textSize="15sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/music_widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tippe auf ▶ für Sofort-Wiedergabe"
            android:textColor="#C5A059"
            android:textSize="12sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Playback Control Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="4dp">

        <ImageView
            android:id="@+id/btn_music_widget_shuffle"
            android:layout_width="42dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_music_shuffle_gold"
            android:tint="#C5A059"
            android:contentDescription="Zufällige Wiedergabe"
            android:background="?android:attr/selectableItemBackground" />

        <TextView
            android:id="@+id/btn_music_widget_prev"
            android:layout_width="48dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:text="⏮\uFE0E"
            android:textColor="#F8FAFC"
            android:textSize="16sp"
            android:background="?android:attr/selectableItemBackground" />

        <TextView
            android:id="@+id/btn_music_widget_play_pause"
            android:layout_width="64dp"
            android:layout_height="36dp"
            android:layout_marginHorizontal="10dp"
            android:gravity="center"
            android:text="▶\uFE0E"
            android:textColor="#C5A059"
            android:textStyle="bold"
            android:textSize="19sp"
            android:background="?android:attr/selectableItemBackground" />

        <TextView
            android:id="@+id/btn_music_widget_next"
            android:layout_width="48dp"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:gravity="center"
            android:text="⏭\uFE0E"
            android:textColor="#F8FAFC"
            android:textSize="16sp"
            android:background="?android:attr/selectableItemBackground" />

        <TextView
            android:id="@+id/btn_music_widget_open"
            android:layout_width="42dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="♪"
            android:textColor="#C5A059"
            android:textStyle="bold"
            android:textSize="17sp"
            android:background="?android:attr/selectableItemBackground" />
    </LinearLayout>
</LinearLayout>
