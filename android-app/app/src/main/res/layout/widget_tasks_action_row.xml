<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/task_action_row_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/widget_button_gold_shape"
    android:paddingVertical="10dp"
    android:paddingHorizontal="14dp"
    android:gravity="center">

    <ImageView
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginEnd="6dp"
        android:src="@drawable/ic_widget_add"
        android:tint="#C5A059"
        android:contentDescription="Hinzufügen" />

    <TextView
        android:id="@+id/task_action_row_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NEUE AUFGABE HINZUFÜGEN"
        android:textColor="#C5A059"
        android:textSize="11.5sp"
        android:textStyle="bold"
        android:letterSpacing="0.06" />

</LinearLayout>
