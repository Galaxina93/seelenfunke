<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/widget_item_card_shape"
    android:paddingVertical="9dp"
    android:paddingHorizontal="10dp"
    android:gravity="center_vertical">

    <!-- Category Accent Bar -->
    <FrameLayout
        android:id="@+id/item_category_bar"
        android:layout_width="3.5dp"
        android:layout_height="28dp"
        android:background="#C5A059"
        android:layout_marginEnd="10dp"
        android:layout_gravity="center_vertical" />

    <!-- Text Content -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_gravity="center_vertical">

        <!-- Date & Time Row -->
        <TextView
            android:id="@+id/item_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Heute · 14:00"
            android:textColor="#C5A059"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <!-- Title -->
        <TextView
            android:id="@+id/item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="Termin Titel"
            android:textColor="#F8FAFC"
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <!-- Description -->
        <TextView
            android:id="@+id/item_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Beschreibung"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginTop="2dp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
