<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/task_list_item_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/widget_item_card_shape"
    android:paddingVertical="10dp"
    android:paddingStart="12dp"
    android:paddingEnd="8dp"
    android:gravity="center_vertical">

    <!-- List Select Area (Icon + Name) -->
    <LinearLayout
        android:id="@+id/task_list_select_area"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/task_list_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="10dp"
            android:scaleType="fitCenter"
            android:tint="#C5A059"
            android:src="@drawable/ic_bookmark"
            android:contentDescription="Listen-Symbol" />

        <TextView
            android:id="@+id/task_list_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Mein Tag"
            android:textColor="#F8FAFC"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/task_list_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_badge_shape"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="0"
            android:textColor="#C5A059"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Rename List Button -->
    <FrameLayout
        android:id="@+id/task_list_edit_button"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:padding="6dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_widget_edit"
            android:tint="#94A3B8"
            android:scaleType="fitCenter"
            android:contentDescription="Liste umbenennen" />
    </FrameLayout>

    <!-- Delete List Button -->
    <FrameLayout
        android:id="@+id/task_list_delete_button"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:padding="6dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_delete"
            android:tint="#EF4444"
            android:scaleType="fitCenter"
            android:contentDescription="Liste löschen" />
    </FrameLayout>

</LinearLayout>
