<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_tasks_list_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/widget_item_card_shape"
    android:padding="10dp"
    android:layout_marginTop="2dp"
    android:layout_marginBottom="2dp"
    android:layout_marginStart="2dp"
    android:layout_marginEnd="2dp"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/list_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="10dp"
        android:src="@android:drawable/ic_menu_agenda"
        android:tint="#C5A059" />

    <TextView
        android:id="@+id/list_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="#F8FAFC"
        android:textSize="13.5sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/list_open_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="4dp"
        android:textColor="#94A3B8"
        android:textSize="13sp"
        android:textStyle="bold"
        android:text="" />



    <ImageView
        android:id="@+id/btn_rename_list"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="8dp"
        android:src="@android:drawable/ic_menu_edit"
        android:tint="#C5A059"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Liste umbenennen"
        android:padding="4dp" />

    <ImageView
        android:id="@+id/btn_delete_list"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="8dp"
        android:src="@android:drawable/ic_menu_delete"
        android:tint="#EF4444"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Liste löschen"
        android:padding="4dp" />
</LinearLayout>
