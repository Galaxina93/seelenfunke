<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_shopping_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="8dp"
    android:paddingStart="8dp"
    android:paddingEnd="6dp"
    android:background="@drawable/widget_item_card_shape">

    <!-- Category Color Indicator -->
    <FrameLayout
        android:id="@+id/item_category_bar"
        android:layout_width="3dp"
        android:layout_height="18dp"
        android:layout_marginEnd="8dp"
        android:background="#C5A059" />

    <!-- Toggle Area: Checkbox + Name + Quantity Badge -->
    <LinearLayout
        android:id="@+id/item_toggle_area"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/item_checkbox"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/ic_checkbox_unchecked"
            android:contentDescription="Status umschalten" />

        <TextView
            android:id="@+id/item_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Artikelname"
            android:textColor="#F8FAFC"
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/item_quantity_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_badge_shape"
            android:paddingHorizontal="7dp"
            android:paddingVertical="2dp"
            android:text="2x"
            android:textColor="#C5A059"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Delete Item Button -->
    <FrameLayout
        android:id="@+id/item_delete_button"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:padding="5dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_delete"
            android:tint="#64748B"
            android:scaleType="fitCenter"
            android:contentDescription="Artikel löschen" />
    </FrameLayout>

</LinearLayout>
