<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_tasks_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background_shape"
    android:padding="14dp">

    <!-- Header Row -->
    <RelativeLayout
        android:id="@+id/widget_tasks_header_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <!-- Left Side: Back Arrow / App Icon + Title & Subtitle -->
        <LinearLayout
            android:id="@+id/widget_tasks_header_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@+id/widget_tasks_header_actions"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/widget_tasks_back_button"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="6dp"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_back_arrow"
                android:background="@drawable/widget_button_gold_shape"
                android:contentDescription="Zurück zur Übersicht"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/widget_tasks_logo"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@mipmap/ic_launcher_round"
                android:layout_marginEnd="8dp"
                android:contentDescription="Funkenwerk" />

            <LinearLayout
                android:id="@+id/widget_tasks_title_click_area"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_tasks_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AUFGABEN"
                    android:textColor="#C5A059"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_tasks_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Listen-Übersicht"
                    android:textColor="#94A3B8"
                    android:textSize="10sp"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>

        <!-- Right Side: Refresh & + Add Buttons -->
        <LinearLayout
            android:id="@+id/widget_tasks_header_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/widget_tasks_refresh_button"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_refresh"
                android:tint="#94A3B8"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Synchronisieren" />

            <ImageButton
                android:id="@+id/widget_tasks_add_button"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="6dp"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_add"
                android:tint="#C5A059"
                android:background="@drawable/widget_button_gold_shape"
                android:contentDescription="Hinzufügen" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Thin Gold/Slate Divider -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#26334A"
        android:layout_marginBottom="8dp" />

    <!-- Tasks / Lists ListView -->
    <ListView
        android:id="@+id/tasks_widget_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="6dp"
        android:scrollbars="none" />

    <!-- Empty State -->
    <TextView
        android:id="@+id/tasks_widget_empty_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="Keine offenen Aufgaben"
        android:textColor="#64748B"
        android:textSize="13sp"
        android:visibility="gone" />

</LinearLayout>
