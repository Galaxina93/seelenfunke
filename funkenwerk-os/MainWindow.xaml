                            <Grid.RowDefinitions>
                                <RowDefinition Height="42"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="20"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="{DynamicResource WindowHeaderGlassBrush}" CornerRadius="15,15,0,0" Padding="14,0" Tag="ViewerWin" MouseLeftButtonDown="WindowHeader_MouseLeftButtonDown">
                                <Grid>
                                    <TextBlock x:Name="ViewerTitleTxt" Text="✦  VORSCHAU" Foreground="{DynamicResource ChampagneGoldBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
