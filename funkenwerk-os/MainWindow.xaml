                                        </StackPanel>
                                        <Button x:Name="SaveNoteBtn" Content="Speichern" Height="25" Margin="0,0,6,0" Style="{StaticResource NobleGoldBtn}" Padding="10,2" Click="SaveOpenNote_Click"/>
                                        <Button Content="◧" Width="26" Height="25" Padding="0" Margin="0,0,4,0" Style="{StaticResource GlassBtn}" Tag="ViewerWin|Left" Click="SnapInternalWin_Click"/>
                                        <Button Content="◨" Width="26" Height="25" Padding="0" Margin="0,0,6,0" Style="{StaticResource GlassBtn}" Tag="ViewerWin|Right" Click="SnapInternalWin_Click"/>
                                        <Button Content="—" Width="28" Height="25" Padding="0" Margin="0,0,4,0" Style="{StaticResource GlassBtn}" Tag="ViewerWin" Click="MinimizeInternalWin_Click"/>
                                        <Button Content="□" Width="28" Height="25" Padding="0" Margin="0,0,4,0" Style="{StaticResource GlassBtn}" Tag="ViewerWin" Click="MaximizeInternalWin_Click"/>
                                        <Button Content="✕" Width="28" Height="25" Padding="0" Style="{StaticResource GlassBtn}" Tag="ViewerWin" Click="CloseInternalWin_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="1" Margin="14,12,14,2">
                                <TextBox x:Name="NoteEditorTextBox" Visibility="Visible" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                         Background="{DynamicResource InputGlassBrush}" Foreground="{DynamicResource TextPrimaryBrush}" CaretBrush="#C5A059" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" Padding="12" FontSize="13.5"/>
                                <Border x:Name="LightboxImageHost" Visibility="Collapsed" Background="#AA07090E" CornerRadius="10" Padding="10" ClipToBounds="True"
                                        PreviewMouseWheel="LightboxImageHost_MouseWheel">
                                    <Grid>
                                        <Image x:Name="LightboxPreviewImg" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0.5,0.5">
                                            <Image.RenderTransform>
                                                <ScaleTransform x:Name="LightboxImgScale" ScaleX="1" ScaleY="1"/>
                                            </Image.RenderTransform>
                                        </Image>
                                        <Button Content="‹" Width="36" Height="56" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0" Style="{StaticResource GlassBtn}" FontSize="18" Opacity="0.78" Click="LightboxPrevImg_Click"/>
                                        <Button Content="›" Width="36" Height="56" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" Style="{StaticResource GlassBtn}" FontSize="18" Opacity="0.78" Click="LightboxNextImg_Click"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <TextBlock Grid.Row="2" Text="⤡" FontSize="13" Foreground="#C5A059" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,2" Cursor="SizeNWSE"
                                       Tag="ViewerWin" MouseLeftButtonDown="WindowResizeGrip_MouseLeftButtonDown"/>
                        </Grid>
                    </Border>

                    <!-- ===================================================== -->
                    <!-- OS WINDOW 5: TASCHENRECHNER                           -->
                    <!-- ===================================================== -->
                    <Border x:Name="CalculatorWin" Visibility="Collapsed" Canvas.Left="460" Canvas.Top="85" Width="380" Height="520" MinWidth="340" MinHeight="460"
                            Background="{DynamicResource WindowGlassBrush}" BorderBrush="{DynamicResource GoldBorderBrush}" BorderThickness="1.2" CornerRadius="16"
                            RenderTransformOrigin="0.5,0.5" MouseDown="FloatingWindow_ActivateMouseDown">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="42"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="18"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="{DynamicResource WindowHeaderGlassBrush}" CornerRadius="15,15,0,0" Padding="14,0" Tag="CalculatorWin" MouseLeftButtonDown="WindowHeader_MouseLeftButtonDown">
                                <Grid>
                                    <TextBlock x:Name="CalcWinTitleTxt" Text="✦  TASCHENRECHNER" Foreground="{DynamicResource ChampagneGoldBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Content="—" Width="28" Height="25" Padding="0" Margin="0,0,4,0" Style="{StaticResource GlassBtn}" Tag="CalculatorWin" Click="MinimizeInternalWin_Click"/>
                                        <Button Content="□" Width="28" Height="25" Padding="0" Margin="0,0,4,0" Style="{StaticResource GlassBtn}" Tag="CalculatorWin" Click="MaximizeInternalWin_Click"/>
                                        <Button Content="✕" Width="28" Height="25" Padding="0" Style="{StaticResource GlassBtn}" Tag="CalculatorWin" Click="CloseInternalWin_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Display Screen -->
                            <Border Grid.Row="1" Margin="14,12,14,6" Background="{DynamicResource InputGlassBrush}" BorderBrush="{DynamicResource GoldBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,10" Cursor="Hand"
                                    MouseLeftButtonUp="CalcCopyDisplay_Click" ToolTip="Klicken zum Kopieren">
                                <StackPanel>
                                    <TextBlock x:Name="CalcExpressionTxt" Text="" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Right" MinHeight="17" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="CalcDisplayTxt" Text="0" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource ChampagneGoldBrush}" TextAlignment="Right" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>

                            <!-- Compact History Tape -->
                            <ScrollViewer Grid.Row="2" MaxHeight="56" VerticalScrollBarVisibility="Auto" Margin="14,0,14,8">
                                <ItemsControl x:Name="CalcHistoryList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="6" Padding="8,3" Margin="0,0,0,2" Background="{DynamicResource CardGlassBrush}" Cursor="Hand"
                                                    Tag="{Binding}" MouseLeftButtonUp="CalcHistoryItem_Click">
                                                <Grid>
                                                    <TextBlock Text="{Binding Expression}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding ResultFormatted}" FontSize="11" FontWeight="Bold" Foreground="#C5A059" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Keypad -->
                            <UniformGrid Grid.Row="3" Columns="4" Rows="6" Margin="14,0,14,4">
                                <Button Content="+19%" Margin="3" FontSize="12" Style="{StaticResource GlassBtn}" Tag="VAT_ADD" Click="CalcKey_Click"/>
                                <Button Content="-19%" Margin="3" FontSize="12" Style="{StaticResource GlassBtn}" Tag="VAT_SUB" Click="CalcKey_Click"/>
                                <Button Content="%" Margin="3" FontSize="13.5" Style="{StaticResource GlassBtn}" Tag="%" Click="CalcKey_Click"/>
                                <Button Content="⌫" Margin="3" FontSize="14" Style="{StaticResource GlassBtn}" Tag="BACK" Click="CalcKey_Click"/>

                                <Button Content="C" Margin="3" FontSize="13.5" Style="{StaticResource GlassBtn}" Tag="C" Click="CalcKey_Click"/>
                                <Button Content="±" Margin="3" FontSize="14" Style="{StaticResource GlassBtn}" Tag="SIGN" Click="CalcKey_Click"/>
                                <Button Content="📋" Margin="3" FontSize="13" Style="{StaticResource GlassBtn}" Tag="COPY" Click="CalcKey_Click"/>
                                <Button Content="÷" Margin="3" FontSize="16" Style="{StaticResource GlassBtn}" Tag="/" Click="CalcKey_Click"/>

                                <Button Content="7" Margin="3" FontSize="16" Style="{StaticResource GlassBtn}" Tag="7" Click="CalcKey_Click"/>
                                <Button Content="8" Margin="3" FontSize="16" Style="{StaticResource GlassBtn}" Tag="8" Click="CalcKey_Click"/>
                                <Button Content="9" Margin="3" FontSize="16" Style="{StaticResource GlassBtn}" Tag="9" Click="CalcKey_Click"/>
                                <Button Content="×" Margin="3" FontSize="16" Style="{StaticResource GlassBtn}" Tag="*" Click="CalcKey_Click"/>

                                <Button Content="4" Margin="3" FontSize="16" Style="{StaticResource GlassBtn}" Tag="4" Click="CalcKey_Click"/>
                                <Button Content="5" Margin="3" FontSize="16" Style="{StaticResource GlassBtn}" Tag="5" Click="CalcKey_Click"/>
                                <Button Content="6" Margin="3" FontSize="16" Style="{StaticResource GlassBtn}" Tag="6" Click="CalcKey_Click"/>
                                <Button Content="−" Margin="3" FontSize="16" Style="{StaticResource GlassBtn}" Tag="-" Click="CalcKey_Click"/>

                                <Button Content="1" Margin="3" FontSize="16" Style="{StaticResource GlassBtn}" Tag="1" Click="CalcKey_Click"/>
                                <Button Content="2" Margin="3" FontSize="16" Style="{StaticResource GlassBtn}" Tag="2" Click="CalcKey_Click"/>
                                <Button Content="3" Margin="3" FontSize="16" Style="{StaticResource GlassBtn}" Tag="3" Click="CalcKey_Click"/>
                                <Button Content="+" Margin="3" FontSize="16" Style="{StaticResource GlassBtn}" Tag="+" Click="CalcKey_Click"/>

                                <Button Content="0" Margin="3" FontSize="16" Style="{StaticResource GlassBtn}" Tag="0" Click="CalcKey_Click"/>
                                <Button Content="00" Margin="3" FontSize="14" Style="{StaticResource GlassBtn}" Tag="00" Click="CalcKey_Click"/>
                                <Button Content="," Margin="3" FontSize="17" Style="{StaticResource GlassBtn}" Tag="," Click="CalcKey_Click"/>
                                <Button Content="=" Margin="3" FontSize="17" Style="{StaticResource NobleGoldBtn}" Tag="=" Click="CalcKey_Click"/>
                            </UniformGrid>

                            <TextBlock Grid.Row="4" Text="⤡" FontSize="13" Foreground="#C5A059" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,2" Cursor="SizeNWSE"
                                       Tag="CalculatorWin" MouseLeftButtonDown="WindowResizeGrip_MouseLeftButtonDown"/>
                        </Grid>
                    </Border>

                    <!-- ===================================================== -->
                    <!-- OS WINDOW 6: AUSSCHNEIDEN (SNIPPING & MARKIERUNG)     -->
                    <!-- ===================================================== -->
                    <Border x:Name="SnipWin" Visibility="Collapsed" Canvas.Left="240" Canvas.Top="70" Width="820" Height="550" MinWidth="560" MinHeight="380"
                            Background="{DynamicResource WindowGlassBrush}" BorderBrush="{DynamicResource GoldBorderBrush}" BorderThickness="1.2" CornerRadius="16"
                            RenderTransformOrigin="0.5,0.5" MouseDown="FloatingWindow_ActivateMouseDown">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="42"/>
                                <RowDefinition Height="46"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="20"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="{DynamicResource WindowHeaderGlassBrush}" CornerRadius="15,15,0,0" Padding="14,0" Tag="SnipWin" MouseLeftButtonDown="WindowHeader_MouseLeftButtonDown">
                                <Grid>
                                    <TextBlock x:Name="SnipWinTitleTxt" Text="✦  AUSSCHNEIDEN" Foreground="{DynamicResource ChampagneGoldBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Content="◧" Width="26" Height="25" Padding="0" Margin="0,0,4,0" Style="{StaticResource GlassBtn}" Tag="SnipWin|Left" Click="SnapInternalWin_Click"/>
                                        <Button Content="◨" Width="26" Height="25" Padding="0" Margin="0,0,6,0" Style="{StaticResource GlassBtn}" Tag="SnipWin|Right" Click="SnapInternalWin_Click"/>
                                        <Button Content="—" Width="28" Height="25" Padding="0" Margin="0,0,4,0" Style="{StaticResource GlassBtn}" Tag="SnipWin" Click="MinimizeInternalWin_Click"/>
                                        <Button Content="□" Width="28" Height="25" Padding="0" Margin="0,0,4,0" Style="{StaticResource GlassBtn}" Tag="SnipWin" Click="MaximizeInternalWin_Click"/>
                                        <Button Content="✕" Width="28" Height="25" Padding="0" Style="{StaticResource GlassBtn}" Tag="SnipWin" Click="CloseInternalWin_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Clean Toolbar -->
                            <Border Grid.Row="1" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Padding="12,0">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="✂  Neu" Height="30" Padding="13,0" Margin="0,0,6,0" Style="{StaticResource NobleGoldBtn}" Click="StartNewSnip_Click"/>
                                        <Button x:Name="SnipDelayBtn" Content="⏱ Sofort" Height="30" Padding="10,0" Margin="0,0,10,0" Style="{StaticResource GlassBtn}" Click="ToggleSnipDelay_Click"/>

                                        <Button x:Name="SnipToolNoneBtn" Content="↖" Width="30" Height="30" Padding="0" Margin="0,0,4,0" Style="{StaticResource NobleGoldBtn}" Tag="None" Click="SelectSnipPen_Click" ToolTip="Auswahl"/>
                                        <Button x:Name="SnipToolGoldBtn" Content="✎ Gold" Height="30" Padding="9,0" Margin="0,0,4,0" Style="{StaticResource GlassBtn}" Tag="Gold" Click="SelectSnipPen_Click"/>
                                        <Button x:Name="SnipToolRedBtn" Content="✎ Rot" Height="30" Padding="9,0" Margin="0,0,4,0" Style="{StaticResource GlassBtn}" Tag="Red" Click="SelectSnipPen_Click"/>
                                        <Button x:Name="SnipToolMarkerBtn" Content="🖍 Marker" Height="30" Padding="9,0" Margin="0,0,6,0" Style="{StaticResource GlassBtn}" Tag="Marker" Click="SelectSnipPen_Click"/>
                                        <Button Content="↩" Width="30" Height="30" Padding="0" Margin="0,0,4,0" Style="{StaticResource GlassBtn}" Click="SnipUndoStroke_Click" ToolTip="Rückgängig"/>
                                        <Button Content="✕" Width="30" Height="30" Padding="0" Style="{StaticResource GlassBtn}" Click="SnipClearStrokes_Click" ToolTip="Markierungen löschen"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Content="📋 Zwischenspeicher (Strg+V)" Height="30" Padding="11,0" Style="{StaticResource GlassBtn}" Click="SnipCopyCurrent_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Capture Canvas / Empty State -->
                            <Grid Grid.Row="2" Margin="14,12,14,4">
                                <Border Background="#AA07090E" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10">
                                    <Grid>
                                        <Button x:Name="SnipEmptyPromptBtn" Content="✂   Bereich ausschneiden" Padding="22,12" FontSize="13.5" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Style="{StaticResource NobleGoldBtn}" Click="StartNewSnip_Click"/>

                                        <Viewbox x:Name="SnipPreviewViewbox" Visibility="Collapsed" Stretch="Uniform">
                                            <Grid x:Name="SnipExportSurface">
                                                <Image x:Name="SnipCapturedImg" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <InkCanvas x:Name="SnipInkCanvas" Background="Transparent" EditingMode="None" StrokeCollected="SnipInkCanvas_StrokeCollected"/>
                                            </Grid>
                                        </Viewbox>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Grid Grid.Row="3" Margin="14,0,6,2">
                                <TextBlock x:Name="SnipDimensionsFooterTxt" Text="" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="⤡" FontSize="13" Foreground="#C5A059" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="SizeNWSE"
                                           Tag="SnipWin" MouseLeftButtonDown="WindowResizeGrip_MouseLeftButtonDown"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- ===================================================== -->
                    <!-- OS WINDOW 7: NOTIZEN (KURZNOTIZEN / STICKY NOTES)     -->
                    <!-- ===================================================== -->
                    <Border x:Name="NotesWin" Visibility="Collapsed" Canvas.Left="280" Canvas.Top="80" Width="740" Height="500" MinWidth="520" MinHeight="360"
                            Background="{DynamicResource WindowGlassBrush}" BorderBrush="{DynamicResource GoldBorderBrush}" BorderThickness="1.2" CornerRadius="16"
                            RenderTransformOrigin="0.5,0.5" MouseDown="FloatingWindow_ActivateMouseDown"
                            AllowDrop="True" DragOver="NotesWin_DragOver" Drop="NotesWin_Drop">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="42"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="20"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="{DynamicResource WindowHeaderGlassBrush}" CornerRadius="15,15,0,0" Padding="14,0" Tag="NotesWin" MouseLeftButtonDown="WindowHeader_MouseLeftButtonDown">
                                <Grid>
                                    <TextBlock x:Name="NotesWinTitleTxt" Text="✦  NOTIZEN" Foreground="{DynamicResource ChampagneGoldBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Content="◧" Width="26" Height="25" Padding="0" Margin="0,0,4,0" Style="{StaticResource GlassBtn}" Tag="NotesWin|Left" Click="SnapInternalWin_Click"/>
                                        <Button Content="◨" Width="26" Height="25" Padding="0" Margin="0,0,6,0" Style="{StaticResource GlassBtn}" Tag="NotesWin|Right" Click="SnapInternalWin_Click"/>
                                        <Button Content="—" Width="28" Height="25" Padding="0" Margin="0,0,4,0" Style="{StaticResource GlassBtn}" Tag="NotesWin" Click="MinimizeInternalWin_Click"/>
                                        <Button Content="□" Width="28" Height="25" Padding="0" Margin="0,0,4,0" Style="{StaticResource GlassBtn}" Tag="NotesWin" Click="MaximizeInternalWin_Click"/>
                                        <Button Content="✕" Width="28" Height="25" Padding="0" Style="{StaticResource GlassBtn}" Tag="NotesWin" Click="CloseInternalWin_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="225"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left Sticky Notes List -->
                                <Border Grid.Column="0" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,1,0" Padding="10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Button Grid.Row="0" Content="+  Neue Notiz" Height="32" Margin="0,0,0,8" Style="{StaticResource NobleGoldBtn}" Click="CreateStickyNote_Click"/>

                                        <Border Grid.Row="1" Background="{DynamicResource InputGlassBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8,4" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Foreground="#C5A059" VerticalAlignment="Center"/>
                                                <TextBox x:Name="NotesSearchBox" Grid.Column="1" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" CaretBrush="#C5A059" BorderThickness="0" FontSize="12"
                                                         TextChanged="NotesSearchBox_TextChanged"/>
                                            </Grid>
                                        </Border>

                                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl x:Name="StickyNotesListControl">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="9" Margin="0,0,0,6" Padding="0" BorderThickness="1" Cursor="Hand"
                                                                Tag="{Binding}" MouseLeftButtonDown="StickyNoteCard_Click" MouseMove="StickyNoteCard_MouseMove">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{DynamicResource CardGlassBrush}"/>
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                            <Setter Property="Background" Value="#3EC5A059"/>
                                                                            <Setter Property="BorderBrush" Value="#F2C5A059"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="5"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Border Grid.Column="0" Background="{Binding AccentBrush}" CornerRadius="8,0,0,8"/>
                                                                <StackPanel Grid.Column="1" Margin="9,7,9,7">
                                                                    <TextBlock Text="{Binding TitleLine}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                                    <Grid Margin="0,3,0,0">
                                                                        <TextBlock Text="{Binding PreviewSnippet}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,44,0"/>
                                                                        <TextBlock Text="{Binding UpdatedFormatted}" FontSize="9.5" Foreground="#C5A059" HorizontalAlignment="Right"/>
                                                                    </Grid>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>

                                <!-- Right Active Sticky Note Pad -->
                                <Grid Grid.Column="1" Margin="12,10,12,4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="34"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Width="20" Height="20" Margin="0,0,6,0" Background="#C5A059" BorderThickness="0" Cursor="Hand" Tag="gold" Click="SelectStickyColor_Click"><Button.Template><ControlTemplate TargetType="Button"><Ellipse Fill="{TemplateBinding Background}" Stroke="#66FFFFFF" StrokeThickness="1"/></ControlTemplate></Button.Template></Button>
                                            <Button Width="20" Height="20" Margin="0,0,6,0" Background="#FDE68A" BorderThickness="0" Cursor="Hand" Tag="champagne" Click="SelectStickyColor_Click"><Button.Template><ControlTemplate TargetType="Button"><Ellipse Fill="{TemplateBinding Background}" Stroke="#66FFFFFF" StrokeThickness="1"/></ControlTemplate></Button.Template></Button>
                                            <Button Width="20" Height="20" Margin="0,0,6,0" Background="#10B981" BorderThickness="0" Cursor="Hand" Tag="emerald" Click="SelectStickyColor_Click"><Button.Template><ControlTemplate TargetType="Button"><Ellipse Fill="{TemplateBinding Background}" Stroke="#66FFFFFF" StrokeThickness="1"/></ControlTemplate></Button.Template></Button>
                                            <Button Width="20" Height="20" Margin="0,0,6,0" Background="#38BDF8" BorderThickness="0" Cursor="Hand" Tag="ocean" Click="SelectStickyColor_Click"><Button.Template><ControlTemplate TargetType="Button"><Ellipse Fill="{TemplateBinding Background}" Stroke="#66FFFFFF" StrokeThickness="1"/></ControlTemplate></Button.Template></Button>
                                            <Button Width="20" Height="20" Margin="0,0,6,0" Background="#F472B6" BorderThickness="0" Cursor="Hand" Tag="rose" Click="SelectStickyColor_Click"><Button.Template><ControlTemplate TargetType="Button"><Ellipse Fill="{TemplateBinding Background}" Stroke="#66FFFFFF" StrokeThickness="1"/></ControlTemplate></Button.Template></Button>
                                            <Button Width="20" Height="20" Background="#94A3B8" BorderThickness="0" Cursor="Hand" Tag="slate" Click="SelectStickyColor_Click"><Button.Template><ControlTemplate TargetType="Button"><Ellipse Fill="{TemplateBinding Background}" Stroke="#66FFFFFF" StrokeThickness="1"/></ControlTemplate></Button.Template></Button>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Content="📋" Width="30" Height="26" Padding="0" Margin="0,0,5,0" Style="{StaticResource GlassBtn}" Click="CopyStickyNote_Click" ToolTip="Kopieren"/>
                                            <Button Content="🗑" Width="30" Height="26" Padding="0" Style="{StaticResource GlassBtn}" Click="DeleteStickyNote_Click" ToolTip="Löschen"/>
                                        </StackPanel>
                                    </Grid>

                                    <Border x:Name="ActiveStickyPadBorder" Grid.Row="1" Background="#24C5A059" BorderBrush="#80C5A059" BorderThickness="1" CornerRadius="12" Padding="2">
                                        <TextBox x:Name="ActiveStickyTextBox" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                                 Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" CaretBrush="#C5A059" BorderThickness="0" Padding="12" FontSize="14"
                                                 TextChanged="ActiveStickyTextBox_TextChanged"/>
                                    </Border>
                                </Grid>
                            </Grid>

                            <TextBlock Grid.Row="2" Text="⤡" FontSize="13" Foreground="#C5A059" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,2" Cursor="SizeNWSE"
                                       Tag="NotesWin" MouseLeftButtonDown="WindowResizeGrip_MouseLeftButtonDown"/>
                        </Grid>
                    </Border>
                </Canvas>

                <!-- RIGHT-CLICK CONTEXT MENU -->
                <Canvas x:Name="ContextMenuCanvas" Panel.ZIndex="900" Visibility="Collapsed">
                    <Border x:Name="DesktopContextMenuBorder" Width="232" Background="{DynamicResource FlyoutGlassBrush}" BorderBrush="{DynamicResource GoldBorderBrush}" BorderThickness="1.2" CornerRadius="12" Padding="6"
                            RenderTransformOrigin="0,0">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <StackPanel x:Name="ContextMenuItemsStack"/>
                    </Border>
                </Canvas>

                <!-- START MENU & WINDOWS-KEY INSTANT SEARCH FLYOUT (BOTTOM-LEFT) -->
                <Border x:Name="StartMenuFlyout" Panel.ZIndex="800" Visibility="Collapsed" Width="548" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,10"
                        Background="{DynamicResource FlyoutGlassBrush}" BorderBrush="{DynamicResource GoldBorderBrush}" BorderThickness="1.2" CornerRadius="18" Padding="20,18">
                    <Border.RenderTransform>
                        <TranslateTransform Y="0"/>
                    </Border.RenderTransform>
                    <StackPanel>
                        <Border Background="{DynamicResource InputGlassBrush}" BorderBrush="#A6C5A059" BorderThickness="1.2" CornerRadius="10" Padding="11,8" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🔍" FontSize="13" Foreground="#C5A059" VerticalAlignment="Center"/>
                                <TextBox x:Name="StartSearchBox" Grid.Column="1" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" CaretBrush="#C5A059" BorderThickness="0" FontSize="13.5" VerticalContentAlignment="Center"
                                         TextChanged="StartSearchBox_TextChanged" PreviewKeyDown="StartSearchBox_PreviewKeyDown"/>
                            </Grid>
                        </Border>

                        <TextBlock x:Name="StartMenuSectionHeaderTxt" Text="PROGRAMME" Foreground="#C5A059" FontSize="10.5" FontWeight="Bold" Margin="4,0,0,8"/>
                        <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14">
                            <ItemsControl x:Name="StartMenuAppsGrid">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="4"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Margin="3" BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSearchHighlighted}" Value="True">
                                                            <Setter Property="Background" Value="#38C5A059"/>
                                                            <Setter Property="BorderBrush" Value="#F2C5A059"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Button Style="{StaticResource TrayIconBtn}" Padding="6,9" Tag="{Binding Id}" Click="StartMenuApp_Click" MouseRightButtonUp="StartMenuApp_RightClick"
                                                    PreviewMouseLeftButtonDown="StartMenuApp_PreviewMouseLeftButtonDown" PreviewMouseMove="StartMenuApp_PreviewMouseMove">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Image Source="{Binding IconImage}" Width="40" Height="40" Margin="0,0,0,6"/>
                                                    <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="108"/>
                                                </StackPanel>
                                            </Button>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <UniformGrid Columns="4" Margin="0,0,0,16">
                            <Button Content="Meine Daten" Style="{StaticResource GlassBtn}" Margin="0,0,5,0" Tag="MeineDaten" Click="StartQuickFolder_Click"/>
                            <Button Content="📥 Trichter" Style="{StaticResource GlassBtn}" Margin="2,0,3,0" Tag="EingangTrichter" Click="StartQuickFolder_Click"/>
                            <Button Content="☁ kDrive" Style="{StaticResource GlassBtn}" Margin="3,0,2,0" Tag="CloudKDrive" Click="StartQuickFolder_Click"/>
                            <Button Content="Desktop" Style="{StaticResource GlassBtn}" Margin="5,0,0,0" Tag="OsDesktop" Click="StartQuickFolder_Click"/>
                        </UniformGrid>

                        <Border BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,1,0,0" Padding="2,12,2,0">
                            <Grid>
                                <Button Style="{StaticResource TrayIconBtn}" HorizontalAlignment="Left" Padding="6,4" Click="StartOpenAccount_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="StartUserOnlineDot" Width="8" Height="8" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Alina Steinhauer" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </Button>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="🔒 Sperren" Style="{StaticResource GlassBtn}" Padding="10,5" Margin="0,0,6,0" Click="LockScreenNow_Click"/>
                                    <Button Content="↻" Width="32" Style="{StaticResource GlassBtn}" Padding="0,5" Margin="0,0,6,0" Click="PowerReboot_Click" ToolTip="Neu starten"/>
                                    <Button Content="⏻" Width="32" Style="{StaticResource NobleGoldBtn}" Padding="0,5" Margin="0,0,6,0" Click="PowerShutdown_Click" ToolTip="Herunterfahren"/>
                                    <Button Content="✕" Width="32" Style="{StaticResource GlassBtn}" Padding="0,5" Click="PowerExitApp_Click" ToolTip="Schließen"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- TRAY FLYOUT 1: WLAN -->
                <Border x:Name="WifiFlyout" Visibility="Collapsed" Width="345" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,10"
                        Background="{DynamicResource FlyoutGlassBrush}" BorderBrush="{DynamicResource GoldBorderBrush}" BorderThickness="1.2" CornerRadius="16" Padding="16">
                    <Border.RenderTransform><TranslateTransform Y="0"/></Border.RenderTransform>
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="WLAN &amp; NETZWERK" Foreground="#C5A059" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button Content="↻" Width="28" Height="25" Padding="0" HorizontalAlignment="Right" Style="{StaticResource GlassBtn}" Click="RefreshWifiScan_Click"/>
                        </Grid>

                        <Border Background="{DynamicResource CardGlassBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="10,8" Margin="0,0,0,10">
                            <TextBlock x:Name="WifiActiveSummaryTxt" Text="Prüfe Verbindung..." FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ChampagneGoldBrush}"/>
                        </Border>

                        <ScrollViewer MaxHeight="210" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
                            <ItemsControl x:Name="WifiListControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardGlassBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,5" Cursor="Hand"
                                                Tag="{Binding}" MouseLeftButtonUp="WifiNetworkItem_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Ssid}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1" Text="{Binding StatusBadge}" FontSize="10.5" Foreground="{Binding StatusColorHex}" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0"/>
                                                <TextBlock Grid.Column="2" Text="{Binding SignalLabel}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <StackPanel x:Name="WifiConnectSubPanel" Visibility="Collapsed">
                            <TextBlock x:Name="WifiSelectedSsidTxt" Text="Netzwerk" FontSize="11.5" FontWeight="Bold" Foreground="#FCE7B2" Margin="0,0,0,5"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                                <PasswordBox x:Name="WifiPwdBox" Grid.Column="0" Height="32" VerticalContentAlignment="Center" Padding="8,0" Background="{DynamicResource InputGlassBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1"/>
                                <TextBox x:Name="WifiPwdRevealBox" Grid.Column="0" Visibility="Collapsed" Height="32" VerticalContentAlignment="Center" Padding="8,0" Background="{DynamicResource InputGlassBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1"/>
                                <Button Grid.Column="1" Content="👁" Height="32" Margin="4,0,0,0" Padding="0" Style="{StaticResource GlassBtn}" Click="ToggleWifiPwdEye_Click"/>
                            </Grid>
                            <Button Content="VERBINDEN" Height="34" Style="{StaticResource NobleGoldBtn}" Click="ConnectSelectedWifi_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- TRAY FLYOUT 2: BLUETOOTH -->
                <Border x:Name="BluetoothFlyout" Visibility="Collapsed" Width="335" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,10"
                        Background="{DynamicResource FlyoutGlassBrush}" BorderBrush="{DynamicResource GoldBorderBrush}" BorderThickness="1.2" CornerRadius="16" Padding="16">
                    <Border.RenderTransform><TranslateTransform Y="0"/></Border.RenderTransform>
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="BLUETOOTH" Foreground="#C5A059" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="+ Koppeln" Height="25" Padding="9,0" Margin="0,0,5,0" Style="{StaticResource GlassBtn}" Click="OpenBtPairing_Click"/>
                                <Button Content="↻" Width="28" Height="25" Padding="0" Style="{StaticResource GlassBtn}" Click="RefreshBtScan_Click"/>
                            </StackPanel>
                        </Grid>

                        <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="BluetoothListControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardGlassBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="11,9" Margin="0,0,0,5" Cursor="Hand"
                                                Tag="{Binding}" MouseLeftButtonUp="BluetoothDeviceItem_Click">
                                            <Grid>
                                                <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,84,0"/>
                                                <TextBlock Text="{Binding StatusBadge}" FontSize="11" FontWeight="Bold" Foreground="{Binding StatusColorHex}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- TRAY FLYOUT 3: SOUNDVERWALTUNG (LAUTSPRECHER/HEADSET + MIKROFON + MUSIK) -->
                <Border x:Name="SoundFlyout" Visibility="Collapsed" Width="355" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,10"
                        Background="{DynamicResource FlyoutGlassBrush}" BorderBrush="{DynamicResource GoldBorderBrush}" BorderThickness="1.2" CornerRadius="16" Padding="16">
                    <Border.RenderTransform><TranslateTransform Y="0"/></Border.RenderTransform>
                    <StackPanel>
                        <TextBlock Text="LAUTSTÄRKE" Foreground="#C5A059" FontSize="11.5" FontWeight="Bold" Margin="0,0,0,8"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="34"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="FlyoutMuteBtn" Grid.Column="0" Content="🔊" Height="28" Padding="0" Style="{StaticResource GlassBtn}" Click="MuteToggle_Click"/>
                            <Button Grid.Column="1" Content="−" Height="28" Padding="0" Margin="4,0,4,0" Style="{StaticResource GlassBtn}" Click="VolMinus_Click"/>
                            <Slider x:Name="MasterVolSlider" Grid.Column="2" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="5" VerticalAlignment="Center" ValueChanged="MasterVolSlider_ValueChanged"/>
                            <Button Grid.Column="3" Content="+" Height="28" Padding="0" Margin="4,0,0,0" Style="{StaticResource GlassBtn}" Click="VolPlus_Click"/>
                            <TextBlock x:Name="FlyoutVolTxt" Grid.Column="4" Text="50" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock Text="AUSGABEGERÄT (LAUTSPRECHER / HEADSET)" Foreground="#C5A059" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/>
                        <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                            <ItemsControl x:Name="AudioOutputsListControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardGlassBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,4" Cursor="Hand"
                                                Tag="{Binding DeviceId}" MouseLeftButtonUp="AudioOutputItem_Click">
                                            <Grid>
                                                <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,22,0"/>
                                                <TextBlock Text="{Binding ActiveMark}" FontSize="12" FontWeight="Bold" Foreground="#C5A059" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Headset Microphone Control -->
                        <Grid Margin="0,0,0,5">
                            <TextBlock Text="MIKROFON" Foreground="#C5A059" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button x:Name="MicMuteBtn" Content="🎙 Aktiv" Height="23" Padding="8,0" HorizontalAlignment="Right" Style="{StaticResource GlassBtn}" Click="ToggleMicMute_Click"/>
                        </Grid>
                        <ScrollViewer MaxHeight="85" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                            <ItemsControl x:Name="AudioInputsListControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardGlassBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,4" Cursor="Hand"
                                                Tag="{Binding DeviceId}" MouseLeftButtonUp="AudioInputItem_Click">
                                            <Grid>
                                                <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,22,0"/>
                                                <TextBlock Text="{Binding ActiveMark}" FontSize="12" FontWeight="Bold" Foreground="#C5A059" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <UniformGrid Columns="4">
                            <Button Content="⏮" Height="30" Margin="0,0,4,0" Style="{StaticResource GlassBtn}" Click="MusicPrev_Click"/>
                            <Button Content="⏯" Height="30" Margin="2,0,2,0" Style="{StaticResource NobleGoldBtn}" Click="MusicToggle_Click"/>
                            <Button Content="⏭" Height="30" Margin="2,0,4,0" Style="{StaticResource GlassBtn}" Click="MusicNext_Click"/>
                            <Button Content="✦ Fokus" Height="30" Style="{StaticResource GlassBtn}" Click="MusicFocus_Click"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- TRAY FLYOUT 4: KALENDER -->
                <Border x:Name="CalendarFlyout" Visibility="Collapsed" Width="320" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,10"
                        Background="{DynamicResource FlyoutGlassBrush}" BorderBrush="{DynamicResource GoldBorderBrush}" BorderThickness="1.2" CornerRadius="16" Padding="18">
                    <Border.RenderTransform><TranslateTransform Y="0"/></Border.RenderTransform>
                    <StackPanel>
                        <TextBlock x:Name="CalLargeClockTxt" Text="22:00:00" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource ChampagneGoldBrush}"/>
                        <TextBlock x:Name="CalFullDateTxt" Text="Montag, 09. November 2026" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,14"/>

                        <Grid Margin="0,0,0,8">
                            <Button Content="‹" Width="26" Height="24" Padding="0" HorizontalAlignment="Left" Style="{StaticResource GlassBtn}" Click="CalPrevMonth_Click"/>
                            <TextBlock x:Name="CalMonthTitleTxt" Text="November 2026" FontSize="12.5" FontWeight="Bold" Foreground="#C5A059" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Button Content="›" Width="26" Height="24" Padding="0" HorizontalAlignment="Right" Style="{StaticResource GlassBtn}" Click="CalNextMonth_Click"/>
                        </Grid>

                        <UniformGrid Columns="7" Margin="0,0,0,4">
                            <TextBlock Text="Mo" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Di" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Mi" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Do" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Fr" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Sa" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="So" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                        </UniformGrid>
                        <UniformGrid x:Name="CalendarDaysGrid" Columns="7" Rows="6"/>
                    </StackPanel>
                </Border>

                <Border x:Name="OsToastBanner" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,18,0,0"
                        Background="#EB12151E" BorderBrush="#F2C5A059" BorderThickness="1.2" CornerRadius="18" Padding="18,8" IsHitTestVisible="False">
                    <TextBlock x:Name="OsToastTxt" Text="✓ Bereit" Foreground="#FCE7B2" FontSize="12" FontWeight="Bold"/>
                </Border>
            </Grid>

            <!-- ============================================================= -->
            <!-- CONFIGURABLE OS TASKBAR (BOTTOM / TOP / LEFT / RIGHT + FLOAT) -->
            <!-- ============================================================= -->
            <Border x:Name="TaskbarBorder" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Height="52"
                    Background="{DynamicResource TaskbarGlassBrush}" BorderBrush="{DynamicResource GoldBorderBrush}" BorderThickness="0,1,0,0" Padding="10,0,4,0"
                    AllowDrop="True" DragOver="Taskbar_DragOver" Drop="Taskbar_Drop"
                    MouseRightButtonUp="TaskbarBorder_MouseRightButtonUp">
                <Grid x:Name="TaskbarInnerGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="TbInnerCol0" Width="Auto"/>
                        <ColumnDefinition x:Name="TbInnerCol1" Width="*"/>
                        <ColumnDefinition x:Name="TbInnerCol2" Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="TbInnerRow0" Height="*"/>
                        <RowDefinition x:Name="TbInnerRow1" Height="Auto"/>
                        <RowDefinition x:Name="TbInnerRow2" Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel x:Name="TaskbarStartCluster" Grid.Column="0" Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Button x:Name="StartButton" Style="{StaticResource TrayIconBtn}" Padding="9,5" Margin="0,0,4,0" Click="ToggleStartMenu_Click" ToolTip="Start">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="funkenwerk_os.png" Width="28" Height="28"/>
                                <TextBlock x:Name="StartBtnLabelTxt" Text="Start" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource ChampagneGoldBrush}" VerticalAlignment="Center" Margin="7,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="TaskbarSearchBtn" Style="{StaticResource TrayIconBtn}" Padding="9,7" Click="TaskbarSearch_Click" ToolTip="Suchen">
                            <Viewbox Width="16" Height="16">
                                <Canvas Width="24" Height="24">
                                    <Ellipse Canvas.Left="3" Canvas.Top="3" Width="14" Height="14" Stroke="#D9FCE7B2" StrokeThickness="2.2"/>
                                    <Path Stroke="#D9FCE7B2" StrokeThickness="2.2" StrokeStartLineCap="Round" Data="M15.5 15.5 L21 21"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </StackPanel>

                    <ScrollViewer x:Name="TaskbarAppsScrollViewer" Grid.Column="1" Grid.Row="0" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center">
                        <ItemsControl x:Name="TaskbarWindowsStrip" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="9" Padding="8,4" Margin="3,2" Cursor="Hand" BorderThickness="1"
                                            Tag="{Binding}" AllowDrop="True"
                                            PreviewMouseLeftButtonDown="TaskbarWindowItem_PreviewMouseDown"
                                            PreviewMouseMove="TaskbarWindowItem_PreviewMouseMove"
                                            MouseDown="TaskbarWindowItem_MouseDown"
                                            MouseLeftButtonUp="TaskbarWindowItem_LeftClick"
                                            MouseRightButtonUp="TaskbarWindowItem_RightClick"
                                            DragOver="TaskbarWindowItem_DragOver"
                                            DragLeave="TaskbarWindowItem_DragLeave"
                                            Drop="TaskbarWindowItem_Drop"
                                            ToolTip="{Binding PillLabel}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#18FFFFFF"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter Property="Background" Value="#26FFFFFF"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Background" Value="#38C5A059"/>
                                                        <Setter Property="BorderBrush" Value="#D9C5A059"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <Image Source="{Binding IconImage}" Width="24" Height="24"/>
                                                <TextBlock Text="{Binding PillLabel}" Visibility="{Binding LabelVisibility}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" MaxWidth="130" TextTrimming="CharacterEllipsis" Margin="7,0,2,0"/>
                                            </StackPanel>
                                            <Border Visibility="{Binding RunningIndicatorVisibility}" Height="2.5" Width="22" CornerRadius="1.2" Background="#C5A059" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,-4"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel x:Name="TaskbarTrayCluster" Grid.Column="2" Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource TrayIconBtn}" Padding="8,7" Click="OpenAccountDirect_Click" ToolTip="Mein-Seelenfunke Status">
                            <Ellipse x:Name="TrayApiDot" Width="8" Height="8" Fill="#10B981"/>
                        </Button>

                        <Button Style="{StaticResource TrayIconBtn}" Padding="9,7" Click="ToggleWifiFlyout_Click" ToolTip="WLAN &amp; Netzwerk">
                            <Viewbox Width="17" Height="17">
                                <Canvas Width="24" Height="24">
                                    <Path x:Name="TrayWifiPath" Fill="Transparent" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="2.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M2 8.8C7.5 4 16.5 4 22 8.8 M5.5 12.5C9.2 9.3 14.8 9.3 18.5 12.5 M9 16.2C10.8 14.7 13.2 14.7 15 16.2"/>
                                    <Ellipse Canvas.Left="10.5" Canvas.Top="18.5" Width="3" Height="3" Fill="#C5A059"/>
                                </Canvas>
                            </Viewbox>
                        </Button>

                        <Button Style="{StaticResource TrayIconBtn}" Padding="9,7" Click="ToggleBluetoothFlyout_Click" ToolTip="Bluetooth &amp; Teufel">
                            <Viewbox Width="17" Height="17">
                                <Canvas Width="24" Height="24">
                                    <Path x:Name="TrayBtPath" Fill="Transparent" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="2.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Data="M6.5 7.5 L17.5 16.5 L12 22 L12 2 L17.5 7.5 L6.5 16.5"/>
                                </Canvas>
                            </Viewbox>
                        </Button>

                        <Button Style="{StaticResource TrayIconBtn}" Padding="9,6" Click="ToggleSoundFlyout_Click" PreviewMouseWheel="TraySoundButton_PreviewMouseWheel" ToolTip="Sound &amp; Headset (Mausrad = Lautstärke)">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Viewbox Width="17" Height="17">
                                    <Canvas Width="24" Height="24">
                                        <Path x:Name="TraySoundSpeakerPath" Fill="Transparent" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="2.1" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Data="M11 5L6 9H2v6h4l5 4V5z M15.5 8.5a5 5 0 0 1 0 7 M19 5a9.5 9.5 0 0 1 0 14"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock x:Name="TrayVolTxt" Text="50%" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource TrayIconBtn}" Padding="10,3" Margin="2,0,4,0" Click="ToggleCalendarFlyout_Click" ToolTip="Kalender">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="TrayClockTimeTxt" Text="22:00" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TrayClockDateTxt" Text="09.11.2026" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Border x:Name="ShowDesktopSliverBorder" Width="7" Height="38" Background="Transparent" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1,0,0,0" Cursor="Hand"
                                MouseLeftButtonUp="ShowDesktopSliver_Click" ToolTip="Desktop anzeigen"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- LOCK SCREEN & 60 FPS PORTAL -->
        <Grid x:Name="LockScreenOverlay" Panel.ZIndex="20" Visibility="Collapsed" Background="#38000000">
            <Border Width="390" VerticalAlignment="Center" HorizontalAlignment="Center" Background="#32000000" BorderBrush="#88C5A059" BorderThickness="1.2" CornerRadius="22" Padding="32,28">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="✦   F U N K E N W E R K   O S   ✦" Foreground="#F2FCE7B2" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                    <TextBlock x:Name="LockClockTxt" Text="22:00" Foreground="#FFFFFF" FontSize="52" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="LockDateTxt" Text="Montag, 09. November 2026" Foreground="#E0FCE7B2" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,22"/>
                    <Button Content="✦   ENTSPERREN   ✦" Width="220" Height="42" Style="{StaticResource NobleGoldBtn}" Click="UnlockWithMagicPortal_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="MagicPortalOverlay" Panel.ZIndex="30" Background="#EB070A12" Visibility="Collapsed" IsHitTestVisible="True">
            <Ellipse Width="660" Height="660" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#44C5A059" Offset="0.0"/>
                        <GradientStop Color="#18C5A059" Offset="0.45"/>
                        <GradientStop Color="#00C5A059" Offset="1.0"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Canvas x:Name="MagicSparksCanvas" IsHitTestVisible="False"/>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid Width="166" Height="166" HorizontalAlignment="Center" Margin="0,0,0,18">
                    <Ellipse x:Name="MagicShockwaveRing" Width="108" Height="108" Stroke="#C5A059" StrokeThickness="2" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform><ScaleTransform x:Name="MagicShockwaveScale" ScaleX="0.8" ScaleY="0.8"/></Ellipse.RenderTransform>
                    </Ellipse>
                    <Viewbox Width="162" Height="162" RenderTransformOrigin="0.5,0.5">
                        <Viewbox.RenderTransform><RotateTransform x:Name="MagicOrbitRotate" Angle="0"/></Viewbox.RenderTransform>
                        <Canvas Width="200" Height="200">
                            <Ellipse Canvas.Left="8" Canvas.Top="8" Width="184" Height="184" Stroke="#66C5A059" StrokeThickness="1.2" StrokeDashArray="4 8"/>
                            <Ellipse Canvas.Left="18" Canvas.Top="18" Width="164" Height="164" Stroke="#99C5A059" StrokeThickness="1.6" StrokeDashArray="16 8 3 8"/>
                        </Canvas>
                    </Viewbox>
                    <Border Width="86" Height="86" CornerRadius="43" BorderBrush="#CCFFFFFF" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FDE68A" Offset="0.0"/>
                                <GradientStop Color="#C5A059" Offset="0.55"/>
                                <GradientStop Color="#9A7229" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.RenderTransform><ScaleTransform x:Name="MagicCoreScale" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                        <Viewbox Width="42" Height="42" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Viewbox.RenderTransform><RotateTransform x:Name="MagicStarRotate" Angle="0"/></Viewbox.RenderTransform>
                            <Canvas Width="24" Height="24">
                                <Path Fill="#111827" Data="M12 2L14.6 9.4L22 12L14.6 14.6L12 22L9.4 14.6L2 12L9.4 9.4L12 2Z"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                </Grid>

                <Border Background="#26C5A059" BorderBrush="#66C5A059" BorderThickness="1" CornerRadius="14" Padding="14,5" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="#FBBF24" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="MagicPhasePillTxt" Text="SEELENFUNKEN SAMMELN SICH..." Foreground="#FDE68A" FontSize="11" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <TextBlock HorizontalAlignment="Center" FontSize="32" FontWeight="Bold" Foreground="#F9FAFB">
                    <Run Text="Funkenwerk "/>
                    <Run Text="erwacht" Foreground="#C5A059"/>
                </TextBlock>
            </StackPanel>
        </Grid>

    </Grid>
</Window>
