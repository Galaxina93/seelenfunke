<Window x:Class="FunkenwerkOS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FunkenwerkOS"
        Title="Funkenwerk OS"
        Icon="funkenwerk_os.ico"
        Width="1560" Height="930"
        MinWidth="1024" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="#090B10"
        Foreground="{DynamicResource TextPrimaryBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <SolidColorBrush x:Key="TaskbarGlassBrush" Color="#DF0A0C12"/>
        <SolidColorBrush x:Key="FlyoutGlassBrush" Color="#EE0D1018"/>
        <SolidColorBrush x:Key="WindowGlassBrush" Color="#F20E111A"/>
        <SolidColorBrush x:Key="WindowHeaderGlassBrush" Color="#2EC5A059"/>
        <SolidColorBrush x:Key="CardGlassBrush" Color="#88161B28"/>
        <SolidColorBrush x:Key="CardHoverGlassBrush" Color="#BF1F273A"/>
        <SolidColorBrush x:Key="InputGlassBrush" Color="#BF07090E"/>
        <SolidColorBrush x:Key="GoldBorderBrush" Color="#80C5A059"/>
        <SolidColorBrush x:Key="SubtleBorderBrush" Color="#3AC5A059"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F9FAFB"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B8C0CC"/>
        <SolidColorBrush x:Key="ChampagneGoldBrush" Color="#FCE7B2"/>

        <Style x:Key="NobleGoldBtn" TargetType="Button">
            <Setter Property="Background" Value="#D91F1708"/>
            <Setter Property="Foreground" Value="#FFFCE7B2"/>
            <Setter Property="BorderBrush" Value="#F2C5A059"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="Padding" Value="13,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EB2E220C"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFFDE68A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardGlassBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverGlassBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#C5A059"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TrayIconBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2AC5A059"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#55C5A059"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ContextItemBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}" Margin="2,1">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#35C5A059"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColHeaderBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#C5A059"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#25C5A059"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="OsRootGrid" ClipToBounds="True">

        <!-- LAYER 0: ATELIER LIVE WALLPAPER -->
        <Grid x:Name="WallpaperHostGrid" IsHitTestVisible="False" CacheMode="BitmapCache">
            <Border x:Name="KosmosBackdropBorder">
                <Border.Background>
                    <RadialGradientBrush Center="0.5,0.42" GradientOrigin="0.5,0.42" RadiusX="0.85" RadiusY="0.85">
                        <GradientStop Color="#1F1910" Offset="0.0"/>
                        <GradientStop Color="#0E1118" Offset="0.55"/>
                        <GradientStop Color="#07090E" Offset="1.0"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>
            <Image x:Name="WallpaperPosterImg" Panel.ZIndex="1" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
            <MediaElement x:Name="WallpaperVideoA" Panel.ZIndex="3" LoadedBehavior="Manual" UnloadedBehavior="Manual" ScrubbingEnabled="False" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" IsMuted="True"/>
            <MediaElement x:Name="WallpaperVideoB" Panel.ZIndex="2" Opacity="1" LoadedBehavior="Manual" UnloadedBehavior="Manual" ScrubbingEnabled="False" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" IsMuted="True"/>
            <Border Panel.ZIndex="4">
                <Border.Background>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.8" RadiusY="0.8">
                        <GradientStop Color="#1E000000" Offset="0.0"/>
                        <GradientStop Color="#34000000" Offset="0.72"/>
                        <GradientStop Color="#58000000" Offset="1.0"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>
        </Grid>

        <!-- LAYER 1: 60 FPS GPU GOLDEN SPARKS -->
        <local:AmbientSparksRenderer x:Name="DesktopSparksLayer" Panel.ZIndex="1"/>

        <!-- MAIN WORK AREA + 4-EDGE CONFIGURABLE TASKBAR -->
        <Grid x:Name="WorkspaceShellGrid" Panel.ZIndex="2">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TopTaskbarRow" Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition x:Name="BottomTaskbarRow" Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftTaskbarCol" Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="RightTaskbarCol" Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ============================================================= -->
            <!-- DESKTOP SURFACE + RESIZABLE OS WINDOWS                        -->
            <!-- ============================================================= -->
            <Grid x:Name="DesktopWorkAreaGrid" Grid.Row="1" Grid.Column="1" Background="Transparent"
                  MouseLeftButtonDown="DesktopSurface_MouseLeftButtonDown"
                  MouseMove="DesktopSurface_MouseMove"
                  MouseLeftButtonUp="DesktopSurface_MouseLeftButtonUp"
                  MouseRightButtonUp="DesktopSurface_MouseRightButtonUp"
                  AllowDrop="True"
                  DragOver="DesktopSurface_ExternalFileDragOver"
                  Drop="DesktopSurface_ExternalFileDrop">

                <Canvas x:Name="DesktopIconsCanvas" Background="Transparent"/>

                <Canvas IsHitTestVisible="False">
                    <Border x:Name="SelectionMarqueeBorder" Visibility="Collapsed" Background="#28C5A059" BorderBrush="#D9C5A059" BorderThickness="1.2" CornerRadius="4"/>
                    <Border x:Name="WindowSnapPreviewBorder" Visibility="Collapsed" Background="#22C5A059" BorderBrush="#F2C5A059" BorderThickness="1.8" CornerRadius="14"/>
                </Canvas>

                <Canvas x:Name="RenameOverlayCanvas" Visibility="Collapsed">
                    <Border x:Name="RenameBoxBorder" Background="#EB0B0E15" BorderBrush="#F2C5A059" BorderThickness="1.2" CornerRadius="6" Padding="4,2" Width="120">
                        <TextBox x:Name="InlineRenameTextBox" Background="Transparent" Foreground="#FFFFFF" CaretBrush="#C5A059" BorderThickness="0" FontSize="11.5" FontWeight="SemiBold" TextAlignment="Center"
                                 KeyDown="InlineRenameTextBox_KeyDown" LostFocus="InlineRenameTextBox_LostFocus"/>
                    </Border>
                </Canvas>

                <!-- ========================================================= -->
                <!-- FLOATING RESIZABLE & SNAPPABLE OS WINDOWS                 -->
                <!-- ========================================================= -->
                <Canvas x:Name="FloatingWindowsCanvas">

                    <!-- ===================================================== -->
                    <!-- OS WINDOW 1: FUNKENWERK DATEIEN (PRO FILE EXPLORER)   -->
                    <!-- ===================================================== -->
                    <Border x:Name="ExplorerWin" Visibility="Collapsed" Canvas.Left="150" Canvas.Top="55" Width="1020" Height="620" MinWidth="680" MinHeight="420"
                            Background="{DynamicResource WindowGlassBrush}" BorderBrush="{DynamicResource GoldBorderBrush}" BorderThickness="1.2" CornerRadius="16"
                            RenderTransformOrigin="0.5,0.5" MouseDown="FloatingWindow_ActivateMouseDown" PreviewMouseDown="ExplorerWin_PreviewMouseDown">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="42"/>
                                <RowDefinition Height="46"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="28"/>
                            </Grid.RowDefinitions>

                            <!-- Clean Window Header -->
                            <Border Grid.Row="0" Background="{DynamicResource WindowHeaderGlassBrush}" CornerRadius="15,15,0,0" Padding="14,0" Tag="ExplorerWin" MouseLeftButtonDown="WindowHeader_MouseLeftButtonDown">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Image x:Name="ExplorerHeaderIcon" Width="20" Height="20" Margin="0,0,8,0"/>
                                        <TextBlock Text="DATEIEN" Foreground="{DynamicResource ChampagneGoldBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Content="◧" Width="28" Height="25" Padding="0" Margin="0,0,4,0" Style="{StaticResource GlassBtn}" Tag="ExplorerWin|Left" Click="SnapInternalWin_Click" ToolTip="Links andocken"/>
                                        <Button Content="◨" Width="28" Height="25" Padding="0" Margin="0,0,6,0" Style="{StaticResource GlassBtn}" Tag="ExplorerWin|Right" Click="SnapInternalWin_Click" ToolTip="Rechts andocken"/>
                                        <Button Content="—" Width="28" Height="25" Padding="0" Margin="0,0,4,0" Style="{StaticResource GlassBtn}" Tag="ExplorerWin" Click="MinimizeInternalWin_Click"/>
                                        <Button Content="□" Width="28" Height="25" Padding="0" Margin="0,0,4,0" Style="{StaticResource GlassBtn}" Tag="ExplorerWin" Click="MaximizeInternalWin_Click"/>
                                        <Button Content="✕" Width="28" Height="25" Padding="0" Style="{StaticResource GlassBtn}" Tag="ExplorerWin" Click="CloseInternalWin_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Pro Explorer Navigation, Breadcrumb, Search & View Switcher Bar -->
                            <Border Grid.Row="1" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Padding="10,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="165"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Back / Forward / Up -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <Button x:Name="ExpBackBtn" Content="←" Width="30" Height="28" Padding="0" Margin="0,0,4,0" Style="{StaticResource GlassBtn}" Click="ExplorerBack_Click" ToolTip="Zurück"/>
                                        <Button x:Name="ExpForwardBtn" Content="→" Width="30" Height="28" Padding="0" Margin="0,0,4,0" Style="{StaticResource GlassBtn}" Click="ExplorerForward_Click" ToolTip="Vorwärts"/>
                                        <Button Content="↑" Width="30" Height="28" Padding="0" Style="{StaticResource GlassBtn}" Click="ExplorerUp_Click" ToolTip="Übergeordneter Ordner"/>
                                    </StackPanel>

                                    <!-- Clickable Breadcrumb Bar -->
                                    <Border Grid.Column="1" Background="{DynamicResource InputGlassBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="8" Height="30" Padding="6,0" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center">
                                            <ItemsControl x:Name="ExplorerBreadcrumbsControl">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Content="{Binding Label}" Tag="{Binding FullPath}" Padding="6,2" FontSize="11.5" Style="{StaticResource TrayIconBtn}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                                    AllowDrop="True" DragOver="ExplorerDropTarget_DragOver" Drop="BreadcrumbSegment_Drop" Click="BreadcrumbSegment_Click"/>
                                                            <TextBlock Text="›" Foreground="#C5A059" FontSize="12" VerticalAlignment="Center" Margin="1,0"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>

                                    <!-- Instant Search Filter -->
                                    <Border Grid.Column="2" Background="{DynamicResource InputGlassBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="8" Height="30" Padding="8,0" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="18"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Foreground="#C5A059" VerticalAlignment="Center"/>
                                            <TextBox x:Name="ExplorerSearchBox" Grid.Column="1" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" CaretBrush="#C5A059" BorderThickness="0" VerticalContentAlignment="Center" FontSize="12"
                                                     TextChanged="ExplorerSearchBox_TextChanged"/>
                                        </Grid>
                                    </Border>

                                    <!-- View Mode Toggle (Große Symbole vs Detail-Tabelle) + New Folder / Note + Trichter + Cloud Sync -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="ViewIconsBtn" Content="⊞" Width="32" Height="28" Padding="0" Margin="0,0,4,0" Style="{StaticResource GlassBtn}" Click="SwitchExplorerViewIcons_Click" ToolTip="Große Symbole"/>
                                        <Button x:Name="ViewDetailsBtn" Content="☰" Width="32" Height="28" Padding="0" Margin="0,0,8,0" Style="{StaticResource NobleGoldBtn}" Click="SwitchExplorerViewDetails_Click" ToolTip="Detail-Tabelle"/>
                                        <Button Content="+ Ordner" Height="28" Margin="0,0,5,0" Style="{StaticResource GlassBtn}" Click="ExplorerNewFolder_Click"/>
                                        <Button Content="+ Notiz" Height="28" Margin="0,0,5,0" Style="{StaticResource GlassBtn}" Click="ExplorerNewNote_Click"/>
                                        <Button Content="📥 Trichter" Height="28" Margin="0,0,5,0" Style="{StaticResource NobleGoldBtn}" Click="ExplorerSortFunnel_Click" ToolTip="00_Eingang_Trichter automatisch in die 8 Säulen einsortieren"/>
                                        <Button Content="☁ Sync" Height="28" Margin="0,0,5,0" Style="{StaticResource GlassBtn}" Click="ExplorerSyncCloudNow_Click" ToolTip="Meine Daten (8 Säulen) mit kDrive &amp; Anbindungen synchronisieren"/>
                                        <Button x:Name="EmptyRecycleBtn" Visibility="Collapsed" Content="Leeren" Height="28" Style="{StaticResource NobleGoldBtn}" Click="EmptyRecycleBin_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Sidebar + Dual-View Content Area -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="212"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left Sidebar: Strict 8-Pillar Trichter Architecture + Cloud Bindings (kDrive) + Mounted Drives (Zero Standard Folders!) -->
                                <Border Grid.Column="0" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,1,0" Padding="8,10">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <TextBlock Text="TRICHTER &amp; ZENTRALE" Foreground="#C5A059" FontSize="10" FontWeight="Bold" Margin="10,0,0,4"/>
                                            <Button Content="✦  Meine Daten" Style="{StaticResource ContextItemBtn}" Foreground="#FCE7B2" Tag="MeineDaten" AllowDrop="True" DragOver="ExplorerDropTarget_DragOver" Drop="ExplorerQuickNav_Drop" Click="ExplorerQuickNav_Click"/>
                                            <Button Content="📥  00 · Eingang-Trichter" Style="{StaticResource ContextItemBtn}" Tag="EingangTrichter" AllowDrop="True" DragOver="ExplorerDropTarget_DragOver" Drop="ExplorerQuickNav_Drop" Click="ExplorerQuickNav_Click"/>
                                            <Button Content="Desktop" Style="{StaticResource ContextItemBtn}" Tag="OsDesktop" AllowDrop="True" DragOver="ExplorerDropTarget_DragOver" Drop="ExplorerQuickNav_Drop" Click="ExplorerQuickNav_Click"/>
                                            <Button Content="Papierkorb" Style="{StaticResource ContextItemBtn}" Tag="RecycleBin" AllowDrop="True" DragOver="ExplorerDropTarget_DragOver" Drop="ExplorerQuickNav_Drop" Click="ExplorerQuickNav_Click"/>

                                            <Border Height="1" Background="{DynamicResource SubtleBorderBrush}" Margin="8,7"/>
                                            <TextBlock Text="8 SÄULEN (MEINE DATEN)" Foreground="#C5A059" FontSize="10" FontWeight="Bold" Margin="10,0,0,4"/>
                                            <Button Content="01 · Mein-Seelenfunke" Style="{StaticResource ContextItemBtn}" Tag="Pillar:01_Mein-Seelenfunke" AllowDrop="True" DragOver="ExplorerDropTarget_DragOver" Drop="ExplorerQuickNav_Drop" Click="ExplorerQuickNav_Click"/>
                                            <Button Content="02 · Finanzen &amp; Steuern" Style="{StaticResource ContextItemBtn}" Tag="Pillar:02_Finanzen_Steuern_Banken" AllowDrop="True" DragOver="ExplorerDropTarget_DragOver" Drop="ExplorerQuickNav_Drop" Click="ExplorerQuickNav_Click"/>
                                            <Button Content="03 · Haus &amp; Immobilie" Style="{StaticResource ContextItemBtn}" Tag="Pillar:03_Haus_Immobilie" AllowDrop="True" DragOver="ExplorerDropTarget_DragOver" Drop="ExplorerQuickNav_Drop" Click="ExplorerQuickNav_Click"/>
                                            <Button Content="04 · Verträge &amp; Mobilität" Style="{StaticResource ContextItemBtn}" Tag="Pillar:04_Versicherungen_Vertraege_Mobilitaet" AllowDrop="True" DragOver="ExplorerDropTarget_DragOver" Drop="ExplorerQuickNav_Drop" Click="ExplorerQuickNav_Click"/>
                                            <Button Content="05 · Familie &amp; Ausweise" Style="{StaticResource ContextItemBtn}" Tag="Pillar:05_Familie_Ausweise_Vorsorge" AllowDrop="True" DragOver="ExplorerDropTarget_DragOver" Drop="ExplorerQuickNav_Drop" Click="ExplorerQuickNav_Click"/>
                                            <Button Content="06 · Gesundheit" Style="{StaticResource ContextItemBtn}" Tag="Pillar:06_Gesundheit" AllowDrop="True" DragOver="ExplorerDropTarget_DragOver" Drop="ExplorerQuickNav_Drop" Click="ExplorerQuickNav_Click"/>
                                            <Button Content="07 · Behörden &amp; Recht" Style="{StaticResource ContextItemBtn}" Tag="Pillar:07_Behoerden_Recht_Berufshistorie" AllowDrop="True" DragOver="ExplorerDropTarget_DragOver" Drop="ExplorerQuickNav_Drop" Click="ExplorerQuickNav_Click"/>
                                            <Button Content="08 · Tresor &amp; Backups" Style="{StaticResource ContextItemBtn}" Tag="Pillar:08_Tresor_Backups" AllowDrop="True" DragOver="ExplorerDropTarget_DragOver" Drop="ExplorerQuickNav_Drop" Click="ExplorerQuickNav_Click"/>
                                            <Button x:Name="ExplorerWslProjectBtn" Content="Seelenfunke Projekt" Style="{StaticResource ContextItemBtn}" Tag="SeelenfunkeProject" AllowDrop="True" DragOver="ExplorerDropTarget_DragOver" Drop="ExplorerQuickNav_Drop" Click="ExplorerQuickNav_Click"/>

                                            <Border Height="1" Background="{DynamicResource SubtleBorderBrush}" Margin="8,7"/>
                                            <Grid Margin="10,0,6,4">
                                                <TextBlock Text="ANBINDUNGEN" Foreground="#C5A059" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                                <Button Content="+" Width="20" Height="18" Padding="0" FontSize="11" Style="{StaticResource GlassBtn}" HorizontalAlignment="Right" Click="OpenSettingsStorageTab_Click" ToolTip="Cloud- &amp; Speicher-Anbindungen verwalten"/>
                                            </Grid>

                                            <ItemsControl x:Name="ExplorerCloudBindingsControl">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource ContextItemBtn}" Tag="{Binding}" AllowDrop="True"
                                                                DragOver="ExplorerDropTarget_DragOver"
                                                                Drop="ExplorerCloudBindingItem_Drop"
                                                                Click="ExplorerCloudBindingItem_Click"
                                                                MouseRightButtonUp="ExplorerCloudBindingItem_RightClick">
                                                            <Grid Width="174">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Ellipse Grid.Column="0" Width="7" Height="7" Fill="{Binding StatusHex}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding SidebarLabel}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <Border Height="1" Background="{DynamicResource SubtleBorderBrush}" Margin="8,7"/>
                                            <TextBlock Text="LAUFWERKE" Foreground="#C5A059" FontSize="10" FontWeight="Bold" Margin="10,0,0,4"/>

                                            <ItemsControl x:Name="ExplorerDrivesControl">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource ContextItemBtn}" Tag="{Binding RootPath}" AllowDrop="True" DragOver="ExplorerDropTarget_DragOver" Drop="ExplorerDriveItem_Drop" Click="ExplorerDriveItem_Click">
                                                            <Grid Width="174">
                                                                <TextBlock Text="{Binding Label}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,46,0"/>
                                                                <TextBlock Text="{Binding FreeSpaceBadge}" FontSize="10" Foreground="#C5A059" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>

                                <!-- Right Dual-View Workspace (Supports Drop & Empty-Area Right-Click) -->
                                <Grid Grid.Column="1" Background="Transparent" AllowDrop="True"
                                      DragOver="ExplorerDropTarget_DragOver"
                                      Drop="ExplorerContent_Drop"
                                      MouseLeftButtonDown="ExplorerEmptySpace_MouseLeftButtonDown"
                                      MouseRightButtonUp="ExplorerEmptySpace_MouseRightButtonUp">

                                    <!-- VIEW MODE A: DETAIL-TABELLE (Name | Erstellt am | Geändert am | Typ | Größe) -->
                                    <Grid x:Name="ExplorerDetailsView" Visibility="Visible">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="32"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Sortable Column Header Row -->
                                        <Border Grid.Row="0" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Padding="12,0,18,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="136"/>
                                                    <ColumnDefinition Width="136"/>
                                                    <ColumnDefinition Width="74"/>
                                                    <ColumnDefinition Width="86"/>
                                                </Grid.ColumnDefinitions>
                                                <Button x:Name="ColSortNameBtn" Grid.Column="1" Content="Name ▲" Style="{StaticResource ColHeaderBtn}" Tag="Name" Click="ExplorerSortColumn_Click"/>
                                                <Button x:Name="ColSortCreatedBtn" Grid.Column="2" Content="Erstellt am" Style="{StaticResource ColHeaderBtn}" Tag="Created" Click="ExplorerSortColumn_Click"/>
                                                <Button x:Name="ColSortModifiedBtn" Grid.Column="3" Content="Geändert am" Style="{StaticResource ColHeaderBtn}" Tag="Modified" Click="ExplorerSortColumn_Click"/>
                                                <Button x:Name="ColSortTypeBtn" Grid.Column="4" Content="Typ" Style="{StaticResource ColHeaderBtn}" Tag="Type" Click="ExplorerSortColumn_Click"/>
                                                <Button x:Name="ColSortSizeBtn" Grid.Column="5" Content="Größe" HorizontalContentAlignment="Right" Style="{StaticResource ColHeaderBtn}" Tag="Size" Click="ExplorerSortColumn_Click"/>
                                            </Grid>
                                        </Border>

                                        <ListBox x:Name="ExplorerDetailsItemsControl" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="10,6"
                                                 VirtualizingPanel.IsVirtualizing="True"
                                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                                 VirtualizingPanel.ScrollUnit="Pixel"
                                                 ScrollViewer.CanContentScroll="True"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="0"/>
                                                    <Setter Property="Margin" Value="0"/>
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <ContentPresenter/>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="7" Padding="8,6" Margin="0,0,0,3" Cursor="Hand" BorderThickness="1"
                                                            AllowDrop="{Binding IsDirectory}" DragOver="ExplorerDropTarget_DragOver" Drop="ExplorerFolderRow_Drop"
                                                            Tag="{Binding}"
                                                            MouseLeftButtonDown="ExplorerEntry_MouseLeftButtonDown"
                                                            MouseMove="ExplorerEntry_MouseMove"
                                                            MouseRightButtonUp="ExplorerEntry_MouseRightButtonUp">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource CardGlassBrush}"/>
                                                                <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="Background" Value="#3EC5A059"/>
                                                                        <Setter Property="BorderBrush" Value="#F2C5A059"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsCut}" Value="True">
                                                                        <Setter Property="Opacity" Value="0.52"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="30"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="136"/>
                                                                <ColumnDefinition Width="136"/>
                                                                <ColumnDefinition Width="74"/>
                                                                <ColumnDefinition Width="86"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Image Grid.Column="0" Source="{Binding IconImage}" Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding CreatedFormatted}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding ModifiedFormatted}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="4" Text="{Binding TypeBadge}" FontSize="10.5" FontWeight="Bold" Foreground="#C5A059" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="5" Text="{Binding SizeFormatted}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>

                                    <!-- VIEW MODE B: GROSSE SYMBOLE (Large Tiles + Photo Thumbnails + Creation Date) -->
                                    <ScrollViewer x:Name="ExplorerIconsView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="12,10">
                                        <ItemsControl x:Name="ExplorerIconsItemsControl">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="124" Height="128" CornerRadius="11" Padding="8,9,8,6" Margin="0,0,8,8" Cursor="Hand" BorderThickness="1"
                                                            AllowDrop="{Binding IsDirectory}" DragOver="ExplorerDropTarget_DragOver" Drop="ExplorerFolderRow_Drop"
                                                            Tag="{Binding}"
                                                            MouseLeftButtonDown="ExplorerEntry_MouseLeftButtonDown"
                                                            MouseMove="ExplorerEntry_MouseMove"
                                                            MouseRightButtonUp="ExplorerEntry_MouseRightButtonUp">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource CardGlassBrush}"/>
                                                                <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="Background" Value="#3EC5A059"/>
                                                                        <Setter Property="BorderBrush" Value="#F2C5A059"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsCut}" Value="True">
                                                                        <Setter Property="Opacity" Value="0.52"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="58"/>
                                                                <RowDefinition Height="*"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>
                                                            <Image Grid.Row="0" Source="{Binding IconImage}" Width="52" Height="52" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextAlignment="Center" TextWrapping="Wrap" MaxHeight="32" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                                            <TextBlock Grid.Row="2" Text="{Binding CreatedFormatted}" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <!-- Inline Explorer Rename / Properties Modal Overlay -->
                                    <Grid x:Name="ExplorerModalOverlay" Visibility="Collapsed" Background="#9906080D">
                                        <Border Width="380" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{DynamicResource FlyoutGlassBrush}" BorderBrush="#F2C5A059" BorderThickness="1.2" CornerRadius="14" Padding="20">
                                            <StackPanel>
                                                <TextBlock x:Name="ExpModalTitleTxt" Text="EIGENSCHAFTEN" Foreground="#C5A059" FontSize="12" FontWeight="Bold" Margin="0,0,0,12"/>

                                                <TextBox x:Name="ExpModalInputBox" Visibility="Collapsed" Height="34" VerticalContentAlignment="Center" Padding="10,0" Margin="0,0,0,12"
                                                         Background="{DynamicResource InputGlassBrush}" Foreground="{DynamicResource TextPrimaryBrush}" CaretBrush="#C5A059" BorderBrush="{DynamicResource GoldBorderBrush}" BorderThickness="1"
                                                         KeyDown="ExpModalInputBox_KeyDown"/>

                                                <TextBlock x:Name="ExpModalDetailsTxt" Visibility="Collapsed" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" LineHeight="20" TextWrapping="Wrap" Margin="0,0,0,14"/>

                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button x:Name="ExpModalConfirmBtn" Content="Übernehmen" Style="{StaticResource NobleGoldBtn}" Margin="0,0,6,0" Click="ExpModalConfirm_Click"/>
                                                    <Button Content="Schließen" Style="{StaticResource GlassBtn}" Click="ExpModalClose_Click"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Grid>

                            <!-- Status Footer + Corner Resize Grip -->
                            <Border Grid.Row="3" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,1,0,0" Padding="12,0,6,0">
                                <Grid>
                                    <TextBlock x:Name="ExplorerStatusFooterTxt" Text="0 Elemente" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="⤡" FontSize="13" Foreground="#C5A059" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="SizeNWSE"
                                               Tag="ExplorerWin" MouseLeftButtonDown="WindowResizeGrip_MouseLeftButtonDown"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- ===================================================== -->
                    <!-- OS WINDOW 2: SYSTEMEINSTELLUNGEN & STANDARDPROGRAMME  -->
                    <!-- ===================================================== -->
                    <Border x:Name="SettingsWin" Visibility="Collapsed" Canvas.Left="240" Canvas.Top="75" Width="840" Height="560" MinWidth="680" MinHeight="460"
                            Background="{DynamicResource WindowGlassBrush}" BorderBrush="{DynamicResource GoldBorderBrush}" BorderThickness="1.2" CornerRadius="16"
                            RenderTransformOrigin="0.5,0.5" MouseDown="FloatingWindow_ActivateMouseDown">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="42"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="20"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="{DynamicResource WindowHeaderGlassBrush}" CornerRadius="15,15,0,0" Padding="14,0" Tag="SettingsWin" MouseLeftButtonDown="WindowHeader_MouseLeftButtonDown">
                                <Grid>
                                    <TextBlock Text="✦  EINSTELLUNGEN" Foreground="{DynamicResource ChampagneGoldBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Content="—" Width="28" Height="25" Padding="0" Margin="0,0,4,0" Style="{StaticResource GlassBtn}" Tag="SettingsWin" Click="MinimizeInternalWin_Click"/>
                                        <Button Content="□" Width="28" Height="25" Padding="0" Margin="0,0,4,0" Style="{StaticResource GlassBtn}" Tag="SettingsWin" Click="MaximizeInternalWin_Click"/>
                                        <Button Content="✕" Width="28" Height="25" Padding="0" Style="{StaticResource GlassBtn}" Tag="SettingsWin" Click="CloseInternalWin_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,1,0" Padding="12">
                                    <StackPanel>
                                        <Button x:Name="SetTabDefaultsBtn" Content="Standardprogramme" Style="{StaticResource NobleGoldBtn}" Margin="0,0,0,7" Click="OpenSettingsDefaultsTab_Click"/>
                                        <Button x:Name="SetTabStorageBtn" Content="Anbindungen &amp; Trichter" Style="{StaticResource GlassBtn}" Margin="0,0,0,7" Click="OpenSettingsStorageTab_Click"/>
                                        <Button x:Name="SetTabTaskbarBtn" Content="Taskleiste" Style="{StaticResource GlassBtn}" Margin="0,0,0,7" Click="OpenSettingsTaskbarTab_Click"/>
                                        <Button x:Name="SetTabStyleBtn" Content="Personalisierung" Style="{StaticResource GlassBtn}" Margin="0,0,0,7" Click="OpenSettingsStyleTab_Click"/>
                                        <Button x:Name="SetTabAccountBtn" Content="Seelenfunke Konto" Style="{StaticResource GlassBtn}" Margin="0,0,0,7" Click="OpenSettingsAccountTab_Click"/>
                                        <Button x:Name="SetTabFortressBtn" Content="Festung &amp; Freigaben" Style="{StaticResource GlassBtn}" Click="OpenSettingsFortressTab_Click"/>
                                    </StackPanel>
                                </Border>

                                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="20,14">
                                    <Grid>
                                        <!-- TAB 1: STANDARDPROGRAMME -->
                                        <StackPanel x:Name="SettingsDefaultsPanel" Visibility="Visible">
                                            <TextBlock Text="STANDARDPROGRAMME" Foreground="#C5A059" FontSize="11.5" FontWeight="Bold" Margin="0,0,0,12"/>

                                            <Border Background="{DynamicResource CardGlassBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,9" Margin="0,0,0,7">
                                                <Grid>
                                                    <TextBlock Text="Webseiten &amp; Links (.html, https)" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <Button Content="Browser" Style="{StaticResource NobleGoldBtn}" Padding="11,4" HorizontalAlignment="Right" IsHitTestVisible="False"/>
                                                </Grid>
                                            </Border>

                                            <Border Background="{DynamicResource CardGlassBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,9" Margin="0,0,0,7">
                                                <Grid>
                                                    <TextBlock Text="PDF-Dokumente (.pdf)" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <Button x:Name="DefPdfAppBtn" Content="PDF" Style="{StaticResource NobleGoldBtn}" Padding="11,4" Margin="0,0,6,0" Tag="pdf|pdf" Click="SelectDefaultProgram_Click"/>
                                                        <Button x:Name="DefPdfPrintBtn" Content="Drucker" Style="{StaticResource GlassBtn}" Padding="11,4" Tag="pdf|drucker" Click="SelectDefaultProgram_Click"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <Border Background="{DynamicResource CardGlassBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,9" Margin="0,0,0,7">
                                                <Grid>
                                                    <TextBlock Text="Audio &amp; Musik (.mp3, .wav, .flac)" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <Button x:Name="DefAudioPlayerBtn" Content="Mediaplayer" Style="{StaticResource NobleGoldBtn}" Padding="11,4" Margin="0,0,6,0" Tag="audio|player" Click="SelectDefaultProgram_Click"/>
                                                        <Button x:Name="DefAudioSuiteBtn" Content="Zentrale" Style="{StaticResource GlassBtn}" Padding="11,4" Tag="audio|funkenwerk" Click="SelectDefaultProgram_Click"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <Border Background="{DynamicResource CardGlassBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,9" Margin="0,0,0,7">
                                                <Grid>
                                                    <TextBlock Text="Videos (.mp4, .mkv, .mov)" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <Button x:Name="DefVideoPlayerBtn" Content="Mediaplayer" Style="{StaticResource NobleGoldBtn}" Padding="11,4" Margin="0,0,6,0" Tag="video|player" Click="SelectDefaultProgram_Click"/>
                                                        <Button x:Name="DefVideoStudioBtn" Content="Videostudio" Style="{StaticResource GlassBtn}" Padding="11,4" Tag="video|video" Click="SelectDefaultProgram_Click"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <Border Background="{DynamicResource CardGlassBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,9" Margin="0,0,0,14">
                                                <Grid>
                                                    <TextBlock Text="Bilder (.png, .jpg, .webp)" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <Button x:Name="DefImgInternalBtn" Content="Bildvorschau" Style="{StaticResource NobleGoldBtn}" Padding="11,4" Margin="0,0,6,0" Tag="image|internal_image" Click="SelectDefaultProgram_Click"/>
                                                        <Button x:Name="DefImgDruckerBtn" Content="Drucker" Style="{StaticResource GlassBtn}" Padding="11,4" Tag="image|drucker" Click="SelectDefaultProgram_Click"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <Button Content="✦  ALS SYSTEM-STANDARD ÜBERNEHMEN" Height="36" Style="{StaticResource NobleGoldBtn}" Click="SyncSystemDefaultPrograms_Click"/>
                                        </StackPanel>

                                        <!-- TAB 1A: ANBINDUNGEN (kDrive / CLOUD / NAS) & KEIN-DATENMÜLL TRICHTER -->
                                        <StackPanel x:Name="SettingsStoragePanel" Visibility="Collapsed">
                                            <TextBlock Text="TRICHTER-LOGIK &amp; KEIN-DATENMÜLL-WÄCHTER" Foreground="#C5A059" FontSize="11.5" FontWeight="Bold" Margin="0,0,0,10"/>

                                            <Border Background="{DynamicResource CardGlassBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,7">
                                                <Grid>
                                                    <TextBlock Text="Downloads automatisch in Trichter (8 Säulen) leiten" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <Button x:Name="AutoRedirectDownloadsToggleBtn" Content="AKTIV" Width="115" Style="{StaticResource NobleGoldBtn}" HorizontalAlignment="Right" Click="ToggleAutoRedirectDownloads_Click"/>
                                                </Grid>
                                            </Border>

                                            <Border Background="{DynamicResource CardGlassBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,10">
                                                <Grid>
                                                    <TextBlock Text="Kein-Datenmüll-Wächter (Temp/Junk &amp; 8-Säulen-Zwang)" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <Button x:Name="ZeroGarbageGuardToggleBtn" Content="AKTIV" Width="115" Style="{StaticResource NobleGoldBtn}" HorizontalAlignment="Right" Click="ToggleZeroGarbageGuard_Click"/>
                                                </Grid>
                                            </Border>

                                            <UniformGrid Columns="2" Margin="0,0,0,16">
                                                <Button Content="📥  Trichter jetzt sortieren" Height="34" Margin="0,0,4,0" Style="{StaticResource GlassBtn}" Click="ExplorerSortFunnel_Click"/>
                                                <Button Content="☁  Mit kDrive &amp; Anbindungen synchronisieren" Height="34" Margin="4,0,0,0" Style="{StaticResource NobleGoldBtn}" Click="ExplorerSyncCloudNow_Click"/>
                                            </UniformGrid>

                                            <TextBlock Text="CLOUD- &amp; SPEICHER-ANBINDUNGEN (kDRIVE, WEBDAV, NAS)" Foreground="#C5A059" FontSize="11.5" FontWeight="Bold" Margin="0,0,0,8"/>

                                            <ItemsControl x:Name="StorageBindingsListControl" Margin="0,0,0,10">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource CardGlassBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,0,0,7">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>

                                                                <Grid Grid.Row="0">
                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <Ellipse Width="8" Height="8" Fill="{Binding StatusHex}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                                        <TextBlock Text="{Binding StatusBadge}" FontSize="10.5" Foreground="#C5A059" FontWeight="Bold" VerticalAlignment="Center"/>
                                                                    </StackPanel>

                                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                                        <Button Content="Öffnen" Height="25" Padding="9,0" Margin="0,0,4,0" Style="{StaticResource GlassBtn}" Tag="{Binding Id}" Click="OpenStorageBindingInExplorer_Click"/>
                                                                        <Button Content="Trichter-Eingang" Height="25" Padding="9,0" Margin="0,0,4,0" Style="{StaticResource GlassBtn}" Tag="{Binding Id}" Click="ToggleStorageBindingIngest_Click"/>
                                                                        <Button Content="8-Säulen-Sync" Height="25" Padding="9,0" Margin="0,0,4,0" Style="{StaticResource GlassBtn}" Tag="{Binding Id}" Click="ToggleStorageBindingMirror_Click"/>
                                                                        <Button Content="✕" Width="25" Height="25" Padding="0" Style="{StaticResource GlassBtn}" Tag="{Binding Id}" Click="RemoveStorageBinding_Click"/>
                                                                    </StackPanel>
                                                                </Grid>

                                                                <Grid Grid.Row="1" Margin="16,4,0,0">
                                                                    <TextBlock Text="{Binding LocalOrUncPath}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,220,0"/>
                                                                    <TextBlock Text="{Binding ModeSummary}" FontSize="10.5" Foreground="#FCE7B2" HorizontalAlignment="Right"/>
                                                                </Grid>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Add Custom Cloud / NAS / WebDAV Binding -->
                                            <Border Background="{DynamicResource CardGlassBrush}" BorderBrush="#99C5A059" BorderThickness="1" CornerRadius="10" Padding="11">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="140"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="NewBindingNameBox" Grid.Column="0" Height="28" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,5,0"
                                                             Background="{DynamicResource InputGlassBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1"
                                                             Text="kDrive / Cloud"/>
                                                    <TextBox x:Name="NewBindingPathBox" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,5,0"
                                                             Background="{DynamicResource InputGlassBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1"/>
                                                    <Button Grid.Column="2" Content="Ordner" Height="28" Margin="0,0,5,0" Style="{StaticResource GlassBtn}" Click="BrowseNewBindingFolder_Click"/>
                                                    <Button Grid.Column="3" Content="+ Anbinden" Height="28" Style="{StaticResource NobleGoldBtn}" Click="AddStorageBinding_Click"/>
                                                </Grid>
                                            </Border>
                                        </StackPanel>

                                        <!-- TAB 1B: TASKLEISTENEINSTELLUNGEN -->
                                        <StackPanel x:Name="SettingsTaskbarPanel" Visibility="Collapsed">
                                            <TextBlock Text="TASKLEISTEN-POSITION" Foreground="#C5A059" FontSize="11.5" FontWeight="Bold" Margin="0,0,0,10"/>
                                            <UniformGrid Columns="4" Margin="0,0,0,16">
                                                <Button x:Name="TbPosBottomBtn" Content="Unten" Height="38" Margin="0,0,4,0" Style="{StaticResource NobleGoldBtn}" Tag="Bottom" Click="SelectTaskbarPosition_Click"/>
                                                <Button x:Name="TbPosTopBtn" Content="Oben" Height="38" Margin="2,0,2,0" Style="{StaticResource GlassBtn}" Tag="Top" Click="SelectTaskbarPosition_Click"/>
                                                <Button x:Name="TbPosLeftBtn" Content="Links" Height="38" Margin="2,0,2,0" Style="{StaticResource GlassBtn}" Tag="Left" Click="SelectTaskbarPosition_Click"/>
                                                <Button x:Name="TbPosRightBtn" Content="Rechts" Height="38" Margin="4,0,0,0" Style="{StaticResource GlassBtn}" Tag="Right" Click="SelectTaskbarPosition_Click"/>
                                            </UniformGrid>

                                            <TextBlock Text="APP-VERKNÜPFUNGEN POSITION" Foreground="#C5A059" FontSize="11.5" FontWeight="Bold" Margin="0,0,0,10"/>
                                            <UniformGrid Columns="3" Margin="0,0,0,16">
                                                <Button x:Name="TbAlignLeftBtn" Content="Links" Height="38" Margin="0,0,5,0" Style="{StaticResource NobleGoldBtn}" Tag="Left" Click="SelectTaskbarAlignment_Click"/>
                                                <Button x:Name="TbAlignCenterBtn" Content="Mittig" Height="38" Margin="2,0,2,0" Style="{StaticResource GlassBtn}" Tag="Center" Click="SelectTaskbarAlignment_Click"/>
                                                <Button x:Name="TbAlignRightBtn" Content="Rechts" Height="38" Margin="5,0,0,0" Style="{StaticResource GlassBtn}" Tag="Right" Click="SelectTaskbarAlignment_Click"/>
                                            </UniformGrid>

                                            <TextBlock Text="DARSTELLUNG" Foreground="#C5A059" FontSize="11.5" FontWeight="Bold" Margin="0,0,0,10"/>
                                            <Border Background="{DynamicResource CardGlassBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,11" Margin="0,0,0,10">
                                                <Grid>
                                                    <TextBlock Text="Transparent-Modus" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <Button x:Name="TaskbarTransparentToggleBtn" Content="AUS" Width="130" Style="{StaticResource GlassBtn}" HorizontalAlignment="Right" Click="ToggleTaskbarTransparent_Click"/>
                                                </Grid>
                                            </Border>
                                        </StackPanel>

                                        <!-- TAB 2: PERSONALISIERUNG -->
                                        <StackPanel x:Name="SettingsStylePanel" Visibility="Collapsed">
                                            <TextBlock Text="HINTERGRUND" Foreground="#C5A059" FontSize="11.5" FontWeight="Bold" Margin="0,0,0,10"/>
                                            <UniformGrid Columns="3" Margin="0,0,0,16">
                                                <Button x:Name="WpVideoBtn" Content="Atelier Live-Video" Height="40" Margin="0,0,6,0" Style="{StaticResource NobleGoldBtn}" Click="SetWallpaperVideo_Click"/>
