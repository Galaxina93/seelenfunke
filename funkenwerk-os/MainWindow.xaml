                                    <StackPanel><TextBlock Text="VERFÜGBAR" Foreground="#C5A059" FontSize="10.5" FontWeight="Bold"/><TextBlock x:Name="KpiAvailableTxt" Text="0,00 €" FontSize="24" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel>
                                </Border>
                                <Border Background="{DynamicResource CardGlassBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                                    <StackPanel><TextBlock Text="OFFENE AUFGABEN" Foreground="#C5A059" FontSize="10.5" FontWeight="Bold"/><TextBlock x:Name="KpiOpenTasksTxt" Text="0" FontSize="24" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel>
                                </Border>
                            </UniformGrid>

                            <Grid Grid.Row="2" Margin="16,0,16,4">
