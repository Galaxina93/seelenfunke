                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="20"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="{DynamicResource WindowHeaderGlassBrush}" CornerRadius="15,15,0,0" Padding="14,0" Tag="LeitstandWin" MouseLeftButtonDown="WindowHeader_MouseLeftButtonDown">
