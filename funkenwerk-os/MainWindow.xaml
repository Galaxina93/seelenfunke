                                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Grid.Column="2" Text="{Binding StatusLabel}" FontSize="10.5" Foreground="#C5A059" FontWeight="Bold" VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Grid>

                            <TextBlock Grid.Row="3" Text="⤡" FontSize="13" Foreground="#C5A059" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,2" Cursor="SizeNWSE"
                                       Tag="LeitstandWin" MouseLeftButtonDown="WindowResizeGrip_MouseLeftButtonDown"/>
                        </Grid>
                    </Border>

                    <!-- ===================================================== -->
                    <!-- OS WINDOW 4: NOTIZ-EDITOR & LIGHTBOX BILDVORSCHAU     -->
                    <!-- ===================================================== -->
                    <Border x:Name="ViewerWin" Visibility="Collapsed" Canvas.Left="300" Canvas.Top="90" Width="760" Height="520" MinWidth="460" MinHeight="340"
                            Background="{DynamicResource WindowGlassBrush}" BorderBrush="{DynamicResource GoldBorderBrush}" BorderThickness="1.2" CornerRadius="16"
