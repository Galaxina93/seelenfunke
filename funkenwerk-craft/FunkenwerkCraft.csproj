<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>FunkenwerkCraft</AssemblyName>
    <RootNamespace>FunkenwerkCraft</RootNamespace>
    <Product>Funkenwerk Craft</Product>
    <Company>Mein-Seelenfunke</Company>
    <Version>1.5.1</Version>
    <AssemblyVersion>1.5.1.15</AssemblyVersion>
    <FileVersion>1.5.1.15</FileVersion>
    <InformationalVersion>1.5.1+b15</InformationalVersion>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>funkenwerk_craft.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\funkenwerk\FunkenwerkVersioning.cs" Link="Shared\FunkenwerkVersioning.cs" />
    <Resource Include="funkenwerk_craft.ico" />
    <Resource Include="funkenwerk_craft.png" />
    <None Include="funkenwerk_craft.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
