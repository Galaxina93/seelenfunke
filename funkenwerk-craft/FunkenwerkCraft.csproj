<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>FunkenwerkCraft</AssemblyName>
    <RootNamespace>FunkenwerkCraft</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>funkenwerk_craft.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="funkenwerk_craft.ico" />
    <Resource Include="funkenwerk_craft.png" />
    <None Include="funkenwerk_craft.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
